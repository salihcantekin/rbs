          ],
          "description": "The new output profile, when one was written."
        },
        "report": {
          "$ref": "#/$defs/ObsCheck",
          "description": "The check's report."
        },
        "shortcuts_added": {
          "description": "Hotkeys added as shortcuts.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "collection",
        "shortcuts_added",
        "report"
      ],
      "title": "ObsRun",
      "type": "object"
