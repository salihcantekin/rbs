    "output_schema": {
      "$defs": {
        "LibraryEntry": {
          "description": "One entry of a user data library (`profile.list`, `collection.list`; protocol 1.4).",
          "properties": {
            "id": {
              "description": "Its stable id, passed to `profile.switch` and `collection.switch`.",
              "type": "string"
            },
            "name": {
              "description": "Its name, unique in the library ignoring case.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "type": "object"
        },
        "ObsCheck": {
          "description": "`import.obs.check` (protocol 1.82): the report; nothing was written.",
          "properties": {
            "entries": {
              "description": "What does not, in the order met.",
              "items": {
                "$ref": "#/$defs/ObsReportEntry"
              },
              "type": "array"
            },
            "exact": {
              "$ref": "#/$defs/ObsCounts",
              "description": "What comes across exactly."
            },
            "name": {
