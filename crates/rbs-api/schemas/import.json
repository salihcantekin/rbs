  },
  "import.obs.scan": {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Parameters of a method that takes none. Unknown fields are ignored.",
      "title": "Empty",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`import.obs.scan` (protocol 1.82): what OBS's settings folders on the server's\ncomputer hold, by name only (never a path).",
      "properties": {
        "collections": {
          "description": "Scene collection names, as `import.obs.check` takes them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profiles": {
          "description": "Profile names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "collections",
        "profiles"
      ],
      "title": "ObsScan",
      "type": "object"
    }
  }
