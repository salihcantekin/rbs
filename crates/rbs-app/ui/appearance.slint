// Settings › Appearance (ADR-0057, docs/specs/themes.md): which theme the app uses, the
// theme library and the theme editor. Rust (`appearance_page`) pushes state into the
// `Appearance` global of the Settings window and handles its callbacks.
import { Theme, Tokens } from "tokens.slint";
import { Button, Checkbox, ColorPicker, FocusRing, RingFocus, IconButton, IconName, MenuSurface, NumberField, Overlays, SegmentedControl, Select, Slider, TextField, Toggle, ValueReadout, SettingRow, ListRow } from "components.slint";
import { SettingsCard, SettingBlock, SettingsNotice, SettingsCallout, RevealOnShow } from "settings.slint";

// One theme in the library: built-in themes first, then user themes by name.
// `surface`, `text`, `accent`: its swatch. `usable`: it passes every rule; else
// `problem` is its first problem.
export struct ThemeOption {
    name: string,
    user: bool,
    usable: bool,
    problem: string,
    surface: color,
    text: color,
    accent: color,
    // Colour warnings of a usable theme (ADR-0072).
    warnings: int,
}

// One token in the editor. `kind`: 0 colour, 1 number (`unit` px or ms), 2 text style,
// 3 font family. `overridden`: the theme sets it (Reset removes it).
export struct ThemeTokenRow {
    name: string,
    label: string,
    kind: int,
    color: color,
    number: float,
    step: float,
    unit: string,
    size: float,
    line: float,
    weight: float,
    fonts: string,
    overridden: bool,
    problem: string,
    // Colour warnings in words (ADR-0072): shown, never blocking.
    warning: string,
    // "Fix" can clear the warnings by moving the colour's lightness.
    fixable: bool,
}

export global Appearance {
    in property <[ThemeOption]> themes;
    // Usable themes only, for the pickers, and their list positions.
    in property <[string]> usable-names;
    in property <bool> follow-system: true;
    // Spacing for every theme (ADR-0112): 0 regular, 1 compact (spacing, control height
    // and panel gaps step down), 2 roomy (default control and panel gaps step up).
    in property <int> density: 0;
    // Stops 1, 2 and 3. Kept while compact is off.
    in property <int> compact-steps: 1;
    // Positions in `usable-names`.
    in property <int> dark-index;
    in property <int> light-index;
    in property <int> theme-index;
    // Position in `themes`; -1 none.
    in property <int> selected: -1;
    // A note: a theme in use could not be used, or an action failed.
    in property <string> note;
    // `RBS_TOKENS` or `RBS_THEME` is set.
    in property <bool> dev-override;
    // "Keep this look?" is asked.
    in property <bool> keep-asking;
    in property <int> keep-seconds;
    // The editor.
    in property <bool> editing;
    in property <string> editor-name;
    in property <[string]> groups;
    in property <int> group;
    in property <[ThemeTokenRow]> rows;
    in property <[string]> general-problems;
    // How many colour warnings the draft has (ADR-0072).
    in property <int> warning-count;
    in property <[string]> unknown-tokens;
    in property <bool> can-save;
    in property <bool> changed;
    // The theme being edited is used by a slot: its changes show in the windows.
    in property <bool> editing-in-use;
    // The family the window uses now ("" the system font).
    in property <string> font-in-use;
    // A value typed in the editor and not yet confirmed (Enter or leaving the field):
    // `pending-kind` is the row's kind (1 number, 2 text style, 3 font family) or -1
    // for none, `pending-part` the text style's part. Only the focused field types, so
    // one slot holds it. Save is on while it is set and applies it first, so a value
    // being typed is saved without leaving the field.
    in-out property <int> pending-kind: -1;
    // The font picker's list: `find-fonts` fills the picker's rows with the installed
    // families whose names contain the filter, when it opens and as the filter changes.
    callback find-fonts(string);
    // The button that opened the picker (its row's label), the family picked and a
    // counter that moves with each pick.
    in-out property <string> font-owner;
    in-out property <string> font-picked;
    in-out property <int> font-picked-serial;
    // The font field's suggestions for the family being typed (the part after the
    // last comma): names that start with it first. `suggest-fonts` fills it as the
    // field's text changes; `complete-font` returns the text with that part replaced.
    in property <[string]> font-suggestions;
    callback suggest-fonts(string);
    pure callback complete-font(string, string) -> string;
    in-out property <string> pending-name;
    in-out property <int> pending-part;
    in-out property <string> pending-text;
    public function hold(kind: int, name: string, part: int, text: string) {
        pending-kind = kind;
        pending-name = name;
        pending-part = part;
        pending-text = text;
    }
    public function apply-pending() {
        if pending-kind == 1 && pending-text.is-float() {
            set-number(pending-name, pending-text.to-float());
        } else if pending-kind == 2 && pending-text.is-float() {
            set-style(pending-name, pending-part, pending-text.to-float());
        } else if pending-kind == 3 {
            set-fonts(pending-text);
        }
        pending-kind = -1;
    }
    // 0 dark, 1 light, 2 the one theme.
    callback pick(int, int);
    callback set-follow-system(bool);
    callback set-density(int);
    callback set-compact-steps(int);
    callback select(int);
    callback use-selected();
    callback edit();
    callback duplicate();
    callback rename(string);
    callback delete();
    callback import();
    callback export();
    callback set-group(int);
    callback set-color(string, string);
    callback set-number(string, float);
    callback set-style(string, int, float);
    callback set-fonts(string);
    callback reset(string);
    // Moves a colour to the nearest lightness that clears its warnings.
    callback fix(string);
    callback save();
    callback cancel();
    callback keep();
    callback undo();
}

component Hint inherits Text {
    color: Theme.text-secondary;
    font-size: Tokens.type-caption-size;
    wrap: word-wrap;
}

// A colour warning: a small mark and the words in the warning colour (amber), so it
// reads as advice, not as an error (ADR-0072).
component Warning inherits HorizontalLayout {
    in property <string> text;
    spacing: Tokens.space-2;
    VerticalLayout {
        padding-top: (Tokens.type-caption-line - Tokens.space-2) / 2;
        alignment: start;
        Rectangle {
            width: Tokens.space-2;
            height: Tokens.space-2;
            border-radius: Tokens.space-1;
            background: Theme.state-warning;
            accessible-role: none;
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: Theme.state-warning;
        font-size: Tokens.type-caption-size;
        wrap: word-wrap;
        accessible-label: @tr("Warning: {}", root.text);
    }
}

component Problem inherits Text {
    color: Theme.state-error;
    font-size: Tokens.type-caption-size;
    wrap: word-wrap;
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: Tokens.space-1;
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    @children
}

// Three squares: background, text and accent colour of a theme.
component Swatch inherits HorizontalLayout {
    in property <color> surface;
    in property <color> text;
    in property <color> accent;
    spacing: 0px;
    alignment: start;
    accessible-role: none;
    for c in [root.surface, root.text, root.accent]: Rectangle {
        width: Tokens.size-icon-box;
        height: Tokens.size-icon-box;
        background: c;
        border-width: Tokens.size-border;
        border-color: Theme.border-subtle;
    }
}

// "Keep this look?" (spec: Keep this look). Escape is Undo (the Settings window).
component KeepLook inherits Rectangle {
    background: Theme.surface-overlay;
    border-radius: Tokens.radius-sm;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    height: row.preferred-height;
    accessible-role: groupbox;
    accessible-label: @tr("Keep this look?");
    row := HorizontalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-2;
        Text {
            horizontal-stretch: 1;
            text: @tr("Keep this look? It goes back in {} s.", Appearance.keep-seconds);
            color: Theme.text-primary;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        Button {
            text: @tr("Keep");
            kind: "primary";
            clicked => { Appearance.keep(); }
        }
        Button {
            text: @tr("Undo");
            clicked => { Appearance.undo(); }
        }
    }
}

// "Add font": opens the searchable picker (ADR-0094 B1, `Overlays.picker-*`) over the
// fonts this computer has. The list is read when the picker first opens (nothing is read
// while the editor is unused, P13). A pick comes back as `Appearance.font-picked`, and
// only the button that opened the picker (`font-owner`) reports it with `picked`; the
// row puts it first in the family list.
component FontMenu inherits Button {
    in property <string> for-label;
    callback picked(string);
    property <int> serial: Appearance.font-picked-serial;
    text: @tr("Add font");
    accessible-name: @tr("Add a font to {}", root.for-label);
    icon: IconName.chevron-down;
    dense: true;
    changed serial => {
        if Appearance.font-owner == root.for-label { root.picked(Appearance.font-picked); }
    }
    // The focus goes back to the button that opened the picker when it closes.
    property <bool> picking: Overlays.picker-open;
    changed picking => {
        if !root.picking && Appearance.font-owner == root.for-label { root.take-focus(); }
    }
    clicked => {
        Appearance.font-owner = root.for-label;
        Overlays.picker-title = @tr("Add a font to {}", root.for-label);
        Overlays.picker-status = "";
        Overlays.picker-open = true;
        Appearance.find-fonts("");
    }
}

// The font family field: the editable list, with suggestions under it while a name
// is typed (installed families read the first time something is typed, P13). Down
// and Up move the highlight, Tab completes the name and keeps typing, Return
// completes and confirms, Escape hides the suggestions. A click on one completes it.
component FontField inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    // The text as typed (not yet confirmed) and confirmed (Return or leaving).
    callback edited(string);
    callback accepted(string);
    out property <string> text: field.text;
    public function set-text(t: string) {
        field.text = t;
        field.caret-to-end();
        root.edited(t);
    }
    property <int> pick: 0;
    property <bool> hidden;
    // The pointer is over a suggestion: the list stays open when the click takes focus
    // from the field.
    property <bool> over;
    property <bool> open: (field.has-focus || root.over) && !root.hidden && Appearance.font-suggestions.length > 0;
    function take(name: string) {
        root.set-text(Appearance.complete-font(field.text, name));
        Appearance.suggest-fonts("");
    }
    // A pick with the pointer is final: the field shows the whole name and confirms it.
    function choose(name: string) {
        root.take(name);
        root.over = false;
        root.accepted(field.text);
    }
    spacing: Tokens.space-1;
    keys := FocusScope {
        // literal-begin: a key hook around the field, not a visual value
        focus-on-click: false;
        focus-on-tab-navigation: false;
        // literal-end
        height: field.height;
        capture-key-pressed(e) => {
            if !root.open { return reject; }
            if e.text == Key.DownArrow {
                root.pick = mod(root.pick + 1, Appearance.font-suggestions.length);
                return accept;
            }
            if e.text == Key.UpArrow {
                root.pick = mod(root.pick + Appearance.font-suggestions.length - 1, Appearance.font-suggestions.length);
                return accept;
            }
            if e.text == Key.Tab && !e.modifiers.shift {
                root.take(Appearance.font-suggestions[root.pick]);
                return accept;
            }
            if e.text == Key.Return {
                root.take(Appearance.font-suggestions[root.pick]);
                root.accepted(field.text);
                return accept;
            }
            if e.text == Key.Escape {
                root.hidden = true;
                return accept;
            }
            reject
        }
        field := TextField {
            width: parent.width;
            label: root.label;
            placeholder: @tr("System font");
            text: root.value;
            edited(t) => {
                root.hidden = false;
                root.pick = 0;
                Appearance.suggest-fonts(t);
                root.edited(t);
            }
            accepted(t) => { root.accepted(t); }
        }
    }
    if root.open: MenuSurface {
        height: list.preferred-height;
        accessible-role: AccessibleRole.list;
        accessible-label: @tr("Fonts that match");
        list := VerticalLayout {
            padding: Tokens.space-1;
            for name[i] in Appearance.font-suggestions: Rectangle {
                height: Tokens.size-control-md;
                border-radius: Tokens.radius-sm;
                background: i == root.pick || touch.has-hover ? Theme.surface-overlay : transparent;
                accessible-role: button;
                accessible-label: name;
                accessible-action-default => { root.choose(name); }
                Text {
                    x: Tokens.space-2;
                    width: parent.width - 2 * Tokens.space-2;
                    text: name;
                    color: Theme.text-primary;
                    font-size: Tokens.type-body-size;
                    font-weight: i == root.pick ? Tokens.type-title-weight : Tokens.type-body-weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
                touch := TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            root.choose(name);
                        }
                    }
                    property <bool> hovered: self.has-hover;
                    changed hovered => { root.over = self.hovered; }
                }
            }
            Text {
                x: Tokens.space-2;
                text: @tr("Tab to complete, Up and Down to choose, Escape to close");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                accessible-role: none;
            }
        }
    }
}

// One token in the editor, as a setting row: its name (and what to type, and its
// problem) on the left, its fields and Reset on the right. A value being typed is held
// in `Appearance.pending-*` so Save sees it before Enter or leaving the field.
component TokenEditorRow inherits Rectangle {
    in property <ThemeTokenRow> item;
    in property <bool> divider: true;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    if root.divider: Rectangle {
        y: 0;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    lay := HorizontalLayout {
        padding-top: Tokens.space-2;
        padding-bottom: Tokens.space-2;
        spacing: Tokens.space-3;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Tokens.space-1;
            Text {
                text: item.kind == 1 ? item.label + " (" + item.unit + ")" : item.label;
                color: Theme.text-primary;
                font-size: Tokens.type-label-size;
                wrap: word-wrap;
                accessible-role: none;
            }
            if item.kind == 2: Hint { text: @tr("Size, line height, weight"); }
            if item.kind == 3: Hint {
                text: Appearance.font-in-use == "" ? @tr("Type names separated by commas, or pick one with Add font; the first one this computer has is used. In use: the system font.") : @tr("Type names separated by commas, or pick one with Add font; the first one this computer has is used. In use: {}.", Appearance.font-in-use);
            }
            // The font family list is long text: its field takes the row's width,
            // under the name.
            if item.kind == 3: HorizontalLayout {
                spacing: Tokens.space-2;
                fonts-field := FontField {
                    horizontal-stretch: 1;
                    label: item.label;
                    value: item.fonts;
                    edited(t) => { Appearance.hold(3, item.name, 0, t); }
                    accepted(t) => {
                        Appearance.pending-kind = -1;
                        if t != item.fonts { Appearance.set-fonts(t); }
                    }
                }
                // The buttons keep their height and stay level with the field while
                // suggestions open under it.
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: start;
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        FontMenu {
                            horizontal-stretch: 0;
                            for-label: item.label;
                            picked(name) => {
                                Appearance.pending-kind = -1;
                                Appearance.set-fonts(fonts-field.text == "" ? name : name + ", " + fonts-field.text);
                            }
                        }
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("Reset");
                            accessible-name: @tr("Reset {}", item.label);
                            kind: "ghost";
                            dense: true;
                            enabled: item.overridden;
                            clicked => { Appearance.reset(item.name); }
                        }
                    }
                }
            }
            if item.problem != "": Problem { text: item.problem; }
            if item.warning != "": Warning { text: item.warning; }
        }
        if item.kind != 3: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Tokens.space-2;
            alignment: end;
            if item.fixable: VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("Fix");
                    accessible-name: @tr("Fix the colour of {}", item.label);
                    dense: true;
                    clicked => { Appearance.fix(item.name); }
                }
            }
            if item.kind == 0: VerticalLayout {
                alignment: center;
                ColorPicker {
                    label: item.label;
                    value: item.color;
                    picked(hex) => { Appearance.set-color(item.name, hex); }
                }
            }
            if item.kind == 1: VerticalLayout {
                alignment: center;
                NumberField {
                    width: Tokens.size-menu-sm / 2;
                    label: item.label;
                    value: item.number;
                    step: item.step;
                    typed(t) => { Appearance.hold(1, item.name, 0, t); }
                    edited(v) => {
                        Appearance.pending-kind = -1;
                        Appearance.set-number(item.name, v);
                    }
                }
            }
            if item.kind == 2: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    NumberField {
                        width: Tokens.size-menu-sm / 3;
                        label: @tr("{} size", item.label);
                        value: item.size;
                        typed(t) => { Appearance.hold(2, item.name, 0, t); }
                        edited(v) => {
                            Appearance.pending-kind = -1;
                            Appearance.set-style(item.name, 0, v);
                        }
                    }
                    NumberField {
                        width: Tokens.size-menu-sm / 3;
                        label: @tr("{} line height", item.label);
                        value: item.line;
                        typed(t) => { Appearance.hold(2, item.name, 1, t); }
                        edited(v) => {
                            Appearance.pending-kind = -1;
                            Appearance.set-style(item.name, 1, v);
                        }
                    }
                    NumberField {
                        width: Tokens.size-menu-sm / 3;
                        label: @tr("{} weight", item.label);
                        value: item.weight;
                        step: 100;
                        typed(t) => { Appearance.hold(2, item.name, 2, t); }
                        edited(v) => {
                            Appearance.pending-kind = -1;
                            Appearance.set-style(item.name, 2, v);
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("Reset");
                    accessible-name: @tr("Reset {}", item.label);
                    kind: "ghost";
                    dense: true;
                    enabled: item.overridden;
                    clicked => { Appearance.reset(item.name); }
                }
            }
        }
    }
}

// Save and Cancel (or Close) of the editor. Save applies a value still being typed
// first, so it never needs Enter or leaving the field.
component EditorActions inherits HorizontalLayout {
    spacing: Tokens.space-2;
    alignment: end;
    Button {
        text: @tr("Save");
        kind: "primary";
        enabled: Appearance.can-save || Appearance.pending-kind >= 0;
        clicked => {
            Appearance.apply-pending();
            Appearance.save();
        }
    }
    Button {
        text: Appearance.changed || Appearance.pending-kind >= 0 ? @tr("Cancel") : @tr("Close");
        clicked => {
            Appearance.pending-kind = -1;
            Appearance.cancel();
        }
    }
}

// The theme editor: its title with Save and Cancel (or Close) at the top, the group
// picker and the group's tokens as rows.
component ThemeEditor inherits VerticalLayout {
    spacing: Tokens.space-3;
    HorizontalLayout {
        spacing: Tokens.space-3;
        Text {
            horizontal-stretch: 1;
            text: @tr("Edit {}", Appearance.editor-name);
            color: Theme.text-primary;
            font-size: Tokens.type-title-size;
            font-weight: Tokens.type-title-weight;
            vertical-alignment: center;
            overflow: elide;
        }
        EditorActions { horizontal-stretch: 0; }
    }
    if Appearance.editing-in-use: Hint { text: @tr("Changes show in every window as you make them. Colours that are hard to read get a warning; you can still use and save them."); }
    if Appearance.warning-count > 0: Warning {
        text: Appearance.warning-count == 1 ? @tr("1 colour warning. The theme is still used and saved as it is.") : @tr("{} colour warnings. The theme is still used and saved as it is.", Appearance.warning-count);
    }
    if !Appearance.editing-in-use: SettingsNotice {
        text: @tr("This theme is not in use, so the windows do not show its changes. Pick it under Theme in use to see them.");
    }
    for p in Appearance.general-problems: Problem { text: p; }
    SettingRow {
        divider: false;
        label: @tr("Group");
        control-width: Tokens.size-menu-sm;
        Select {
            label: @tr("Group");
            options: Appearance.groups;
            index: Appearance.group;
            selected(i) => { Appearance.set-group(i); }
        }
    }
    VerticalLayout {
        spacing: 0px;
        for r in Appearance.rows: TokenEditorRow { item: r; }
    }
    if Appearance.unknown-tokens.length > 0: Field {
        label: @tr("Not used by this version");
        for n in Appearance.unknown-tokens: Hint { text: n; }
    }
}

// One theme in the library list: its swatch, its name, "Built in" for the built-in
// ones, and its first problem when it cannot be used. The selected one has a quiet
// plate and the title weight, and is marked selected for screen readers (U7). At its right edge, its actions as icon buttons:
// Use, Edit (Duplicate to edit for a built-in theme), Duplicate, and for user themes
// Export and Delete; each acts on this row's theme.
component ThemeListRow inherits Rectangle {
    in property <ThemeOption> theme;
    in property <bool> selected;
    in property <bool> enabled: true;
    // Beside the editor: the name gets the room, the "Built in" chip and the actions
    // are left out (the accessible name still says it is built in).
    in property <bool> compact;
    callback activated();
    callback use-it();
    callback edit-it();
    callback duplicate-it();
    callback export-it();
    callback delete-it();
    property <length> swatch-w: 3 * Tokens.size-icon-box;
    height: row.height;
    forward-focus: row;
    row := ListRow {
        width: parent.width;
        lead-space: root.swatch-w;
        name: root.theme.name;
        // Why a theme cannot be used, or how many colours need a look (U7: words).
        warning: !root.theme.usable;
        note: !root.theme.usable ? @tr("Cannot be used: {}", root.theme.problem)
            : root.theme.warnings == 1 ? @tr("1 colour warning")
            : root.theme.warnings > 1 ? @tr("{} colour warnings", root.theme.warnings)
            : "";
        selected: root.selected;
        enabled: root.enabled;
        accessible-name: root.theme.user ? root.theme.name : @tr("{} (built in)", root.theme.name);
        activated => { root.activated(); }
        if !root.theme.user && !root.compact: VerticalLayout {
            alignment: center;
            Rectangle {
                border-radius: self.height / 2;
                border-width: Tokens.size-border;
                border-color: Theme.border-subtle;
                height: chip.preferred-height + Tokens.space-1;
                width: chip.preferred-width + Tokens.space-2 * 2;
                chip := Text {
                    text: @tr("Built in");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    accessible-role: none;
                }
            }
        }
        // Actions a theme does not have (Export and Delete of a built-in one) leave
        // their place empty, so the icons line up from row to row.
        if !root.compact: HorizontalLayout {
            spacing: Tokens.space-1;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: IconName.check;
                    name: @tr("Use {}", root.theme.name);
                    enabled: root.enabled && root.theme.usable;
                    clicked => { root.use-it(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: IconName.pencil;
                    name: root.theme.user ? @tr("Edit {}", root.theme.name) : @tr("Duplicate {} to edit", root.theme.name);
                    enabled: root.enabled;
                    clicked => { root.edit-it(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: IconName.copy;
                    name: @tr("Duplicate {}", root.theme.name);
                    enabled: root.enabled;
                    clicked => { root.duplicate-it(); }
                }
            }
            VerticalLayout {
                alignment: center;
                width: Tokens.size-control-sm;
                if root.theme.user: IconButton {
                    icon: IconName.export;
                    name: @tr("Export {}…", root.theme.name);
                    enabled: root.enabled;
                    clicked => { root.export-it(); }
                }
            }
            VerticalLayout {
                alignment: center;
                width: Tokens.size-control-sm;
                if root.theme.user: IconButton {
                    icon: IconName.trash;
                    name: @tr("Delete {}…", root.theme.name);
                    enabled: root.enabled;
                    clicked => { root.delete-it(); }
                }
            }
        }
    }
    // The swatch is drawn over the room the row keeps for it (no input of its own).
    Swatch {
        x: Tokens.space-2;
        y: (root.height - Tokens.size-icon-box) / 2;
        surface: root.theme.surface;
        text: root.theme.text;
        accent: root.theme.accent;
    }
}

export component AppearanceSettings inherits Rectangle {
    // The theme Delete asks about (a position in `Appearance.themes`), -1 none.
    property <int> confirm-delete: -1;
    property <ThemeOption> current: Appearance.selected >= 0 ? Appearance.themes[Appearance.selected] : { name: "" };
    property <bool> has-selection: Appearance.selected >= 0;
    // The amount slider while a drag is in progress (0 to 1); -1 when it is not.
    property <float> compact-drag: -1;
    function compact-stop(v: float) -> int {
        if v < 0.25 { return 1; }
        if v < 0.75 { return 2; }
        return 3;
    }
    function compact-text(n: int) -> string {
        if n <= 1 { return "1"; }
        if n == 2 { return "2"; }
        return "3";
    }
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        if Appearance.dev-override: SettingsNotice {
            text: @tr("A development override (RBS_TOKENS or RBS_THEME) is in effect: the themes chosen here are saved but not all of them are shown.");
        }
        if Appearance.note != "": SettingsNotice { text: Appearance.note; problem: true; }
        if Appearance.keep-asking: KeepLook { }
        SettingsCard {
            title: @tr("Theme in use");
            id: "settings.appearance.theme-in-use";
            SettingRow {
                divider: false;
                label: @tr("Use the system appearance");
                help: @tr("Dark while the system is dark, Light while it is light. Choosing a theme below keeps that theme instead.");
                fill: false;
                Toggle {
                    label: @tr("Use the system appearance");
                    checked: Appearance.follow-system;
                    toggled(on) => { Appearance.set-follow-system(on); }
                }
            }
            SettingRow {
                divider: false;
                label: @tr("Spacing");
                help: @tr("Compact packs more in; roomy gives larger controls. Applies to every theme.");
                SegmentedControl {
                    label: @tr("Spacing");
                    options: [@tr("Regular"), @tr("Compact"), @tr("Roomy")];
                    index: Appearance.density;
                    selected(i) => { Appearance.set-density(i); }
                }
            }
            if Appearance.density == 1: SettingRow {
                label: @tr("Amount");
                help: @tr("1 is the next smaller step. 3 is as tight as these tokens can go.");
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Slider {
                        horizontal-stretch: 1;
                        label: @tr("Compact spacing amount");
                        value: root.compact-drag >= 0 ? root.compact-drag : (Appearance.compact-steps - 1) * 0.5;
                        value-text: root.compact-text(root.compact-drag >= 0 ? root.compact-stop(root.compact-drag) : Appearance.compact-steps);
                        step: 0.5;
                        moved(v) => { root.compact-drag = v; }
                        released => {
                            if root.compact-drag >= 0 {
                                Appearance.set-compact-steps(root.compact-stop(root.compact-drag));
                                root.compact-drag = -1;
                            }
                        }
                        cancelled => { root.compact-drag = -1; }
                        reset => {
                            root.compact-drag = -1;
                            Appearance.set-compact-steps(1);
                        }
                    }
                    ValueReadout {
                        text: root.compact-text(root.compact-drag >= 0 ? root.compact-stop(root.compact-drag) : Appearance.compact-steps);
                    }
                }
            }
            if Appearance.density != 0: SettingsNotice {
                text: @tr("This changes spacing for every theme. Theme files are not changed. Choose Regular to use each theme's own spacing.");
            }
        }
        // The theme list on the left, the editor on the right (owner's choice, ADR-0057
        // decision 6). The list keeps its own height at the top: it is short and the
        // editor is long, so it is never stretched to the editor's height.
        HorizontalLayout {
            spacing: Tokens.space-4;
            alignment: stretch;
            VerticalLayout {
                alignment: start;
                // Beside the editor the list is a narrow column; alone it takes the width.
                min-width: Appearance.editing ? Tokens.size-menu-sm : 0px;
                max-width: Appearance.editing ? Tokens.size-menu-sm : 100000px;
                horizontal-stretch: Appearance.editing ? 0 : 1;
                SettingsCard {
                    title: @tr("Themes");
                    id: "settings.appearance.themes";
                    // The card's line with Import at its right (Import adds a theme, so
                    // it belongs to the list, not to a row).
                    if !Appearance.editing: HorizontalLayout {
                        spacing: Tokens.space-3;
                        padding-bottom: Tokens.space-2;
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Pick a theme to use, edit or share it. Built-in themes cannot be changed: duplicate one to make your own.");
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        Button {
                            horizontal-stretch: 0;
                            text: @tr("Import…");
                            accessible-name: @tr("Import a theme…");
                            kind: "ghost";
                            dense: true;
                            lead: IconName.import;
                            clicked => { Appearance.import(); }
                        }
                    }
                    VerticalLayout {
                        spacing: Tokens.space-1;
                        padding-bottom: Tokens.space-2;
                        accessible-role: list;
                        accessible-label: @tr("Themes");
                        for t[i] in Appearance.themes: ThemeListRow {
                            theme: t;
                            selected: Appearance.selected == i;
                            enabled: !Appearance.editing;
                            compact: Appearance.editing;
                            activated => { Appearance.select(i); }
                            use-it => {
                                Appearance.select(i);
                                Appearance.use-selected();
                            }
                            edit-it => {
                                Appearance.select(i);
                                Appearance.edit();
                            }
                            duplicate-it => {
                                Appearance.select(i);
                                Appearance.duplicate();
                            }
                            export-it => {
                                Appearance.select(i);
                                Appearance.export();
                            }
                            delete-it => {
                                Appearance.select(i);
                                root.confirm-delete = i;
                            }
                        }
                    }
                    if !Appearance.editing && root.current.user: SettingRow {
                        label: @tr("Name");
                        TextField {
                            label: @tr("Name");
                            text: root.current.name;
                            accepted(t) => { Appearance.rename(t); }
                        }
                    }
                    if !Appearance.editing && root.confirm-delete >= 0: SettingBlock {
                        RevealOnShow { }
                        SettingsCallout {
                            label: @tr("Delete {}?", Appearance.themes[root.confirm-delete].name);
                            Text {
                                text: @tr("Delete {}? You can get it back from the deleted folder.", Appearance.themes[root.confirm-delete].name);
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Tokens.space-2;
                                alignment: start;
                                Button {
                                    text: @tr("Delete");
                                    kind: "primary";
                                    clicked => {
                                        Appearance.select(root.confirm-delete);
                                        root.confirm-delete = -1;
                                        Appearance.delete();
                                    }
                                }
                                Button {
                                    text: @tr("Cancel");
                                    clicked => { root.confirm-delete = -1; }
                                }
                            }
                        }
                    }
                }
            }
            if Appearance.editing: SettingsCard {
                horizontal-stretch: 1;
                ThemeEditor { padding-bottom: Tokens.space-3; }
            }
        }
    }
    height: form.preferred-height;
}
