    callback set-source-on-return(int /* source */, int /* index */);
    // "Keep running for" (ADR-0152 decision 3): a position in the list.
    callback set-source-linger(int /* source */, int /* index */);
    // A scroll's "When it comes back": Start over (0) or Continue (1); one undo step.
    callback set-source-scroll-return(int /* source */, int /* index */);
    // Sets the play range's start (0) or end (1) at a media time, or plays the whole
    // file again (2); one undo step (ADR-0108 decision 11).
    callback set-media-range-mark(int /* source */, int /* mark */, int /* ms */);
    callback change-media-file(int /* source */);
