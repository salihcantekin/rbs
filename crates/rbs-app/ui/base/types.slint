    callback set-group-visible(int /* group */, bool /* visible */);
    callback set-group-locked(int /* group */, bool /* locked */);
    // Media files (ADR-0108 decision 10): live playback actions, then stored settings.
    // "m:ss" of a media time; hours as "h:mm:ss".
    pure public function media-clock(ms: int) -> string {
        let s = Math.floor(ms / 1000);
        let h = Math.floor(s / 3600);
        let m = Math.floor(Math.mod(s, 3600) / 60);
        let sec = Math.mod(s, 60);
        let mm = h > 0 && m < 10 ? "0" + m : "" + m;
        let ss = sec < 10 ? "0" + sec : "" + sec;
        return h > 0 ? h + ":" + mm + ":" + ss : mm + ":" + ss;
    }
    // "m:ss.t" of a media time, to the tenth of a second: a play range's ends.
    pure public function media-mark(ms: int) -> string {
        return media-clock(ms) + "." + Math.floor(Math.mod(ms, 1000) / 100);
    }
    // A media file's play state in words (ADR-0108 decision 10).
    pure public function media-state-text(state: int) -> string {
        return state == 0 ? @tr("Playing")
            : state == 1 ? @tr("Paused")
            : state == 2 ? @tr("Cued: plays when it goes on air")
            : state == 3 ? @tr("Ended")
            : state == 5 ? @tr("The file cannot be opened")
            : @tr("Not shown");
    }
    callback media-play-pause(int /* source */);
    callback media-restart(int /* source */);
    callback media-seek(int /* source */, int /* ms */);
    callback set-media-loop(int /* source */, bool /* on */);
