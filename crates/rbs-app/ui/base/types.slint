// Every global, struct and enum of the desktop UI (ADR-0138 decision 2). Moved here
// from the files named above each group; those files import them back by path, and
// the window crates import them from the base library (`@rbsui`).
import { Palette } from "std-widgets.slint";
import { Theme, Tokens, ThemeSlot } from "tokens.slint";

// From components.slint.
// Focus ring drawn around a focused control.
// A FocusScope that tells keyboard focus from pointer focus (like CSS :focus-visible).
// A click or press calls `focus-pointer()`; `ring` is then false until focus leaves,
// so the focus ring appears only after Tab or arrow-key navigation, never after a mouse
// click. Focus and the accessibility tree are unchanged.
// Rule (tests/ui_patterns.rs): a focus scope without child elements that is declared after another element sets
// `focus-on-click: false`. Declared later, it lies over that element, and a scope that
// takes focus on click accepts the first press while it has no focus, so the control
// under it would need a second click (a Tabs bar after a click in another panel). The
// control's own click handler calls `focus-pointer()` instead.
// Keyboard focus that lands in a scrolled list shows the whole row holding the
// control, its name and help too, not only the control (Slint scrolls just the
// focused element into view). A control reports where its focus landed; the
// `SettingRow` that contains that place reports itself; the `ScrollArea` that holds
// the row scrolls it into view. All in window coordinates, all on events only.
export global FocusReveal {
    in-out property <int> serial;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <int> row-serial;
    in-out property <length> row-x;
    in-out property <length> row-y;
    in-out property <length> row-w;
    in-out property <length> row-h;
    public function focused(x: length, y: length) {
        self.x = x;
        self.y = y;
        self.serial += 1;
    }
    public function row(x: length, y: length, w: length, h: length) {
        self.row-x = x;
        self.row-y = y;
        self.row-w = w;
        self.row-h = h;
        self.row-serial += 1;
    }
}

// The Settings search target (docs/specs/settings-search.md, step 2). The window
// sets `key` (a row key or card id) and steps `serial`; the row or card with that
// key, when drawn, answers: it sets `found`, reports itself through FocusReveal so
// its scroll area brings it into view, and is marked while `marked` holds its key.
// Rows also answer when they are made, so a section switched to at the same time
// works. Nothing runs while `key` is empty.
export global SettingsFind {
    in-out property <string> key;
    in-out property <int> serial;
    in-out property <bool> found;
    in-out property <string> marked;
    // Called by the row or card with `key` (absolute position and size).
    public function answer(key: string, x: length, y: length, w: length, h: length) {
        self.found = true;
        self.marked = key;
        FocusReveal.row(x, y, w, h);
    }
}

