// One fixed picture size inside a SizeNest. `scale` is its long side divided by 4K,
// so the frames share one corner and keep their pixel ratio.
export struct SizeBand { title: string, detail: string, picture-w: int, picture-h: int, index: int, scale: float }

// Panel sections the user closed (ADR-0078), saved in the workspace file. Rust answers
// `closed`; `rev` changes whenever the answers may have, because Slint calls a pure
// callback again only when its arguments change.
// Which section levels are drawn (ADR-0113 decision 1), set from the `experience`
// setting in every window. Both on until the app sets them, so a window shows
// everything.
export global Experience {
    in property <bool> advanced: true;
    in property <bool> expert: true;
    // Shells whose "More options are hidden" line was answered with Show (decision 4),
    // by the shell's id, while this window is open. Slint asks again when `rev` changes;
    // the shell steps it after `show`.
    in-out property <int> rev;
    pure callback shown(string /* id */, int /* rev */) -> bool;
    callback show(string /* id */);
}

export global Sections {
    in property <int> rev;
    // The Mixer's layout (ADR-0083): 0 auto (by the panel's shape), 1 rows, 2 columns.
    in property <int> mixer-orientation;
    // Columns: This scene pane share of the groups row (0.05..0.95). Default 0.5.
    in property <float> mixer-scene-share;
    pure callback closed(string /* id */, int /* rev */) -> bool;
    callback set-closed(string /* id */, bool /* closed */);
    callback set-mixer-scene-share(float /* share */);
    // A page's cards by id prefix: 0 none fold, 1 some are open, 2 all are closed.
    pure callback group-state(string /* prefix */, int /* rev */) -> int;
    callback set-group(string /* prefix */, bool /* closed */);
    // The same for a list of section ids, comma separated (the sections Properties
    // draws now): 0 none, 1 some are open, 2 all are closed.
    pure callback list-state(string /* ids */, int /* rev */) -> int;
    callback set-list(string /* ids */, bool /* closed */);
}

// ---- Overlays (ADR-0094): the info hint popover and the tooltip --------------------
// Slint draws a `PopupWindow` without keyboard focus, so these are plain layers drawn
// last in the window root by `OverlayHost` (one per window). They exist (are
// instantiated) only while open or shown, and the only timer runs while a tooltip is
// waiting. The shell cuts what they cover out of the native preview layer through
// `hint-cover` and `tip-cover` (ADR-0054), like the toasts.
export struct OverlayCover { x: length, y: length, width: length, height: length }

// A row of the picker: `index` is its place in the listing the app made it from, so a
// filter never changes what choosing it means.
export struct PickerRow { name: string, note: string, index: int }

// The menus RBS draws in the window (ADR-0137): every context menu (`CommandMenu`)
// is a layer of the window's `OverlayHost`, drawn from tokens the same on every
// platform. Only the projector keeps a native menu (`NativeCommandMenu`), which the
// system draws outside its shared picture.

// One choice of a native submenu: its title, the registry id it runs, and whether it
// is the current one.
export struct ContextChoice { title: string, id: string, checked: bool, icon: image }

// One item of a native menu: `kind` 1 a command, 2 a separator, 3 a submenu of `choices`.
export struct ContextItem {
    kind: int,
    title: string,
    // Empty while a checkmark takes its place.
    icon: image,
    id: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
    choices: [ContextChoice],
}

// One row of a drawn menu: `kind` 1 a command, 2 a separator, 3 a submenu (its rows
// come from `ContextMenus.submenu`).
export struct MenuRow {
    kind: int,
    title: string,
    // Icon name from the set; empty while a checkmark takes its place.
    icon: string,
    // The shortcut bound to the command, as the platform writes it, or "".
    shortcut: string,
    id: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
    // Why it is disabled, or "".
    reason: string,
}

export global ContextMenus {
    // The native menu's items (the projector), at most as many as its slots.
    in-out property <[ContextItem]> items;
    // The native menu's items of `context` for `target` (`key=value&...`, the
    // parameters that name what was right-clicked, percent-encoded as in command ids).
    callback prepare(string /* context */, string /* target */) -> [ContextItem];
    // The drawn menu's rows of `context` for `target`. Rust keeps the submenus of the
    // menu it made, sets `has-reasons`, and keeps the focus of the moment, which
    // `closed` gives back.
    callback rows(string /* context */, string /* target */) -> [MenuRow];
    // The rows of the submenu at row `index` of the last menu made.
    callback submenu(int) -> [MenuRow];
    // The next row after `from` (wrapping) whose title starts with `letter`
    // (case-insensitive), or -1.
    pure callback find(/* rows */ [MenuRow], /* from */ int, /* letter */ string) -> int;
    // Where a menu (`beside` false) or a submenu (`beside` true) of natural size `w` x `h`
    // goes for `anchor`, in a window `win-w` x `win-h`, `margin` from its edges
    // (`menu_layout::place`).
    pure callback place(/* anchor */ OverlayCover, /* w */ length, /* h */ length, /* win-w */ length, /* win-h */ length, /* margin */ length, /* beside */ bool) -> OverlayCover;
    // Runs a command registry id: false when it is refused (its entry is disabled by
    // now, ADR-0137 decision 6), so a switch row keeps its state and the menu closes.
    callback run(string) -> bool;
    // The drawn menu closed: Rust gives the focus back to what had it.
    callback closed();
    // The drawn menu of the window: open, its rows, whether any row has a disabled
    // reason (the menu then has a reason line), and its anchor (window coordinates:
    // the bottom-left corner and the height above it). `serial` moves on each open.
    in-out property <bool> open;
    in-out property <[MenuRow]> shown;
    in-out property <bool> has-reasons;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> above;
    in-out property <length> wide;
    in-out property <int> serial;
    // Where the menu and its submenu are, for the preview layer's cut-out (ADR-0054).
    in-out property <OverlayCover> cover;
    in-out property <bool> sub-open;
    in-out property <OverlayCover> sub-cover;
    // Opens the menu of `context` for `target` under the window point (`x`, `y`), or
    // over it, `above` higher, when there is no room below; a menu that does not fit
    // on the right ends at `x + wide` (a button's right edge). Nothing opens when the
    // context has no items.
    public function open-at(context: string, target: string, x: length, y: length, wide: length, above: length) {
        let rows = root.rows(context, target);
        if rows.length == 0 { return; }
        root.shown = rows;
        root.x = x;
        root.y = y;
        root.above = above;
        root.wide = wide;
        root.serial += 1;
        root.open = true;
    }
    // Closes the menu without running anything.
    public function close() {
        if !root.open { return; }
        root.open = false;
        root.sub-open = false;
        root.closed();
    }
}

export global Overlays {
    property <int> serial;
    // The info hint popover: its text, and the button it belongs to (its window
    // position and size). One is open at a time.
    in-out property <bool> hint-open;
    in-out property <int> hint-owner;
    in-out property <string> hint-text;
    in-out property <string> hint-detail;
    in-out property <length> hint-x;
    in-out property <length> hint-y;
    in-out property <length> hint-w;
    in-out property <length> hint-h;
    in-out property <OverlayCover> hint-cover;
    public function open-hint(text: string, detail: string, x: length, y: length, w: length, h: length) -> int {
        ContextMenus.close();
        serial += 1;
        hint-text = text;
        hint-detail = detail;
        hint-x = x;
        hint-y = y;
        hint-w = w;
        hint-h = h;
        hint-owner = serial;
        hint-open = true;
        tip-owner = -1;
        tip-shown = false;
        return serial;
    }
    public function close-hint() { hint-open = false; }

    // The colour popover (ColorPicker): opened by a swatch at its window position, drawn
    // by `OverlayHost`; a pick comes back as `color-result` with `color-serial` moving,
    // and only the swatch whose id is `color-owner` takes it.
    in-out property <bool> color-open;
    in-out property <string> color-label;
    in-out property <color> color-value;
    in-out property <length> color-x;
    in-out property <length> color-y;
    in-out property <length> color-w;
    in-out property <length> color-h;
    in-out property <int> color-owner;
    in-out property <string> color-result;
    in-out property <int> color-serial;
    in-out property <OverlayCover> color-cover;
    public function open-color(label: string, value: color, x: length, y: length, w: length, h: length) -> int {
        ContextMenus.close();
        serial += 1;
        color-label = label;
        color-value = value;
        color-x = x;
        color-y = y;
        color-w = w;
        color-h = h;
        color-owner = serial;
        color-open = true;
        return serial;
    }

    // The long list of a `Select` (`SelectList`): opened by the field at its window
    // position, drawn by `OverlayHost`; a choice comes back as `select-result` with
    // `select-serial` moving, and only the Select whose id is `select-owner` takes it.
    in-out property <bool> select-open;
    in-out property <string> select-label;
    in-out property <[string]> select-options;
    // The chosen option (checked) and the highlighted one (Up and Down move it).
    in-out property <int> select-chosen;
    in-out property <int> select-current;
    in-out property <length> select-x;
    in-out property <length> select-y;
    in-out property <length> select-w;
    in-out property <length> select-h;
    in-out property <int> select-owner: -1;
    in-out property <int> select-result;
    in-out property <int> select-serial;
    in-out property <OverlayCover> select-cover;
    public function open-select(label: string, options: [string], index: int, x: length, y: length, w: length, h: length) -> int {
        ContextMenus.close();
        serial += 1;
        select-label = label;
        select-options = options;
        select-chosen = index;
        select-current = max(0, index);
        select-x = x;
        select-y = y;
        select-w = w;
        select-h = h;
        select-owner = serial;
        select-open = true;
        return serial;
    }
    public function choose-select(index: int) {
        select-open = false;
        select-result = index;
        select-serial += 1;
    }

    // The searchable picker (Add source; the font list next): a title, a filter field
    // that keeps the focus, a status line while it says something (searching, nothing
    // found), the rows the app made, Cancel. The app filters (`picker-filtered`) and
    // sets the rows; Enter chooses the highlighted row, Up and Down move it, Escape or a
    // click outside cancels. Reported as a cover like the name prompt (ADR-0054).
    in-out property <bool> picker-open;
    in-out property <string> picker-title;
    in-out property <string> picker-status;
    in-out property <[PickerRow]> picker-rows;
    in-out property <int> picker-current;
    in-out property <OverlayCover> picker-cover;
    // An optional checkbox next to Cancel (empty label: none), for example "Capture
    // audio too" when adding a display or window (ADR-0096). The explanation sits
    // behind its info button.
    in-out property <string> picker-option-label;
    in-out property <string> picker-option-hint;
    in-out property <bool> picker-option;
    callback picker-option-toggled(bool);
    callback picker-chosen(int /* the row's index */);
    callback picker-filtered(string);
    callback picker-cancelled();

    // The name prompt of the main window (Save as new): a small dialog over the
    // window. Enter accepts, Escape or Cancel closes it; a refusal stays in the prompt
    // as `name-error`. Reported as a cover like the hint (ADR-0054).
    in-out property <bool> name-open;
    in-out property <string> name-value;
    in-out property <string> name-error;
    // The dialog's title and the label of its accepting button; `name-ask` false makes
    // it a confirmation (Delete / Keep, Keep focused) with `name-error` as its message
    // line and no field.
    in-out property <string> name-title: @tr("Save as new workspace");
    in-out property <string> name-confirm: @tr("Save");
    in-out property <bool> name-ask: true;
    in-out property <OverlayCover> name-cover;
    callback name-accepted(string);
    callback name-cancelled();

    // The transition rail's options (ADR-0128): drawn by the main window over the
    // button that opened them (its window position and size); `transition-full` adds
    // the type and the duration (the narrow rail). Reported as a cover like the hint.
    in-out property <bool> transition-open;
    in-out property <bool> transition-full;
    in-out property <length> transition-x;
    in-out property <length> transition-y;
    in-out property <length> transition-w;
    in-out property <length> transition-h;
    in-out property <OverlayCover> transition-cover;

    // A scene's "Transition into this scene" card (ADR-0135 decision 14): drawn by the
    // window whose Scenes panel holds the scene's row, under the row (its window
    // position and size). `scene-transition-kind` is -1 for the collection's kind, else
    // the rail's index; `scene-transition-ms` -1 for the kind's own duration. Reported
    // as a cover like the hint.
    in-out property <bool> scene-transition-open;
    in-out property <int> scene-transition-id: -1;
    in-out property <string> scene-transition-name;
    in-out property <int> scene-transition-kind: -1;
    in-out property <int> scene-transition-ms: -1;
    in-out property <length> scene-transition-x;
    in-out property <length> scene-transition-y;
    in-out property <length> scene-transition-w;
    in-out property <length> scene-transition-h;
    in-out property <OverlayCover> scene-transition-cover;

    // The live chip's destinations list (ADR-0127 decision 17): drawn by the main
    // window under the button that opened it, reported as a cover like the hint.
    in-out property <bool> live-open;
    in-out property <length> live-x;
    in-out property <length> live-y;
    in-out property <length> live-w;
    in-out property <length> live-h;
    in-out property <OverlayCover> live-cover;

    // The "Add vertical output" dialog (ADR-0093 decision 8): a small form over the
    // main window. Rust reads the chosen values when `vertical-accepted` fires and
    // sets `vertical-error` when the studio refuses. With a vertical canvas already
    // there (`vertical-exists`) the dialog offers Remove instead.
    in-out property <bool> vertical-open;
    in-out property <bool> vertical-exists;
    in-out property <string> vertical-error;
    in-out property <OverlayCover> vertical-cover;
    // 0 is 1080x1920, 1 is 720x1280, 2 is a custom size (`vertical-w` by `vertical-h`).
    in-out property <int> vertical-size;
    in-out property <float> vertical-w: 1080;
    in-out property <float> vertical-h: 1920;
    in-out property <bool> vertical-follow: true;
    // 0 keeps the main layout, 1 Fit, 2 Fill, 3 Stack.
    in-out property <int> vertical-layout;
    callback vertical-accepted();
    callback vertical-removed();
    callback vertical-cancelled();

    // The first-run page (ADR-0113 decision 5): shown once on a new install. `first-run-choice`
    // is 0 Simple, 1 Standard (the default), 2 Pro; `first-run-theme` 0 System, 1 Dark,
    // 2 Light. `first-run-done` gets the choice, or -1 for Skip.
    in-out property <bool> first-run-open;
    in-out property <OverlayCover> first-run-cover;
    in-out property <int> first-run-choice: 1;
    in-out property <int> first-run-theme;
    callback first-run-done(int /* choice, -1 skipped */, int /* theme */);
    // The page's second step (ADR-0141 decision 11): 0 the experience level, 1 access to
    // the camera, microphone and screen (`Studio.permission-rows`), shown only when one
    // is not asked yet or blocked. `first-run-access-done` closes it.
    in-out property <int> first-run-step;
    // A row of the access step still has something to do: its button reads Later, else
    // Done.
    in-out property <bool> first-run-access-to-do;
    callback first-run-access-done();

    // The tooltip: waits `delay.tooltip` after the pointer rests on its control, shows
    // at once for keyboard focus, stays while the pointer is over the control or the
    // tooltip, and Escape dismisses it until the pointer or focus leaves. Only the
    // active window shows one. The app reports what Slint does not tell a control
    // (`rbs_app::window_events`): losing the activation, a press, a scroll, the pointer
    // leaving the window or moving off the control (`pointer-at`) close it.
    in-out property <int> tip-owner: -1;
    in-out property <bool> window-active: true;
    in-out property <string> tip-text;
    in-out property <length> tip-x;
    in-out property <length> tip-y;
    in-out property <length> tip-w;
    in-out property <length> tip-h;
    in-out property <bool> tip-shown;
    in-out property <bool> tip-over;
    in-out property <OverlayCover> tip-cover;
    out property <bool> tip-waiting: tip-owner >= 0 && !tip-shown && !hint-open && window-active;
    public function window-activation(active: bool) {
        window-active = active;
        if !active {
            tip-close();
            // A drawn menu closes with its window's activation (ADR-0137 decision 6).
            ContextMenus.close();
        }
    }
    // Closes the tooltip, shown or waiting.
    public function tip-close() {
        tip-owner = -1;
        tip-shown = false;
        tip-over = false;
    }
    // The app reports where the pointer moved in the window (logical pixels): outside
    // the tooltip's control and the tooltip itself, the tooltip closes. This also covers
    // a control that went away under it (a page change, a list rebuilt) and a move onto
    // a control without a tooltip, which never call `tip-leave`.
    public function pointer-at(x: length, y: length) {
        if tip-owner < 0 { return; }
        if x >= tip-x && x < tip-x + tip-w && y >= tip-y && y < tip-y + tip-h { return; }
        if tip-shown && x >= tip-cover.x && x < tip-cover.x + tip-cover.width && y >= tip-cover.y && y < tip-cover.y + tip-cover.height { return; }
        tip-close();
    }
    public function tip-enter(text: string, x: length, y: length, w: length, h: length, by-focus: bool) -> int {
        serial += 1;
        tip-text = text;
        tip-x = x;
        tip-y = y;
        tip-w = w;
        tip-h = h;
        tip-owner = serial;
        tip-shown = by-focus && !hint-open && window-active;
        return serial;
    }
    public function tip-leave(owner: int) {
        if owner == tip-owner && !tip-over {
            tip-owner = -1;
            tip-shown = false;
        }
    }
    // True when a tooltip was showing for `owner` and is now dismissed.
    public function tip-dismiss(owner: int) -> bool {
        if owner == tip-owner && tip-shown {
            tip-shown = false;
            tip-owner = -1;
            return true;
        }
        return false;
    }
}

// From app.slint.
// One destination of the running stream in the live chip's list (ADR-0127 decision 17).
export struct LiveDestinationRow { id: int, name: string, state: string, detail: string, problem: bool, can-stop: bool, can-retry: bool }

export struct TabData { id: string, title: string, known: bool, icon: string }

export struct StackData { window: int, stack: int, x: length, y: length, w: length, h: length, tabs: [TabData], active: int, collapsed: bool, can-collapse: bool, can-hide: bool }

// The Transition rail of the centre's studio split, in studio mode (ADR-0064).
export struct RailData { shown: bool, x: length, y: length, w: length, h: length, below: bool }

export struct HandleData { window: int, index: int, x: length, y: length, w: length, h: length, horizontal: bool, percent: int }

export struct PanelEntry { id: string, title: string, open: bool }

export struct WorkspaceEntry { name: string, built-in: bool, current: bool }

// A toolbar item (ADR-0050). kind: 0 command, 1 the workspace picker, 2 separator,
// 3 flexible space, 4 an item this version cannot run (shown disabled).
export struct ToolbarData { id: string, title: string, kind: int, enabled: bool, checked: bool, live: bool, icon: string, icon-only: bool }

// An auto-hidden panel's edge tab (ADR-0049 decision 2); `size` is its flyout's
// width, or height on the bottom edge.
export struct EdgeTabData { id: string, title: string, icon: string, size: length }

// State and commands shared by every window. Slint globals are per window, so
// A rectangle in window coordinates.
export struct Cover {
    x: length,
    y: length,
    width: length,
    height: length,
}

// Rust pushes the same state into each window's copy.
// The menu bar's run-time values (menu_bar.rs): titles, enabled and checked states
// indexed in the generated items' order, and each choice submenu's choices.
export struct MenuChoice { title: string, id: string, checked: bool, icon: image }

export global Menus {
    in property <[string]> titles;
    // Each item's icon; empty while a checkmark takes its place.
    in property <[image]> icons;
    in property <[bool]> enabled;
    in property <[bool]> checked;
    in property <[[MenuChoice]]> choices;
    // Runs a command registry id (ADR-0050).
    callback run(string);
}

export global Shell {
    // The chord that runs `canvas.transition`, as the platform writes it; shown on the
    // Transition rail (ADR-0064). Empty when it has none.
    in property <string> transition-keys;
    // The menu bar shows: macOS's system menu bar. Windows and Linux use the RBS menu
    // (ADR-0069). A binding, so every window (main and floating) gets it. In-out only
    // for rendered tests: Slint's testing backend has no system menu bar, so on macOS
    // Slint would draw the bar inside the window, where the app never shows it.
    in-out property <bool> native-menu-bar: Platform.os == OperatingSystemType.macos;
    // Counts `ui.app_menu.open` runs and F10 presses: each opens the RBS menu with its
    // search field.
    in-out property <int> app-menu-asked;
    // 0 not live, 1 live, 2 recording, 3 live and recording.
    in property <int> live-state;
    in property <string> live-duration;
    // The running stream's destinations (ADR-0127 decision 17): "2/3" live of those
    // Go live started, empty with one; and the chip's list.
    in property <string> live-dest-count;
    in property <[LiveDestinationRow]> live-dests;
    callback live-dest-stop(int);
    callback live-dest-retry(int);
    in property <string> live-outputs;
    // How long the recording's pause has lasted ("0:01:05"), while it is paused
    // (ADR-0124); live-duration then holds the time recorded, which stands still.
    in property <string> rec-paused-for;
    // How long the stream's hold has lasted ("0:00:42"), while it is held (ADR-0124).
    in property <string> st-held-for;
    // The recording in progress, or the next one while idle is not what this names:
    // the running file has no picture.
    in property <bool> audio-only;
    // RBS sends the program to the virtual camera (ADR-0066 decision 12).
    in property <bool> live-camera;
    // A canvas shows stream items (ADR-0148 decision 8): the status text names the
    // stream only then ("Not recording" otherwise).
    in property <bool> streaming: true;
    in property <[PanelEntry]> panels;
    in property <[WorkspaceEntry]> workspaces;
    in property <string> workspace-name;
    in property <bool> workspace-built-in;
    in property <bool> locked;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // 0 none, 1 "<subject> closed." (undo), 2 automatic switch from workspace <subject>.
    in property <int> toast-kind;
    in property <string> toast-subject;
    // Bumps when a new toast replaces the one showing, so its countdown starts again.
    in property <int> toast-generation;
    // 0 none, 1 layout locked, 2 other error with <error-detail>, 3 a notice whose
    // <error-detail> is the whole text (ADR-0055: a caught panic, an unclean last exit).
    in property <int> error-kind;
    in property <string> error-detail;
    // Bumps when a new error replaces the one showing, so its countdown starts again.
    in property <int> error-generation;
    // Where the bottom toast and the top error bar are while they show (the main
    // window's): the preview layer hides only while one overlaps the picture.
    in-out property <Cover> bottom-toast;
    in-out property <Cover> top-toast;
    // The End stream question's card while it shows.
    in-out property <Cover> confirm-cover;
    // Quit while a stream or a recording runs: the frame asks first (U4, ADR-0156).
    in property <bool> quit-confirm;
    // What the quit ends, so the question names it: 1 the stream, 2 the recording,
    // 3 both.
    in property <int> quit-ending: 1;
    // The first Close to the background says once where RBS went (ADR-0056): 0 none,
    // 1 macOS (the Dock), 2 Windows (the notification area).
    in property <int> background-notice;
    callback background-notice-ok();
    // Cmd+W on macOS: Close, as the main window's close button (ADR-0056).
    callback close-main();
    // The quit question's answers: end what runs and quit, or keep it.
    callback quit-end-live();
    callback quit-keep();
    // The toolbar row's groups (ADR-0071): the items before its flexible space and the
    // items after it, and whether the toolbar is shown.
    in property <[ToolbarData]> toolbar;
    in property <[ToolbarData]> toolbar-end;
    // Go live and Record, the frame's fixed group (ADR-0073): shown with the toolbar
    // hidden too.
    in property <[ToolbarData]> toolbar-fixed;
    in property <bool> toolbar-visible: true;
    // Windows (ADR-0071) and macOS (ADR-0180): the toolbar row is the title bar and
    // ends with the window buttons. Set once the OS title bar is taken away.
    in property <bool> custom-caption;
    in property <bool> window-maximized;
    // macOS (ADR-0180 decision 6): the system's title bar height, which the row covers.
    // Measured from the window, not a visual value; 0 elsewhere.
    in property <length> caption-min-height;
    // The main window is full screen: minimize and maximize hide (ADR-0180 decision 4).
    in property <bool> window-full-screen;
    // The maximize button gets its mouse through the OS (snap layouts): its hover and
    // pressed state come from there.
    in property <bool> caption-max-hover;
    in property <bool> caption-max-pressed;
    // 0 minimize, 1 maximize or restore, 2 close.
    callback caption(int);
    // Where the row's groups and the maximize button are, in the window (logical px):
    // the hit test's regions. Sent whenever one moves.
    callback caption-regions(length /* lead end */, length /* end start */, length /* max x */, length /* max width */, length /* row height */);
    // End stream from the menu bar: the frame asks first (U4).
    in property <bool> end-stream-confirm;
    // Record (1) or Go live (2) was pressed while no microphone is heard: the frame
    // asks first (UI spec, "Silent output warning"); 0 asks nothing. The reason in
    // words for the question's first line.
    in property <int> silent-confirm;
    in property <string> silent-reason;
    // `go` starts anyway; `stop-asking` (with `go`) turns the warning off.
    callback silent-answer(bool /* go */, bool /* stop-asking */);
    // The same for the vertical canvas's stream (ADR-0093 decision 6).
    in property <bool> end-vertical-confirm;
    // A vertical canvas exists: Go live and Record get a ▾ with its outputs.
    in property <bool> vertical-outputs;
    // The vertical canvas streams, records (or starts to): Go live and Record show "9:16".
    in property <bool> vertical-live;
    in property <bool> vertical-rec;
    // The chips beside Record and Go live (ADR-0111): 0 none, 1 starting, 2 connecting,
    // 3 recording or live, 4 stopping; and the elapsed time.
    in property <int> vertical-rec-state;
    in property <string> vertical-rec-time;
    in property <int> vertical-live-state;
    in property <string> vertical-live-time;
    // A chip's stop: the vertical stream (true) or recording alone.
    callback vertical-stop(bool /* stream */);
    // End stream ends the vertical stream too: the question names both.
    in property <bool> end-stream-both;
    // The main output stopped and the vertical one runs on: 1 recording, 2 stream.
    in property <int> vertical-left;
    callback vertical-left-stop();
    callback vertical-left-dismiss();
    // A vertical server is saved; without one the ▾ menu offers to set it up.
    in property <bool> vertical-stream-set-up;
    // The gap between panel cards and around them: the layout's divider thickness.
    // literal: Rust sets it to rbs_ui::layout::HANDLE_THICKNESS, which the frame geometry also uses
    in property <length> gap: 6px;
    // Edge tabs of auto-hidden panels on the left, right and bottom edges.
    in property <[EdgeTabData]> left-tabs;
    in property <[EdgeTabData]> right-tabs;
    in property <[EdgeTabData]> bottom-tabs;
    // Every edge tab's panel id, joined: changes when one is added, pinned or closed.
    in property <string> edge-ids;
    // Ask the main window to slide an auto-hidden panel out (reveal-edge 0 left,
    // 1 right, 2 bottom) or to slide the current one back (reveal-edge -1).
    // The serial changes on each ask, so the same panel can be shown again.
    in property <int> reveal-edge: -1;
    in property <EdgeTabData> reveal-tab;
    in property <int> reveal-serial;
    // The slid-out auto-hide panel's rectangle while one is out (the preview layer
    // leaves it out, ADR-0054).
    in-out property <bool> flyout-open;
    in-out property <Cover> flyout;
    callback end-stream-answer(bool /* end */);
    callback end-vertical-answer(bool /* end */);

    // Dragging a tab (ADR-0049 decision 5): the payload names the panel; the dock area
    // under the pointer reports moves and the drop in its own coordinates, and Rust
    // answers with the guide: the part of window <drop-window> the drop would fill.
    pure callback panel-data(string /* panel */) -> data-transfer;
    // True when a drag payload is a panel id, so a source drag is not docked and a
    // panel drag is not taken for a source.
    pure callback is-panel(data-transfer) -> bool;
    callback drag-over(int /* window */, data-transfer, length, length);
    callback drag-drop(int /* window */, data-transfer, length, length);
    callback drag-leave();
    // The maximized panel's id, or empty (ADR-0049 decision 2; not saved).
    in property <string> maximized;
    in property <int> drop-window: -1;
    in property <Cover> drop-guide;
    // The guide in window surface coordinates while it shows: the preview layer cuts it out.
    in-out property <bool> drop-open;
    in-out property <Cover> drop-cover;
    // A window's dock area: its position in the window and its size.
    callback relayout(int /* window */, length, length, length, length);
    callback collapse(string, bool /* collapsed */);
    callback auto-hide(string);
    callback pin(string);
    callback activate-tab(int /* window */, int /* stack */, int /* tab */);
    callback close-panel(string);
    callback toggle-panel(string);
    callback dock(int /* window */);
    // Wanted position of the handle along its axis, in the dock area.
    callback drag(int /* window */, int /* handle */, length);
    callback drag-end();
    callback nudge(int /* window */, int /* handle */, length);
    callback switch-workspace(string);
    callback toast-undo();
    callback toast-dismiss();
    callback dismiss-error();
}

// From app_menu.slint.
// One row of the item column. kind: 1 command, 2 section heading, 3 separator,
// 4 picker (opens its choices), 5 back (from a picker's choices).
export struct AppMenuRow {
    kind: int,
    title: string,
    // Icon name from the set.
    icon: string,
    // The shortcut bound to it, as the platform writes it.
    shortcut: string,
    // A picker's current choice ("Edit" for Workspace).
    value: string,
    // The id a click runs (commands) or the picker's id (pickers).
    id: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
    // Why it is disabled; shown under the menu while it is the current row.
    reason: string,
    // The rows Up and Down move to (-1: none).
    up: int,
    down: int,
}

// An Output profile chip in the bottom row.
export struct AppMenuChip {
    title: string,
    id: string,
    current: bool,
}

export global AppMenus {
    // The menu is open (a layer of the main window) and where it is, for the preview
    // layer's cut-out.
    in-out property <bool> open;
    in-out property <OverlayCover> cover;
    // The menu shown last, kept while the app runs.
    in-out property <int> category;
    // The menus, in menu bar order (refreshed when the menu opens).
    in-out property <[string]> categories;
    in-out property <[AppMenuChip]> profiles;
    // The shortcuts of the search command and of Settings, or "".
    in-out property <string> search-shortcut;
    in-out property <string> settings-shortcut;
    // Fills `categories`, `profiles` and the shortcuts.
    callback prepare();
    // The rows of menu `category`, of the picker `picker` when it is not "", or the
    // search results for `query` when it is not blank.
    callback rows(/* category */ int, /* picker */ string, /* query */ string) -> [AppMenuRow];
    // Runs a command registry id.
    callback run(string);
}

// From appearance.slint.
// One theme in the library: built-in themes first, then user themes by name.
// `surface`, `text`, `accent`: its swatch. `usable`: it passes every rule; else
// `problem` is its first problem.
export struct ThemeOption {
    name: string,
    user: bool,
    usable: bool,
    problem: string,
    surface: color,
    text: color,
    accent: color,
    // Colour warnings of a usable theme (ADR-0072).
    warnings: int,
}

// One token in the editor. `kind`: 0 colour, 1 number (`unit` px or ms), 2 text style,
// 3 font family, 4 the theme's effects (ADR-0122: `choice` Calm, Glow, Glass or Tactile;
// `disabled` says why they cannot apply). `overridden`: the theme sets it (Reset removes
// it).
export struct ThemeTokenRow {
    name: string,
    label: string,
    kind: int,
    color: color,
    number: float,
    step: float,
    unit: string,
    size: float,
    line: float,
    weight: float,
    fonts: string,
    choice: int,
    disabled: string,
    overridden: bool,
    problem: string,
    // Colour warnings in words (ADR-0072): shown, never blocking.
    warning: string,
    // "Fix" can clear the warnings by moving the colour's lightness.
    fixable: bool,
    // What a length shapes, in words; empty when the label says it.
    hint: string,
}

export global Appearance {
    in property <[ThemeOption]> themes;
    // Usable themes only, for the pickers, and their list positions.
    in property <[string]> usable-names;
    in property <bool> follow-system: true;
    // Spacing for every theme (ADR-0112): 0 regular, 1 compact (spacing, control height
    // and panel gaps step down), 2 roomy (default control and panel gaps step up).
    in property <int> density: 0;
    // Stops 1, 2 and 3. Kept while compact is off.
    in property <int> compact-steps: 1;
    // The default spacing, as an index like `density`.
    in property <int> density-default: 0;
    // Positions in `usable-names`.
    in property <int> dark-index;
    in property <int> light-index;
    in property <int> theme-index;
    // Position in `themes`; -1 none.
    in property <int> selected: -1;
    // A note: a theme in use could not be used, or an action failed.
    in property <string> note;
    // `RBS_TOKENS` or `RBS_THEME` is set.
    in property <bool> dev-override;
    // "Keep this look?" is asked.
    in property <bool> keep-asking;
    in property <int> keep-seconds;
    // The editor.
    in property <bool> editing;
    in property <string> editor-name;
    in property <[string]> groups;
    in property <int> group;
    in property <[ThemeTokenRow]> rows;
    in property <[string]> general-problems;
    // How many colour warnings the draft has (ADR-0072).
    in property <int> warning-count;
    in property <[string]> unknown-tokens;
    in property <bool> can-save;
    in property <bool> changed;
    // The theme being edited is used by a slot: its changes show in the windows.
    in property <bool> editing-in-use;
    // The family the window uses now ("" the system font).
    in property <string> font-in-use;
    // A value typed in the editor and not yet confirmed (Enter or leaving the field):
    // `pending-kind` is the row's kind (1 number, 2 text style, 3 font family) or -1
    // for none, `pending-part` the text style's part. Only the focused field types, so
    // one slot holds it. Save is on while it is set and applies it first, so a value
    // being typed is saved without leaving the field.
    in-out property <int> pending-kind: -1;
    // The font picker's list: `find-fonts` fills the picker's rows with the installed
    // families whose names contain the filter, when it opens and as the filter changes.
    callback find-fonts(string);
    // The button that opened the picker (its row's label), the family picked and a
    // counter that moves with each pick.
    in-out property <string> font-owner;
    in-out property <string> font-picked;
    in-out property <int> font-picked-serial;
    // The font field's suggestions for the family being typed (the part after the
    // last comma): names that start with it first. `suggest-fonts` fills it as the
    // field's text changes; `complete-font` returns the text with that part replaced.
    in property <[string]> font-suggestions;
    callback suggest-fonts(string);
    pure callback complete-font(string, string) -> string;
    in-out property <string> pending-name;
    in-out property <int> pending-part;
    in-out property <string> pending-text;
    public function hold(kind: int, name: string, part: int, text: string) {
        pending-kind = kind;
        pending-name = name;
        pending-part = part;
        pending-text = text;
    }
    public function apply-pending() {
        if pending-kind == 1 && pending-text.is-float() {
            set-number(pending-name, pending-text.to-float());
        } else if pending-kind == 2 && pending-text.is-float() {
            set-style(pending-name, pending-part, pending-text.to-float());
        } else if pending-kind == 3 {
            set-fonts(pending-text);
        }
        pending-kind = -1;
    }
    // 0 dark, 1 light, 2 the one theme.
    callback pick(int, int);
    callback set-follow-system(bool);
    callback set-density(int);
    callback set-compact-steps(int);
    callback select(int);
    callback use-selected();
    callback edit();
    callback duplicate();
    callback rename(string);
    callback delete();
    callback import();
    callback export();
    callback set-group(int);
    callback set-color(string, string);
    callback set-number(string, float);
    callback set-style(string, int, float);
    // The theme's effects: 0 Calm, 1 Glow, 2 Glass, 3 Tactile (ADR-0122).
    callback set-effects(int);
    callback set-fonts(string);
    callback reset(string);
    // Moves a colour to the nearest lightness that clears its warnings.
    callback fix(string);
    callback save();
    callback cancel();
    callback keep();
    callback undo();
}

// From context_menu.slint: moved before Overlays, which closes the drawn menu.

// From obs_import.slint.
// One scene of the chosen collection and whether it is brought.
export struct ObsSceneChoice {
    name: string,
    on: bool,
}

// One line of the check: the OBS object, where it is, and why it did not come across
// exactly.
export struct ObsReportRow {
    name: string,
    place: string,
    reason: string,
}

// From replay.slint.
export global ReplayBuffer {
    // The studio runs, so the buffer can arm.
    in property <bool> can-arm;
    // The buffer keeps the past now.
    in property <bool> armed;
    // Arm it when RBS starts.
    in property <bool> arm-on-start;
    in property <bool> audio;
    // The length slider, 0 to 1 on a log scale, and its text ("2 min").
    in property <float> length;
    in property <string> length-text;
    // The saved length differs from the default, which reads as `length-default-text`.
    in property <bool> length-changed;
    in property <string> length-default-text;
    in property <[string]> memories;
    in property <int> memory;
    // The default memory limit as an index into `memories`, or -1 when not offered.
    in property <int> memory-default: -1;
    in property <string> folder;
    // Bumped when Rust changes the folder, so the field takes the new text.
    in property <int> folder-serial;
    // What it holds in words, with `tone` 0 neutral, 1 good, 2 problem.
    in property <string> status;
    in property <int> tone;
    // What the settings cost in memory, in words.
    in property <string> estimate;
    // The last problem with the settings, or "".
    in property <string> problem;
    // A clip is being cut or written.
    in property <bool> saving;
    in property <bool> can-save;
    // The last clip: its file name, and whether it can be shown in its folder.
    in property <string> saved-name;
    in property <string> saved-error;
    callback toggle(bool);
    callback set-arm-on-start(bool);
    callback set-audio(bool);
    callback length-moved(float);
    callback length-released();
    callback reset-length();
    callback set-memory(int);
    callback set-folder(string);
    callback save();
    callback show-saved();
}

// From settings.slint.
// One result of the Settings window's search field (docs/specs/settings-search.md,
// step 3): what was found, where it is ("Recording › Encoding"; empty for a section)
// and the section number it opens, which gives its icon.
export struct SettingsHit {
    title: string,
    path: string,
    section: int,
}

// The Settings page's scroll. A panel that opens inside the page (a confirmation, the
// shortcut recorder) reports its place; the page moves so that place is on screen.
export global SettingsScroll {
    in-out property <int> serial: 0;
    in-out property <length> y: 0px;
    in-out property <length> h: 0px;
    // The place goes to the top of the view, not only into it (a long panel such as the
    // theme editor, whose start is what matters).
    in-out property <bool> top: false;
    public function reveal(ay: length, ah: length) {
        self.y = ay;
        self.h = ah;
        self.top = false;
        self.serial += 1;
    }
    public function reveal-top(ay: length) {
        self.y = ay;
        self.top = true;
        self.serial += 1;
    }
}

// From shortcuts.slint.
// One shortcut of a row: its label ("⇧⌘Z"), canonical text, and scope.
export struct ShortcutChip {
    label: string,
    keys: string,
    global: bool,
}

// One command (or picker choice). `group` is set on the first row of a menu group.
// `problem`: why one of its shortcuts does nothing; `note`: what a global shortcut of
// it does without asking.
export struct ShortcutRow {
    group: string,
    command: string,
    title: string,
    chips: [ShortcutChip],
    changed: bool,
    problem: string,
    note: string,
    // Its feature is off (streaming, ADR-0148): the name is dimmed, keys still edit.
    off: bool,
}

export global Shortcuts {
    // A key press no control took in a main or floating window: true when it ran a
    // shortcut. Arguments: text, Ctrl (Cmd on macOS), Alt, Shift, Meta, repeat.
    callback press(string, bool, bool, bool, bool, bool) -> bool;

    in property <[ShortcutRow]> rows;
    in property <string> hint;
    in property <string> note;
    in-out property <string> search;
    callback set-search(string);
    // The category filter: "All" first, then the categories (rbs_ui Category::ALL);
    // `category` is the chosen index. `assigned-only` shows only commands with a
    // shortcut. `filtered`: either filter hides rows.
    in property <[string]> categories: ["All"];
    in property <int> category;
    callback set-category(int);
    in property <bool> assigned-only;
    callback set-assigned-only(bool);
    in property <bool> filtered;
    callback remove(int, int);
    callback reset(int);
    in property <bool> confirm-reset-all;
    callback ask-reset-all();
    callback answer-reset-all(bool);

    // The recorder: the row it adds to (-1 none).
    in property <int> recording: -1;
    // Its chord, as a label; "" until a key is pressed.
    in property <string> rec-label;
    // 0 nothing yet, 1 free, 2 taken (Replace), 3 refused, 4 warning.
    in property <int> rec-state;
    in property <string> rec-message;
    in property <bool> rec-global;
    in property <bool> rec-global-available;
    in property <[bool]> rec-mods: [false, false, false, false];
    in property <[string]> mod-names: ["Ctrl", "Alt", "Shift", "Meta"];
    in property <[string]> key-names;
    in property <int> rec-key: -1;
    callback add(int);
    // Double-click on a chip (row, chip): the recorder opens with that shortcut, and
    // Save replaces it.
    callback edit(int, int);
    in property <bool> rec-editing;
    // A key press in the recorder: true when taken.
    callback rec-press(string, bool, bool, bool, bool) -> bool;
    callback rec-set-mod(int, bool);
    callback rec-set-key(int);
    callback rec-set-global(bool);
    callback rec-confirm();
    callback rec-cancel();
}

// From studio.slint.
// `picture`: a video source; `x`, `y`, `w`, `h` place its box on the canvas (canvas
// pixels). `can-up` / `can-down`: another source with a picture is above / below it.
// Style (ADR-0053): `shape` 0 rectangle, 1 circle, 2 ellipse; `radius` for rectangles;
// `border` on or off, its `border-width`, its colour as `#rrggbb` or `#rrggbbaa` text
// and as a swatch (the values a border gets when turned on while it is off).
// One field of a filter in the Filters tab (ADR-0062), generated from its type's
// schema: `kind` 0 a number (`position` from 0 to 1 on its slider, `step` one step
// there, `value-text` the value with its unit; `min`, `max`, `snap` (the value's step),
// `decimals` and `suffix` (the unit with its space) for the text while dragging), 1 a colour (`colour` as #rrggbb or
// #rrggbbaa, `swatch` the same colour).
export struct FilterFieldData { label: string, help: string, log: bool, options: [string], choice: int, kind: int, position: float, step: float, value-text: string, min: float, max: float, snap: float, decimals: int, suffix: string, colour: string, swatch: color, changed: bool, default-text: string }

// One filter of a source's chain: `known` false for a type this version lacks (it can
// only be removed); `can-up` / `can-down` false at the ends of the chain and at the
// line after the pointer filters (ADR-0165 decision 3). `perm-text`: why a pointer
// filter cannot see clicks, with `perm-action` 1 Allow, 2 Fix permission (ADR-0165
// decision 7). `cursor`: a Pointer halo on a screen or window capture shows the
// source's Show the cursor, 1 off, 2 on; 0 no such row.
export struct FilterLevels { input: float, reduction: float }

export struct FilterData { id: int, name: string, enabled: bool, known: bool, gate: bool, latency-text: string, latency-warn: bool, curve: string, curve-text: string, bar-label: string, open-pos: float, close-pos: float, can-up: bool, can-down: bool, perm-text: string, perm-action: int, cursor: int, fields: [FilterFieldData] }

export struct SourceData { id: int, name: string, kind: string, browser: bool, icon: string, status: string, ok: bool, picture: bool, visible: bool, x: float, y: float, w: float, h: float, can-up: bool, can-down: bool, shape: int, radius: float, scroll-on: bool, scroll-dir: int, scroll-speed: float, scroll-gap: float, scroll-repeat: int, scroll-start: int, scroll-return: int, scroll-fade: float, scroll-paused: bool, border: bool, border-width: float, border-color: string, border-swatch: color, crop-l: int, crop-t: int, crop-r: int, crop-b: int, pic-w: int, pic-h: int, locked: bool, flip-h: bool, flip-v: bool, rotation: float, audio: bool, muted: bool, volume: float, volume-text: string, filters: [FilterData], selected-filter: int, sync-offset: int, global: bool, also-in: string, in-globals: bool, places: int, kind-code: int, companion: bool, custom-glide: bool, glide-duration: int, glide-easing: int, solid: bool, fill: string, fill-swatch: color, filled: bool, item-id: int, cap-has: bool, cap-l: int, cap-t: int, cap-r: int, cap-b: int, chrome-on: bool, chrome-t: int, chrome-r: int, chrome-b: int, chrome-l: int, chrome-fill: int, has-work-rect: bool, show-for-ms: int, cue-remaining-ms: int, record-separately: bool, record-choice: int, record-form: int, media: bool, media-path: string, media-loop: bool, act-on: bool, act-run: int, act-return: int, act-linger: int, act-warm-up: string, media-start-ms: int, media-end-ms: int, media-state: int, media-pos-ms: int, media-len-ms: int, scene-level: bool, scene-entry: bool, own-volume-text: string, device-peers: string, peer-count: int, perm-kind: int, perm-action: int, slides: bool, slides-folder: string, slides-note: string, slides-position: string, slides-paused: bool, slides-fields: [FilterFieldData], nested: bool, parent: int, parent-name: string, expandable: bool, open: bool, arrow-room: bool, sound-muted: bool, picked: bool, grouped: bool, group-id: int, group-head: bool, group-open: bool, group-name: string, group-hidden: bool, group-locked: bool }

// `global`: a global source's row (ADR-0065). `also-in`: the other scenes that place it,
// by name; `in-globals`: it is a global source too; `places`: how many items place it.
// A scene in the Scenes panel (ADR-0059): `live` on air, `number` its place (1 up).
// `live`: the scene on air; `preview`: the preview scene in studio mode (ADR-0061).
// `own-levels`: the scene keeps its own volumes and mutes (Own levels, ADR-0091).
// `transition-kind`: the scene's own transition into it (ADR-0135), -1 the collection's,
// else the rail's index; `transition-ms` its own duration, -1 the kind's.
export struct SceneData { id: int, name: string, live: bool, preview: bool, number: int, own-levels: bool, transition-kind: int, transition-ms: int }

// A source of the collection for Add source's "Existing source" list.
// A look in the Library (ADR-0075): `group` 0 colour, 1 effect, 2 shape. A sample
// picture: `frame` is true for a frame (transparent in the middle), `thumb` its picture.
export struct LookData { id: string, name: string, group: int }

export struct SampleData { id: string, name: string, frame: bool, thumb: image }

export struct KindData { code: int, label: string }

// A filled rectangle of the selection on the preview (outline or handle), in the
// panel's coordinates; kind 0 outline, 1 handle border, 2 handle inside.
export struct MarkData { x: length, y: length, w: length, h: length, kind: int }

// One line of the Source tab's target list: `index` is its place in the answer, `current` marks the source's own target (ADR-0077).
// One mode of a camera in the Source settings window: its size and the frame rates it runs at.
export struct ModeData { label: string, rates: [string] }

// What the Source settings window shows for one source (ADR-0077): the camera's modes with
// the chosen mode and rate, or the rates of a screen or window and its cursor choice.
// The Measure sync offset window (ADR-0126 step 6). `phase`: 0 ready, 1 measuring,
// 2 a result, 3 no result, 4 Start refused. `reason` (phase 3): 0 too few claps,
// 1 no movement seen, 2 claps disagree, 3 not heard, 4 source closed, 5 offset
// changed, 6 a filter changed, 7 studio restarted, 8 cancelled, 9 other. `refusal`
// (phase 4): 0 busy, 1 not heard, 2 no picture now, 3 no reference, 4 not a picture,
// 5 other. `progress`: 0 to 1 of the longest measurement.
export struct SyncMeasureData { source: int, name: string, current: int, refs: [string], ref-ids: [int], ref-index: int, phase: int, pairs: int, sound: bool, picture: bool, progress: float, suggested: int, measured: int, clamped: bool, spread: int, reason: int, onset-filter: bool, refusal: int }

// The Paste attributes and Reset source windows (ADR-0133 decision 8). A group row:
// `index` is its place in the window's group order; `at-default` when the value is the default;
// `help` says why it is off or that Undo leaves it.
export struct AttributeGroupRow { id: string, title: string, index: int, checked: bool, enabled: bool, at-default: bool, help: string }

// A source to paste onto: `note` is its place when placed twice, or "global"; `shown`
// is false while Same type only hides it.
export struct AttributeTargetRow { name: string, note: string, checked: bool, copied: bool, shown: bool }

// `count` sources are checked, `groups-on` groups; `has-filters` when a filter group is on.
export struct AttributesData { paste: bool, name: string, picture: [AttributeGroupRow], sound: [AttributeGroupRow], source: [AttributeGroupRow], targets: [AttributeTargetRow], same-type: bool, append: bool, count: int, groups-on: int, has-filters: bool }

// The Text tab of a text source (ADR-0129 decision 13), filled while the selected
// source is one (`on`). `kind`: 0 text, 1 clock, 2 countdown, 3 stopwatch, 4 recording
// time, 5 stream time. `align`: 0 left, 1 centre, 2 right. A countdown counts to
// `target` when `until`, else for `minutes` and `seconds`. `format-default` is the
// pattern used while `format` is empty. Colours are `#rrggbb[aa]` with their swatch.
export struct TextData { on: bool, id: int, kind: int, text: string, file: string, file-name: string, file-lines: int, fields: bool, font: string, size: float, bold: bool, italic: bool, color: string, swatch: color, align: int, format: string, format-default: string, until: bool, target: string, minutes: int, seconds: int, end-text: string, outline: bool, outline-width: float, outline-color: string, outline-swatch: color, shadow: bool, shadow-color: string, shadow-swatch: color, shadow-x: float, shadow-y: float, shadow-blur: float, background: bool, background-color: string, background-swatch: color, padding: float, single-line: bool }

// A browser source's Page tab (ADR-0109, ADR-0132, ADR-0149). `file` is true for a local
// file (`url` is then its `file:` address and `file-name` its name). `state`: 0 the page
// runs or will run when shown, 1 the browser engine is not installed, 2 both page slots
// are taken, 3 the page failed to load (`status` says why), 4 hidden and not running,
// 5 the page runs drawn without the graphics card (ADR-0157 decision 9).
export struct BrowserData { on: bool, id: int, file: bool, url: string, file-name: string, width: int, height: int, canvas-w: int, canvas-h: int, fps: int, zoom: int, transparent: bool, css: string, reload-on-file-change: bool, keep-signed-in: bool, reload-every: int, script: string, script-on-load: bool, script-every: int, run: int, on-return: int, linger: int, retry-on-error: bool, running: bool, state: int, status: string }

export struct SourceSettingsData { id: int, name: string, kind-code: int, modes: [ModeData], mode-labels: [string], mode-index: int, rates: [string], rate-index: int, has-cursor: bool, cursor: bool, cap-has: bool, cap-l: int, cap-t: int, cap-r: int, cap-b: int, chrome-on: bool, chrome-t: int, chrome-r: int, chrome-b: int, chrome-l: int, chrome-fill: int, has-work-rect: bool, pic-w: int, pic-h: int, has-region-preview: bool, region-preview: image, has-color: bool, color-matrix: int, color-range: int }

// `heading` is set on the first row of a group ("Same application", "Other").
// `picture` is the target's thumbnail when `has-picture`; `wants-picture` is set for displays and windows, whose rows keep the kind's icon until the picture comes.
export struct SourceTargetData { name: string, current: bool, index: int, heading: string, picture: image, has-picture: bool, wants-picture: bool }

// One meter's moving parts as fractions of the bar (rbs_ui::meter::MeterView::zones),
// its peak-hold position and zone and the clip latch (U16). Its accessible value is in
// `meter-values`, so its 1 Hz change redraws nothing.
export struct MeterRow {
    // The source's id and whether its sound is muted (ADR-0059).
    id: int,
    muted: bool,
    // The fader: its position (0 to 1, the fader law) and the level in words ("-6.0 dB").
    volume: float,
    volume-text: string,
    name: string,
    icon: string,
    lo-from: float, lo-to: float, mi-from: float, mi-to: float, hi-from: float, hi-to: float,
    peak: float, peak-zone: int, clipped: bool,
    // A global source (ADR-0065): the Mixer groups it apart from the scene's own.
    global: bool,
    // Heard on the monitor (ADR-0097): 0 off, 1 monitor and output, 2 monitor only;
    // and soloed on the monitor.
    monitor: int,
    solo: bool,
    // False while an audio source is not running: the strip stays, the fader does not move.
    live: bool,
    // The program scene is in Own levels (ADR-0091): the fader and mute show and edit
    // that scene's level for the source, and the strip shows the scene mark.
    scene-level: bool,
}

export struct ScaleMark { label: string, at: float }

// The master's loudness (ADR-0092 decision 7), shown while `on`. Bar positions follow the
// meter law (rbs_ui::meter::position), so a LUFS value sits at its dB on the dBFS scale.
// `has` is false until the meter has a short-term value (silence reads none).
// The texts are ready to show ("−14.2", "−0.6 dBTP"); an empty text has no value yet.
export struct LoudnessData {
    on: bool,
    has: bool,
    short-text: string,
    at: float,
    target-at: float,
    target-text: string,
    over: bool,
    momentary: string,
    integrated: string,
    range: string,
    true-peak: string,
    limit-text: string,
}

// The encoder fields of one output (a recording or a stream): the options offered and
// the one in use (rbs_app::encoder_form). `rate-kind`: 0 CBR, 1 VBR, 2 constant quality.
// One destination of the stream in Settings, Stream (ADR-0127 decision 17).
// `removable`: the row has its own Remove (the first destination does not, ADR-0127
// decision 1).
export struct DestinationRow { id: int, name: string, note: string, on: bool, warn: bool, removable: bool }

export struct EncoderData {
    codecs: [string], codec: int,
    encoders: [string], encoder: int,
    video-rates: [string], video-rate: int,
    audio-rates: [string], audio-rate: int,
    rate-modes: [string], rate-mode: int, rate-kind: int, bitrate-label: string,
    peaks: [string], peak: int,
    qualities: [string], quality: int,
    padding: bool, padding-available: bool,
    keyframes: [string], keyframe: int,
    presets: [string], preset: int,
    profiles: [string], profile: int,
    b-frames: [string], b-frame: int, b-frames-note: string,
    // The chosen video bitrate, and the recommendation when it is below that
    // figure (0 when it is not, or when there is no bitrate). The picture is the
    // resolved output size at the canvas frame rate.
    video-kbps: int, recommended-kbps: int,
    out-width: int, out-height: int, out-fps: int,
    // 0 Video (Rec. 709 limited), 1 Screen (sRGB full range).
    delivery: int,
    // Lifts only the darkest tones. Shown while Colour is Video.
    open-shadows: bool,
    // The default of each field, by its `set` code (an index into that field's
    // options), or -1 when the default is not one of them or the field has none.
    defaults: [int],
}

// One access token in the Remote control section: its name and what it allows.
export struct TokenRow { name: string, access: string }

// One recent action of AI tools (ADR-0134 decision 7): when, the method, and whether it
// was allowed; `why` says why it was refused.
export struct AiActionRow { time: string, method: string, allowed: bool, why: string }

// One line of the Stats panel: a section heading (`heading`, `label` only) or a counter
// with its value; `bad` marks a value that shows a loss (in words too, U7).
export struct StatRow { heading: bool, label: string, value: string, bad: bool }

// An output profile or scene collection in its menu (ADR-0051).
export struct EntryRow { id: string, name: string, current: bool }

// One row of Settings › Permissions (ADR-0141). `kind` is the permission kind (0 camera,
// 1 microphone, 2 screen and windows, 3 system and app sound); `tone` 0 plain, 1 warning,
// 2 problem; `action` 0 none, 1 Allow, 2 Open system settings, 3 Restart RBS.
export struct PermissionRowData { kind: int, label: string, status: string, tone: int, value: string, action: int, action-text: string }

// One row of Settings › Add-ons (ADR-0145). `action` 0 none, 1 Download, 2 Cancel,
// 3 Remove, 4 Update, 5 Retry (`rbs_app::add_on_text::Action`); `value` is shown
// beside the button when not empty.
export struct LogAreaRow { name: string, label: string, level: int }
export struct AddOnRowData { id: string, label: string, help: string, problem: bool, value: string, action: int, action-text: string }

export global Studio {
    // 0 starting, 1 running, 2 failed (`failure` says why).
    in property <int> state;
    in property <string> failure;
    // A restart of the studio runs: Restart the studio is not offered (crash-resilience spec).
    in property <bool> restart-busy;
    // Stops what is left of the stopped studio and starts it again with the scenes as last saved.
    callback restart-studio();
    in property <[SourceData]> sources;
    in property <[KindData]> kinds;
    // The Source tab's list of what the selected source's kind can capture.
    in property <[SourceTargetData]> source-targets;
    // The Source settings window's content: empty until the host answers, then one entry.
    in property <[SourceSettingsData]> source-settings;
    // The Measure sync offset window's content: empty until the host answers, then one entry.
    in property <[SyncMeasureData]> sync-measure;
    // The Paste attributes or Reset source window's content: empty until the host answers.
    in property <[AttributesData]> attributes;
    // The source whose sync offset was just changed in Properties: its row offers
    // "Apply to N sources" while other sources of its device differ (ADR-0126).
    in-out property <int> sync-offer-for: -1;
    // The kind `targets` lists; -1 while a list is being made.
    in property <[MeterRow]> meters;
    // Sources kept out of the Mixer, still heard (ADR-0080); no meter runs for them.
    in property <[MeterRow]> hidden-meters;
    // The master strip (ADR-0081): one row while the studio has a mixer, else none.
    in property <[MeterRow]> master-meter;
    // The meters' accessible values (U16), by the row of `meters` and of `master-meter`.
    // Apart from the rows: only the accessible elements read them, so the value's
    // change once a second redraws nothing (Slint redraws when a row it draws from
    // changes, even when the drawn parts stay the same).
    in property <[string]> meter-values;
    in property <[string]> master-meter-values;
    // How many of `meters` are the scene's own and how many are global (Mixer groups).
    in property <int> meter-scenes;
    in property <int> meter-globals;
    // Native meters (ADR-0035): while true, a native layer over the Mixer draws the
    // moving parts of its level bars (lit zones and peak line) and Slint draws only the
    // bars' backgrounds, so a meter update redraws nothing here. Each bar tells the
    // shell where it is (`meter-placed`), the panel where its viewport is
    // (`mixer-placed`), and a change of `meter-epoch` asks every bar to tell again.
    in property <bool> native-meters;
    in property <int> meter-epoch;
    // A level bar's place in the window (logical pixels); `key` is the source id, or
    // -1 for the master. `shown` is false while the bar is in a zero-wide cell.
    callback meter-placed(/* key */ int, /* x */ length, /* y */ length, /* w */ length, /* h */ length, /* vertical */ bool, /* shown */ bool);
    // The Mixer's viewport in the window, which the native layer clips to.
    callback mixer-placed(/* x */ length, /* y */ length, /* w */ length, /* h */ length);
    // The Mixer's bars may have been made or dropped (arrangement, a group opened or
    // closed, a source added or removed): after the next redraw every bar is asked again
    // and the native layer keeps only the bars that answer.
    callback meters-relayout();
    // The program scene (the scene the Mixer hears), and its name while it is in Own
    // levels (ADR-0091): empty in Shared levels. The Mixer's "This scene" header and
    // Properties › Sound say whose level a fader edits.
    in property <int> program-scene: -1;
    in property <string> scene-levels;
    // The Stats panel's lines; empty while nothing records or streams.
    in property <[StatRow]> stats;
    in property <[ScaleMark]> scale;
    // 0 shown, 1 starting, 2 not on this platform yet, 3 not in this session (remote
    // desktop), 4 shown only in the main window, 5 the studio is not running.
    in property <int> preview-state: 1;
    // Name of the source just deleted (an undo toast shows while it is set);
    // `deleted-from-scene`: only removed from one scene (ADR-0065).
    in property <string> deleted;
    in property <bool> deleted-from-scene;
    // Bumps on each delete, so the toast's countdown starts again.
    in property <int> deleted-generation;
    // Something goes out (a recording or a stream): edits to what is on air show at once.
    out property <bool> on-air: self.rec-state != 0 || self.st-state != 0;
    // The panel the picture shows in: "rbs.program", else "rbs.preview" (without studio
    // mode both show the scene on air); the other one says where it is.
    in property <string> picture-panel: "rbs.program";
    // Studio mode (ADR-0061): Preview shows the preview scene (edited there) and
    // Program the scene on air; `scene-preview-state` is the Preview picture's state,
    // with the codes of `preview-state`.
    in property <bool> studio-mode;
    in property <int> scene-preview-state: 1;
    // The vertical canvas's picture (ADR-0093 decision 7), with the codes of
    // `preview-state`, 7: no vertical canvas exists, 8: its picture did not start.
    in property <int> vertical-preview-state: 1;
    callback set-studio-mode(bool /* on */);
    // The preview scene goes on air and the scene on air to preview (a cut).
    callback transition();
    // The T-bar (ADR-0135): its place from 0 to 1, set by the rail while it moves. A
    // value between holds the transition there, 1 puts the preview scene on air, 0
    // cancels. `tbar-resets` changes when a held T-bar ended otherwise (a take, a
    // transition, a switch or a preview change): the rail goes back to 0.
    in-out property <float> tbar;
    in property <int> tbar-resets;
    callback transition-progress(float /* t */);
    callback list-targets(int /* kind */);
    callback list-source-targets(int /* source */);
    // The Source settings window opens for a source.
    callback open-source-settings(int /* source */);
    // The Measure sync offset window opens for a source with sound (ADR-0126).
    callback open-sync-measure(int /* source */);
    // Settings › General: open the Import from OBS window (ADR-0131).
    callback open-obs-import();
    // Start in that window, clapping in view of a picture source.
    callback start-sync-measure(int /* reference */);
