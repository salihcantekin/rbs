// Panels connected to the studio (ADR-0041 decision 7): Program, Sources, Mixer, Live
// controls and Outputs.
// Rust pushes state into the `Studio` global of every window and handles its callbacks
// by sending commands to the studio's control thread.
import { Theme, Tokens } from "tokens.slint";
import { DialogActions, HScrollArea, ListBox, ScrollArea, Button, Checkbox, ColorPicker, FocusRing, RingFocus, SectionHeader, Tabs, Icon, IconButton, MenuItem, MenuSurface, EmptyState, NumberField, Select, SegmentedControl, SizeNest, Slider, VSlider, LevelText, ValueReadout, TextField, TextArea, Toggle, InfoHint, FeatureSection, SettingRow, ListRow, StatusLine, HintText as Hint, CaptionField as Field, MenuArea, SurfaceCard } from "components.slint";
import { SettingsCard, SettingBlock, SettingsStatus, SettingsNotice, SettingsCallout, RevealOnShow, Shown } from "settings.slint";
import { CommandMenu } from "context_menu.slint";
import { ReplayControls, ReplaySettings } from "replay.slint";
import { FilterFieldData, FilterLevels, FilterData, SourceData, SceneData, LookData, SampleData, KindData, MarkData, ModeData, SyncMeasureData, AttributeGroupRow, AttributeTargetRow, AttributesData, TextData, SourceSettingsData, SourceTargetData, MeterRow, ScaleMark, LoudnessData, DestinationRow, EncoderData, TokenRow, AiActionRow, StatRow, EntryRow, PermissionRowData, Studio, Sections, Experience, IconName, Icons, SizeBand, Overlays } from "base/types.slint";
export { FilterFieldData, FilterLevels, FilterData, SourceData, SceneData, LookData, SampleData, KindData, MarkData, ModeData, SyncMeasureData, AttributeGroupRow, AttributeTargetRow, AttributesData, TextData, SourceSettingsData, SourceTargetData, MeterRow, ScaleMark, LoudnessData, DestinationRow, EncoderData, TokenRow, AiActionRow, StatRow, EntryRow, PermissionRowData, Studio }

// The audio-only strip above a program picture. The native picture starts below it, so
// this stays visible. `size.control.md` high, matching the inset in the preview layer.
component AudioOnlyStrip inherits Rectangle {
    height: Tokens.size-control-md;
    background: Theme.surface-raised;
    border-width: Tokens.size-border;
    border-color: Theme.border-strong;
    HorizontalLayout {
        height: parent.height;
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-3;
        spacing: Tokens.space-2;
        alignment: center;
        VerticalLayout {
            height: parent.height;
            alignment: center;
            Icon { name: IconName.speaker; ink: Theme.text-primary; }
        }
        VerticalLayout {
            height: parent.height;
            alignment: center;
            Text {
                text: @tr("Audio only. The picture is not recorded.");
                color: Theme.text-primary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
    }
}

// The canvas as the viewers see it. The picture is a native layer the app places over
// this rectangle; Slint draws only the background and the letterbox bars.
// "rbs.program", "rbs.preview" or the vertical canvas's "rbs.program?canvas=vertical"
// (ADR-0093 decision 7: its picture is made only while the panel shows).
export component ProgramPanel inherits Rectangle {
    in property <string> panel;
    in property <string> title;
    property <bool> vertical: panel == "rbs.program?canvas=vertical";
    // In studio mode both panels have a picture: Preview the preview scene, Program the
    // scene on air (ADR-0061).
    property <bool> scene: Studio.studio-mode && panel == "rbs.preview";
    property <bool> here: vertical || Studio.studio-mode || Studio.picture-panel == panel;
    // The codes of `Studio.preview-state`; the vertical panel's add 7 (no vertical
    // canvas) and 8 (its picture did not start).
    property <int> shown: vertical ? Studio.vertical-preview-state : !here ? 6 : scene ? Studio.scene-preview-state : Studio.preview-state;
    background: Theme.surface-sunken;
    accessible-role: image;
    accessible-label: title;
    property <bool> audio-only: vertical ? Studio.vertical-audio-only
        : (panel == "rbs.program" || panel == "rbs.preview") && Studio.rec-audio-only;
    accessible-description: root.audio-only ? @tr("Audio only. The picture is not recorded.")
        : shown != 0 ? note.text
        : vertical ? @tr("The live picture of the vertical canvas")
        : scene ? @tr("The picture of the preview scene, the next to go on air")
        : @tr("The live picture of the scene on air");
    // The native picture, the presses and the selection marks start below this strip
    // (`below_strip` in main.rs: none on a panel too short to keep both).
    property <length> strip: root.audio-only && root.height > 2 * Tokens.size-control-md
        ? Tokens.size-control-md : 0;
    if root.audio-only: AudioOnlyStrip {
        y: 0;
        width: parent.width;
    }
    note := Text {
        visible: shown != 0;
        width: parent.width - 2 * Tokens.space-4;
        text: vertical && shown == 1 ? @tr("The vertical picture is starting.")
            : vertical && shown == 2 ? @tr("The vertical picture is not available on this platform yet. Its recording and stream work as usual.")
            : vertical && shown == 3 ? @tr("The vertical picture cannot be shown in this session, for example over remote desktop.")
            : shown == 7 ? @tr("There is no vertical canvas. Add a vertical output to see it here.")
            : shown == 8 ? @tr("The vertical picture did not start. Hide and show this panel to try again.")
            : shown == 1 ? (scene ? @tr("The preview is starting.") : @tr("The program is starting."))
            : shown == 2 && scene ? @tr("The preview scene's own picture is not available on this platform yet. Its sources are in the Sources panel, and Transition puts it on air.")
            : shown == 2 ? @tr("The program picture is not available on this platform yet.")
            : shown == 3 ? @tr("The program picture cannot be shown in this session, for example over remote desktop.")
            : shown == 4 ? @tr("The picture shows in the main window. Dock this panel back to see it here.")
            : shown == 6 ? @tr("Studio mode is off, so the scene on air shows in the Program panel.")
            : @tr("The studio is not running: {}", Studio.failure);
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    // Selecting, moving and resizing sources on the picture (ADR-0048). Arrow keys move
    // the selected source by 1 canvas pixel, with Shift by 10; Escape clears the
    // selection. Delete or Backspace asks with the source row's confirmation: a bar
    // drawn on the picture would sit under the live picture.
    // In studio mode the preview scene is edited, on the Preview picture only; the
    // vertical canvas, which shows the scene on air, only outside studio mode and while
    // its picture shows (no dragging blind), where a box becomes the source's own
    // layout on that canvas (ADR-0093 decision 4).
    property <bool> editable: vertical
        ? Studio.state == 1 && !Studio.studio-mode && shown == 0
        : here && Studio.state == 1 && (!Studio.studio-mode || scene);
    keys := FocusScope {
        focus-on-click: false;
        enabled: editable;
        key-pressed(e) => {
            if Studio.selected-source < 0 { return reject; }
            let step = e.modifiers.shift ? 10 : 1;
            if e.text == Key.LeftArrow { root.nudge(-step, 0); return accept; }
            if e.text == Key.RightArrow { root.nudge(step, 0); return accept; }
            if e.text == Key.UpArrow { root.nudge(0, -step); return accept; }
            if e.text == Key.DownArrow { root.nudge(0, step); return accept; }
            if e.text == Key.Escape { Studio.preview-deselect(); return accept; }
            if e.text == Key.Delete || e.text == Key.Backspace {
                Studio.ask-remove-selected();
                return accept;
            }
            reject
        }
    }
    // A right-click on the picture: the menu of the source under the pointer (it
    // becomes the selection), else the panel's own menu.
    property <Point> menu-at;
    function nudge(dx: int, dy: int) {
        if vertical { Studio.vertical-nudge(dx, dy); } else { Studio.preview-nudge(dx, dy); }
    }
    function release() {
        if vertical { Studio.vertical-release(); } else { Studio.preview-release(); }
    }
    menu := CommandMenu {
        context: "preview";
        target: "h=" + round(touch.height / 1px) + "&id=" + root.panel + "&w=" + round(touch.width / 1px)
            + "&x=" + round(root.menu-at.x / 1px) + "&y=" + round(root.menu-at.y / 1px);
    }
    // The menu opens on every running picture, also one that is not edited (Program
    // in studio mode); only selecting and moving need `editable`.
    touch := TouchArea {
        y: root.strip;
        height: root.height - root.strip;
        enabled: here && Studio.state == 1;
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { root.release(); return; }
            // The menu opens when the right button goes up, not down, so the press it
            // opened on has its release.
            if e.button == PointerEventButton.right {
                if e.kind == PointerEventKind.up {
                    keys.focus();
                    root.menu-at = { x: self.mouse-x, y: self.mouse-y };
                    // `menu-at` is in the picture's (touch area's) coordinates; the
                    // menu element covers the whole panel.
                    menu.open({ x: root.menu-at.x, y: root.menu-at.y + root.strip });
                }
                return;
            }
            if e.button != PointerEventButton.left || !editable { return; }
            if e.kind == PointerEventKind.down {
                keys.focus();
                if vertical {
                    Studio.vertical-press(self.pressed-x / 1px, self.pressed-y / 1px, self.width / 1px, self.height / 1px, e.modifiers.shift, e.modifiers.control || e.modifiers.meta, e.modifiers.alt);
                } else {
                    Studio.preview-press(self.pressed-x / 1px, self.pressed-y / 1px, self.width / 1px, self.height / 1px, e.modifiers.shift, e.modifiers.control || e.modifiers.meta, e.modifiers.alt);
                }
            }
            if e.kind == PointerEventKind.up { root.release(); }
        }
        moved => {
            if self.pressed && editable {
                if vertical {
                    Studio.vertical-drag(self.mouse-x / 1px, self.mouse-y / 1px);
                } else {
                    Studio.preview-drag(self.mouse-x / 1px, self.mouse-y / 1px);
                }
            }
        }
    }
    // Where no layer shows the picture, the toolkit draws the selection itself, clipped
    // to the panel like the layer's marks.
    if shown != 0 && editable: Rectangle {
        y: root.strip;
        height: root.height - root.strip;
        clip: true;
        for m in vertical ? Studio.vertical-marks : Studio.marks: Rectangle {
            x: m.x;
            y: m.y;
            width: m.w;
            height: m.h;
            background: m.kind == 2 ? Theme.surface-raised : Theme.accent;
        }
    }
}

// One row of the Sources list (spec Frame, mockup E): the kind's icon, the name (the
// state below it only when something is wrong), and on the right Show/Hide and, for a
// picture, Lock. Move up, Move down and Remove are in the row's menu; Delete asks first.
component SourceRowView inherits Rectangle {
    in property <SourceData> data;
    // Move up, Move down or Remove was confirmed: the list is made again, so
    // the row's focus is about to go.
    callback leaving();
    property <bool> selected: Studio.selected-source == data.id;
    // `delete-all`: the confirm removes the source from every scene (Delete source).
    property <bool> delete-all;
    property <int> confirm-asked: Studio.confirm-source-asked;
    changed confirm-asked => { root.take-confirm(); }
    function take-confirm() {
        if Studio.confirming-source == data.id {
            root.delete-all = Studio.confirm-source-kind == 2;
            row.confirm = true;
            Studio.confirming-source = -1;
        }
    }
    // Rename: from the menu, a shortcut or F2. Double-click opens Source settings
    // when the source has one (screens, windows and cameras).
    property <int> rename-asked: Studio.rename-source-asked;
    changed rename-asked => { root.take-rename(); }
    init => { root.take-confirm(); root.take-rename(); }
    function take-rename() {
        if Studio.renaming-source == data.id { row.editing = true; Studio.renaming-source = -1; }
    }
    height: row.height;
    menu := CommandMenu {
        context: "source";
        target: "source=" + data.id;
    }
    row := ListRow {
        width: parent.width;
        has-icon: true;
        icon: Icons.named(data.icon);
        name: data.name;
        // A source that is not running (its window closed, its camera unplugged): the
        // mark and the reason say so, the name is dimmed (ADR-0077, U7).
        warning: !data.ok;
        note: data.ok ? "" : data.status;
        dimmed: !data.visible;
        selected: root.selected;
        accessible-name: @tr("{}, {}, {}{}{}", data.name, data.kind, data.status, data.visible ? "" : @tr(", hidden"), data.locked ? @tr(", locked") : "");
        accessible-hint: (data.global ? @tr("In every scene. ") : data.in-globals ? @tr("Also in every scene. ") : data.also-in != "" ? @tr("Also in {}. ", data.also-in) : "")
            + (data.picture ? @tr("Alt+Up or Alt+Down changes the layer, F2 renames it, double-click opens Source settings when available, Delete asks before removing it from this scene, the Menu key or Shift+F10 opens its menu") : @tr("F2 renames it, double-click opens Source settings when available, Delete asks before removing it from this scene, the Menu key or Shift+F10 opens its menu"));
        edit-label: @tr("Name of the source {}", data.name);
        confirm-question: root.delete-all ? @tr("Delete {} from every scene?", data.name)
            : data.global ? @tr("Remove {} from global sources?", data.name)
            : @tr("Remove {} from this scene?", data.name);
        confirm-name: root.delete-all ? @tr("Delete {}", data.name)
            : data.global ? @tr("Remove {} from global sources", data.name)
            : @tr("Remove {} from this scene", data.name);
        // Rows of sources with a picture can be dragged onto each other to change the
        // layer order; a press without a drag selects the row.
        allow-drag: data.picture;
        drag-data: Studio.source-data(data.id);
        drop-enabled: Studio.dragging-source >= 0;
        activated => { Studio.select-source(data.id); }
        double-clicked => {
            Studio.select-source(data.id);
            // Screens, windows and cameras (kind-code 0–2) have a Source settings
            // window; other kinds keep the selection only (Rename stays on F2 / menu).
            if data.kind-code >= 0 && data.kind-code <= 2 { Studio.open-source-settings(data.id); }
        }
        menu-asked(at) => { Studio.select-source(data.id); menu.open(at); }
        renamed(t) => { Studio.rename-source(data.id, t); }
        delete-asked => { root.delete-all = false; self.confirm = true; }
        confirmed => {
            root.leaving();
            if root.delete-all { Studio.delete-source(data.id); } else { Studio.remove-from-scene(data.id); }
        }
        dragging(on) => { Studio.dragging-source = on ? data.id : -1; }
        can-take(d) => { return !Studio.is-panel(d) && Studio.dragging-source >= 0 && data.picture && Studio.dragging-source != data.id; }
        took(d) => {
            Studio.move-source-to(Studio.dragging-source, data.id);
            Studio.dragging-source = -1;
        }
        key(e) => {
            if e.modifiers.alt && e.text == Key.UpArrow && data.picture && data.can-up {
                root.leaving(); Studio.move-source(data.id, true); return accept;
            }
            if e.modifiers.alt && e.text == Key.DownArrow && data.picture && data.can-down {
                root.leaving(); Studio.move-source(data.id, false); return accept;
            }
            reject
        }
        // In every scene, or also in other scenes (ADR-0065): one source, one device;
        // the words are in the accessible description (U7).
        if data.global || data.in-globals: VerticalLayout {
            alignment: center;
            Icon { name: IconName.globe; ink: Theme.text-secondary; }
        }
        if !data.global && !data.in-globals && data.also-in != "": VerticalLayout {
            alignment: center;
            Icon { name: IconName.link; ink: Theme.text-secondary; }
        }
            // A media file plays or pauses from its row (ADR-0108), its time beside it.
            if data.media && data.media-len-ms > 0: Text {
                text: Studio.media-clock(data.media-pos-ms);
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
                accessible-role: none;
            }
            if data.media: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: data.media-state == 0 ? IconName.pause : IconName.play;
                    name: data.media-state == 0 ? @tr("Pause {}", data.name) : @tr("Play {}", data.name);
                    enabled: data.media-state != 5;
                    clicked => { Studio.media-play-pause(data.id); }
                }
            }
            // Eye = lasting hide/show (undoable). Hourglass = timed show (ADR-0105).
            VerticalLayout {
                alignment: center;
                spacing: Tokens.space-1;
                IconButton {
                    icon: data.show-for-ms > 0
                        ? IconName.hourglass
                        : (data.visible ? IconName.eye : IconName.eye-off);
                    name: data.show-for-ms > 0
                        ? (data.visible
                            ? @tr("Hide {}", data.name)
                            : @tr("Timed show {} for {} ms", data.name, data.show-for-ms))
                        : (data.visible
                            ? @tr("Hide {}", data.name)
                            : @tr("Show {}", data.name));
                    checked: data.show-for-ms > 0 ? false : !data.visible;
                    clicked => {
                        if data.show-for-ms > 0 {
                            if data.visible {
                                Studio.set-source-visible(data.id, false);
                            } else {
                                Studio.show-item(data.item-id);
                            }
                        } else {
                            Studio.set-source-visible(data.id, !data.visible);
                        }
                    }
                }
                if data.picture && data.show-for-ms > 0 && data.cue-remaining-ms > 0: Text {
                    text: data.cue-remaining-ms + @tr(" ms left");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    horizontal-alignment: center;
                }
            }
            // Locked on the picture panel (sources with a picture only).
            if data.picture: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: data.locked ? IconName.lock : IconName.unlock;
                    name: data.locked ? @tr("Unlock {}", data.name) : @tr("Lock {}", data.name);
                    checked: data.locked;
                    clicked => { Studio.set-source-locked(data.id, !data.locked); }
                }
            }
    }
}

// One scene in the Scenes panel: its number, its name and, on air, a Live badge
// (mockup E). A click puts it on air. Rename shows on hover. Delete asks first.
component SceneRowView inherits Rectangle {
    in property <SceneData> data;
    in property <bool> can-remove;
    in property <int> live-state;
    // Remove was confirmed: the list is made again, so the row's focus is about to go.
    callback leaving();
    property <bool> studio: Studio.studio-mode;
    property <bool> marked: studio ? data.preview : data.live;
    property <int> confirm-asked: Studio.confirm-scene-asked;
    changed confirm-asked => { root.take-scene-confirm(); }
    // What the row's confirm asks: 0 remove the scene, 1 discard its own levels.
    property <int> confirm-kind;
    function take-scene-confirm() {
        if Studio.confirming-scene == data.id {
            root.confirm-kind = Studio.confirm-scene-kind;
            row.confirm = true;
            Studio.confirming-scene = -1;
        }
    }
    property <int> rename-asked: Studio.rename-scene-asked;
    changed rename-asked => { root.take-rename(); }
    property <int> transition-asked: Studio.transition-scene-asked;
    changed transition-asked => { root.take-transition(); }
    init => { root.take-scene-confirm(); root.take-rename(); root.take-transition(); }
    // Opens the scene's transition card under the row (ADR-0135).
    function take-transition() {
        if Studio.transition-scene == data.id {
            Studio.transition-scene = -1;
            Overlays.scene-transition-id = data.id;
            Overlays.scene-transition-name = data.name;
            Overlays.scene-transition-kind = data.transition-kind;
            Overlays.scene-transition-ms = data.transition-ms;
            Overlays.scene-transition-x = root.absolute-position.x;
            Overlays.scene-transition-y = root.absolute-position.y;
            Overlays.scene-transition-w = root.width;
            Overlays.scene-transition-h = root.height;
            Overlays.scene-transition-open = true;
        }
    }
    function take-rename() {
        if Studio.renaming-scene == data.id { row.editing = true; Studio.renaming-scene = -1; }
    }
    height: row.height;
    menu := CommandMenu {
        context: "scene";
        target: "scene=" + data.id;
    }
    row := ListRow {
        width: parent.width;
        lead: data.number;
        name: data.name;
        selected: root.marked;
        accessible-name: @tr("{}{}{}{}", data.name,
            data.own-levels ? @tr(", own levels") : "",
            root.studio && data.preview ? @tr(", in preview") : "",
            !data.live ? ""
            : root.live-state == 0 ? (root.studio ? @tr(", program") : @tr(", shown"))
            : root.live-state == 2 ? @tr(", on air and recording")
            : @tr(", on air"));
        accessible-hint: Studio.studio-mode
            ? @tr("Return puts it in preview, F2 renames it, Delete asks before removing it, the Menu key or Shift+F10 opens its menu")
            : @tr("Return puts it on air, F2 renames it, Delete asks before removing it, the Menu key or Shift+F10 opens its menu");
        edit-label: @tr("Name of the scene {}", data.name);
        confirm-question: root.confirm-kind == 1 ? @tr("Discard own levels of {}?", data.name) : @tr("Remove {}?", data.name);
        confirm-name: root.confirm-kind == 1 ? @tr("Use shared levels in {}", data.name) : @tr("Remove scene {}", data.name);
        allow-drag: true;
        drag-data: Studio.scene-data(data.id);
        drop-enabled: Studio.dragging-scene >= 0;
        activated => { Studio.switch-scene(data.id); }
        double-clicked => { self.editing = true; }
        menu-asked(at) => { menu.open(at); }
        renamed(t) => { Studio.rename-scene(data.id, t); }
        delete-asked => { if root.can-remove { root.confirm-kind = 0; self.confirm = true; } }
        confirmed => {
            if root.confirm-kind == 1 {
                self.confirm = false;
                Studio.use-shared-levels(data.id);
            } else {
                root.leaving();
                Studio.remove-scene(data.id);
            }
        }
        dragging(on) => { Studio.dragging-scene = on ? data.id : -1; }
        can-take(d) => { return !Studio.is-panel(d) && Studio.dragging-scene >= 0 && Studio.dragging-scene != data.id; }
        took(d) => {
            Studio.move-scene-to(Studio.dragging-scene, data.id);
            Studio.dragging-scene = -1;
        }
            // Own levels (ADR-0091): the scene mark; the row's name says it in words.
            if data.own-levels && !row.editing: VerticalLayout {
                alignment: center;
                Icon { name: IconName.sliders; ink: Theme.text-secondary; }
            }
            if studio && data.live && root.live-state == 0 && !row.editing: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: Tokens.type-caption-line;
                    width: program-text.preferred-width + 2 * Tokens.space-2;
                    border-radius: self.height / 2;
                    background: Theme.surface-overlay;
                    program-text := Text {
                        text: @tr("Program");
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                        font-weight: Tokens.type-label-weight;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
            // On air: in words with a small dot in the live colour (U7, U12), only while
            // it goes out. No filled badge: the live indicator already carries the state.
            if data.live && root.live-state != 0 && !row.editing: HorizontalLayout {
                spacing: Tokens.space-1 / 2;
                VerticalLayout {
                    alignment: center;
                    Icon { name: IconName.dot; ink: Theme.state-live; }
                }
                Text {
                    text: root.live-state == 1 ? @tr("Live")
                        : root.live-state == 2 ? (Studio.rec-button-audio ? @tr("REC audio") : @tr("REC"))
                        : Studio.rec-button-audio ? @tr("Live · REC audio") : @tr("Live · REC");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    font-weight: Tokens.type-label-weight;
                    vertical-alignment: center;
                }
            }
            if !row.editing: VerticalLayout {
                alignment: center;
                IconButton {
                    visible: row.hovered || row.editing;
                    icon: IconName.more;
                    name: @tr("Actions for {}", data.name);
                    clicked => {
                        menu.open-from({
                            x: self.absolute-position.x - menu.absolute-position.x,
                            y: self.absolute-position.y - menu.absolute-position.y + self.height,
                        }, self.width, self.height);
                    }
                }
            }
            if !row.editing: VerticalLayout {
                alignment: center;
                IconButton {
                    visible: (row.hovered || row.editing) && root.can-remove;
                    icon: IconName.close;
                    name: @tr("Remove scene {}", data.name);
                    clicked => { row.focus-pointer(); root.confirm-kind = 0; row.confirm = true; }
                }
            }
    }
}

// The scenes the canvas may show (ADR-0059). A click puts one on air (a cut); the `+`
// in the card title row adds one. Removing the scene on air first puts the one
// before it on air; the last scene cannot be removed.
export component ScenesPanel inherits Rectangle {
    background: Theme.surface-raised;
    in property <int> live-state;
    property <int> asked: Studio.add-scene-asked;
    changed asked => { if Studio.state == 1 { Studio.add-scene(); } }
    // A right-click outside the rows: the panel's own menu (Add scene).
    panel-menu := CommandMenu { context: "scenes"; }
    MenuArea { menu-at(x, y) => { panel-menu.open({ x: x, y: y }); } }
    if Studio.scenes.length == 0: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("No scenes yet");
        message: Studio.state == 0 ? @tr("The studio is starting.") : @tr("The studio is not running.");
    }
    if Studio.scenes.length > 0: flick := ScrollArea {
        width: parent.width;
        height: parent.height;
        content-height: max(rows.preferred-height, self.height);
        // A list that can pan holds a press briefly, so a quick click on a confirm
        // button never arrives and the next one does. The wheel still scrolls.
        drag-pan: false;
        // Under the rows: the empty space below them opens the panel's menu.
        MenuArea {
            width: parent.width;
            height: max(rows.preferred-height, flick.view-height);
            menu-at(x, y) => {
                panel-menu.open({
                    x: self.absolute-position.x - root.absolute-position.x + x,
                    y: self.absolute-position.y - root.absolute-position.y + y,
                });
            }
        }
        rows := VerticalLayout {
            padding: Tokens.space-2;
            // The bar sits in the trailing padding, so both sides look alike.
            padding-right: max(0px, Tokens.space-2 - flick.bar-room);
            spacing: Tokens.space-1;
            alignment: start;
            for sc in Studio.scenes: SceneRowView {
                data: sc;
                can-remove: Studio.scenes.length > 1;
                live-state: root.live-state;
                leaving => { list-focus.focus(); }
            }
        }
    }
    list-focus := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }
}

// A heading in the Sources list: the global sources, then the scene's. While the
// studio is on air the Global heading says that its sources are on air in every scene,
// also while studio mode edits the preview scene (U4).
// The Global group's header (ADR-0065, ADR-0078): the shared SectionHeader with the count,
// closed by default, so the user knows global sources exist without them taking the list.
// While the program is on air the group says so.
component GlobalsHeader inherits Rectangle {
    in property <bool> open;
    height: head.height;
    head := SectionHeader {
        title: @tr("Global ({})", Studio.global-count);
        collapsible: true;
        open: root.open;
        toggled(o) => { Sections.set-closed("sources.global", !o); }
    }
    if Studio.on-air: Rectangle {
        x: parent.width - self.width;
        width: air.preferred-width + 2 * Tokens.space-2;
        height: Tokens.type-caption-line;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: Theme.state-live;
        air := Text {
            text: @tr("On air");
            color: Theme.text-on-live;
            font-size: Tokens.type-caption-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: @tr("On air in every scene");
        }
    }
}

export component SourcesPanel inherits Rectangle {
    background: Theme.surface-raised;
    // Add source lives in the panel card's title row; undo and redo in the Edit menu
    // and the usual keys (U4).
    property <length> header: 0px;
    // The Global group is closed until the user opens it (ADR-0078, ADR-0065).
    property <bool> globals-open: !Sections.closed("sources.global", Sections.rev);
    // A right-click outside the rows: the panel's own menu (Add source).
    panel-menu := CommandMenu { context: "sources"; }
    // The empty state's Add source: the source types as a menu (ADR-0094 B1).
    add-menu := CommandMenu { context: "add-source"; }
    MenuArea { menu-at(x, y) => { panel-menu.open({ x: x, y: y }); } }
    if Studio.sources.length == 0: EmptyState {
        y: header;
        width: parent.width;
        height: parent.height - header;
        title: @tr("No sources yet");
        message: @tr("Add a screen, window, camera or audio device to the scene.");
        action: Studio.state == 1 ? @tr("Add source") : "";
        act => { add-menu.open({ x: self.x + self.width / 2, y: self.y + self.height / 2 }); }
    }
    if Studio.sources.length > 0: flick := ScrollArea {
        y: header;
        width: parent.width;
        height: parent.height - header;
        content-height: max(rows.preferred-height, self.height);
        // A list that can pan holds a press briefly, so a quick click on a confirm
        // button never arrives and the next one does. The wheel still scrolls.
        drag-pan: false;
        // Under the rows: the empty space below them opens the panel's menu.
        MenuArea {
            width: parent.width;
            height: max(rows.preferred-height, flick.view-height);
            menu-at(x, y) => {
                panel-menu.open({
                    x: self.absolute-position.x - root.absolute-position.x + x,
                    y: self.absolute-position.y - root.absolute-position.y + y,
                });
            }
        }
        rows := VerticalLayout {
            padding: Tokens.size-panel-pad;
            // The bar sits in the trailing padding, so both sides look alike.
            padding-right: max(0px, Tokens.size-panel-pad - flick.bar-room);
            // Each entry spaces itself, so a folded global row takes no room.
            spacing: 0;
            alignment: start;
            for s[i] in Studio.sources: VerticalLayout {
                spacing: Tokens.space-1;
                padding-bottom: !s.global || root.globals-open || Studio.selected-source == s.id || i == 0 ? Tokens.space-1 : 0;
                // Global sources come first, under their own heading (ADR-0065): they
                // are drawn above every scene. The group is folded unless opened.
                if s.global && i == 0: GlobalsHeader { open: root.globals-open; }
                if !s.global && i > 0 && Studio.sources[i - 1].global: SectionHeader { title: @tr("This scene"); }
                if !s.global || root.globals-open || Studio.selected-source == s.id: SourceRowView {
                    data: s;
                    leaving => { list-focus.focus(); }
                }
            }
        }
    }
    // Takes the focus from a row that is made again (a layer move) or deleted, so
    // Ctrl+Z / Cmd+Z right after it still reaches the window's undo keys.
    list-focus := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }
}

// The headphones button of a Mixer strip (ADR-0097 decision 5): a click turns the
// source's monitor on (Monitor and output) or off; Alt-click (Option-click on macOS)
// solos it on the monitor; a right-click opens the monitor menu, which the strip's own
// menu has too. Monitor only adds a dot (warning colour while no device plays, so the
// source still goes to the outputs), solo an "S"; the accessible name says both (U7).
component MonitorButton inherits Rectangle {
    in property <MeterRow> data;
    in property <string> title;
    property <string> mode-text: data.monitor == 2 ? @tr("Monitor only") : data.monitor == 1 ? @tr("Monitor and output") : @tr("Monitor off");
    property <string> state-text: data.monitor == 2 && Studio.monitor-tone != 1
        ? @tr("{}; it goes to the outputs until the monitor plays", root.mode-text)
        : root.mode-text;
    width: button.width;
    height: button.height;
    button := IconButton {
        icon: data.monitor == 0 && !data.solo ? IconName.headphones-off : IconName.headphones;
        name: data.solo ? @tr("Monitor of {}: {}, soloed", root.title, root.state-text) : @tr("Monitor of {}: {}", root.title, root.state-text);
        checked: data.monitor != 0 || data.solo;
        alt-click: true;
        clicked => { Studio.set-source-monitor(data.id, data.monitor == 0 ? 1 : 0); }
        alt-clicked => { Studio.set-source-solo(data.id, !data.solo); }
        context-requested(x, y) => {
            menu.open({
                x: x - menu.absolute-position.x,
                y: y - menu.absolute-position.y,
            });
        }
    }
    if data.monitor == 2: Rectangle {
        x: root.width - self.width;
        y: root.height - self.height;
        width: Tokens.space-2;
        height: Tokens.space-2;
        border-radius: self.width / 2;
        background: Studio.monitor-tone == 1 ? Theme.accent : Theme.state-warning;
    }
    if data.solo: Text {
        x: root.width - self.width;
        y: 0;
        // "S" for solo; the accessible name says it in words.
        text: @tr("S");
        color: Theme.text-primary;
        font-size: Tokens.type-caption-size;
        font-weight: Tokens.type-label-weight;
        accessible-role: none;
    }
    menu := CommandMenu {
        context: "mixer-monitor";
        target: "source=" + data.id;
    }
}

// The monitor in the Mixer's narrow layout (ADR-0097): one row under the scale, shown
// only while a source is monitored or soloed. The headphones in the state's colour, the
// monitor volume (sent when a drag ends), the device, the latency or the problem in
// words; the solo chip that ends solo goes on its own line below.
component MonitorRow inherits VerticalLayout {
    // The fader position while a drag runs; -1 otherwise. Cleared once the host
    // reports that position, so the knob does not jump back before the answer.
    property <float> drag: -1;
    property <float> shown-volume: Studio.monitor-volume;
    changed shown-volume => {
        if root.drag >= 0 && Math.abs(root.shown-volume - root.drag) < 0.02 {
            root.drag = -1;
        }
    }
    spacing: Tokens.space-1;
    HorizontalLayout {
        height: Tokens.size-control-md;
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            Icon {
                name: IconName.headphones;
                ink: Studio.monitor-tone == 2 ? Theme.state-warning : Studio.monitor-tone == 1 ? Theme.accent : Theme.text-secondary;
            }
        }
        Text {
            text: @tr("Monitor");
            color: Theme.text-primary;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
            accessible-role: none;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: Tokens.size-menu-sm * 0.25;
            max-width: Tokens.size-menu-sm * 0.5;
            Slider {
                label: @tr("Monitor volume");
                value: root.drag >= 0 ? root.drag : Studio.monitor-volume;
                value-text: Studio.monitor-volume-text;
                moved(v) => { root.drag = v; Studio.preview-monitor-volume(v); }
                released => { if root.drag >= 0 { Studio.set-monitor-volume(root.drag); } }
                cancelled => { root.drag = -1; Studio.preview-monitor-volume(-1); }
                reset => { root.drag = -1; Studio.set-monitor-volume(1); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: Tokens.size-menu-sm * 0.4;
            max-width: Tokens.size-menu-sm * 0.8;
            Select {
                label: @tr("Monitor device");
                options: Studio.monitor-devices;
                index: Studio.monitor-device;
                selected(i) => { Studio.set-monitor-device(i); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Studio.monitor-tone == 1 ? Studio.monitor-latency : Studio.monitor-status;
            color: Studio.monitor-tone == 2 ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            InfoHint {
                label: @tr("Monitor");
                text: @tr("Sources with their monitor on play here, after their fader and mute and before the master. The monitor goes through the mix, so it lags the sound by the latency shown: for playing live, use your audio interface's direct monitoring.");
                detail: @tr("Monitor only takes a source off the stream and the recording while the monitor plays. Alt-click (Option-click) a headphones button to solo a source.");
            }
        }
    }
    if Studio.monitor-solo != "": HorizontalLayout {
        alignment: start;
        Button {
            lead: IconName.headphones;
            dense: true;
            text: @tr("Solo: {}", Studio.monitor-solo);
            icon: IconName.close;
            accessible-name: @tr("End solo of {}", Studio.monitor-solo);
            tooltip: @tr("End solo");
            clicked => { Studio.end-monitor-solo(); }
        }
    }
}

// The monitor in the Mixer's wide layout (ADR-0097): the same controls as
// MonitorRow, stacked in a column after the master.
component MonitorBox inherits VerticalLayout {
    // The fader position while a drag runs; -1 otherwise. Cleared once the host
    // reports that position, so the knob does not jump back before the answer.
    property <float> drag: -1;
    property <float> shown-volume: Studio.monitor-volume;
    changed shown-volume => {
        if root.drag >= 0 && Math.abs(root.shown-volume - root.drag) < 0.02 {
            root.drag = -1;
        }
    }
    spacing: Tokens.space-2;
    alignment: start;
    HorizontalLayout {
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            Icon {
                name: IconName.headphones;
                ink: Studio.monitor-tone == 2 ? Theme.state-warning : Studio.monitor-tone == 1 ? Theme.accent : Theme.text-secondary;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Studio.monitor-tone == 1 ? Studio.monitor-latency : Studio.monitor-status;
            color: Studio.monitor-tone == 2 ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            overflow: elide;
        }
        InfoHint {
            label: @tr("Monitor");
            text: @tr("Sources with their monitor on play here, after their fader and mute and before the master. The monitor goes through the mix, so it lags the sound by the latency shown: for playing live, use your audio interface's direct monitoring.");
            detail: @tr("Monitor only takes a source off the stream and the recording while the monitor plays. Alt-click (Option-click) a headphones button to solo a source.");
        }
    }
    Select {
        label: @tr("Monitor device");
        options: Studio.monitor-devices;
        index: Studio.monitor-device;
        selected(i) => { Studio.set-monitor-device(i); }
    }
    HorizontalLayout {
        spacing: Tokens.space-2;
        Slider {
            horizontal-stretch: 1;
            label: @tr("Monitor volume");
            value: root.drag >= 0 ? root.drag : Studio.monitor-volume;
            value-text: Studio.monitor-volume-text;
            moved(v) => { root.drag = v; Studio.preview-monitor-volume(v); }
            released => { if root.drag >= 0 { Studio.set-monitor-volume(root.drag); } }
            cancelled => { root.drag = -1; Studio.preview-monitor-volume(-1); }
            reset => { root.drag = -1; Studio.set-monitor-volume(1); }
        }
        Text {
            width: Tokens.size-control-lg * 4;
            horizontal-stretch: 0;
            text: Studio.monitor-volume-text;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    if Studio.monitor-solo != "": HorizontalLayout {
        alignment: start;
        Button {
            lead: IconName.headphones;
            dense: true;
            text: @tr("Solo: {}", Studio.monitor-solo);
            icon: IconName.close;
            accessible-name: @tr("End solo of {}", Studio.monitor-solo);
            tooltip: @tr("End solo");
            clicked => { Studio.end-monitor-solo(); }
        }
    }
}

// The master's short-term loudness in a column strip (ADR-0092 decision 7): a dot that
// lights while the true peak has passed the limit since the last reset, then the number.
// The slot has no room for a button; the details open from the Loudness strip beside
// the master.
export component LoudnessReadout inherits Rectangle {
    in property <bool> compact: true;
    property <string> number: Studio.loudness.has ? Studio.loudness.short-text : "—";
    property <color> lamp: Studio.loudness.over ? Theme.meter-clip : Theme.text-disabled;
    accessible-role: text;
    accessible-label: Studio.loudness.has ? @tr("Loudness {} LUFS", Studio.loudness.short-text) : @tr("Loudness, no value yet");
    if root.compact: HorizontalLayout {
        spacing: 0px;
        alignment: center;
        Icon { name: IconName.dot; ink: root.lamp; }
        Text {
            text: root.number;
            color: Theme.text-primary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The same in a row: the dot, then a button with the value in LUFS that opens or
// closes the loudness details under the master.
export component LoudnessButton inherits HorizontalLayout {
    property <string> number: Studio.loudness.has ? Studio.loudness.short-text : "—";
    spacing: 0px;
    VerticalLayout {
        alignment: center;
        Icon { name: IconName.dot; ink: Studio.loudness.over ? Theme.meter-clip : Theme.text-disabled; }
    }
    Button {
        kind: "ghost";
        dense: true;
        small: true;
        text: @tr("{} LUFS", root.number);
        tooltip: Studio.loudness.over ? @tr("True peak passed {}", Studio.loudness.limit-text) : @tr("Short-term loudness");
        accessible-name: Studio.loudness.has ? @tr("Loudness {} LUFS", Studio.loudness.short-text) : @tr("Loudness, no value yet");
        clicked => { Sections.set-closed("mixer.loudness", !Sections.closed("mixer.loudness", Sections.rev)); }
    }
}

// The master's loudness bar: short-term loudness on the meter law, and the target as a
// mark across it. Vertical in a column strip, horizontal in a row.
export component LoudnessBar inherits Rectangle {
    in property <bool> vertical;
    background: Theme.surface-sunken;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    border-radius: Tokens.radius-sm;
    clip: true;
    accessible-role: none;
    if Studio.loudness.has && root.vertical: Rectangle {
        y: parent.height * (1 - Studio.loudness.at);
        height: parent.height * Studio.loudness.at;
        background: Theme.loudness-fill;
    }
    if Studio.loudness.has && !root.vertical: Rectangle {
        x: 0;
        width: parent.width * Studio.loudness.at;
        background: Theme.loudness-fill;
    }
    if root.vertical: Rectangle {
        y: max(0px, parent.height * (1 - Studio.loudness.target-at) - Tokens.size-meter-target / 2);
        height: Tokens.size-meter-target;
        background: Theme.loudness-target;
    }
    if !root.vertical: Rectangle {
        x: max(0px, parent.width * Studio.loudness.target-at - Tokens.size-meter-target / 2);
        width: Tokens.size-meter-target;
        background: Theme.loudness-target;
    }
}

// One line of the loudness details: what, and its value or a dash.
component LoudnessLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> strong;
    spacing: Tokens.space-3;
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    Text {
        text: root.value == "" ? "—" : root.value;
        color: Theme.text-primary;
        font-size: Tokens.type-body-size;
        font-weight: root.strong ? Tokens.type-label-weight : Tokens.type-body-weight;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// The loudness details (ADR-0092): every value of `loudness.status`, the target, and
// Reset. Drawn in the Mixer under its own "Loudness" header (closed by default) after
// the master: under it in rows, as a column beside it in columns.
export component LoudnessDetails inherits VerticalLayout {
    spacing: Tokens.space-1;
    LoudnessLine { label: @tr("Short-term"); value: Studio.loudness.has ? @tr("{} LUFS", Studio.loudness.short-text) : ""; strong: true; }
    LoudnessLine { label: @tr("Momentary"); value: Studio.loudness.momentary; }
    LoudnessLine { label: @tr("Integrated"); value: Studio.loudness.integrated; strong: true; }
    LoudnessLine { label: @tr("Range"); value: Studio.loudness.range; }
    LoudnessLine { label: @tr("True peak"); value: Studio.loudness.true-peak; }
    LoudnessLine { label: @tr("Target"); value: Studio.loudness.target-text; }
    HorizontalLayout {
        padding-top: Tokens.space-1;
        spacing: Tokens.space-2;
        alignment: end;
        Button { kind: "ghost"; dense: true; icon: IconName.gear; text: @tr("Settings"); clicked => { Studio.open-loudness-settings(); } }
        Button { kind: "secondary"; dense: true; icon: IconName.reset; text: @tr("Reset"); clicked => { Studio.reset-loudness(); } }
    }
}

// The mixer's level in words ("0 dB", "−6.0 dB", "Silent"). A fixed width, so a longer
// reading does not resize the fader. Not a field: the fader is the only control.
// The accessible name includes the level.
component LevelReadout inherits Rectangle {
    in property <string> text;
    in property <string> title;
    in property <bool> muted;
    // Rows: fixed `size.meter.readout` so a longer reading does not resize the fader.
    // Columns control column: `compact` — caption size in `size.mixer.controls`.
    in property <bool> fixed: true;
    in property <bool> compact: false;
    width: root.compact ? Tokens.size-mixer-controls : Tokens.size-meter-readout;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("Volume of {}, {}", title, text);
    if !root.compact: HorizontalLayout {
        width: parent.width;
        ValueReadout {
            text: root.text;
            color: root.muted ? Theme.text-disabled : Theme.text-secondary;
        }
    }
    if root.compact: Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.muted ? Theme.text-disabled : Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// Name, level, clip box and icon buttons, in one order for a row and a column.
// A control the strip does not have (the master's monitor and more) is left out,
// so it takes no space and does not leave a hole.
component StripControls inherits HorizontalLayout {
    in property <MeterRow> data;
    in property <bool> master;
    in property <string> title;
    // Columns: the readout shrinks with the strip. Rows keep it fixed.
    in property <bool> fixed-readout: true;
    // Columns put the name above the fader, so this row is only the readout and buttons.
    in property <bool> show-name: true;
    callback reset();
    callback toggle-muted();
    // The "more" button (sources only): its lower left, in window coordinates.
    callback open-menu(length, length);
    spacing: Tokens.space-1;
    width: 100%;
    min-width: 0px;
    // Name (and icon) on the left, readout and buttons on the right — never centred
    // in a wide panel.
    alignment: stretch;
    if root.show-name: VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        // The scene mark (ADR-0091) takes the source icon's place: no extra width.
        Icon {
            name: data.scene-level ? IconName.sliders : data.muted ? IconName.speaker-off : Icons.named(data.icon);
            ink: data.muted ? Theme.text-disabled : data.scene-level ? Theme.accent : Theme.text-secondary;
        }
    }
    if root.show-name: VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        min-width: 0px;
        Text {
            text: root.title;
            color: data.muted ? Theme.text-disabled : Theme.text-primary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
    }
    // Columns put the name above: a spacer keeps the readout and buttons on the right.
    if !root.show-name: Rectangle {
        horizontal-stretch: 1;
        min-width: 0px;
    }
    if root.master && Studio.loudness.on: VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        LoudnessButton { }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        min-width: 0px;
        LevelReadout { text: data.volume-text; title: root.title; muted: data.muted; fixed: root.fixed-readout; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        Rectangle {
            width: Tokens.size-icon-box;
            height: Tokens.size-icon-box;
            border-width: Tokens.size-border;
            border-color: Theme.border-strong;
            border-radius: Tokens.radius-sm;
            background: data.clipped ? Theme.meter-clip : transparent;
            accessible-role: button;
            accessible-label: data.clipped ? @tr("Clipped. Reset the clip indicator of {}", root.title) : @tr("Not clipped: {}", root.title);
            accessible-action-default => { root.reset(); }
            TouchArea { clicked => { root.reset(); } }
        }
    }
    if !root.master: VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        MonitorButton { data: data; title: root.title; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        IconButton {
            icon: data.muted ? IconName.speaker-off : IconName.speaker;
            name: data.muted ? @tr("Unmute {}", root.title) : @tr("Mute {}", root.title);
            checked: data.muted;
            framed: true;
            clicked => { root.toggle-muted(); }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        IconButton {
            icon: IconName.more;
            name: @tr("More options for {}", root.title);
            clicked => { root.open-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
}

// One horizontal meter (AudioMeter, U16) in the rows arrangement. Two lines, so the
// fader can be as long as the row and the row stays inside the panel: the icon, name,
// level, clip box and icon buttons on the first line, then the bar and the fader.
component MeterView inherits Rectangle {
    in property <MeterRow> data;
    callback reset();
    // The master strip (ADR-0081): its own callbacks and its own menu (ADR-0092).
    in property <bool> master;
    property <string> title: root.master ? @tr("Master") : data.name;
    function set-volume(v: float) {
        if root.master { Studio.set-master-volume(v); } else { Studio.set-source-volume(data.id, v); }
    }
    function toggle-muted() {
        if root.master { Studio.set-master-muted(!data.muted); } else { Studio.set-source-muted(data.id, !data.muted); }
    }
    accessible-role: progress-indicator;
    accessible-label: data.scene-level ? @tr("{}, level of this scene", root.title) : root.title;
    accessible-value: data.value;
    // The source's menu (ADR-0080): the "more" button, a right-click or the Menu key.
    // A source's menu, or the master's (ADR-0092: Show loudness and more).
    menu := CommandMenu {
        context: root.master ? "mixer-master" : "mixer-source";
        // In Own levels the scene too, for "Use the source's level" (ADR-0091).
        target: root.master ? "" : data.scene-level ? "source=" + data.id + "&scene=" + Studio.program-scene : "source=" + data.id;
    }
    MenuArea { menu-at(x, y) => { menu.open({ x: x, y: y }); } }
    VerticalLayout {
        width: 100%;
        spacing: Tokens.space-1;
        // First line, and it does not wrap: icon, name, level, clip box, then the
        // icon buttons the strip actually has. Full width so the name stays left and
        // the buttons stay right in a wide Mixer.
        StripControls {
            height: Tokens.size-control-md;
            spacing: Tokens.space-2;
            data: data;
            master: root.master;
            title: root.title;
            reset => { root.reset(); }
            toggle-muted => { root.toggle-muted(); }
            open-menu(x, y) => {
                menu.open({
                    x: x - menu.absolute-position.x,
                    y: y - menu.absolute-position.y,
                });
            }
        }
        // Second line: the meter and the fader, both as long as the row. The fader's
        // own minimum would force the row wider than a narrow panel.
        VerticalLayout {
            width: 100%;
            spacing: 0px;
            // The level bar spans the fader's track, not its knob room: Slider insets
            // its track by half the knob (`space.3`), so both ends line up with it.
            HorizontalLayout {
                padding-left: Tokens.space-3 / 2;
                padding-right: Tokens.space-3 / 2;
                bar := Rectangle {
                    height: Tokens.size-meter-bar;
                    background: Theme.surface-sunken;
                    border-width: Tokens.size-border;
                    border-color: Theme.border-subtle;
                    border-radius: Tokens.radius-sm;
                    clip: true;
                    Rectangle { x: parent.width * data.lo-from; width: parent.width * (data.lo-to - data.lo-from); background: Theme.meter-low; }
                    Rectangle { x: parent.width * data.mi-from; width: parent.width * (data.mi-to - data.mi-from); background: Theme.meter-mid; }
                    Rectangle { x: parent.width * data.hi-from; width: parent.width * (data.hi-to - data.hi-from); background: Theme.meter-high; }
                    if data.peak > 0: Rectangle {
                        x: max(0px, parent.width * data.peak - Tokens.size-meter-peak);
                        width: Tokens.size-meter-peak;
                        background: data.peak-zone == 2 ? Theme.meter-high : data.peak-zone == 1 ? Theme.meter-mid : Theme.meter-low;
                    }
                }
            }
            // The loudness bar (ADR-0092) under the level bar, on the same scale.
            if root.master && Studio.loudness.on: HorizontalLayout {
                padding-left: Tokens.space-3 / 2;
                padding-right: Tokens.space-3 / 2;
                LoudnessBar {
                    height: Tokens.size-meter-loudness;
                    vertical: false;
                }
            }
            // The fader under the bar, the same width (ADR-0059 fader law, -60 to 0 dB).
            Slider {
                min-width: 0px;
                label: @tr("Volume of {}", root.title);
                value: data.volume;
                value-text: data.volume-text;
                enabled: data.live && !data.muted;
                moved(v) => { root.set-volume(v); }
                reset => { root.set-volume(1); }
            }
        }
    }
}

// A hidden source in the columns arrangement: the same width as a strip, name on top,
// the Show button at the bottom. No meter and no fader (ADR-0080: it is still heard).
component HiddenStrip inherits Rectangle {
    in property <MeterRow> data;
    width: Tokens.size-mixer-strip;
    horizontal-stretch: 0;
    clip: true;
    property <length> pad: Tokens.space-1;
    property <length> name-h: Tokens.size-control-sm;
    menu := CommandMenu {
        context: "mixer-source";
        target: "source=" + data.id;
    }
    MenuArea { menu-at(x, y) => { menu.open({ x: x, y: y }); } }
    HorizontalLayout {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad;
        height: root.name-h;
        spacing: root.pad;
        Icon { name: data.muted ? IconName.speaker-off : Icons.named(data.icon); ink: Theme.text-secondary; }
        Text {
            text: data.name;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
    }
    IconButton {
        x: (root.width - self.width) / 2;
        y: root.height - root.pad - self.height;
        icon: IconName.eye;
        name: @tr("Show {} in the Mixer", data.name);
        clicked => { Studio.set-source-mixer-hidden(data.id, false); }
    }
}

// A hidden source in the rows arrangement (ADR-0080): its name and a button that shows
// it in the Mixer again.
component HiddenRow inherits Rectangle {
    in property <MeterRow> data;
    height: Tokens.size-control-md;
    menu := CommandMenu {
        context: "mixer-source";
        target: "source=" + data.id;
    }
    MenuArea { menu-at(x, y) => { menu.open({ x: x, y: y }); } }
    HorizontalLayout {
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            Icon { name: data.muted ? IconName.speaker-off : Icons.named(data.icon); ink: Theme.text-secondary; }
        }
        Text {
            text: data.name;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.eye;
                name: @tr("Show {} in the Mixer", data.name);
                clicked => { Studio.set-source-mixer-hidden(data.id, false); }
            }
        }
    }
}

// One vertical strip. The panel assigns the box (width `size.mixer.strip`, height the
// row). Positions are explicit, so a stretch pass cannot collapse the fader or float
// the buttons. The five control slots share one height; Master leaves monitor and more
// empty so "0 dB" lines up.
component MeterStrip inherits Rectangle {
    in property <MeterRow> data;
    callback reset();
    // The master strip (ADR-0081): its own callbacks and its own menu (ADR-0092).
    in property <bool> master;
    property <string> title: root.master ? @tr("Master") : data.name;
    function set-volume(v: float) {
        if root.master { Studio.set-master-volume(v); } else { Studio.set-source-volume(data.id, v); }
    }
    function toggle-muted() {
        if root.master { Studio.set-master-muted(!data.muted); } else { Studio.set-source-muted(data.id, !data.muted); }
    }
    // The panel sets the height. Width stays the token, so a long name cannot widen the column.
    // VSlider centres its track in its own width, so that width stays `size.control.sm`.
    // The master with its loudness bar (ADR-0092) is that bar and a gap wider.
    property <bool> loud: root.master && Studio.loudness.on;
    property <length> loud-w: root.loud ? Tokens.size-meter-loudness + Tokens.space-1 : 0px;
    width: Tokens.size-mixer-strip + root.loud-w;
    horizontal-stretch: 0;
    clip: true;
    property <bool> quiet: data.muted || (!root.master && !data.live);
    property <length> pad: Tokens.space-1;
    property <length> gap: Tokens.space-1;
    property <length> name-h: Tokens.size-control-sm;
    property <length> slot: Tokens.size-control-sm;
    property <length> controls-w: Tokens.size-mixer-controls;
    // Five slots and the four gaps between them. Master keeps the empty ones.
    property <length> controls-h: 5 * root.slot + 4 * root.gap;
    property <length> body-y: root.pad + root.name-h + root.gap;
    property <length> body-h: max(0px, root.height - root.body-y - root.pad);
    property <length> controls-y: max(root.body-y, root.height - root.pad - root.controls-h);
    property <length> controls-x: root.width - root.pad - root.controls-w;
    property <length> step: root.slot + root.gap;
    accessible-role: progress-indicator;
    accessible-label: data.scene-level ? @tr("{}, level of this scene", root.title) : root.title;
    accessible-value: data.live ? data.value : data.volume-text;
    // A source's menu, or the master's (ADR-0092: Show loudness and more).
    menu := CommandMenu {
        context: root.master ? "mixer-master" : "mixer-source";
        // In Own levels the scene too, for "Use the source's level" (ADR-0091).
        target: root.master ? "" : data.scene-level ? "source=" + data.id + "&scene=" + Studio.program-scene : "source=" + data.id;
    }
    MenuArea { menu-at(x, y) => { menu.open({ x: x, y: y }); } }
    HorizontalLayout {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad;
        height: root.name-h;
        spacing: root.gap;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            // The scene mark (ADR-0091) takes the source icon's place: no extra width.
            Icon {
                name: data.scene-level ? IconName.sliders : data.muted ? IconName.speaker-off : Icons.named(data.icon);
                ink: root.quiet ? Theme.text-disabled : data.scene-level ? Theme.accent : Theme.text-secondary;
            }
        }
        Text {
            text: root.title;
            color: root.quiet ? Theme.text-disabled : Theme.text-primary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
    }
    // The level bar spans the fader's track, not its knob room: VSlider insets its
    // track by half the knob (`space.3`), so 0 dB and the bottom line up with it.
    property <length> track-inset: Tokens.space-3 / 2;
    bar := Rectangle {
        x: root.pad;
        y: root.body-y + root.track-inset;
        width: Tokens.size-meter-bar;
        height: max(0px, root.body-h - 2 * root.track-inset);
        background: Theme.surface-sunken;
        border-width: Tokens.size-border;
        border-color: Theme.border-subtle;
        border-radius: Tokens.radius-sm;
        clip: true;
        Rectangle { y: parent.height * (1 - data.lo-to); height: parent.height * (data.lo-to - data.lo-from); background: Theme.meter-low; }
        Rectangle { y: parent.height * (1 - data.mi-to); height: parent.height * (data.mi-to - data.mi-from); background: Theme.meter-mid; }
        Rectangle { y: parent.height * (1 - data.hi-to); height: parent.height * (data.hi-to - data.hi-from); background: Theme.meter-high; }
        if data.peak > 0: Rectangle {
            y: min(parent.height - Tokens.size-meter-peak, parent.height * (1 - data.peak));
            height: Tokens.size-meter-peak;
            background: data.peak-zone == 2 ? Theme.meter-high : data.peak-zone == 1 ? Theme.meter-mid : Theme.meter-low;
        }
    }
    if root.loud: LoudnessBar {
        x: root.pad + Tokens.size-meter-bar + root.gap;
        y: root.body-y + root.track-inset;
        width: Tokens.size-meter-loudness;
        height: max(0px, root.body-h - 2 * root.track-inset);
        vertical: true;
    }
    VSlider {
        x: root.pad + Tokens.size-meter-bar + root.gap + root.loud-w;
        y: root.body-y;
        width: Tokens.size-control-sm;
        height: root.body-h;
        horizontal-stretch: 0;
        label: @tr("Volume of {}", root.title);
        value: data.volume;
        value-text: data.volume-text;
        enabled: (root.master || data.live) && !data.muted;
        moved(v) => { root.set-volume(v); }
        reset => { root.set-volume(1); }
    }
    // Five slots, anchored to the bottom. Missing widgets leave their slot empty, so
    // Master (no monitor, no more) keeps the same readout position as a source.
    LevelReadout {
        x: root.controls-x;
        y: root.controls-y;
        height: root.slot;
        text: data.volume-text;
        title: root.title;
        muted: root.quiet;
        compact: true;
    }
    Rectangle {
        x: root.controls-x + (root.controls-w - root.slot) / 2;
        y: root.controls-y + root.step;
        width: root.slot;
        height: root.slot;
        border-width: Tokens.size-border;
        border-color: Theme.border-strong;
        border-radius: Tokens.radius-sm;
        background: data.clipped ? Theme.meter-clip : transparent;
        accessible-role: button;
        accessible-label: data.clipped ? @tr("Clipped. Reset the clip indicator of {}", root.title) : @tr("Not clipped: {}", root.title);
        accessible-action-default => { root.reset(); }
        TouchArea { clicked => { root.reset(); } }
    }
    if !root.master: MonitorButton {
        x: root.controls-x + (root.controls-w - self.width) / 2;
        y: root.controls-y + 2 * root.step;
        data: data;
        title: root.title;
    }
    // The master's monitor slot holds its loudness readout (ADR-0092).
    if root.loud: LoudnessReadout {
        x: root.controls-x;
        y: root.controls-y + 2 * root.step;
        width: root.controls-w;
        height: root.slot;
        compact: true;
    }
    IconButton {
        x: root.controls-x + (root.controls-w - self.width) / 2;
        y: root.controls-y + 3 * root.step;
        icon: data.muted ? IconName.speaker-off : IconName.speaker;
        name: data.muted ? @tr("Unmute {}", root.title) : @tr("Mute {}", root.title);
        checked: data.muted;
        framed: true;
        clicked => { root.toggle-muted(); }
    }
    IconButton {
        x: root.controls-x + (root.controls-w - self.width) / 2;
        y: root.controls-y + 4 * root.step;
        icon: IconName.more;
        name: @tr("More options for {}", root.title);
        clicked => {
            menu.open-from({
                x: self.absolute-position.x - menu.absolute-position.x,
                y: self.absolute-position.y + self.height - menu.absolute-position.y,
            }, self.width, self.height);
        }
    }
}

// Compact group caption for columns: uppercase, elides to the pane width, never sets
// the pane's preferred width (This scene / Global stay open in columns).
component MixerCaption inherits Rectangle {
    in property <string> title;
    // The scene mark before the title (Own levels, ADR-0091).
    in property <bool> mark;
    // A "more" button at the end, for the group's menu: its lower left, window coordinates.
    in property <bool> more;
    in property <string> more-name;
    callback open-menu(length, length);
    height: Tokens.size-control-sm;
    min-width: 0px;
    property <length> lead: root.mark ? Tokens.size-icon-box + Tokens.space-1 : 0px;
    property <length> tail: root.more ? Tokens.size-control-sm + Tokens.space-1 : 0px;
    if root.mark: Icon {
        x: 0;
        y: (parent.height - self.height) / 2;
        name: IconName.sliders;
        ink: Theme.accent;
    }
    if root.more: IconButton {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        icon: IconName.more;
        name: root.more-name;
        clicked => { root.open-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
    }
    Text {
        x: root.lead;
        width: max(0px, parent.width - root.lead - root.tail);
        height: parent.height;
        text: root.title.to-uppercase();
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        font-weight: Tokens.type-label-weight;
        letter-spacing: Tokens.size-tracking-caps;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// One columns group. Width is the strip count times the strip width: the caption elides
// inside that and never widens the group. Height is the row's inner height, passed in,
// so every strip (including Master) gets the same box.
component MixerGroupCluster inherits Rectangle {
    in property <string> title;
    // 0 = This scene, 1 = Global, 2 = Master.
    in property <int> kind;
    in property <length> col-h;
    property <int> count: root.kind == 2 ? Studio.master-meter.length : root.kind == 0 ? Studio.meter-scenes : Studio.meter-globals;
    property <length> strip-w: Tokens.size-mixer-strip + Tokens.size-field-gap;
    property <length> body-y: Tokens.size-control-sm + Tokens.size-field-gap;
    width: root.count > 0 ? (root.kind == 2 ? Tokens.size-mixer-strip + (Studio.loudness.on ? Tokens.size-meter-loudness + Tokens.space-1 : 0px) : root.count * root.strip-w) : 0px;
    height: root.col-h;
    horizontal-stretch: 0;
    clip: true;
    // This scene's group: Shared or Own levels and its menu (ADR-0091).
    property <bool> own: root.kind == 0 && Studio.scene-levels != "";
    scene-menu := CommandMenu {
        context: "mixer-scene";
        target: "scene=" + Studio.program-scene;
    }
    MixerCaption {
        y: 0;
        width: parent.width;
        title: root.own ? @tr("Scene levels") : root.title;
        mark: root.own;
        more: root.kind == 0;
        more-name: @tr("Levels of this scene");
        accessible-role: text;
        accessible-label: root.own ? @tr("Scene levels of {}", Studio.scene-levels) : root.title;
        open-menu(x, y) => {
            scene-menu.open({
                x: x - scene-menu.absolute-position.x,
                y: y - scene-menu.absolute-position.y,
            });
        }
    }
    if root.kind == 2 && Studio.master-meter.length > 0: MeterStrip {
        x: 0;
        y: root.body-y;
        height: root.height - root.body-y;
        master: true;
        data: Studio.master-meter[0];
        reset => { Studio.reset-master-clip(); }
    }
    if root.kind != 2: HorizontalLayout {
        x: 0;
        y: root.body-y;
        width: parent.width;
        height: root.height - root.body-y;
        spacing: 0px;
        alignment: start;
        for m in Studio.meters: Rectangle {
            property <bool> show: (root.kind == 0 && !m.global) || (root.kind == 1 && m.global);
            // A source in the other group keeps a zero-wide cell, so it cannot open a hole
            // or push this group's strips apart.
            width: show ? root.strip-w : 0px;
            height: parent.height;
            horizontal-stretch: 0;
            clip: true;
            MeterStrip {
                x: 0;
                y: 0;
                height: parent.height;
                data: m;
                reset => { Studio.reset-clip(m.id); }
            }
        }
    }
}

// A group closed in the columns arrangement (Hidden only): a vertical strip as wide as
// a collapsed stack. The title runs along the strip; the chevron points right.
component MixerGroupStrip inherits Rectangle {
    in property <string> title;
    callback open();
    width: Tokens.size-control-lg;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    border-radius: Tokens.radius-sm;
    background: touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: button;
    accessible-label: title;
    accessible-expanded: false;
    accessible-action-default => { root.open(); }
    forward-focus: focus;
    property <length> label-room: max(0px, root.height - Tokens.size-icon-box - 3 * Tokens.space-1);
    Icon {
        x: (parent.width - self.width) / 2;
        y: Tokens.space-1;
        name: IconName.chevron-right;
        ink: Theme.text-secondary;
    }
    label := Text {
        width: min(self.preferred-width, root.label-room);
        height: self.preferred-height;
        x: (parent.width - self.width) / 2;
        y: Tokens.size-icon-box + 2 * Tokens.space-1 + (self.width - self.height) / 2;
        transform-rotation: 90deg;
        text: root.title.to-uppercase();
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        font-weight: Tokens.type-label-weight;
        letter-spacing: Tokens.size-tracking-caps;
        overflow: elide;
        accessible-role: none;
    }
    focus := RingFocus {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.open(); return accept; }
            reject
        }
    }
    touch := TouchArea {
        clicked => { focus.focus-pointer(); root.open(); }
    }
    FocusRing { show: focus.ring; border-radius: Tokens.radius-sm; }
}

// The Mixer (ADR-0078 / ADR-0083 / ADR-0101): wide = fixed strips side by side with
// horizontal scroll; tall = rows under foldable headers.
export component MixerPanel inherits Rectangle {
    background: Theme.surface-raised;
    // ADR-0083: a fixed layout never reflows by size; auto follows the panel's shape.
    property <bool> wide: Sections.mixer-orientation == 2 || (Sections.mixer-orientation == 0 && self.width > self.height * 1.5);
    property <bool> hidden-closed: Sections.closed("mixer.hidden", Sections.rev);
    // Rows still fold This scene / Global; columns keep them open.
    property <bool> scene-closed: Sections.closed("mixer.scene", Sections.rev);
    property <bool> global-closed: Sections.closed("mixer.global", Sections.rev);
    // The loudness details after the master (ADR-0092), closed by default.
    property <bool> loudness-closed: Sections.closed("mixer.loudness", Sections.rev);
    property <bool> loudness-shown: Studio.loudness.on && Studio.master-meter.length > 0;
    property <bool> any: Studio.meters.length + Studio.hidden-meters.length > 0;
    if !root.any: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("No audio sources");
        message: @tr("Add an audio input, system audio or application audio to see its levels here.");
        action: Studio.state == 1 ? @tr("Add source") : "";
        act => { add-menu.open({ x: self.x + self.width / 2, y: self.y + self.height / 2 }); }
    }
    // Columns: a clipped panel with one absolutely positioned row at its preferred
    // width. Flickable/layout children otherwise fill the panel and stretch Master away
    // from the sources (x/y take the row out of that fill behaviour).
    if root.any && root.wide: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;
        TouchArea {
            width: parent.width;
            height: parent.height;
            // A wheel the strips and the area do not use pans the row sideways.
            scroll-event(e) => {
                flick.scroll-by(-(e.delta-x != 0px ? e.delta-x : e.delta-y));
                accept
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    mixer-menu.open({
                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                    });
                }
            }
        }
        flick := HScrollArea {
            width: parent.width;
            height: parent.height;
            content-width: row.preferred-width;
            // Taller than the viewport only when the viewport is shorter than a strip
            // plus its caption: then the row scrolls so the buttons can be reached.
            content-height: row.height;
            // x/y: do not fill the Flickable viewport (that was spreading the strips).
            row := HorizontalLayout {
                // Caption, the gap under it, the strip's own minimum, and the panel padding.
                property <length> col-min: Tokens.size-control-sm + Tokens.size-field-gap + Tokens.size-mixer-min-h + 2 * Tokens.size-panel-pad;
                property <length> col-h: self.height - 2 * Tokens.size-panel-pad;
                x: 0;
                y: 0;
                height: max(flick.view-height, self.col-min);
                width: self.preferred-width;
                padding: Tokens.size-panel-pad;
                spacing: Tokens.size-field-gap;
                alignment: start;
                if Studio.meter-scenes > 0: MixerGroupCluster {
                    title: @tr("This scene");
                    kind: 0;
                    col-h: row.col-h;
                }
                if Studio.meter-globals > 0: MixerGroupCluster {
                    title: @tr("Global ({})", Studio.meter-globals);
                    kind: 1;
                    col-h: row.col-h;
                }
                if Studio.master-meter.length > 0: Rectangle {
                    width: Tokens.size-border;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    background: Theme.border-subtle;
                }
                if Studio.master-meter.length > 0: MixerGroupCluster {
                    title: @tr("Master");
                    kind: 2;
                    col-h: row.col-h;
                }
                // The loudness details (ADR-0092): a folded strip, or a column.
                if root.loudness-shown: Rectangle {
                    width: Tokens.size-border;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    background: Theme.border-subtle;
                }
                if root.loudness-shown && root.loudness-closed: MixerGroupStrip {
                    height: row.col-h;
                    title: @tr("Loudness");
                    open => { Sections.set-closed("mixer.loudness", false); }
                }
                if root.loudness-shown && !root.loudness-closed: VerticalLayout {
                    width: Tokens.size-menu-sm;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    spacing: Tokens.size-field-gap;
                    HorizontalLayout {
                        height: Tokens.size-control-sm;
                        spacing: Tokens.space-1;
                        IconButton {
                            icon: IconName.chevron-down;
                            name: @tr("Hide the loudness details");
                            clicked => { Sections.set-closed("mixer.loudness", true); }
                        }
                        Text {
                            text: @tr("Loudness");
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            font-weight: Tokens.type-label-weight;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                        }
                    }
                    LoudnessDetails { }
                    Rectangle { vertical-stretch: 1; }
                }
                if Studio.monitor-wanted: Rectangle {
                    width: Tokens.size-border;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    background: Theme.border-subtle;
                }
                if Studio.monitor-wanted: VerticalLayout {
                    width: Tokens.size-menu-sm;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    spacing: Tokens.size-field-gap;
                    MixerCaption { title: @tr("Monitor"); }
                    MonitorBox { }
                }
                if Studio.hidden-meters.length > 0 && root.hidden-closed: MixerGroupStrip {
                    height: row.col-h;
                    title: @tr("Hidden ({})", Studio.hidden-meters.length);
                    open => { Sections.set-closed("mixer.hidden", false); }
                }
                if Studio.hidden-meters.length > 0 && !root.hidden-closed: Rectangle {
                    property <length> strip-w: Tokens.size-mixer-strip + Tokens.size-field-gap;
                    property <length> body-y: Tokens.size-control-sm + Tokens.size-field-gap;
                    width: Studio.hidden-meters.length * strip-w;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    clip: true;
                    HorizontalLayout {
                        y: 0;
                        width: parent.width;
                        height: Tokens.size-control-sm;
                        spacing: Tokens.space-1;
                        IconButton {
                            icon: IconName.chevron-down;
                            name: @tr("Hide the Hidden section");
                            clicked => { Sections.set-closed("mixer.hidden", true); }
                        }
                        Text {
                            text: @tr("Hidden ({})", Studio.hidden-meters.length);
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            font-weight: Tokens.type-label-weight;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        x: 0;
                        y: body-y;
                        width: parent.width;
                        height: parent.height - body-y;
                        spacing: 0px;
                        alignment: start;
                        for m in Studio.hidden-meters: HiddenStrip {
                            height: parent.height;
                            data: m;
                        }
                    }
                }
            }
        }
    }
    // Narrow: rows under full-width headers, then the labelled scale (dBFS). The
    // content is exactly as wide as the panel, so a narrow panel never scrolls
    // sideways; a long list still scrolls down. A drag on a fader does not pan this.
    if root.any && !root.wide: Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: max(strips.preferred-height, self.height);
        mouse-drag-pan-enabled: false;
        MenuArea {
            width: root.width;
            height: max(strips.preferred-height, root.height);
            menu-at(x, y) => {
                // Relative to the panel, where the menu is, whatever the scroll.
                mixer-menu.open({
                    x: self.absolute-position.x - root.absolute-position.x + x,
                    y: self.absolute-position.y - root.absolute-position.y + y,
                });
            }
        }
        strips := VerticalLayout {
            width: parent.width;
            padding: Tokens.size-panel-pad;
            // Each entry spaces itself, so a folded group takes no room: it closes
            // upward to its title row.
            spacing: 0px;
            alignment: start;
            // This scene's group: Shared or Own levels and its menu (ADR-0091).
            if Studio.meter-scenes > 0: HorizontalLayout {
                spacing: Tokens.size-field-gap;
                SectionHeader {
                    horizontal-stretch: 1;
                    title: Studio.scene-levels != "" ? @tr("Scene levels · {}", Studio.scene-levels) : @tr("This scene");
                    collapsible: true;
                    open: !root.scene-closed;
                    toggled(o) => { Sections.set-closed("mixer.scene", !o); }
                }
                IconButton {
                    icon: IconName.more;
                    name: @tr("Levels of this scene");
                    clicked => {
                        scene-menu.open-from({
                            x: self.absolute-position.x - scene-menu.absolute-position.x,
                            y: self.absolute-position.y + self.height - scene-menu.absolute-position.y,
                        }, self.width, self.height);
                    }
                }
            }
            for m in Studio.meters: VerticalLayout {
                padding-bottom: m.global || root.scene-closed ? 0px : Tokens.space-1;
                if !m.global && !root.scene-closed: MeterView {
                    data: m;
                    reset => { Studio.reset-clip(m.id); }
                }
            }
            if Studio.meter-globals > 0: VerticalLayout {
                padding-top: Studio.meter-scenes > 0 ? Tokens.size-section-gap : 0px;
                SectionHeader {
                    title: @tr("Global ({})", Studio.meter-globals);
                    collapsible: true;
                    open: !root.global-closed;
                    toggled(o) => { Sections.set-closed("mixer.global", !o); }
                }
            }
            for m in Studio.meters: VerticalLayout {
                padding-bottom: !m.global || root.global-closed ? 0px : Tokens.space-1;
                if m.global && !root.global-closed: MeterView {
                    data: m;
                    reset => { Studio.reset-clip(m.id); }
                }
            }
            // The master (ADR-0081): after the groups, under a divider, so the scale
            // below serves it too.
            if Studio.master-meter.length > 0: VerticalLayout {
                padding-top: Tokens.size-section-gap;
                spacing: Tokens.size-field-gap;
                Rectangle {
                    height: Tokens.size-border;
                    background: Theme.border-subtle;
                }
                MeterView {
                    master: true;
                    data: Studio.master-meter[0];
                    reset => { Studio.reset-master-clip(); }
                }
            }
            // The labelled scale (dBFS) under the faders, which are as wide as the row.
            scale-row := Rectangle {
                height: Tokens.size-meter-scale-line;
                // A narrow panel shows every second or third label, so none overlap.
                property <int> step: self.width >= Tokens.size-menu-sm ? 1 : self.width >= Tokens.size-menu-sm / 2 ? 2 : 3;
                for mark[i] in Studio.scale: Text {
                    visible: Math.mod(i, scale-row.step) == 0;
                    // On the faders' track, which is inset by half the knob.
                    x: Tokens.space-3 / 2 + (parent.width - Tokens.space-3) * mark.at - self.width / 2;
                    height: parent.height;
                    text: mark.label;
                    color: Theme.text-secondary;
                    font-size: Tokens.size-meter-scale;
                    vertical-alignment: center;
                }
            }
            // The loudness details (ADR-0092), folded by default; the master's LUFS
            // button opens them too.
            if root.loudness-shown: VerticalLayout {
                padding-top: Tokens.size-section-gap;
                SectionHeader {
                    title: @tr("Loudness");
                    collapsible: true;
                    open: !root.loudness-closed;
                    toggled(o) => { Sections.set-closed("mixer.loudness", !o); }
                }
                if !root.loudness-closed: LoudnessDetails { }
            }
            // The monitor (ADR-0097), under the scale while it is wanted.
            if Studio.monitor-wanted: VerticalLayout {
                padding-top: Tokens.size-section-gap;
                MonitorRow { }
            }
            if Studio.hidden-meters.length > 0: VerticalLayout {
                padding-top: Tokens.size-section-gap;
                SectionHeader {
                    title: @tr("Hidden ({})", Studio.hidden-meters.length);
                    collapsible: true;
                    open: !root.hidden-closed;
                    toggled(o) => { Sections.set-closed("mixer.hidden", !o); }
                }
                if !root.hidden-closed: VerticalLayout {
                    for m in Studio.hidden-meters: HiddenRow { data: m; }
                }
            }
        }
    }
    // The Mixer's own menu (ADR-0080): a right-click outside any strip or row.
    mixer-menu := CommandMenu { context: "mixer"; }
    // This scene's levels (ADR-0091): Own levels and back, from the group's "more".
    scene-menu := CommandMenu {
        context: "mixer-scene";
        target: "scene=" + Studio.program-scene;
    }
    // The empty state's Add source: the source types as a menu (ADR-0094 B1).
    add-menu := CommandMenu { context: "add-source"; }
}

// Live controls: Go live and End stream, Record and Stop recording. The stream and the
// recording run at the same time or alone (ADR-0047). End stream asks first (U4: it
// cannot be undone). Under them, Start and Stop virtual camera (ADR-0066).
// The transition rail or panel (ADR-0061, UI spec Studio mode): the transition's name
// ("Cut", the only one for now) and, in studio mode, the Transition button that puts
// the preview scene on air. Narrower than 40 px it is only the button, floating over
// the bottom edge of the two views. Collection glide is Settings › General; a
// per-source override is Properties (ADR-0100) — not on this panel.
export component TransitionPanel inherits Rectangle {
    background: Theme.surface-raised;
    property <bool> narrow: root.width < Tokens.size-transition-narrow;
    property <bool> can: Studio.studio-mode && Studio.state == 1;
    if !narrow: VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-2;
        alignment: center;
        Text {
            text: @tr("Cut");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            accessible-role: none;
        }
        if root.can: Button {
            // "Go" in a short panel has no room for the icon.
            lead: root.width < Tokens.size-transition-short ? IconName.none : IconName.transition;
            text: root.width < Tokens.size-transition-short ? @tr("Go") : @tr("Transition");
            kind: "primary";
            accessible-name: @tr("Transition: put the preview scene on air");
            clicked => { Studio.transition(); }
        }
        if !Studio.studio-mode && root.width >= Tokens.size-transition-short: Text {
            text: @tr("Turn on studio mode to prepare the next scene in Preview.");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if narrow && root.can: VerticalLayout {
        alignment: end;
        padding-bottom: Tokens.space-2;
        IconButton {
            icon: IconName.chevron-right;
            name: @tr("Transition: put the preview scene on air");
            clicked => { Studio.transition(); }
        }
    }
}

export component LiveControlsPanel inherits Rectangle {
    background: Theme.surface-raised;
    property <bool> recording: Studio.rec-state == 2;
    property <bool> live: Studio.st-state == 2;
    // "End stream" was pressed: the question shows until answered.
    property <bool> confirming: false;
    changed live => { if !live { confirming = false; } }
    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-2;
        alignment: start;
        HorizontalLayout {
            spacing: Tokens.space-2;
            alignment: start;
            Button {
                lead: live || Studio.st-state == 3 ? IconName.stop : IconName.bolt;
                // While the stream ends the button says so (disabled) until the
                // output closed, so it never offers Go live too early.
                text: Studio.st-state == 3 ? @tr("Ending…") : live ? @tr("End stream") : @tr("Go live");
                kind: live || Studio.st-state == 3 ? "live" : "primary";
                enabled: Studio.state == 1 && !confirming
                    && (live || (Studio.st-state == 0 && Studio.rec-unavailable == ""));
                clicked => {
                    if live { confirming = true; } else { Studio.go-live(); }
                }
            }
            Button {
                // Stopping: the button says so (disabled) until the file is closed;
                // Record comes back only then.
                text: Studio.rec-state == 3 ? @tr("Stopping…")
                    : recording ? (Studio.rec-button-audio ? @tr("Stop audio recording") : @tr("Stop recording"))
                    : Studio.rec-button-audio ? @tr("Record audio") : @tr("Record");
                kind: recording || Studio.rec-state == 3 ? "live" : "secondary";
                // Record's dot in the live colour, in its well; the stop square on the
                // live fill (ADR-0118).
                lead: recording || Studio.rec-state == 3 ? IconName.stop : IconName.dot;
                lead-ink: recording || Studio.rec-state == 3 || !self.enabled ? self.ink : Theme.state-live;
                lead-signal: !recording && Studio.rec-state != 3 && self.enabled;
                enabled: Studio.state == 1
                    && (Studio.rec-unavailable == "" || Studio.rec-audio-only)
                    && (recording || Studio.rec-state == 0);
                clicked => {
                    if recording { Studio.stop-recording(); } else { Studio.record(); }
                }
            }
        }
        if confirming: Rectangle {
            border-width: Tokens.size-border;
            border-color: Theme.border-subtle;
            border-radius: Tokens.radius-sm;
            accessible-role: groupbox;
            accessible-label: @tr("End the stream?");
            // Keep streaming, the safe answer, has the focus.
            init => { keep.focus(); }
            VerticalLayout {
                padding: Tokens.space-2;
                spacing: Tokens.space-2;
                Text {
                    text: Studio.st-end-both ? @tr("End both streams, main and vertical? Viewers see them end.") : @tr("End the stream? Viewers see it end.");
                    color: Theme.text-primary;
                    font-size: Tokens.type-body-size;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    alignment: start;
                    // Its own name, so assistive technology never confuses it with
                    // the (disabled) End stream button above.
                    Button {
                        text: Studio.st-end-both ? @tr("Yes, end both streams") : @tr("Yes, end the stream");
                        kind: "live";
                        clicked => {
                            confirming = false;
                            Studio.end-stream();
                        }
                    }
                    keep := Button {
                        text: @tr("Keep streaming");
                        clicked => { confirming = false; }
                    }
                }
            }
        }
        if Studio.st-text != "": Text {
            // The stream's state in words (U4, U9); the live indicator shows it too.
            text: Studio.st-text;
            color: Studio.st-bad ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        if Studio.st-needs-setup && Studio.st-state == 0: HorizontalLayout {
            alignment: start;
            Button {
                lead: IconName.gear;
                text: @tr("Stream settings");
                clicked => { Studio.open-stream-settings(); }
            }
        }
        Text {
            // State in words (U4, U9); the live indicator shows it everywhere too.
            text: Studio.rec-state == 1 ? @tr("Starting the recording…")
                : Studio.rec-state == 2 ? (Studio.rec-button-audio ? @tr("Recording audio to {}", Studio.rec-file) : @tr("Recording to {}", Studio.rec-file))
                : Studio.rec-state == 3 ? @tr("Stopping the recording and closing the file…")
                : Studio.rec-unavailable != "" && !Studio.rec-audio-only ? Studio.rec-unavailable
                : Studio.rec-note != "" ? Studio.rec-note
                : Studio.rec-audio-only ? @tr("Audio only. The picture is not recorded.")
                : "";
            color: Studio.rec-state == 0 && ((Studio.rec-unavailable != "" && !Studio.rec-audio-only) || Studio.rec-note-bad) ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        if Studio.rec-state == 2 && Studio.rec-note != "": Text {
            text: Studio.rec-note;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            wrap: word-wrap;
        }
        // The virtual camera: stopping asks nothing, the camera then shows its still
        // picture (ADR-0066 decision 12).
        if Studio.vcam-shown: HorizontalLayout {
            alignment: start;
            Button {
                lead: Studio.vcam-on ? IconName.stop : IconName.camera;
                text: Studio.vcam-on ? @tr("Stop virtual camera") : @tr("Start virtual camera");
                kind: Studio.vcam-on ? "live" : "secondary";
                enabled: Studio.vcam-can;
                clicked => { Studio.vcam-toggle(!Studio.vcam-on); }
            }
        }
        if Studio.vcam-shown && Studio.vcam-text != "": Text {
            // State in words (U4); the live indicator says "Virtual camera on" too.
            text: Studio.vcam-text;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        // The replay buffer: arm it, save a clip (ADR-0088).
        ReplayControls { }
    }
}

// A section title that does not collapse (ADR-0076): the same look as SectionHeader,
// with a rule to the end of the row, but plain text for screen readers.
component SectionTitle inherits HorizontalLayout {
    in property <string> title;
    spacing: Tokens.size-field-gap;
    VerticalLayout {
        alignment: center;
        Text {
            text: title.to-uppercase();
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            font-weight: Tokens.type-label-weight;
            letter-spacing: Tokens.size-tracking-caps;
            accessible-role: text;
            accessible-label: title;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
    }
}

// A collapsible group of fields under a SectionHeader. A closed section draws nothing and
// takes no room. Its state is saved in the workspace file under `id` (ADR-0078).
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> id;
    // The explanation behind an info button at the end of the header (ADR-0094 rule A1);
    // empty draws no button.
    in property <string> hint;
    // A section with one value and a known default (owner decision 2026-11-14, ADR-0114
    // decision 4): while the value differs, a reset button sits at the trailing end of
    // the header, before the info button. `default-text` names the default.
    in property <bool> changed;
    in property <string> default-text;
    callback reset();
    property <bool> closed: Sections.closed(root.id, Sections.rev);
    spacing: Tokens.size-field-gap;
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        SectionHeader {
            horizontal-stretch: 1;
            title: root.title;
            collapsible: true;
            open: !root.closed;
            toggled(o) => { Sections.set-closed(root.id, !o); }
        }
        if root.changed && !root.closed: IconButton {
            icon: IconName.reset;
            name: @tr("Reset {} to {}", root.title, root.default-text);
            clicked => { root.reset(); }
        }
        if root.hint != "" && !root.closed: InfoHint {
            label: root.title;
            text: root.hint;
        }
    }
    // Slint cannot put @children in an `if`, so a closed section is hidden and takes
    // no room (like Shown): it draws and handles no input. Width follows the section
    // so a stretched slider (volume) fills the panel instead of staying at preferred width.
    Rectangle {
        visible: !root.closed;
        width: 100%;
        height: root.closed ? 0px : inner.preferred-height;
        inner := VerticalLayout {
            width: 100%;
            spacing: Tokens.size-field-gap;
            @children
        }
    }
}

// Reports its place when the Library gear asks, so Properties can scroll to it.
component LookAnchor inherits Rectangle {
    height: 0px;
    property <int> ask: Studio.look-reveal;
    property <int> reported: -1;
    function report() {
        if root.ask <= 0 || self.absolute-position.y <= 0px || root.reported == root.ask {
            return;
        }
        root.reported = root.ask;
        Studio.look-anchor-y = self.absolute-position.y;
        Studio.look-anchor-serial += 1;
    }
    changed ask => { root.reported = -1; root.report(); }
    changed y => { root.report(); }
}

// The selected source's properties. For now: where its picture is on the canvas
// (position and size in canvas pixels). Rotation, crop and filters come later.
// The colour code of a colour source: a short field, and Copy while the pointer is over
// it or it has focus. Pasting a whole code sets the colour.
component ColourCode inherits Rectangle {
    in property <SourceData> data;
    property <string> fill-text: data.fill;
    property <bool> show-copy: cover.has-hover || fill-field.has-focus || copy.pointed;
    width: Tokens.size-color-code;
    height: Tokens.size-control-md;
    fill-field := TextField {
        width: parent.width;
        height: parent.height;
        // The copy button is drawn over this end of the field.
        end-inset: Tokens.size-control-sm + Tokens.space-1;
        label: @tr("Fill of {}", data.name);
        text: data.fill;
        // A later fill copies in. An unfinished edit does not change `fill-text`,
        // so this does not wipe what is being typed.
        property <string> copied: root.fill-text;
        changed copied => { self.text = self.copied; }
        enabled: !data.locked;
        accepted(t) => {
            if t != data.fill { Studio.set-source-fill(data.id, t); }
            self.text = data.fill;
        }
        edited(t) => { if t != data.fill { Studio.set-source-fill(data.id, t); } }
    }
    copy := IconButton {
        x: parent.width - self.width - Tokens.space-1;
        y: (parent.height - self.height) / 2;
        opacity: root.show-copy ? 1 : 0;
        icon: IconName.copy;
        name: @tr("Copy the fill of {}", data.name);
        clicked => { fill-field.copy-all(); }
    }
    // Over the text only, and only until the field is focused, so a click focuses it
    // and the copy button stays clickable.
    cover := TouchArea {
        width: parent.width - Tokens.size-control-sm - Tokens.space-1;
        height: parent.height;
        enabled: !fill-field.has-focus;
        clicked => { fill-field.focus(); }
    }
}

// Fill: the checkbox at the start, the swatch and the code at the end of the same
// line. When the panel is too narrow for one line, the swatch and the code go on a
// second line, so nothing is cut off at the panel's minimum width (U11).
component FillLine inherits Rectangle {
    in property <SourceData> data;
    property <length> swatch: Tokens.size-control-md * 4 / 5;
    property <length> tail: root.data.filled ? root.swatch + Tokens.size-field-gap + Tokens.size-color-code : 0px;
    property <bool> stacked: root.data.filled && root.width < check.min-width + Tokens.size-field-gap + root.tail;
    property <length> line: max(check.preferred-height, Tokens.size-control-md);
    min-width: max(check.min-width, root.tail);
    height: root.stacked ? root.line * 2 + Tokens.size-field-gap : root.line;
    check := Checkbox {
        x: 0px;
        y: (root.line - self.height) / 2;
        text: @tr("Fill");
        checked: data.filled;
        enabled: !data.locked;
        toggled(on) => { Studio.set-source-filled(data.id, on); }
    }
    // The swatch is a square a step smaller than the field (four fifths of a control).
    if data.filled: ColorPicker {
        x: root.stacked ? 0px : root.width - root.tail;
        y: (root.stacked ? root.line + Tokens.size-field-gap : 0px) + (root.line - self.height) / 2;
        width: root.swatch;
        height: root.swatch;
        label: @tr("Choose the fill of {}", data.name);
        value: data.fill-swatch;
        enabled: !data.locked;
        picked(c) => { if c != data.fill { Studio.set-source-fill(data.id, c); } }
    }
    if data.filled: ColourCode {
        x: (root.stacked ? 0px : root.width - root.tail) + root.swatch + Tokens.size-field-gap;
        // On its own line the code reaches the panel's edge like the fields above it.
        width: root.stacked ? root.width - self.x : Tokens.size-color-code;
        y: (root.stacked ? root.line + Tokens.size-field-gap : 0px) + (root.line - self.height) / 2;
        data: root.data;
    }
}

// Shape and border of a picture (ADR-0053), under its position and size. Every change
// is one undo step.
component StyleFields inherits Section {
    in property <SourceData> data;
    LookAnchor { }
    // The colour that stands. The field's text is set from it whenever it changes,
    // because setting the text after an edit ends the field's binding.
    property <string> colour-text: data.border-color;
    changed colour-text => { colour.text = colour-text; }
    title: @tr("Shape and border");
    id: "properties.shape";
    hint: data.locked ? @tr("Unlock the source to change its shape and border.") : "";
    Field {
        label: @tr("Shape");
        // Five names do not fit a segmented control in a narrow panel.
        Select {
            label: @tr("Shape of {}", data.name);
            options: [@tr("Rectangle"), @tr("Circle"), @tr("Ellipse"), @tr("Triangle"), @tr("Arrow")];
            index: data.shape;
            enabled: !data.locked;
            selected(i) => {
                Studio.set-source-style(data.id, i, i == 0 ? data.radius : 0, data.border, data.border-width, data.border-color, 0);
            }
        }
    }
    Shown {
        shown: data.shape == 0;
        Field {
            label: @tr("Corner radius");
            NumberField {
                label: @tr("Corner radius of {}", data.name);
                value: data.radius;
                enabled: !data.locked;
                edited(v) => {
                    Studio.set-source-style(data.id, 0, max(v, 0), data.border, data.border-width, data.border-color, self.gesture);
                }
            }
        }
    }
    Hint {
        text: data.shape == 1
            ? @tr("The largest circle that fits in the box, centred. Make the box square for a full circle of the picture.")
            : data.shape == 2 ? @tr("The ellipse that fills the box.")
            : data.shape == 3 ? @tr("The tip is the top edge of the box. Flip the source to point it the other way.")
            : data.shape == 4 ? @tr("The arrow points at the right edge of the box. Flip the source to point it the other way.")
            : @tr("In canvas pixels. 0 keeps square corners; half the shorter side makes round ends.");
    }
    // A colour source can be an outline. The colour stays, so turning Fill back on
    // restores it. Off with no border would draw nothing, so the host adds a border.
    if data.solid: FillLine { data: root.data; }
    if data.solid: Rectangle {
        horizontal-stretch: 1;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    Checkbox {
        text: @tr("Border");
        checked: data.border;
        enabled: !data.locked;
        toggled(on) => {
            Studio.set-source-style(data.id, data.shape, data.radius, on, data.border-width, data.border-color, 0);
        }
    }
    Shown {
        shown: data.border;
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Field {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Width");
                NumberField {
                    label: @tr("Border width of {}", data.name);
                    value: data.border-width;
                    enabled: !data.locked;
                    edited(v) => {
                        if v > 0 {
                            Studio.set-source-style(data.id, data.shape, data.radius, true, v, data.border-color, self.gesture);
                        }
                    }
                }
            }
            Field {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Colour");
                HorizontalLayout {
                    spacing: Tokens.size-field-gap;
                    // The colour as a swatch that opens the colour picker, beside its
                    // text (never colour alone, U7).
                    picker := ColorPicker {
                        label: @tr("Choose the border colour of {}", data.name);
                        value: data.border-swatch;
                        enabled: !data.locked;
                        picked(c) => {
                            if c != data.border-color {
                                Studio.set-source-style(data.id, data.shape, data.radius, true, data.border-width, c, 0);
                            }
                        }
                    }
                    colour := TextField {
                        label: @tr("Border colour of {}", data.name);
                        text: data.border-color;
                        enabled: !data.locked;
                        accepted(t) => {
                            if t != data.border-color {
                                Studio.set-source-style(data.id, data.shape, data.radius, true, data.border-width, t, 0);
                            }
                            // A refused colour goes back to the one that stands; an
                            // accepted one arrives through `colour-text`.
                            self.text = data.border-color;
                        }
                    }
                }
            }
        }
        Hint {
            text: @tr("Drawn inside the edge, so the box stays the same. Colour as #rrggbb, or #rrggbbaa with transparency.");
        }
    }
}

// Flip, rotate, fit and centre a picture (ADR-0084), under its position and size. Every
// button is one undo step.
component ArrangeFields inherits Section {
    in property <SourceData> data;
    property <bool> known: data.pic-w > 0;
    title: @tr("Flip, rotate & fit");
    id: "properties.arrange";
    hint: data.locked
        ? @tr("Unlock the source to change its transform.")
        : @tr("Drag the rotation, or turn by 90 with the buttons.");
    // Icon-only buttons: two short rows (ADR-0084). Center H/V stay in the menus so
    // this section does not grow.
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        alignment: start;
        IconButton {
            icon: IconName.flip-h;
            name: @tr("Flip {} horizontally", data.name);
            checked: data.flip-h;
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 0); }
        }
        IconButton {
            icon: IconName.flip-v;
            name: @tr("Flip {} vertically", data.name);
            checked: data.flip-v;
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 1); }
        }
        IconButton {
            icon: IconName.rotate-ccw;
            name: @tr("Rotate {} 90 degrees counter-clockwise", data.name);
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 3); }
        }
        IconButton {
            icon: IconName.rotate-cw;
            name: @tr("Rotate {} 90 degrees clockwise", data.name);
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 2); }
        }
        IconButton {
            icon: IconName.center;
            name: @tr("Center {} on the canvas", data.name);
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 8); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        alignment: start;
        IconButton {
            icon: IconName.fit;
            name: @tr("Fit {} inside the canvas", data.name);
            enabled: known && !data.locked;
            clicked => { Studio.transform-source(data.id, 5); }
        }
        IconButton {
            icon: IconName.fill-canvas;
            name: @tr("Fill the canvas with {}", data.name);
            enabled: known && !data.locked;
            clicked => { Studio.transform-source(data.id, 6); }
        }
        IconButton {
            icon: IconName.stretch;
            name: @tr("Stretch {} to the canvas", data.name);
            enabled: known && !data.locked;
            clicked => { Studio.transform-source(data.id, 7); }
        }
        IconButton {
            icon: IconName.reset;
            name: @tr("Reset the transform of {}", data.name);
            enabled: known && !data.locked;
            clicked => { Studio.transform-source(data.id, 9); }
        }
    }
    // Under the buttons: drag sets the angle. The number is the value, not a field.
    // One drag is one undo step.
    property <int> spin: 0;
    property <float> shown: -1;
    property <float> from: 0;
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Slider {
            horizontal-stretch: 1;
            label: @tr("Rotation of {}", data.name);
            value: (root.shown >= 0 ? root.shown : data.rotation) / 360;
            value-text: round(root.shown >= 0 ? root.shown : data.rotation) + "°";
            // One degree. Shift moves ten.
            step: 1.0 / 360;
            enabled: !data.locked;
            moved(v) => {
                if root.spin == 0 {
                    root.from = data.rotation;
                    Studio.gesture-serial += 1;
                    root.spin = Studio.gesture-serial;
                }
                root.shown = v * 360;
                Studio.set-source-rotation(data.id, root.shown, root.spin);
            }
            released => { root.shown = -1; root.spin = 0; }
            cancelled => {
                if root.spin != 0 { Studio.set-source-rotation(data.id, root.from, root.spin); }
                root.shown = -1;
                root.spin = 0;
            }
            reset => {
                Studio.gesture-serial += 1;
                Studio.set-source-rotation(data.id, 0, Studio.gesture-serial);
            }
        }
        Text {
            min-width: Tokens.size-control-lg * 2;
            text: round(root.shown >= 0 ? root.shown : data.rotation) + "°";
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// Two crop shortcuts side by side, sharing the line; one under the other when the
// panel is too narrow for both labels, so nothing is cut off (U11).
component RegionPair inherits Rectangle {
    in property <SourceData> data;
    in property <bool> enabled;
    in property <string> first;
    in property <string> first-name;
    in property <int> first-region;
    in property <string> second;
    in property <string> second-name;
    in property <int> second-region;
    property <bool> stacked: root.width < one.min-width + Tokens.size-field-gap + two.min-width;
    property <length> half: (root.width - Tokens.size-field-gap) / 2;
    min-width: max(one.min-width, two.min-width);
    height: root.stacked ? one.height + Tokens.size-field-gap + two.height : one.height;
    one := Button {
        x: 0px;
        y: 0px;
        width: root.stacked ? root.width : root.half;
        text: root.first;
        kind: "secondary";
        enabled: root.enabled;
        accessible-name: root.first-name;
        clicked => { Studio.set-source-region(root.data.id, root.first-region); }
    }
    two := Button {
        x: root.stacked ? 0px : root.half + Tokens.size-field-gap;
        y: root.stacked ? one.height + Tokens.size-field-gap : 0px;
        width: root.stacked ? root.width : root.half;
        text: root.second;
        kind: "secondary";
        enabled: root.enabled;
        accessible-name: root.second-name;
        clicked => { Studio.set-source-region(root.data.id, root.second-region); }
    }
}

// Crop of a picture in source pixels (ADR-0058), under its position and size. Every
// change is one undo step and keeps the picture's scale; the Region buttons show a part
// of the picture as large as the canvas allows.
component CropFields inherits Section {
    in property <SourceData> data;
    property <bool> known: data.pic-w > 0;
    property <bool> can-edit: known && !data.locked;
    title: @tr("Crop");
    id: "properties.crop";
    hint: data.locked
        ? @tr("Unlock the source to change its crop.")
        : known
        ? @tr("In pixels of the {}x{} picture. The box changes so the picture keeps its scale. Alt-drag a handle on the picture panel to crop there.", data.pic-w, data.pic-h)
        : @tr("Available once the source shows a picture.");
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Left");
            label: @tr("Crop left of {}", data.name);
            value: data.crop-l;
            enabled: can-edit;
            edited(v) => { Studio.set-source-crop(data.id, max(v, 0), data.crop-t, data.crop-r, data.crop-b, self.gesture); }
        }
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Right");
            label: @tr("Crop right of {}", data.name);
            value: data.crop-r;
            enabled: can-edit;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, data.crop-t, max(v, 0), data.crop-b, self.gesture); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Top");
            label: @tr("Crop top of {}", data.name);
            value: data.crop-t;
            enabled: can-edit;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, max(v, 0), data.crop-r, data.crop-b, self.gesture); }
        }
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Bottom");
            label: @tr("Crop bottom of {}", data.name);
            value: data.crop-b;
            enabled: can-edit;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, data.crop-t, data.crop-r, max(v, 0), self.gesture); }
        }
    }
    Text {
        text: @tr("Show");
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        accessible-role: none;
    }
    RegionPair {
        data: root.data;
        enabled: can-edit;
        first: @tr("Canvas size");
        first-name: @tr("Show the centre of {} at canvas size", data.name);
        first-region: 1;
        second: @tr("Whole picture");
        second-name: @tr("Show all of {}, fitted to the canvas", data.name);
        second-region: 0;
    }
    RegionPair {
        data: root.data;
        enabled: can-edit;
        first: @tr("Left half");
        first-name: @tr("Show the left half of {}", data.name);
        first-region: 2;
        second: @tr("Right half");
        second-name: @tr("Show the right half of {}", data.name);
        second-region: 3;
    }
}

// The Transform tab: where the picture is on the canvas, its crop, shape and border.
component TransformFields inherits VerticalLayout {
    in property <SourceData> data;
    spacing: Tokens.size-section-gap;
    alignment: start;
    if data.picture: Section {
        title: @tr("Position and size");
        id: "properties.position";
        hint: data.locked
            ? @tr("Unlock the source to change its position and size.")
            : @tr("In canvas pixels, from the top-left corner. Up and Down arrows change a value by 1, with Shift by 10.");
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            // Equal columns, whatever the values' lengths.
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("X");
                label: @tr("Position X of {}", data.name);
                value: data.x;
                enabled: !data.locked;
                edited(v) => { Studio.set-source-box(data.id, v, data.y, data.w, data.h, self.gesture); }
            }
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("Y");
                label: @tr("Position Y of {}", data.name);
                value: data.y;
                enabled: !data.locked;
                edited(v) => { Studio.set-source-box(data.id, data.x, v, data.w, data.h, self.gesture); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("W");
                label: @tr("Width of {}", data.name);
                value: data.w;
                enabled: !data.locked;
                edited(v) => { Studio.set-source-box(data.id, data.x, data.y, v, data.h, self.gesture); }
            }
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("H");
                label: @tr("Height of {}", data.name);
                value: data.h;
                enabled: !data.locked;
                edited(v) => { Studio.set-source-box(data.id, data.x, data.y, data.w, v, self.gesture); }
            }
        }
    }
    if data.picture: ArrangeFields { data: data; }
    if data.picture: CropFields { data: data; }
    if data.picture: StyleFields { data: data; }
}

// One filter in the chain: its on/off Checkbox named after it, then Move up, Move down
// and Remove. A click on the row selects it, so its fields show below the list.
component FilterRowView inherits Rectangle {
    in property <SourceData> source;
    in property <FilterData> data;
    in property <int> index;
    in property <bool> selected;
    // The Library asks for a gear that opens this filter in Properties. The Filters
    // tab leaves it off: the fields are already under the row.
    in property <bool> jump: false;
    callback open-settings();
    horizontal-stretch: 1;
    height: row.height;
    row := ListRow {
        width: parent.width;
        name: data.name;
        note: data.known ? "" : @tr("Not available in this version");
        has-check: data.known;
        checked: data.enabled;
        check-label: @tr("Turn {} on or off", data.name);
        check-toggled(on) => {
            Studio.select-filter(source.id, data.id);
            Studio.set-filter-enabled(data.id, on);
        }
        selected: root.selected;
        accessible-name: @tr("{}, {}", data.name, data.enabled ? @tr("on") : @tr("off"));
        accessible-hint: @tr("Return shows its settings, Delete asks before removing it");
        // Remove asks first, in the row (the same trash and close icons as a source row).
        confirm-question: @tr("Remove {}?", data.name);
        confirm-name: @tr("Remove {}", data.name);
        activated => { Studio.select-filter(source.id, data.id); }
        delete-asked => { self.confirm = true; }
        confirmed => { Studio.remove-filter(data.id); }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.chevron-up;
                name: @tr("Move {} up", data.name);
                enabled: data.can-up;
                clicked => { Studio.move-filter(data.id, index - 1); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.chevron-down;
                name: @tr("Move {} down", data.name);
                enabled: data.can-down;
                clicked => { Studio.move-filter(data.id, index + 1); }
            }
        }
        if root.jump: VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.gear;
                name: @tr("Open settings for {}", data.name);
                clicked => { root.open-settings(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.close;
                name: @tr("Remove {}", data.name);
                clicked => { row.focus-pointer(); row.confirm = true; }
            }
        }
    }
}

// One field of the selected filter, generated from its type's schema.
component FilterFieldView inherits VerticalLayout {
    in property <SourceData> source;
    in property <FilterData> filter;
    in property <FilterFieldData> data;
    in property <int> index;
    // The position the slider shows instead of the stored one: during a drag, and after
    // it until the host stores the value (`waiting`), so the value beside the slider
    // follows the pointer and does not flick back on release.
    property <float> held: -1;
    property <bool> waiting;
    property <bool> shown: held >= 0;
    // The stored value arrived (or changed elsewhere, such as undo): show it again.
    changed data => {
        if root.waiting { root.held = -1; root.waiting = false; }
    }
    // The value at a slider position, as the host stores it (on its step).
    function text-at(p: float) -> string {
        let q = max(0, min(1, p));
        let raw = data.log ? data.min * Math.pow(data.max / data.min, q) : data.min + q * (data.max - data.min);
        let v = data.snap > 0 ? max(data.min, min(data.max, data.min + round((raw - data.min) / data.snap) * data.snap)) : raw;
        // From 1 kHz up in kHz, as the host writes it (`number_text`).
        if data.suffix == " Hz" && abs(v) >= 1000 {
            return (v / 1000).to-fixed(abs(v) < 10000 ? 2 : 1) + " kHz";
        }
        return v.to-fixed(data.decimals) + data.suffix;
    }
    property <string> colour-text: data.colour;
    changed colour-text => { colour.text = colour-text; }
    spacing: Tokens.space-1;
    // The label line: name, (i), and at its right end the reset button while the value
    // differs from the default (owner decision 2026-11-14). The line keeps the button's
    // height either way, so the field does not move when the button comes and goes.
    HorizontalLayout {
        spacing: Tokens.space-1;
        min-height: Tokens.size-control-sm;
        if data.kind != 5: Text {
            text: data.label;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            accessible-role: none;
        }
        // A switch is the label line itself (a setting is a Toggle, ui-review item 18).
        if data.kind == 5: Toggle {
            label: @tr("{} of {}", data.label, filter.name);
            text: data.label;
            checked: data.choice == 1;
            enabled: filter.known;
            toggled(on) => { Studio.set-filter-option(filter.id, index, on ? 1 : 0); }
        }
        if data.help != "": InfoHint { label: data.label; text: data.help; }
        Rectangle { horizontal-stretch: 1; }
        if data.changed && filter.known: IconButton {
            icon: IconName.reset;
            name: @tr("Reset {} to {}", data.label, data.default-text);
            clicked => { root.held = -1; root.waiting = false; Studio.reset-filter-field(filter.id, index); }
        }
    }
    // The standard slider row (the Mixer's volume, Settings > Audio): the track takes
    // every pixel the fixed-width ValueReadout leaves.
    if data.kind == 0: HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Slider {
            horizontal-stretch: 1;
            label: @tr("{} of {}", data.label, filter.name);
            value: shown ? held : data.position;
            value-text: shown ? root.text-at(held) : data.value-text;
            step: data.step;
            enabled: filter.known;
            moved(v) => {
                root.held = v;
                root.waiting = false;
                Studio.preview-filter(filter.id, index, v);
            }
            // Keep showing the released position until the stored value comes back,
            // so the knob does not jump to the old value and then to the new one.
            released => {
                root.waiting = root.held >= 0;
                Studio.commit-filter(filter.id);
            }
            cancelled => {
                root.held = -1;
                root.waiting = false;
                Studio.cancel-filter(filter.id);
            }
            reset => {
                if data.changed {
                    root.held = -1;
                    root.waiting = false;
                    Studio.reset-filter-field(filter.id, index);
                }
            }
        }
        ValueReadout { text: shown ? root.text-at(held) : data.value-text; }
    }
    Shown {
        shown: data.kind == 1;
        HorizontalLayout {
            spacing: Tokens.space-2;
            ColorPicker {
                label: @tr("Choose the {} of {}", data.label, filter.name);
                value: data.swatch;
                picked(c) => {
                    if c != data.colour { Studio.set-filter-colour(filter.id, index, c); }
                }
            }
            colour := TextField {
                horizontal-stretch: 1;
                label: @tr("{} of {}", data.label, filter.name);
                text: data.colour;
                accepted(t) => {
                    if t != data.colour { Studio.set-filter-colour(filter.id, index, t); }
                    self.text = data.colour;
                }
            }
        }
    }
    // A source of the collection (a ducker's key): "None", then the other sound sources.
    Shown {
        shown: data.kind == 3;
        Select {
            label: @tr("{} of {}", data.label, filter.name);
            options: data.options;
            index: data.choice;
            placeholder: @tr("Not in this scene");
            selected(i) => { Studio.set-filter-source(filter.id, index, i); }
        }
    }
    // One of a fixed list: side by side up to three options, else a dropdown.
    if data.kind == 4 && data.options.length <= 3: SegmentedControl {
        label: @tr("{} of {}", data.label, filter.name);
        options: data.options;
        index: data.choice;
        enabled: filter.known;
        selected(i) => { if i != data.choice { Studio.set-filter-option(filter.id, index, i); } }
    }
    if data.kind == 4 && data.options.length > 3: Select {
        label: @tr("{} of {}", data.label, filter.name);
        options: data.options;
        index: data.choice;
        enabled: filter.known;
        selected(i) => { if i != data.choice { Studio.set-filter-option(filter.id, index, i); } }
    }
}

// Add filter: a button that opens the filter types by name as a CommandMenu (ADR-0094
// rule B1). The new filter goes at the end of the chain and is selected.
component AddFilterButton inherits Rectangle {
    in property <SourceData> source;
    // The audio filter types instead of the picture ones (the Audio tab).
    in property <bool> audio;
    height: Tokens.size-control-md;
    Button {
        width: root.width;
        height: root.height;
        text: @tr("Add filter");
        accessible-name: @tr("Add a filter to {}", source.name);
        lead: IconName.plus;
        icon: IconName.chevron-down;
        clicked => { menu.open-from({ x: 0px, y: root.height }, root.width, root.height); }
    }
    menu := CommandMenu {
        context: "add-filter";
        target: "source=" + source.id + (root.audio ? "&audio=1" : "");
    }
}

// The equaliser's response, 20 Hz to 20 kHz on a log scale and -24 to +24 dB, drawn
// from its settings (ADR-0130 decision 10). The 0 dB line and the 100 Hz, 1 kHz and
// 10 kHz lines are its scale. The curve is the settings, not a live measurement.
component EqCurve inherits Rectangle {
    in property <FilterData> filter;
    height: Tokens.size-eq-curve-h;
    background: Theme.surface-sunken;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    border-radius: Tokens.radius-sm;
    clip: true;
    accessible-role: image;
    accessible-label: @tr("Response of {}: {}", filter.name, filter.curve-text);
    Rectangle {
        y: (parent.height - Tokens.size-border) / 2;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    // 100 Hz, 1 kHz and 10 kHz: 1, 2 and 3 decades above 20 Hz is log10(5), 1 + log10(5)
    // and 2 + log10(5) of the three decades the width spans.
    for mark[i] in [{ at: 0.2330, text: "100" }, { at: 0.5663, text: "1k" }, { at: 0.8997, text: "10k" }]: Rectangle {
        x: parent.width * mark.at;
        width: Tokens.size-border;
        background: Theme.border-subtle;
    }
    // The labels sit on the curve's background, left of their lines, not on the lines.
    for mark[i] in [{ at: 0.2330, text: "100" }, { at: 0.5663, text: "1k" }, { at: 0.8997, text: "10k" }]: Text {
        x: parent.width * mark.at - self.width - Tokens.space-1;
        y: Tokens.space-1;
        width: self.preferred-width;
        text: mark.text;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    Path {
        width: parent.width;
        height: parent.height;
        commands: Studio.fit-path(filter.curve, 100, 48, self.width / 1px, self.height / 1px);
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: Theme.accent;
        stroke-width: Tokens.size-eq-curve-line;
        accessible-role: none;
    }
}

// The live level of a noise gate (ADR-0082): the input level as a bar with the open and
// close thresholds as lines on it, and under it how far the gate is turning the sound down.
// It exists only while the gate's section is open, and so does its 30 Hz timer.
component GateBar inherits VerticalLayout {
    in property <FilterData> filter;
    property <FilterLevels> levels;
    spacing: Tokens.space-1;
    Timer {
        interval: 33ms; // literal: the meters' 30 Hz refresh (U16), not a design value
        running: true;
        triggered => { root.levels = Studio.filter-levels(root.filter.id); }
    }
    Text {
        text: root.filter.bar-label;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    Rectangle {
        height: Tokens.space-3;
        background: Theme.surface-sunken;
        border-width: Tokens.size-border;
        border-color: Theme.border-subtle;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: progress-indicator;
        accessible-label: @tr("Input level of {}", root.filter.name);
        Rectangle { width: parent.width * root.levels.input; background: Theme.meter-low; }
        Rectangle {
            x: max(0px, parent.width * root.filter.close-pos - Tokens.size-meter-peak);
            width: Tokens.size-meter-peak;
            background: Theme.text-secondary;
        }
        Rectangle {
            x: max(0px, parent.width * root.filter.open-pos - Tokens.size-meter-peak);
            width: Tokens.size-meter-peak;
            background: Theme.accent;
        }
    }
    Text {
        text: @tr("Gain reduction");
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    Rectangle {
        height: Tokens.space-1;
        background: Theme.surface-sunken;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: progress-indicator;
        accessible-label: @tr("Gain reduction of {}", root.filter.name);
        Rectangle { width: parent.width * root.levels.reduction; background: Theme.meter-mid; }
    }
}

// The Filters tab: the chain in order, Add filter, and the selected filter's fields.
component FiltersFields inherits VerticalLayout {
    in property <SourceData> data;
    // The Filters section of the Audio tab (ADR-0082): audio filter types, and a note
    // about the short dip when the chain's tail changes.
    in property <bool> audio;
    spacing: Tokens.size-field-gap;
    alignment: start;
    if !audio: SectionTitle { title: @tr("Filters"); }
    if data.filters.length == 0: Rectangle {
        height: empty.preferred-height;
        empty := EmptyState {
            width: parent.width;
            title: @tr("No filters");
            message: audio ? @tr("Add filter to raise or lower the level of this source or to gate out its background noise.") : @tr("Add filter to change colours, key out a green screen, blur or sharpen this source.");
        }
    }
    for f[i] in data.filters: FilterRowView {
        source: data;
        data: f;
        index: i;
        selected: f.id == data.selected-filter;
    }
    HorizontalLayout {
        spacing: Tokens.space-1;
        AddFilterButton { source: data; audio: audio; horizontal-stretch: 1; }
        if audio: InfoHint {
            label: @tr("Changing filters");
            text: @tr("Adding, removing or reordering a filter can cause a brief dip (10 to 20 ms) in this source's sound. Changing a setting never does.");
        }
    }
    for f[i] in data.filters: VerticalLayout {
        spacing: Tokens.size-field-gap;
        if f.id == data.selected-filter && f.known: VerticalLayout {
            spacing: Tokens.size-field-gap;
            LookAnchor { }
            FeatureSection {
                title: f.name;
                id: "properties.filter-settings";
                has-toggle: false;
                // The delay a latent filter adds and whether the input took it back
                // (ADR-0130 decision 10; owner decision 2026-11-16: under the title).
                if f.latency-text != "": Text {
                    text: f.latency-text;
                    color: f.latency-warn ? Theme.state-warning : Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    wrap: word-wrap;
                }
                if f.gate: GateBar { filter: f; }
                if f.curve != "": EqCurve { filter: f; }
                for field[j] in f.fields: FilterFieldView {
                    source: data;
                    filter: f;
                    data: field;
                    index: j;
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        lead: IconName.reset;
                        text: @tr("Reset to defaults");
                        kind: "secondary";
                        accessible-name: @tr("Reset {} to defaults", f.name);
                        clicked => { Studio.reset-filter(f.id); }
                    }
                }
            }
        }
    }
}

// The sound of a source and its sync offset: the Audio tab (ADR-0059, ADR-0062).
// Volume, mute and the offset are live controls, not undo steps.
component AudioFields inherits VerticalLayout {
    in property <SourceData> data;
    spacing: Tokens.size-section-gap;
    alignment: start;
    Section {
        title: @tr("Sound");
        id: "properties.sound";
        // Position 1 is 0 dB, the top of the fader and the default. In Own levels
        // (ADR-0091) the scene's level is edited: reset gives the source's own back.
        changed: data.scene-level ? data.scene-entry : data.volume < 1;
        default-text: data.scene-level ? @tr("the source's level, {}", data.own-volume-text) : @tr("0 dB");
        reset => {
            if data.scene-level { Studio.reset-scene-level(data.id); } else { Studio.set-source-volume(data.id, 1); }
        }
        hint: data.scene-level ? @tr("{} keeps its own levels. This volume and mute apply only to that scene.", Studio.scene-levels) : "";
        // Whose level this is, while the scene on air keeps its own (ADR-0091).
        if data.scene-level: HorizontalLayout {
            spacing: Tokens.space-1;
            VerticalLayout {
                alignment: center;
                Icon { name: IconName.sliders; ink: Theme.accent; }
            }
            Text {
                text: @tr("Level of the scene {}", Studio.scene-levels);
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            alignment: stretch;
            // Slot takes every leftover pixel; the readout stays a fixed token width on the right.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                height: Tokens.size-control-sm;
                Slider {
                    width: parent.width;
                    height: parent.height;
                    label: @tr("Volume of {}", data.name);
                    value: data.volume;
                    value-text: data.volume-text;
                    enabled: !data.muted;
                    moved(v) => { Studio.set-source-volume(data.id, v); }
                }
            }
            ValueReadout {
                horizontal-stretch: 0;
                text: data.volume-text;
                color: data.muted ? Theme.text-disabled : Theme.text-secondary;
                accessible-label: @tr("Volume of {}, {}", data.name, data.volume-text);
            }
        }
        Checkbox {
            text: @tr("Mute");
            checked: data.muted;
            toggled(on) => { Studio.set-source-muted(data.id, on); }
        }
    }
    Section {
        title: @tr("Sync offset");
        id: "properties.sync";
        changed: data.sync-offset != 0;
        default-text: @tr("0 ms");
        reset => { Studio.sync-offer-for = data.id; Studio.set-source-sync-offset(data.id, 0); }
        hint: @tr("Delays this source's sound (positive) or plays it earlier (negative) to match the picture, from -200 to 200 ms. Playing it earlier is limited by the audio latency. Measure finds the value from claps the camera sees. A microphone remembers its value on this computer.");
        VerticalLayout {
            spacing: Tokens.size-field-gap;
            HorizontalLayout {
                spacing: Tokens.size-field-gap;
                NumberField {
                    live: false;
                    horizontal-stretch: 1;
                    preferred-width: 0;
                    label: @tr("Sync offset of {} in milliseconds", data.name);
                    unit: @tr("ms");
                    value: data.sync-offset;
                    step: 10;
                    edited(v) => { Studio.sync-offer-for = data.id; Studio.set-source-sync-offset(data.id, round(max(-200, min(200, v)))); }
                }
                Button {
                    text: @tr("Measure");
                    lead: IconName.wand;
                    clicked => { Studio.open-sync-measure(data.id); }
                }
            }
            if Studio.sync-offer-for == data.id && data.peer-count > 0: HorizontalLayout {
                spacing: Tokens.size-field-gap;
                Text {
                    horizontal-stretch: 1;
                    text: data.peer-count == 1 ? @tr("{} uses this microphone with another offset.", data.device-peers) : @tr("{} use this microphone with another offset.", data.device-peers);
                    color: Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                Button {
                    text: data.peer-count == 1 ? @tr("Apply to 1 source") : @tr("Apply to {} sources", data.peer-count);
                    clicked => { Studio.apply-sync-to-device-sources(data.id); }
                }
            }
        }
    }
    // Separate files (ADR-0086): a sound source's row is on the Audio tab; a picture
    // source's is below the tabs (SourceProperties).
    if !data.picture: Section {
        title: @tr("Recording");
        id: "properties.recording";
        hint: @tr("Writes this source's sound to its own WAV file, in a folder with the recording. Changes apply to the next recording.");
        Toggle {
            label: @tr("Record {} separately", data.name);
            text: @tr("Record separately");
            checked: data.record-separately;
            toggled(v) => { Studio.set-source-record-separately(data.id, v); }
        }
        if Studio.rec-state == 2 && data.record-separately: Text {
            text: @tr("Applies to the next recording.");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            wrap: word-wrap;
        }
    }
    // Audio filters belong to a source with only sound (ADR-0082).
    if !data.picture: Section {
        title: @tr("Filters");
        id: "properties.audio-filters";
        FiltersFields { data: data; audio: true; }
    }
}

// The Source tab: what the source captures now, and a list to point it at another target
// (ADR-0077). Reload tries a source that is not running again.
component SourceFields inherits VerticalLayout {
    in property <SourceData> data;
    property <int> source-id: data.id;
    spacing: Tokens.size-field-gap;
    init => { Studio.list-source-targets(data.id); }
    changed source-id => { Studio.list-source-targets(data.id); }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        if !data.ok: VerticalLayout {
            alignment: center;
            Icon { name: IconName.warning; ink: Theme.state-warning; }
        }
        Text {
            horizontal-stretch: 1;
            text: data.status;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
    }
    // Refused access (ADR-0141 decision 8; here, never in the Sources list): Allow
    // shows the system's question, Fix permission opens Settings › Permissions.
    if data.perm-action != 0: HorizontalLayout {
        alignment: start;
        if data.perm-action == 1: Button {
            text: @tr("Allow");
            accessible-name: @tr("Allow access for {}", data.name);
            kind: "primary";
            dense: true;
            clicked => { Studio.permission-action(data.perm-kind, 1); }
        }
        if data.perm-action == 2: Button {
            lead: IconName.lock;
            text: @tr("Fix permission");
            accessible-name: @tr("Fix permission for {}", data.name);
            dense: true;
            clicked => { Studio.open-permission-settings(); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        alignment: start;
        Button {
            lead: IconName.refresh;
            text: @tr("Reload");
            accessible-name: @tr("Reload {}", data.name);
            dense: true;
            clicked => { Studio.reload-source(data.id); }
        }
        if !data.media: Button {
            lead: IconName.refresh;
            text: @tr("Refresh list");
            dense: true;
            clicked => { Studio.list-source-targets(data.id); }
        }
    }
    // A media file: the file, Loop and Restart when shown (ADR-0108), each one undo step.
    if data.media: Field {
        label: @tr("File");
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Text {
                horizontal-stretch: 1;
                text: data.media-path;
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                lead: IconName.folder;
                text: @tr("Change…");
                accessible-name: @tr("Choose another file for {}", data.name);
                dense: true;
                clicked => { Studio.change-media-file(data.id); }
            }
        }
    }
    // Loop and Restart when shown side by side (owner 2026-11-17); the second goes
    // under the first when the panel is too narrow for both.
    if data.media: Rectangle {
        property <length> gap: Tokens.space-4;
        property <bool> one-line: self.width >= loop.preferred-width + self.gap + restart.preferred-width;
        min-height: self.one-line ? max(loop.preferred-height, restart.preferred-height)
            : loop.preferred-height + Tokens.size-field-gap + restart.preferred-height;
        max-height: self.min-height;
        loop := Toggle {
            x: 0px;
            y: 0px;
            width: self.preferred-width;
            height: self.preferred-height;
            text: @tr("Loop");
            label: @tr("Loop {}", data.name);
            checked: data.media-loop;
            toggled(on) => { Studio.set-media-loop(data.id, on); }
        }
        restart := Toggle {
            x: parent.one-line ? loop.preferred-width + parent.gap : 0px;
            y: parent.one-line ? 0px : loop.preferred-height + Tokens.size-field-gap;
            width: min(self.preferred-width, parent.width - self.x);
            height: self.preferred-height;
            text: @tr("Restart when shown");
            label: @tr("Restart {} when shown", data.name);
            checked: data.media-restart;
            toggled(on) => { Studio.set-media-restart-when-shown(data.id, on); }
        }
    }
    // The play range (ADR-0108 decision 11): set from the playback position, as an
    // editor's in and out points (I and O on the position slider do the same). Each
    // press is one undo step.
    if data.media: Field {
        label: @tr("Play range");
        VerticalLayout {
            spacing: Tokens.size-field-gap;
            Text {
                text: data.media-start-ms == 0 && data.media-end-ms < 0 ? @tr("Whole file")
                    : Studio.media-mark(data.media-start-ms) + " – "
                        + (data.media-end-ms < 0 ? @tr("end of file") : Studio.media-mark(data.media-end-ms));
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: Tokens.size-field-gap;
                alignment: start;
                Button {
                    text: @tr("Start here");
                    accessible-name: @tr("Start the play range of {} at {}", data.name, Studio.media-mark(data.media-pos-ms));
                    dense: true;
                    enabled: data.media-len-ms > 0;
                    clicked => { Studio.set-media-range-mark(data.id, 0, data.media-pos-ms); }
                }
                Button {
                    text: @tr("End here");
                    accessible-name: @tr("End the play range of {} at {}", data.name, Studio.media-mark(data.media-pos-ms));
                    dense: true;
                    enabled: data.media-len-ms > 0 && data.media-pos-ms > 0;
                    clicked => { Studio.set-media-range-mark(data.id, 1, data.media-pos-ms); }
                }
                Button {
                    icon: IconName.reset;
                    text: @tr("Whole file");
                    accessible-name: @tr("Play all of {} again", data.name);
                    dense: true;
                    enabled: data.media-start-ms != 0 || data.media-end-ms >= 0;
                    clicked => { Studio.set-media-range-mark(data.id, 2, 0); }
                }
            }
        }
    }
    // Screens, windows and cameras have more settings (ADR-0077).
    if data.kind-code >= 0 && data.kind-code <= 2: HorizontalLayout {
        alignment: start;
        Button {
            lead: IconName.sliders;
            text: @tr("Source settings…");
            accessible-name: @tr("Open the source settings of {}", data.name);
            dense: true;
            clicked => { Studio.open-source-settings(data.id); }
        }
    }
    // A display or a window can bring its sound along (ADR-0096).
    if data.kind-code == 0 || data.kind-code == 1: HorizontalLayout {
        spacing: Tokens.space-1;
        Checkbox {
            horizontal-stretch: 1;
            text: @tr("Capture audio too");
            checked: data.companion;
            toggled(on) => { Studio.set-companion-audio(data.id, on); }
        }
        InfoHint {
            label: @tr("Capture audio too");
            text: data.kind-code == 0
                ? @tr("Adds the system sound as its own audio source, without RBS's own sound. Capturing the system sound and another app's sound can play the same audio twice.")
                : @tr("Adds this window's application sound as its own audio source. Capturing it and the system sound can play the same audio twice.");
        }
    }
    if !data.media: TextField {
        label: @tr("Search the list");
        placeholder: @tr("Search");
        edited(t) => { Studio.filter-source-targets(t); }
    }
    if !data.media && Studio.source-targets.length == 0: Text {
        text: @tr("Nothing of this type was found.");
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        wrap: word-wrap;
    }
    if !data.media: VerticalLayout {
        spacing: Tokens.space-1;
        for t in Studio.source-targets: VerticalLayout {
            spacing: Tokens.space-1;
            if t.heading != "": Text {
                text: t.heading;
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                font-weight: Tokens.type-label-weight;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Tokens.space-2;
                if t.wants-picture: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: Tokens.size-target-thumb-w;
                        height: Tokens.size-target-thumb-h;
                        border-radius: Tokens.radius-sm;
                        background: Theme.surface-sunken;
                        clip: true;
                        if t.has-picture: Image {
                            source: t.picture;
                            width: 100%;
                            height: 100%;
                            accessible-role: none;
                        }
                        if !t.has-picture: Icon {
                            name: Icons.named(data.icon);
                            ink: Theme.text-secondary;
                        }
                    }
                }
                MenuItem {
                    horizontal-stretch: 1;
                    text: t.name;
                    checked: t.current;
                    activated => { Studio.retarget-source(data.id, t.index); }
                }
            }
        }
    }
}

// A colour as a swatch that opens the colour picker, beside its code (never colour
// alone, U7). The code field is set from `value` whenever it changes, because setting
// the text after an edit ends the field's binding; a refused code goes back.
component ColourEntry inherits HorizontalLayout {
    // The accessible names: the swatch button's and the code field's.
    in property <string> pick-label;
    in property <string> label;
    in property <string> value;
    in property <color> swatch;
    callback picked(string);
    property <string> stands: root.value;
    changed stands => { code.text = root.stands; }
    spacing: Tokens.size-field-gap;
    ColorPicker {
        label: root.pick-label;
        value: root.swatch;
        picked(c) => { if c != root.value { root.picked(c); } }
    }
    code := TextField {
        horizontal-stretch: 1;
        label: root.label;
        text: root.value;
        accepted(t) => {
            if t != root.value { root.picked(t); }
            self.text = root.value;
        }
    }
}

// The pattern of a clock or timer, with what its letters mean behind (i).
component TextFormatField inherits Field {
    in property <TextData> text;
    in property <string> name;
    label: @tr("Format");
    HorizontalLayout {
        spacing: Tokens.space-1;
        TextField {
            horizontal-stretch: 1;
            label: @tr("Format of {}", root.name);
            text: root.text.format;
            placeholder: root.text.format-default;
            accepted(t) => { if t != root.text.format { Studio.set-text-value(root.text.id, "format", t); } }
        }
        VerticalLayout {
            alignment: center;
            InfoHint {
                label: @tr("Format");
                text: @tr("HH hours, mm minutes, ss seconds, dd day, MM month, yyyy year, ddd weekday. Text in quotes is shown as it is. Empty uses {}.", root.text.format-default);
            }
        }
    }
}

// Start, Pause and Reset of a countdown's or a stopwatch's timer (text.timer).
component TimerButtons inherits HorizontalLayout {
    in property <TextData> text;
    in property <string> name;
    spacing: Tokens.space-1;
    alignment: start;
    Button {
        lead: IconName.play;
        text: @tr("Start");
        accessible-name: @tr("Start the timer of {}", root.name);
        dense: true;
        clicked => { Studio.text-timer(root.text.id, 0); }
    }
    Button {
        lead: IconName.pause;
        text: @tr("Pause");
        accessible-name: @tr("Pause the timer of {}", root.name);
        dense: true;
        clicked => { Studio.text-timer(root.text.id, 1); }
    }
    Button {
        lead: IconName.reset;
        text: @tr("Reset");
        accessible-name: @tr("Reset the timer of {}", root.name);
        dense: true;
        clicked => { Studio.text-timer(root.text.id, 2); }
    }
}

// The Text tab of a text source (ADR-0129 decision 13): Kind and its own fields, then
// the font, then Outline, Shadow and Background, each turned on by its switch, and
// Fit box to text. Every change is one undo step and shows at once.
component TextFields inherits VerticalLayout {
    in property <SourceData> data;
    property <TextData> t: Studio.text-props;
    // A section's gap between rows, so a tall tab reads top to bottom (owner 2026-11-17).
    spacing: Tokens.size-section-gap;
    Field {
        label: @tr("Kind");
        Select {
            label: @tr("Kind of {}", data.name);
            options: [@tr("Text"), @tr("Clock"), @tr("Countdown"), @tr("Stopwatch"), @tr("Recording time"), @tr("Stream time")];
            index: t.kind;
            selected(i) => { if i != t.kind { Studio.set-text-kind(t.id, i); } }
        }
    }
    // Text: what it shows, its fields, or a file.
    if t.kind == 0: Field {
        label: @tr("Text");
        TextArea {
            label: @tr("Text of {}", data.name);
            text: t.text;
            enabled: t.file == "";
            placeholder: @tr("Type the text to show");
            accepted(v) => { if v != t.text { Studio.set-text-value(t.id, "text", v); } }
        }
    }
    if t.kind == 0 && t.file == "": HorizontalLayout {
        spacing: Tokens.space-1;
        Toggle {
            horizontal-stretch: 1;
            text: @tr("Fill in fields");
            label: @tr("Fill in fields in {}", data.name);
            checked: t.fields;
            toggled(on) => { Studio.set-text-flag(t.id, "fields", on); }
        }
        VerticalLayout {
            alignment: center;
            InfoHint {
                label: @tr("Fill in fields");
                text: @tr("{{time}}, {{date}}, {{time:HH:mm}}, {{scene}}, {{recording_time}} and {{stream_time}} in the text are replaced by their value while it is shown.");
            }
        }
    }
    if t.kind == 0: Field {
        label: @tr("Read from file");
        HorizontalLayout {
            spacing: Tokens.space-1;
            Text {
                horizontal-stretch: 1;
                text: t.file == "" ? @tr("No file") : t.file-name;
                color: t.file == "" ? Theme.text-secondary : Theme.text-primary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                lead: IconName.folder;
                text: @tr("Choose…");
                accessible-name: @tr("Choose a file for {}", data.name);
                dense: true;
                clicked => { Studio.choose-text-file(t.id); }
            }
            if t.file != "": IconButton {
                icon: IconName.close;
                name: @tr("Stop reading from {}", t.file-name);
                clicked => { Studio.set-text-value(t.id, "file", ""); }
            }
        }
    }
    if t.kind == 0 && t.file != "": Field {
        label: @tr("Lines");
        HorizontalLayout {
            spacing: Tokens.space-1;
            NumberField {
                horizontal-stretch: 1;
                label: @tr("Last lines of the file of {}", data.name);
                value: t.file-lines;
                edited(v) => { Studio.set-text-number(t.id, "file_lines", max(0, round(v)), self.gesture); }
            }
            VerticalLayout {
                alignment: center;
                InfoHint {
                    label: @tr("Lines");
                    text: @tr("Shows the last lines of the file, read again when it changes. 0 shows the whole file.");
                }
            }
        }
    }
    // A countdown: for a length, or until a time of day.
    if t.kind == 2: SegmentedControl {
        label: @tr("Countdown of {}", data.name);
        options: [@tr("For a length"), @tr("Until a time")];
        index: t.until ? 1 : 0;
        selected(i) => { if (i == 1) != t.until { Studio.set-text-countdown(t.id, i == 1, t.target, t.minutes * 60 + t.seconds, 0); } }
    }
    if t.kind == 2 && !t.until: HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Field {
            horizontal-stretch: 1;
            label: @tr("Minutes");
            NumberField {
                label: @tr("Countdown minutes of {}", data.name);
                unit: @tr("min");
                value: t.minutes;
                edited(v) => { Studio.set-text-countdown(t.id, false, t.target, max(0, round(v)) * 60 + t.seconds, self.gesture); }
            }
        }
        Field {
            horizontal-stretch: 1;
            label: @tr("Seconds");
            NumberField {
                label: @tr("Countdown seconds of {}", data.name);
                unit: @tr("s");
                value: t.seconds;
                edited(v) => { Studio.set-text-countdown(t.id, false, t.target, t.minutes * 60 + max(0, min(59, round(v))), self.gesture); }
            }
        }
    }
    if t.kind == 2 && t.until: Field {
        label: @tr("Time of day");
        TextField {
            label: @tr("Time of day {} counts down to", data.name);
            text: t.target;
            placeholder: @tr("HH:mm");
            accepted(v) => { if v != t.target { Studio.set-text-countdown(t.id, true, v, t.minutes * 60 + t.seconds, 0); } }
        }
    }
    if t.kind >= 1: TextFormatField { text: t; name: data.name; }
    if t.kind == 2 || t.kind >= 4: Field {
        label: t.kind == 2 ? @tr("Text at zero") : @tr("Text while stopped");
        TextField {
            label: t.kind == 2 ? @tr("Text of {} at zero", data.name) : @tr("Text of {} while stopped", data.name);
            text: t.end-text;
            placeholder: t.kind == 2 ? "00:00" : "";
            accepted(v) => { if v != t.end-text { Studio.set-text-value(t.id, "end_text", v); } }
        }
    }
    if (t.kind == 2 && !t.until) || t.kind == 3: TimerButtons { text: t; name: data.name; }
    // The font: the searchable picker of the installed families, the system font first.
    Field {
        label: @tr("Font");
        HorizontalLayout {
            alignment: start;
            Button {
                text: t.font == "" ? @tr("System font") : t.font;
                icon: IconName.chevron-down;
                menu: true;
                accessible-name: @tr("Font of {}: {}", data.name, t.font == "" ? @tr("System font") : t.font);
                clicked => { Studio.choose-text-font(t.id); }
            }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Field {
            horizontal-stretch: 1;
            label: @tr("Size");
            NumberField {
                label: @tr("Font size of {} in pixels", data.name);
                unit: @tr("px");
                value: t.size;
                edited(v) => { Studio.set-text-number(t.id, "size", max(1, min(1024, v)), self.gesture); }
            }
        }
        Field {
            horizontal-stretch: 1;
            label: @tr("Colour");
            ColourEntry {
                pick-label: @tr("Choose the text colour of {}", data.name);
                label: @tr("Text colour of {}", data.name);
                value: t.color;
                swatch: t.swatch;
                picked(c) => { Studio.set-text-value(t.id, "color", c); }
            }
        }
    }
    HorizontalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        Checkbox {
            text: @tr("Bold");
            checked: t.bold;
            toggled(on) => { Studio.set-text-number(t.id, "weight", on ? 700 : 400, 0); }
        }
        Checkbox {
            text: @tr("Italic");
            checked: t.italic;
            toggled(on) => { Studio.set-text-flag(t.id, "italic", on); }
        }
    }
    Field {
        label: @tr("Alignment");
        SegmentedControl {
            label: @tr("Alignment of {}", data.name);
            options: [@tr("Left"), @tr("Centre"), @tr("Right")];
            index: t.align;
            selected(i) => {
                if i != t.align { Studio.set-text-value(t.id, "align", i == 0 ? "left" : i == 1 ? "center" : "right"); }
            }
        }
    }
    // Effects: each kept while off; its switch draws it.
    FeatureSection {
        title: @tr("Outline");
        id: "properties.text-outline";
        on: t.outline;
        toggled(on) => { Studio.set-text-effect(t.id, 0, on); }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Field {
                horizontal-stretch: 1;
                label: @tr("Width");
                NumberField {
                    label: @tr("Outline width of {} in pixels", data.name);
                    unit: @tr("px");
                    value: t.outline-width;
                    enabled: t.outline;
                    edited(v) => { Studio.set-text-number(t.id, "outline_width", max(0, min(64, v)), self.gesture); }
                }
            }
            Field {
                horizontal-stretch: 1;
                label: @tr("Colour");
                ColourEntry {
                    pick-label: @tr("Choose the outline colour of {}", data.name);
                    label: @tr("Outline colour of {}", data.name);
                    value: t.outline-color;
                    swatch: t.outline-swatch;
                    picked(c) => { Studio.set-text-value(t.id, "outline_color", c); }
                }
            }
        }
    }
    FeatureSection {
        title: @tr("Shadow");
        id: "properties.text-shadow";
        on: t.shadow;
        toggled(on) => { Studio.set-text-effect(t.id, 1, on); }
        Field {
            label: @tr("Colour");
            ColourEntry {
                pick-label: @tr("Choose the shadow colour of {}", data.name);
                label: @tr("Shadow colour of {}", data.name);
                value: t.shadow-color;
                swatch: t.shadow-swatch;
                picked(c) => { Studio.set-text-value(t.id, "shadow_color", c); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Field {
                horizontal-stretch: 1;
                label: @tr("X");
                NumberField {
                    label: @tr("Shadow offset of {} to the right in pixels", data.name);
                    unit: @tr("px");
                    value: t.shadow-x;
                    enabled: t.shadow;
                    edited(v) => { Studio.set-text-number(t.id, "shadow_x", max(-256, min(256, v)), self.gesture); }
                }
            }
            Field {
                horizontal-stretch: 1;
                label: @tr("Y");
                NumberField {
                    label: @tr("Shadow offset of {} downwards in pixels", data.name);
                    unit: @tr("px");
                    value: t.shadow-y;
                    enabled: t.shadow;
                    edited(v) => { Studio.set-text-number(t.id, "shadow_y", max(-256, min(256, v)), self.gesture); }
                }
            }
            Field {
                horizontal-stretch: 1;
                label: @tr("Blur");
                NumberField {
                    label: @tr("Shadow blur of {} in pixels", data.name);
                    unit: @tr("px");
                    value: t.shadow-blur;
                    enabled: t.shadow;
                    edited(v) => { Studio.set-text-number(t.id, "shadow_blur", max(0, min(64, v)), self.gesture); }
                }
            }
        }
    }
    FeatureSection {
        title: @tr("Background");
        id: "properties.text-background";
        on: t.background;
        toggled(on) => { Studio.set-text-effect(t.id, 2, on); }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Field {
                horizontal-stretch: 1;
                label: @tr("Colour");
                ColourEntry {
                    pick-label: @tr("Choose the background colour of {}", data.name);
                    label: @tr("Background colour of {}", data.name);
                    value: t.background-color;
                    swatch: t.background-swatch;
                    picked(c) => { Studio.set-text-value(t.id, "background", c); }
                }
            }
            Field {
                horizontal-stretch: 1;
                label: @tr("Padding");
                NumberField {
                    label: @tr("Background padding of {} in pixels", data.name);
                    unit: @tr("px");
                    value: t.padding;
                    enabled: t.background;
                    edited(v) => { Studio.set-text-number(t.id, "padding", max(0, min(1024, v)), self.gesture); }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        Button {
            lead: IconName.fit;
            text: @tr("Fit box to text");
            accessible-name: @tr("Fit the box of {} to its text", data.name);
            tooltip: @tr("Makes the box just big enough for the text, so nothing is cut or shrunk.");
            dense: true;
            clicked => { Studio.fit-text-box(t.id); }
        }
    }
}

// The playback of the selected media file: Play or Pause, Restart, its state in words,
// and a scrubber with the time. The scrubber seeks when let go; Left and Right on it
// step 5 s. While the program is on air and the file is on it, the on-air mark says a
// press changes what goes out (U4).
component MediaPlayback inherits Section {
    in property <SourceData> data;
    in property <int> live-state;
    property <bool> playing: data.media-state == 0;
    property <bool> on-air: live-state != 0 && (data.media-state == 0 || data.media-state == 1 || data.media-state == 3);
    property <bool> scrubbing;
    property <float> scrub;
    property <float> shown: scrubbing ? scrub
        : data.media-len-ms > 0 ? data.media-pos-ms / data.media-len-ms : 0;
    // The time shown: the scrubber's while it is dragged, else the cursor's.
    property <int> at-ms: scrubbing ? Math.round(scrub * data.media-len-ms) : data.media-pos-ms;
    title: @tr("Playback");
    id: "properties.playback";
    hint: @tr("Play, pause and seek act at once and are not undo steps. A file that is only in the preview scene waits and plays when it goes on air. On the position slider, I sets where the play range starts and O where it ends.");
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        alignment: start;
        Button {
            lead: root.playing ? IconName.pause : IconName.play;
            text: root.playing ? @tr("Pause") : @tr("Play");
            accessible-name: root.playing ? @tr("Pause {}", data.name) : @tr("Play {}", data.name);
            kind: "primary";
            dense: true;
            enabled: data.media-state != 5;
            clicked => { Studio.media-play-pause(data.id); }
        }
        Button {
            lead: IconName.refresh;
            text: @tr("Restart");
            accessible-name: @tr("Play {} from the start", data.name);
            dense: true;
            enabled: data.media-state != 5;
            clicked => { Studio.media-restart(data.id); }
        }
        if root.on-air: VerticalLayout {
            alignment: center;
            Rectangle {
                width: on-air-text.preferred-width + 2 * Tokens.space-2;
                height: Tokens.type-caption-line;
                border-radius: self.height / 2;
                background: Theme.state-live;
                on-air-text := Text {
                    text: @tr("On air");
                    color: Theme.text-on-live;
                    font-size: Tokens.type-caption-size;
                    font-weight: Tokens.type-label-weight;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        // I and O on the position slider set the play range's start and end, as an
        // editor's in and out points (ADR-0108 decision 11); other keys go on up.
        FocusScope {
            horizontal-stretch: 1;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(e) => {
                if e.modifiers.control || e.modifiers.alt || e.modifiers.meta || data.media-len-ms <= 0 {
                    return reject;
                }
                if e.text == "i" || e.text == "I" {
                    Studio.set-media-range-mark(data.id, 0, root.at-ms);
                    return accept;
                }
                if e.text == "o" || e.text == "O" {
                    Studio.set-media-range-mark(data.id, 1, root.at-ms);
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
        Slider {
            horizontal-stretch: 1;
            label: @tr("Position in {}", data.name);
            value: root.shown;
            value-text: Studio.media-clock(root.at-ms);
            enabled: data.media-len-ms > 0 && data.media-state != 5;
            step: data.media-len-ms > 0 ? min(1, 5000 / data.media-len-ms) : 0.02;
            moved(v) => { root.scrubbing = true; root.scrub = v; }
            released => {
                Studio.media-seek(data.id, Math.round(root.scrub * data.media-len-ms));
                root.scrubbing = false;
            }
            cancelled => { root.scrubbing = false; }
        }
            }
        }
        Text {
            text: data.media-len-ms > 0
                ? Studio.media-clock(root.at-ms) + " / " + Studio.media-clock(data.media-len-ms)
                : "";
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
    }
    Text {
        text: Studio.media-state-text(data.media-state);
        color: data.media-state == 5 ? Theme.state-error : Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        wrap: word-wrap;
    }
}

component SourceProperties inherits VerticalLayout {
    in property <SourceData> data;
    // Delete source asks first (ADR-0065).
    property <bool> confirm;
    changed data => { if confirm && Studio.selected-source != data.id { confirm = false; } }
    in property <int> live-state;
    // 0 Transform, 1 Filters, 2 Audio, 3 Source. The Source tab is the last one shown;
    // the first tab opens, except while the source is not running, when the Source tab
    // opens by itself (ADR-0077).
    // A media file has a Source tab too: its file, Loop, Restart when shown and play
    // range (ADR-0108), though it is no capture kind.
    property <bool> has-source: data.kind-code >= 0 || data.media;
    // The tabs before Source: Transform, Filters and Audio for a source with a picture
    // and sound, without Audio when it has none, only Audio for sound alone.
    property <int> before-source: data.picture ? (data.audio ? 3 : 2) : 1;
    property <int> want: Studio.properties-tab;
    // A text source (ADR-0129 decision 13): Text first, then Transform and Filters.
    property <bool> is-text: Studio.text-props.on && Studio.text-props.id == data.id;
    property <int> tab: is-text ? (want == 0 || want == 1 ? want : 4)
        : has-source && (!data.ok || want == 3) ? 3
        : !data.picture ? 2
        : want == 1 ? 1
        : want == 2 && data.audio ? 2
        : 0;
    // The foldable sections drawn for this source and tab, for Collapse all / Expand all
    // in the panel's title row. Keep in step with the `id`s of the sections below.
    // Filter settings show for the selected filter (an unknown type has none).
    property <bool> filter-open: data.selected-filter >= 0 && data.filters.length > 0;
    property <string> folds: (data.media ? "properties.playback," : "")
        + (tab == 0 && data.picture ? "properties.position,properties.arrange,properties.crop,properties.shape," : "")
        + (tab == 1 && root.filter-open ? "properties.filter-settings," : "")
        + (tab == 2 ? "properties.sound,properties.sync," : "")
        + (tab == 2 && !data.picture ? "properties.recording,properties.audio-filters," + (root.filter-open ? "properties.filter-settings," : "") : "")
        + (tab == 4 ? "properties.text-outline,properties.text-shadow,properties.text-background," : "")
        + (data.picture ? "properties.timed-show," : "")
        + "properties.scenes"
        + (data.picture ? ",properties.picture-recording" : "");
    init => { Studio.properties-folds = root.folds; }
    changed folds => { Studio.properties-folds = root.folds; }
    spacing: Tokens.size-section-gap;
    alignment: start;
    // The source: its kind's icon, its name and kind, and its name as a field.
    VerticalLayout {
        spacing: Tokens.size-field-gap;
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            VerticalLayout {
                alignment: center;
                Icon { name: Icons.named(data.icon); ink: Theme.text-primary; }
            }
            Text {
                horizontal-stretch: 1;
                text: data.name;
                color: Theme.text-primary;
                font-size: Tokens.type-label-size;
                font-weight: Tokens.type-title-weight;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: data.kind;
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
            }
            IconButton {
                name: @tr("Delete {}", data.name);
                kind: "danger";
                clicked => { root.confirm = true; }
            }
        }
        if root.confirm: SettingsCallout {
            label: @tr("Delete {} from every scene?", data.name);
            Text {
                text: data.global || data.in-globals
                    ? (data.places > 2 ? @tr("{} is in every scene and {} more. Delete it from all of them?", data.name, data.places - 1) : data.places == 2 ? @tr("{} is in every scene and 1 more. Delete it from all of them?", data.name) : @tr("{} is in every scene. Delete it?", data.name))
                    : data.places > 1 ? @tr("{} is in {} scenes. Delete it from all of them?", data.name, data.places)
                    : @tr("Delete {}? It is only in this scene.", data.name);
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                wrap: word-wrap;
            }
            DialogActions {
                dense: true;
                confirm-text: @tr("Delete source");
                confirm-kind: "danger";
                cancelled => { root.confirm = false; }
                confirmed => { root.confirm = false; Studio.delete-source(data.id); }
            }
        }
        TextField {
            label: @tr("Name of {}", data.name);
            text: data.name;
            accepted(t) => { if t != data.name { Studio.rename-source(data.id, t); } }
        }
    }
    // A media file's playback (ADR-0108 decision 10): live actions, not undo steps.
    if data.media: MediaPlayback { data: data; live-state: root.live-state; }
    // Transform, Filters and, for a source with sound, Audio, then Source (ADR-0062, ADR-0076, ADR-0077).
    if data.picture || has-source: Tabs {
        label: @tr("Properties of {}", data.name);
        options: is-text ? [@tr("Text"), @tr("Transform"), @tr("Filters")]
            : has-source
            ? (data.picture
                ? (data.audio ? [@tr("Transform"), @tr("Filters"), @tr("Audio"), @tr("Source")] : [@tr("Transform"), @tr("Filters"), @tr("Source")])
                : [@tr("Audio"), @tr("Source")])
            : (data.audio ? [@tr("Transform"), @tr("Filters"), @tr("Audio")] : [@tr("Transform"), @tr("Filters")]);
        index: is-text ? (tab == 4 ? 0 : tab + 1) : tab == 3 ? before-source : data.picture ? tab : 0;
        selected(i) => {
            if is-text { Studio.properties-tab = i == 0 ? 4 : i - 1; }
            else if has-source && i == before-source { Studio.properties-tab = 3; }
            else if data.picture { Studio.properties-tab = i; }
            else { Studio.properties-tab = 2; }
        }
    }
    // Filters and the sync offset belong to the source: an edit shows on air at once.
    if live-state != 0 && (tab == 1 || tab == 2): HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Rectangle {
            width: on-air.preferred-width + 2 * Tokens.space-2;
            height: Tokens.type-caption-line;
            border-radius: self.height / 2;
            background: Theme.state-live;
            on-air := Text {
                text: @tr("On air");
                color: Theme.text-on-live;
                font-size: Tokens.type-caption-size;
                font-weight: Tokens.type-label-weight;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Changes here show in the program at once.");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    if tab == 3: SourceFields { data: data; }
    if tab == 4: TextFields { data: data; }
    // Which canvas's layout the Transform fields edit (ADR-0093 decision 4): the
    // vertical canvas's own layout changes only that canvas.
    if tab == 0 && Studio.props-can-vertical: SegmentedControl {
        label: @tr("Canvas of {}", data.name);
        options: [@tr("Main"), @tr("Vertical")];
        index: Studio.props-vertical ? 1 : 0;
        selected(i) => { Studio.set-props-vertical(i == 1); }
    }
    if tab == 0 && Studio.props-vertical: Text {
        text: @tr("Changes here apply to the vertical canvas only.");
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        wrap: word-wrap;
    }
    if tab == 0: TransformFields { data: data; }
    if tab == 1: FiltersFields { data: data; }
    if tab == 2: AudioFields { data: data; }
    if data.picture: Section {
        title: @tr("Timed show");
        id: "properties.timed-show";
        hint: @tr("Hide with the hourglass in Sources if you need to, or press Show now here. It appears for the duration and hides again without Undo. Leave Show duration at 0 and use the eye in Sources for a lasting show.");
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            NumberField {
                live: false;
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Show duration of {} in milliseconds", data.name);
                unit: @tr("ms");
                value: data.show-for-ms;
                edited(v) => { Studio.set-item-show-for(data.item-id, max(0, min(600000, round(v)))); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Button {
                lead: IconName.eye;
                text: @tr("Show now");
                kind: "primary";
                dense: true;
                enabled: data.show-for-ms > 0 && !data.visible;
                clicked => { Studio.show-item(data.item-id); }
            }
            Button {
                lead: IconName.eraser;
                text: @tr("Clear");
                dense: true;
                enabled: data.show-for-ms > 0;
                clicked => { Studio.set-item-show-for(data.item-id, 0); }
            }
        }
        if data.cue-remaining-ms > 0: Text {
            text: data.cue-remaining-ms + @tr(" ms left on Program");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            wrap: word-wrap;
        }
    }
    // Global sources (ADR-0065): on, the source is shown and heard in every scene.
    // Custom glide (ADR-0100): only for a picture source with more than one place.
    Section {
        title: @tr("Scenes");
        id: "properties.scenes";
        hint: data.global
            ? @tr("Turning this off moves it into this scene only, and off air until the next transition in studio mode.")
            : @tr("It then leaves the scenes that have it and is drawn above every scene.");
        Toggle {
            text: @tr("Show in every scene");
            label: @tr("Show {} in every scene", data.name);
            checked: data.global;
            toggled(on) => { Studio.set-global(data.id, on); }
        }
        if data.picture && data.places > 1: VerticalLayout {
            spacing: Tokens.size-field-gap;
            Toggle {
                text: @tr("Custom glide");
                label: @tr("Custom glide for {}", data.name);
                checked: data.custom-glide;
                toggled(on) => {
                    Studio.set-source-glide(
                        data.id,
                        on,
                        on ? (data.custom-glide ? data.glide-duration : Studio.glide-duration) : 0,
                        on ? (data.custom-glide ? data.glide-easing : Studio.glide-easing) : 0
                    );
                }
            }
            if data.custom-glide: Field {
                label: @tr("Duration");
                NumberField {
                    live: false;
                    label: @tr("Glide duration of {} in milliseconds", data.name);
                    unit: @tr("ms");
                    value: data.glide-duration;
                    edited(v) => {
                        Studio.set-source-glide(data.id, true, max(0, min(5000, round(v))), data.glide-easing);
                    }
                }
            }
            if data.custom-glide: Field {
                label: @tr("Easing");
                SegmentedControl {
                    label: @tr("Glide easing of {}", data.name);
                    options: [@tr("Linear"), @tr("Ease in-out")];
                    index: data.glide-easing;
                    selected(i) => { Studio.set-source-glide(data.id, true, data.glide-duration, i); }
                }
            }
        }
    }
    // Separate files of a picture source (ADR-0086 step 3.5, ADR-0117): one switch, and
    // for a still source or a media file the form once it is on.
    if data.picture: Section {
        title: @tr("Recording");
        id: "properties.picture-recording";
        hint: data.record-choice == 1
            ? @tr("Writes this source's picture as PNG images in the recording's folder, a new image each time it changes. Video writes a video file instead. Changes apply to the next recording.")
            : data.record-choice == 2
            ? @tr("Writes this file's picture as a video file, its sound as a WAV file, or both, in the recording's folder. Changes apply to the next recording.")
            : @tr("Writes this source's picture to its own video file in the recording's folder, without its filters. Up to 3 video files are written. Changes apply to the next recording.");
        Toggle {
            label: @tr("Record {} separately", data.name);
            text: @tr("Record separately");
            checked: data.record-separately;
            toggled(v) => { Studio.set-source-record-separately(data.id, v); }
        }
        if data.record-separately && data.record-choice == 1: Field {
            label: @tr("Recorded as");
            Select {
                label: @tr("Recorded form of {}", data.name);
                options: [@tr("Automatic (image)"), @tr("Image"), @tr("Video")];
                index: data.record-form;
                selected(i) => { Studio.set-source-record-form(data.id, i); }
            }
        }
        if data.record-separately && data.record-choice == 2: Field {
            label: @tr("Recorded as");
            Select {
                label: @tr("Recorded feeds of {}", data.name);
                options: [@tr("Picture and sound"), @tr("Picture"), @tr("Sound")];
                index: data.record-form;
                selected(i) => { Studio.set-source-record-form(data.id, i); }
            }
        }
        if Studio.rec-state == 2 && data.record-separately: Text {
            text: @tr("Applies to the next recording.");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            wrap: word-wrap;
        }
    }
}

// The selected source's properties (mockup E): its icon, name and type, its name as a
// field, then the Transform, Filters and Audio tabs (ADR-0062). A source without a
// picture has only the Audio tab, so no tab control shows. The tab picked last applies
// to whichever source is selected. `live-state`: 0 nothing goes out, else the program
// is on air, and Filters and Audio say that their edits show at once.
export component PropertiesPanel inherits Rectangle {
    in property <int> live-state;
    background: Theme.surface-raised;
    property <bool> any: Studio.properties-source >= 0;
    if !any: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("Nothing selected");
        message: @tr("Select a source in the Sources panel to see its properties.");
    }
    if any: props := ScrollArea {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        // A list that can pan holds a press briefly, so a quick click on a confirm
        // button never arrives and the next one does. The wheel still scrolls.
        drag-pan: false;
        property <int> anchor: Studio.look-anchor-serial;
        // The gear's section has just reported its place: move it on screen.
        changed anchor => {
            if anchor <= 0 { return; }
            let margin = Tokens.space-2;
            let y = Studio.look-anchor-y - list.absolute-position.y;
            let h = Tokens.size-control-lg * 4;
            props.scroll-into-view(y - margin, h + 2 * margin);
        }
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            // The bar sits in the trailing padding, so both sides look alike.
            padding-right: max(0px, Tokens.size-panel-pad - props.bar-room);
            alignment: start;
            for s in Studio.sources: VerticalLayout {
                spacing: Tokens.size-section-gap;
                if s.id == Studio.properties-source: SourceProperties {
                    data: s;
                    live-state: root.live-state;
                }
            }
        }
    }
}

// One labelled fact in an output card: the name in secondary, the value in the body size.
component OutputFact inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: Tokens.space-2;
    Text {
        text: label;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        vertical-alignment: center;
        min-width: Tokens.size-control-lg * 3;
    }
    Text {
        text: value;
        color: Theme.text-primary;
        font-size: Tokens.type-body-size;
        font-weight: Tokens.type-label-weight;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

// One output: a title, its facts, and the button that opens its settings.
component OutputCard inherits Rectangle {
    // The files written beside the recording (ADR-0086); empty: no line.
    in property <string> separate;
    in property <string> title;
    in property <string> kind;
    in property <string> encoder;
    in property <string> video;
    in property <string> audio;
    in property <string> where;
    in property <string> where-label;
    in property <string> action;
    // Markers (ADR-0089 decision 10): shown while a recording that writes an editor
    // project runs, with its manual markers so far.
    in property <bool> markers-shown;
    in property <int> markers;
    // Pause (ADR-0124): first in the row while the recording runs; Resume while it is
    // paused.
    in property <bool> pause-shown;
    in property <bool> paused;
    // Hold (ADR-0124): first in the stream card's row while it is live; Resume stream
    // while it is on hold.
    in property <bool> hold-shown;
    in property <bool> held;
    // A notice under the facts, such as a scene hold that fell back ("" for none).
    in property <string> note;
    callback open();
    callback add-marker();
    callback pause();
    callback hold();
    background: Theme.surface-sunken;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    border-radius: Tokens.radius-md;
    accessible-role: list-item;
    accessible-label: @tr("{}, {}, {}", title, kind, where);
    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.size-field-gap;
        Text {
            text: title;
            color: Theme.text-primary;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-title-weight;
        }
        OutputFact { label: @tr("Format"); value: kind; }
        if encoder != "": OutputFact { label: @tr("Encoder"); value: encoder; }
        if video != "": OutputFact { label: @tr("Video"); value: video; }
        OutputFact { label: @tr("Audio"); value: audio; }
        if separate != "": OutputFact { label: @tr("Separate files"); value: separate; }
        OutputFact { label: where-label; value: where; }
        if note != "": StatusLine { text: note; tone: 2; }
        if markers-shown || pause-shown || hold-shown: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-2;
            if hold-shown: Button {
                lead: held ? IconName.play : IconName.hold;
                text: held ? @tr("Resume stream") : @tr("Hold stream");
                clicked => { root.hold(); }
            }
            if pause-shown: Button {
                lead: paused ? IconName.play : IconName.pause;
                text: paused ? @tr("Resume") : @tr("Pause");
                accessible-name: paused ? @tr("Resume recording") : @tr("Pause recording");
                clicked => { root.pause(); }
            }
            if markers-shown: Button {
                lead: IconName.flag;
                text: @tr("Marker");
                accessible-name: @tr("Add marker");
                clicked => { root.add-marker(); }
            }
            if markers-shown: Text {
                text: markers == 1 ? @tr("1 marker") : @tr("{} markers", markers);
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            alignment: start;
            Button { text: action; clicked => { root.open(); } }
        }
    }
}

// Outputs: what the recording and the stream will do, each as a card, and the way
// to its settings. Settings live in the Settings window (U17), not in this panel.
export component OutputsPanel inherits Rectangle {
    background: Theme.surface-raised;
    area := ScrollArea {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            // The bar sits in the trailing padding, so both sides look alike.
            padding-right: max(0px, Tokens.size-panel-pad - area.bar-room);
            spacing: Tokens.size-section-gap;
            alignment: start;
            OutputCard {
                title: Studio.rec-state == 2 && Studio.rec-paused ? @tr("Recording paused")
                    : Studio.rec-state == 2 ? @tr("Recording now") : @tr("Recording");
                kind: Studio.out-kind;
                encoder: Studio.out-encoder-name;
                video: Studio.out-video-line;
                audio: Studio.out-audio-line;
                where: Studio.out-where;
                where-label: @tr("Folder");
                separate: Studio.out-separate;
                markers-shown: Studio.rec-markers-shown;
                markers: Studio.rec-markers;
                pause-shown: Studio.rec-state == 2;
                paused: Studio.rec-paused;
                action: @tr("Recording settings");
                open => { Studio.open-settings(); }
                add-marker => { Studio.add-marker(); }
                pause => { Studio.pause-recording(); }
            }
            OutputCard {
                title: Studio.st-held ? @tr("Stream on hold")
                    : Studio.st-connected ? @tr("Stream live")
                    : Studio.st-state != 0 ? @tr("Stream connecting") : @tr("Stream");
                kind: Studio.st-kind;
                encoder: Studio.st-encoder-name;
                video: Studio.st-video-line;
                audio: Studio.st-audio-line;
                where: Studio.st-where;
                where-label: @tr("Server");
                hold-shown: Studio.st-holdable;
                held: Studio.st-held;
                note: Studio.st-hold-note;
                action: @tr("Stream settings");
                open => { Studio.open-stream-settings(); }
                hold => { Studio.hold-stream(); }
            }
        }
    }
}

// The selected source's shape, when it is not a plain rectangle. It is the shape
// itself, not a look: no checkbox and no remove, so turning it off cannot flatten
// the picture back to a rectangle. A gear still opens the border and fill.
component AppliedShape inherits Rectangle {
    in property <SourceData> source;
    in property <string> title;
    horizontal-stretch: 1;
    // A fixed height. A height taken from a row whose width is this plate loops, and
    // the gear then sits beside the words while the plate itself is full width.
    height: Tokens.size-control-lg + Tokens.space-3;
    border-radius: Tokens.radius-sm;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    background: Theme.surface-sunken;
    accessible-role: text;
    accessible-label: @tr("Shape of {}: {}", source.name, root.title);
    // Not a layout: a layout inside this plate stays as wide as the words, so the
    // gear never reaches the plate's trailing end. The plate's width is set to 100%
    // where it is used, the same way a filter row is.
    words := VerticalLayout {
        x: Tokens.space-2;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - Tokens.space-2 - Tokens.space-1 * 2 - Tokens.size-control-sm;
        spacing: 0px;
        Text {
            text: @tr("Shape");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            overflow: elide;
            accessible-role: none;
        }
    }
    IconButton {
        x: parent.width - self.width - Tokens.space-1;
        y: (parent.height - self.height) / 2;
        icon: IconName.gear;
        name: @tr("Open Shape and border for {}", source.name);
        clicked => { Studio.open-shape-settings(source.id); }
    }
}

// One kind of sample as a list: a ListRow per sample with its picture at the start
// (owner decision 2026-11-13, medium picture). A hidden kind adds no row.
component SampleGrid inherits VerticalLayout {
    in property <bool> frames;
    // Spacing stays 0: a sample of the other kind is an empty layout and must not
    // open a gap.
    spacing: 0px;
    alignment: start;
    for s in Studio.library-samples: VerticalLayout {
        if s.frame == root.frames && s.id != "lower-third": ListRow {
            name: s.name;
            picture: s.thumb;
            picture-height: Tokens.size-row-picture-md;
            picture-checker: true;
            selectable: false;
            accessible-name: @tr("Add {}", s.name);
            activated => { Studio.add-sample(s.id); }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: IconName.plus;
                    name: @tr("Add {}", s.name);
                    clicked => { Studio.add-sample(s.id); }
                }
            }
        }
    }
}

// The Library (ADR-0075): Style copies a look onto the selected source; Add puts a
// background or a frame in the scene. Nothing is linked: a look is copied.
export component LibraryPanel inherits Rectangle {
    background: Theme.surface-raised;
    clip: true;
    property <bool> has-selection: Studio.selected-source >= 0;
    // A look changes a picture. An audio-only selection cannot take one.
    property <bool> can-apply: Studio.looks-ready;
    // 0 Style, 1 Add.
    property <int> mode: 0;
    // Which look the Add button copies.
    property <int> pick: 0;
    // 0 Background, 1 Frame.
    property <int> sample-kind: 0;
    // The shapes Add offers, in reading order (the long name last); `stamp` is the kind `add-stamp` takes.
    property <[{ name: string, icon: IconName, stamp: int }]> shape-list: [
        { name: @tr("Circle"), icon: IconName.circle, stamp: 0 },
        { name: @tr("Square"), icon: IconName.square, stamp: 1 },
        { name: @tr("Rectangle"), icon: IconName.rectangle, stamp: 2 },
        { name: @tr("Ellipse"), icon: IconName.ellipse, stamp: 4 },
        { name: @tr("Triangle"), icon: IconName.triangle, stamp: 5 },
        { name: @tr("Arrow"), icon: IconName.arrow-right, stamp: 6 },
        { name: @tr("Rounded rectangle"), icon: IconName.rounded-rectangle, stamp: 3 },
    ];
    // Thumbnails are made at the size the rows show them (`thumbnail.rs`).
    property <int> picture-px: Math.round(Tokens.size-row-picture-md / 1phx);
    init => { Studio.library-shown(root.picture-px); }
    changed picture-px => { Studio.library-shown(root.picture-px); }
    // The list has no width, and the flickable has no content-width. A `width: 100%`
    // here is the preferred width of the contents, so a short control stays short
    // (design system: filling a row). Properties uses the same shape.
    fl := ScrollArea {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            // The bar sits in the trailing padding, so both sides look alike.
            padding-right: max(0px, Tokens.size-panel-pad - fl.bar-room);
            spacing: Tokens.size-section-gap;
            alignment: start;
            SegmentedControl {
                label: @tr("Library");
                options: [@tr("Style"), @tr("Add")];
                index: root.mode;
                selected(i) => { root.mode = i; }
            }
            // Hint, the look row, the shape and the filters are separate groups.
            if root.mode == 0: VerticalLayout {
                width: 100%;
                horizontal-stretch: 1;
                spacing: Tokens.size-section-gap;
                alignment: start;
                Text {
                    text: !has-selection ? @tr("Select a source, then add a look.")
                        : !can-apply ? @tr("This source has no picture. Looks change a picture, so they stay off until you select one that has.")
                        : @tr("Adds a filter or a shape. A filter of the same kind is replaced. Turn it off, remove it, or open its settings.");
                    color: has-selection && !can-apply ? Theme.state-warning : Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    wrap: word-wrap;
                }
                // The rectangle takes the row. The layout is then given that width, and the
                // select stretches inside it. A preferred width of 0 hides the select.
                if root.can-apply: Rectangle {
                    horizontal-stretch: 1;
                    height: look-row.preferred-height;
                    look-row := HorizontalLayout {
                        width: parent.width;
                        spacing: Tokens.size-field-gap;
                        Select {
                            horizontal-stretch: 1;
                            label: @tr("Look");
                            options: Studio.library-look-names;
                            index: root.pick;
                            selected(i) => { root.pick = i; }
                        }
                        Button {
                            lead: IconName.plus;
                            text: @tr("Add");
                            accessible-name: @tr("Add the selected look");
                            clicked => { Studio.apply-look-at(root.pick); }
                        }
                    }
                }
                if root.can-apply: VerticalLayout {
                    width: 100%;
                    horizontal-stretch: 1;
                    spacing: 0px;
                    alignment: start;
                    for s in Studio.sources: VerticalLayout {
                        width: 100%;
                        horizontal-stretch: 1;
                        spacing: 0px;
                        alignment: start;
                        if s.id == Studio.selected-source: VerticalLayout {
                            width: 100%;
                            horizontal-stretch: 1;
                            spacing: Tokens.size-section-gap;
                            alignment: start;
                            if s.shape != 0 || s.radius > 0 || s.border: AppliedShape {
                                // Same as the filter row under it. Without this, the plate
                                // paints full width but parent.width stays the words' width,
                                // and the gear sits beside them.
                                width: 100%;
                                horizontal-stretch: 1;
                                source: s;
                                title: @tr("Shape and border");
                            }
                            VerticalLayout {
                                width: 100%;
                                horizontal-stretch: 1;
                                spacing: Tokens.size-field-gap;
                                alignment: start;
                            for f[i] in s.filters: FilterRowView {
                                width: 100%;
                                horizontal-stretch: 1;
                                source: s;
                                data: f;
                                index: i;
                                selected: f.id == s.selected-filter;
                                jump: true;
                                open-settings => { Studio.open-filter-settings(s.id, f.id); }
                            }
                            }
                        }
                    }
                }
            }
            // Pictures and shapes are different categories, so a section gap and a
            // SectionTitle sit between them (the same rule as a Properties section).
            if root.mode == 1: VerticalLayout {
                horizontal-stretch: 1;
                spacing: Tokens.size-section-gap;
                alignment: start;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Tokens.size-section-gap;
                    alignment: start;
                    Button {
                        lead: IconName.folder;
                        width: 100%;
                        horizontal-stretch: 1;
                        text: @tr("Choose a PNG file…");
                        accessible-name: @tr("Choose a PNG file");
                        clicked => { Studio.add-image(); }
                    }
                    Text {
                        text: root.sample-kind == 1
                            ? @tr("A frame is added on top. A plain frame's thickness is its border.")
                            : @tr("A background is added behind the scene.");
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                        wrap: word-wrap;
                    }
                    SegmentedControl {
                        label: @tr("Add");
                        options: [@tr("Background"), @tr("Frame")];
                        index: root.sample-kind;
                        selected(i) => { root.sample-kind = i; }
                    }
                    SampleGrid { frames: root.sample-kind == 1; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Tokens.size-section-gap;
                    alignment: start;
                    SectionTitle { title: @tr("Shapes"); }
                    // As many columns as fit (ListBox, automatic columns); a name that
                    // does not fit is elided and shows its tooltip.
                    shapes := ListBox {
                        inline: true;
                        columns: 0;
                        count: root.shape-list.length;
                        row-height: Tokens.size-control-md;
                        spacing: Tokens.space-1;
                        for s[i] in root.shape-list: ListRow {
                            x: shapes.cell-x(i);
                            y: shapes.cell-y(i);
                            width: shapes.cell-width;
                            height: shapes.row-height;
                            has-icon: true;
                            icon: s.icon;
                            name: s.name;
                            selectable: false;
                            accessible-name: @tr("Add {}", s.name);
                            activated => { Studio.add-stamp(s.stamp); }
                        }
                    }
                }
            }
        }
    }
}

// One measured number on its own row, or a group name. A full-width row keeps the
// label and the number readable in a narrow panel (a grid column was collapsing
// them to nothing).
component StatLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> bad;
    in property <bool> heading;
    min-height: heading ? Tokens.size-control-sm : Tokens.size-control-md;
    background: heading ? transparent : Theme.surface-sunken;
    border-width: heading ? 0px : Tokens.size-border;
    border-color: Theme.border-subtle;
    border-radius: Tokens.radius-sm;
    if heading: Text {
        text: label;
        color: Theme.text-primary;
        font-size: Tokens.type-label-size;
        font-weight: Tokens.type-title-weight;
        vertical-alignment: center;
        accessible-role: AccessibleRole.text;
    }
    if !heading: HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;
        Text {
            text: label;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
            accessible-role: none;
        }
        Text {
            text: value;
            color: bad ? Theme.state-error : Theme.text-primary;
            font-size: Tokens.type-body-size;
            font-weight: Tokens.type-title-weight;
            vertical-alignment: center;
            horizontal-alignment: right;
            accessible-role: AccessibleRole.text;
            accessible-label: @tr("{}: {}", label, value);
        }
    }
}

// Stats: the running recording's and stream's counters and the engine's late ticks,
// updated once a second while an output runs (design system: `rbs.stats` 1 Hz).
// Each number is one full-width row, so a narrow panel never clips the text.
export component StatsPanel inherits Rectangle {
    background: Theme.surface-raised;
    if Studio.stats.length == 0: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("Nothing to measure yet");
        message: @tr("Statistics show here while you record or stream.");
    }
    // Nothing in the list takes focus, so the area is the focus stop and keys scroll it.
    if Studio.stats.length > 0: area := ScrollArea {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        focusable: true;
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            // The bar sits in the trailing padding, so both sides look alike.
            padding-right: max(0px, Tokens.size-panel-pad - area.bar-room);
            spacing: Tokens.size-field-gap;
            alignment: start;
            for row in Studio.stats: StatLine {
                label: row.label;
                value: row.value;
                bad: row.bad;
                heading: row.heading;
            }
        }
    }
}
