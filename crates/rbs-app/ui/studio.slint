// Panels connected to the studio (ADR-0041 decision 7): Program, Sources, Mixer, Live
// controls and Outputs.
// Rust pushes state into the `Studio` global of every window and handles its callbacks
// by sending commands to the studio's control thread.
import { Theme, Tokens } from "tokens.slint";
import { Sections, Button, Checkbox, ColorPicker, FocusRing, RingFocus, SectionHeader, Tabs, Icon, IconButton, IconName, Icons, MenuItem, MenuSurface, EmptyState, NumberField, Select, SegmentedControl, Slider, TextField, Toggle } from "components.slint";
import { SettingsCard, SettingRow, SettingBlock, SettingsStatus, SettingsNotice, SettingsCallout } from "settings.slint";
import { CommandMenu } from "context_menu.slint";

// `picture`: a video source; `x`, `y`, `w`, `h` place its box on the canvas (canvas
// pixels). `can-up` / `can-down`: another source with a picture is above / below it.
// Style (ADR-0053): `shape` 0 rectangle, 1 circle, 2 ellipse; `radius` for rectangles;
// `border` on or off, its `border-width`, its colour as `#rrggbb` or `#rrggbbaa` text
// and as a swatch (the values a border gets when turned on while it is off).
// One field of a filter in the Filters tab (ADR-0062), generated from its type's
// schema: `kind` 0 a number (`position` from 0 to 1 on its slider, `step` one step
// there, `value-text` the value with its unit; `min`, `max`, `snap` (the value's step),
// `decimals` and `suffix` (the unit with its space) for the text while dragging), 1 a colour (`colour` as #rrggbb or
// #rrggbbaa, `swatch` the same colour).
export struct FilterFieldData { label: string, kind: int, position: float, step: float, value-text: string, min: float, max: float, snap: float, decimals: int, suffix: string, colour: string, swatch: color }
// One filter of a source's chain: `known` false for a type this version lacks (it can
// only be removed); `can-up` / `can-down` false at the ends of the chain.
export struct FilterData { id: int, name: string, enabled: bool, known: bool, can-up: bool, can-down: bool, fields: [FilterFieldData] }
export struct SourceData { id: int, name: string, kind: string, icon: string, status: string, ok: bool, picture: bool, visible: bool, x: float, y: float, w: float, h: float, can-up: bool, can-down: bool, shape: int, radius: float, border: bool, border-width: float, border-color: string, border-swatch: color, crop-l: int, crop-t: int, crop-r: int, crop-b: int, pic-w: int, pic-h: int, locked: bool, audio: bool, muted: bool, volume: float, volume-text: string, filters: [FilterData], selected-filter: int, sync-offset: int, global: bool, also-in: string, in-globals: bool, places: int, kind-code: int }
// `global`: a global source's row (ADR-0065). `also-in`: the other scenes that place it,
// by name; `in-globals`: it is a global source too; `places`: how many items place it.
// A scene in the Scenes panel (ADR-0059): `live` on air, `number` its place (1 up).
// `live`: the scene on air; `preview`: the preview scene in studio mode (ADR-0061).
export struct SceneData { id: int, name: string, live: bool, preview: bool, number: int }
// A source of the collection for Add source's "Existing source" list.
export struct ExistingData { id: int, name: string, icon: string }
// A look in the Library (ADR-0075): `group` 0 colour, 1 effect, 2 shape. A sample
// picture: `frame` is true for a frame (transparent in the middle), `thumb` its picture.
export struct LookData { id: string, name: string, group: int }
export struct SampleData { id: string, name: string, frame: bool, thumb: image }
export struct KindData { code: int, label: string }
// A filled rectangle of the selection on the preview (outline or handle), in the
// panel's coordinates; kind 0 outline, 1 handle border, 2 handle inside.
export struct MarkData { x: length, y: length, w: length, h: length, kind: int }
export struct TargetData { name: string, is-default: bool }
// One line of the Source tab's target list: `index` is its place in the answer, `current` marks the source's own target (ADR-0077).
export struct SourceTargetData { name: string, current: bool, index: int }
// One meter's moving parts as fractions of the bar (rbs_ui::meter::MeterView::zones),
// its peak-hold position and zone, the clip latch and the accessible value (U16).
export struct MeterRow {
    // The source's id and whether its sound is muted (ADR-0059).
    id: int,
    muted: bool,
    name: string,
    icon: string,
    lo-from: float, lo-to: float, mi-from: float, mi-to: float, hi-from: float, hi-to: float,
    peak: float, peak-zone: int, clipped: bool, value: string,
    // A global source (ADR-0065): the Mixer groups it apart from the scene's own.
    global: bool,
}
export struct ScaleMark { label: string, at: float }
// The encoder fields of one output (a recording or a stream): the options offered and
// the one in use (rbs_app::encoder_form). `rate-kind`: 0 CBR, 1 VBR, 2 constant quality.
export struct EncoderData {
    encoders: [string], encoder: int,
    video-rates: [string], video-rate: int,
    audio-rates: [string], audio-rate: int,
    rate-modes: [string], rate-mode: int, rate-kind: int, bitrate-label: string,
    peaks: [string], peak: int,
    qualities: [string], quality: int,
    padding: bool, padding-available: bool,
    keyframes: [string], keyframe: int,
    presets: [string], preset: int,
    profiles: [string], profile: int,
    b-frames: [string], b-frame: int, b-frames-note: string,
}
// One access token in the Remote control section: its name and what it allows.
export struct TokenRow { name: string, access: string }
// One line of the Stats panel: a section heading (`heading`, `label` only) or a counter
// with its value; `bad` marks a value that shows a loss (in words too, U7).
export struct StatRow { heading: bool, label: string, value: string, bad: bool }
// An output profile or scene collection in its menu (ADR-0051).
export struct EntryRow { id: string, name: string, current: bool }

export global Studio {
    // 0 starting, 1 running, 2 failed (`failure` says why).
    in property <int> state;
    in property <string> failure;
    in property <[SourceData]> sources;
    in property <[KindData]> kinds;
    in property <[TargetData]> targets;
    // The Source tab's list of what the selected source's kind can capture.
    in property <[SourceTargetData]> source-targets;
    // The kind `targets` lists; -1 while a list is being made.
    in property <int> targets-kind: -1;
    in property <[MeterRow]> meters;
    // Sources kept out of the Mixer, still heard (ADR-0080); no meter runs for them.
    in property <[MeterRow]> hidden-meters;
    // How many of `meters` are the scene's own and how many are global (Mixer groups).
    in property <int> meter-scenes;
    in property <int> meter-globals;
    // The Stats panel's lines; empty while nothing records or streams.
    in property <[StatRow]> stats;
    in property <[ScaleMark]> scale;
    // 0 shown, 1 starting, 2 not on this platform yet, 3 not in this session (remote
    // desktop), 4 shown only in the main window, 5 the studio is not running.
    in property <int> preview-state: 1;
    // Name of the source just deleted (an undo toast shows while it is set);
    // `deleted-from-scene`: only removed from one scene (ADR-0065).
    in property <string> deleted;
    in property <bool> deleted-from-scene;
    // Something goes out (a recording or a stream): edits to what is on air show at once.
    out property <bool> on-air: self.rec-state != 0 || self.st-state != 0;
    // The add-source picker's chosen kind; -1 shows the list of types.
    in-out property <int> picker-kind: -1;
    // The panel the picture shows in: "rbs.program", else "rbs.preview" (without studio
    // mode both show the scene on air); the other one says where it is.
    in property <string> picture-panel: "rbs.program";
    // Studio mode (ADR-0061): Preview shows the preview scene (edited there) and
    // Program the scene on air; `scene-preview-state` is the Preview picture's state,
    // with the codes of `preview-state`.
    in property <bool> studio-mode;
    in property <int> scene-preview-state: 1;
    callback set-studio-mode(bool /* on */);
    // The preview scene goes on air and the scene on air to preview (a cut).
    callback transition();
    callback list-targets(int /* kind */);
    callback list-source-targets(int /* source */);
    callback filter-source-targets(string);
    callback retarget-source(int /* source */, int /* index */);
    callback reload-source(int /* source */);
    callback add-source(int /* kind */, int /* target */);
    // Delete source: from every scene and the global sources (ADR-0065).
    callback delete-source(int /* id */);
    // Remove from scene: this scene only (the global sources for a global row); the
    // source goes too when it was its last placement.
    callback remove-from-scene(int /* id */);
    // Show in every scene (ADR-0065): on makes the source global, off moves it into the
    // edited scene.
    callback set-global(int /* id */, bool /* global */);
    // Settings › Global sources: the global sources (rows of `sources` with `global`),
    // the kind picked (an index into `kinds`, -1 none), the Source field's options (the
    // kind's devices, then the collection's sources of that kind that are not global)
    // and how many of them are devices.
    in-out property <int> global-kind: -1;
    in property <[string]> global-options;
    in property <int> global-devices;
    // The kinds Add source offers, by name, for the Kind field; how many global
    // sources there are.
    in property <[string]> global-kind-names;
    in property <int> global-count;
    in-out property <int> global-option: -1;
    callback pick-global-kind(int /* kind index */);
    callback add-global(int /* option */);
    callback remove-global(int /* id */);
    // The source selected in the Sources panel (its id; -1 none). Properties shows it;
    // every window shows the same selection.
    in property <int> selected-source: -1;
    callback select-source(int /* id */);
    // One layer up (over the source above it in the list) or down.
    callback move-source(int /* id */, bool /* up */);
    // A Sources row dragged onto another row: it takes that row's place.
    callback move-source-to(int /* id */, int /* to */);
    // The source whose row is being dragged, or -1.
    in-out property <int> dragging-source: -1;
    pure callback source-data(int /* id */) -> data-transfer;
    // Add source in the Sources panel's title row (the panel card's header) asks the
    // panel to open its menu; each press adds one.
    in-out property <int> add-source-asked;
    // Show or hide a source in the program scene.
    callback set-source-visible(int /* id */, bool /* visible */);
    // Lock a source so the picture panel does not move it (ADR-0059).
    callback set-source-locked(int /* id */, bool /* locked */);
    // A source's sound: mute, and the volume as a fader position from 0 to 1.
    callback set-source-muted(int /* id */, bool /* muted */);
    callback set-source-mixer-hidden(int /* id */, bool /* hidden */);
    callback set-source-volume(int /* id */, float /* position */);
    callback rename-source(int /* id */, string /* name */);
    // The sync offset of a source's sound in milliseconds (ADR-0062): a live control.
    callback set-source-sync-offset(int /* id */, int /* ms */);
    // The Library panel (ADR-0075): the built-in looks and sample pictures. The samples'
    // thumbnails are made when the panel first shows (`library-shown`), not before.
    in property <[LookData]> library-looks;
    in property <[SampleData]> library-samples;
    callback library-shown();
    callback apply-look(string /* look id */);
    callback add-sample(string /* sample id */);
    // Filters (ADR-0062). The catalogue by name, in the order Add filter lists it.
    in property <[string]> filter-types;
    // The Properties tab picked last: 0 Transform, 1 Filters, 2 Audio, 3 Source (shown first).
    in-out property <int> properties-tab;
    callback add-filter(int /* source */, int /* type */);
    callback select-filter(int /* source */, int /* filter */);
    callback remove-filter(int /* filter */);
    callback move-filter(int /* filter */, int /* index */);
    callback set-filter-enabled(int /* filter */, bool /* on */);
    // A slider drag shows on the picture; release commits it as one undo step, cancel
    // puts the stored values back.
    callback preview-filter(int /* filter */, int /* field */, float /* position */);
    callback commit-filter(int /* filter */);
    callback cancel-filter(int /* filter */);
    callback set-filter-colour(int /* filter */, int /* field */, string /* colour */);
    callback reset-filter(int /* filter */);
    // The scenes the canvas may show, in panel order, and what Add source can place
    // again (every source of the collection that the scene does not have yet).
    in property <[SceneData]> scenes;
    in property <[ExistingData]> existing;
    callback switch-scene(int /* id */);
    callback add-scene();
    callback remove-scene(int /* id */);
    callback rename-scene(int /* id */, string /* name */);
    callback add-existing-source(int /* id */);
    // The Scenes panel's `+` in its card title row; each press adds one.
    in-out property <int> add-scene-asked;
    // Rename from a menu or a shortcut: the row of this scene or source starts its
    // name field and sets it back to -1.
    in-out property <int> renaming-scene: -1;
    in-out property <int> renaming-source: -1;
    // Counts the asks, so asking for the same row again is a change too.
    in-out property <int> rename-scene-asked;
    in-out property <int> rename-source-asked;
    // A video source's box on the canvas, in canvas pixels.
    callback set-source-box(int /* id */, float /* x */, float /* y */, float /* w */, float /* h */);
    // Shape and border of a video source (ADR-0053); a colour that is not #rrggbb or
    // #rrggbbaa is ignored.
    // Source pixels cut from each edge (ADR-0058); the box changes so the scale stays.
    callback set-source-crop(int /* id */, int /* left */, int /* top */, int /* right */, int /* bottom */);
    // 0 full picture, 1 canvas size centred, 2 left half, 3 right half.
    callback set-source-region(int /* id */, int /* region */);
    callback set-source-style(int /* id */, int /* shape */, float /* radius */, bool /* border */, float /* width */, string /* colour */);
    // The selection drawn by the toolkit where no preview layer shows the picture (the
    // layer draws it itself otherwise, ADR-0048).
    in property <[MarkData]> marks;
    // Pointer on the picture panel (panel coordinates, logical pixels; `w`, `h` the
    // panel's size). Shift: free resize at corners; Ctrl or Cmd: no snapping.
    // `crop`: Alt (Option) held, a handle crops instead of resizing (ADR-0058).
    callback preview-press(float /* x */, float /* y */, float /* w */, float /* h */, bool /* shift */, bool /* no-snap */, bool /* crop */);
    callback preview-drag(float /* x */, float /* y */);
    callback preview-release();
    // Arrow keys on the picture panel: move the selected source by this many canvas
    // pixels.
    callback preview-nudge(int /* dx */, int /* dy */);
    // Escape on the picture panel.
    callback preview-deselect();
    callback undo-delete();
    callback dismiss-deleted();
    // What Undo and Redo would apply to the scene now: 0 nothing, 1 adding, 2 deleting,
    // 3 the layer order, 4 moving or resizing the source named `undo-name` /
    // `redo-name` (U4). Separate from the layout history (U21).
    in property <int> undo-kind;
    in property <string> undo-name;
    in property <int> redo-kind;
    in property <string> redo-name;
    // Undo (true) or redo (false) the newest scene edit.
    callback undo-edit(bool /* back */);
    callback reset-clip(int /* meter */);

    // Recording: 0 off, 1 starting, 2 recording, 3 stopping.
    in property <int> rec-state;
    // The file being recorded (name only).
    in property <string> rec-file;
    // The last recording's outcome or why one did not start; `rec-note-bad` marks a problem.
    in property <string> rec-note;
    in property <bool> rec-note-bad;
    // Why this system cannot record; empty when it can.
    in property <string> rec-unavailable;
    callback record();
    callback stop-recording();

    // Output settings of the next recording.
    in-out property <string> out-folder;
    // Bumped by Rust when `out-folder` is set from outside the field.
    in-out property <int> out-folder-serial;
    in property <[string]> out-formats;
    in property <int> out-format;
    // The recording's encoder fields.
    in property <EncoderData> out-enc;
    // A problem with the settings or their file; empty when none.
    in property <string> out-note;
    callback set-folder(string);
    callback set-format(int);
    // An encoder field of an output (0 recording, 1 stream) was picked: `field` is an
    // `EncoderFields` code, `value` the picked index (padding: 0 off, 1 on).
    callback set-encoding(int /* output */, int /* field */, int /* value */);
    // One line: format, encoder, bitrates and folder of the next recording.
    in property <string> out-summary;
    // Opens the Settings window at its Recording section.
    callback open-settings();

    // Streaming (Live controls, Settings > Stream): 0 off, 1 starting, 2 live, 3 ending.
    in property <int> st-state;
    // Live and connected: the program reaches the server.
    in property <bool> st-connected;
    // The stream's state or last outcome in words, for Live controls; `st-bad` marks a
    // problem.
    in property <string> st-text;
    in property <bool> st-bad;
    // No server or stream key yet: Live controls offer "Stream settings".
    in property <bool> st-needs-setup;
    callback go-live();
    callback end-stream();

    // The virtual camera in Live controls (ADR-0066 decision 12): shown where this
    // platform has one; `vcam-can` while it is added (or sends) and the studio runs.
    in property <bool> vcam-shown;
    in property <bool> vcam-can;
    in property <bool> vcam-on;
    // Its state in words under the button; empty when the button says enough.
    in property <string> vcam-text;
    // Start (true) or stop sending.
    callback vcam-toggle(bool);
    // Opens the Settings window at its Stream section.
    callback open-stream-settings();
    // Stream settings: the server URL field's text, bumped serial when Rust sets it.
    in property <string> st-server;
    in property <int> st-server-serial;
    // Whether a key is saved, and where keys are kept (the hint).
    in property <bool> st-key-saved;
    in property <string> st-key-place;
    // Bumped when a key was saved or removed: the key field is emptied.
    in property <int> st-key-serial;
    in property <bool> st-reconnect;
    // "Record when the stream starts", and what it costs (shown while it is on).
    in property <bool> st-auto-record;
    in property <string> st-auto-record-note;
    // The server is srt://: the latency field shows.
    in property <bool> st-srt;
    in property <[string]> st-latencies;
    in property <int> st-latency;
    in property <EncoderData> st-enc;
    // A problem with the stream settings, the key or their file; empty when none.
    in property <string> st-note;
    // One line: protocol, server, encoder and bitrates of the next stream.
    in property <string> st-summary;
    callback set-server(string);
    // The server field changed but is not confirmed yet: confirmed when Settings
    // closes or Go live is pressed.
    callback server-edited(string);
    callback save-key(string);
    callback remove-key();
    callback set-reconnect(bool);
    callback set-auto-record(bool);
    callback set-latency(int);

    // The canvas (Settings, Video): sizes and rates offered, the ones in use.
    in property <[string]> canvas-sizes;
    in property <int> canvas-size;
    in property <[string]> canvas-rates;
    in property <int> canvas-rate;
    // The studio restarts with a new canvas; true until it runs again.
    in property <bool> canvas-restarting;
    // A problem with the canvas or its file; empty when none.
    in property <string> canvas-note;
    callback set-canvas-size(int);
    callback set-canvas-rate(int);

    // General (Settings, General, ADR-0056): what closing the main window does.
    // 0 Quit RBS, 1 Keep RBS running.
    in property <int> on-close;
    // 0 macOS, 1 Windows, 2 elsewhere (the setting is not available there).
    in property <int> platform;
    // A hidden window can be brought back on this platform now; without it, closing
    // the window quits.
    in property <bool> way-back;
    callback set-on-close(int);

    // Remote control (Settings, Remote control): other apps control RBS through the
    // control API. Off by default.
    in property <bool> rc-enabled;
    // The port field's text; set by Rust on load and when a typed port is refused.
    in property <string> rc-port;
    // Bumped by Rust when `rc-port` is set from outside the field.
    in property <int> rc-port-serial;
    // Where apps connect, or why remote control is not running; `rc-status-bad` marks a
    // problem.
    in property <string> rc-status;
    in property <bool> rc-status-bad;
    in property <[TokenRow]> rc-tokens;
    // Access choices and the one-line explanation of each.
    in property <[string]> rc-accesses;
    in property <[string]> rc-access-hints;
    // A token just made: shown once, until dismissed. Empty when none.
    in property <string> rc-new-token;
    in property <string> rc-new-token-name;
    // A problem with a token or the settings file; empty when none.
    in property <string> rc-note;
    callback set-rc-enabled(bool);
    callback set-rc-port(string);
    callback create-token(string /* name */, int /* access */);
    callback revoke-token(int);
    callback dismiss-new-token();
    // The access token revoked last; empty when none. "Undo" puts it back.
    in property <string> rc-revoked;
    callback undo-revoke();

    // Network access (ADR-0046): other computers connect over TLS. Off by default.
    in property <bool> rc-network;
    // "Allow remote admin": Full control tokens keep admin from other computers.
    in property <bool> rc-remote-admin;
    // Other computers can connect now: the frame shows it in every workspace.
    in property <bool> rc-network-on;
    // Where other computers connect, or why they cannot; `-bad` marks a problem.
    in property <string> rc-network-status;
    in property <bool> rc-network-status-bad;
    // What clients check: the key pin, and the certificate fingerprint.
    in property <string> rc-key-pin;
    in property <string> rc-fingerprint;
    // Where the certificate came from, and whether it was just renewed.
    in property <string> rc-cert-note;
    // A problem with a network access change (files, new key); empty when none.
    in property <string> rc-network-note;
    // The user's own certificate is used, and its files.
    in property <bool> rc-own;
    in property <string> rc-own-cert;
    in property <string> rc-own-key;
    callback set-rc-network(bool);
    callback set-rc-remote-admin(bool);
    callback rc-use-own(string /* certificate */, string /* key */);
    callback rc-use-generated();
    callback rc-new-key();

    // Output profiles and scene collections (ADR-0051): the entries, the one in use,
    // and the menu actions. Actions: 0 new, 1 duplicate (both with a name and then
    // used), 2 rename the one in use, 3 delete the one in use, 4 import a file,
    // 5 export the one in use to a file.
    in property <[EntryRow]> profiles;
    in property <string> profile-name;
    in property <[EntryRow]> collections;
    in property <string> collection-name;
    // A scene collection switch is running (the studio restarts).
    in property <bool> switching;
    callback switch-profile(string /* id */);
    callback profile-action(int /* action */, string);
    callback switch-collection(string /* id */);
    callback collection-action(int /* action */, string);
}

// The add-source picker: a kind, then what it captures. Keyboard: arrows are not
// needed; Tab moves through the items, Return picks, Escape closes.
export component AddSourceMenu inherits PopupWindow {
    close-policy: close-on-click-outside;
    width: Tokens.size-menu-sm;
    property <string> kind-label;
    MenuSurface {
        width: Tokens.size-menu-sm;
        accessible-role: list;
        accessible-label: Studio.picker-kind < 0 ? @tr("Add source: choose a type") : @tr("Add {}: choose what it captures", kind-label);
        VerticalLayout {
            padding: Tokens.space-2;
            spacing: Tokens.space-1;
            if Studio.picker-kind < 0: VerticalLayout {
                spacing: Tokens.space-1;
                for k[i] in Studio.kinds: MenuItem {
                    autofocus: i == 0;
                    text: k.label;
                    activated => {
                        Studio.picker-kind = k.code;
                        kind-label = k.label;
                        Studio.list-targets(k.code);
                    }
                }
                // A source another scene has: the same device, one instance.
                if Studio.existing.length > 0: MenuItem {
                    text: @tr("Existing source");
                    activated => { Studio.picker-kind = 1000; kind-label = @tr("existing source"); }
                }
                if Studio.kinds.length == 0: Text {
                    text: Studio.state == 0 ? @tr("The studio is starting.") : @tr("No source types are available on this system.");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-body-size;
                    wrap: word-wrap;
                }
            }
            if Studio.picker-kind == 1000: VerticalLayout {
                spacing: Tokens.space-1;
                MenuItem {
                    text: @tr("Back to source types");
                    activated => { Studio.picker-kind = -1; }
                }
                Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
                for e[i] in Studio.existing: MenuItem {
                    autofocus: i == 0;
                    text: e.name;
                    activated => {
                        Studio.add-existing-source(e.id);
                        root.close();
                    }
                }
            }
            if Studio.picker-kind >= 0 && Studio.picker-kind != 1000: VerticalLayout {
                spacing: Tokens.space-1;
                MenuItem {
                    autofocus: Studio.targets-kind != Studio.picker-kind || Studio.targets.length == 0;
                    text: @tr("Back to source types");
                    activated => { Studio.picker-kind = -1; }
                }
                Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
                if Studio.targets-kind != Studio.picker-kind: Text {
                    text: @tr("Looking for devices…");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-body-size;
                }
                if Studio.targets-kind == Studio.picker-kind && Studio.targets.length == 0: Text {
                    text: @tr("Nothing of this type was found.");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-body-size;
                    wrap: word-wrap;
                }
                if Studio.targets-kind == Studio.picker-kind: VerticalLayout {
                    spacing: Tokens.space-1;
                    for t[i] in Studio.targets: MenuItem {
                        autofocus: i == 0;
                        text: t.is-default ? @tr("{} (default)", t.name) : t.name;
                        activated => {
                            Studio.add-source(Studio.picker-kind, i);
                            root.close();
                        }
                    }
                }
            }
        }
    }
}

// The canvas as the viewers see it. The picture is a native layer the app places over
// this rectangle; Slint draws only the background and the letterbox bars.
export component ProgramPanel inherits Rectangle {
    // "rbs.program" or "rbs.preview".
    in property <string> panel;
    in property <string> title;
    // In studio mode both panels have a picture: Preview the preview scene, Program the
    // scene on air (ADR-0061).
    property <bool> scene: Studio.studio-mode && panel == "rbs.preview";
    property <bool> here: Studio.studio-mode || Studio.picture-panel == panel;
    property <int> shown: !here ? 6 : scene ? Studio.scene-preview-state : Studio.preview-state;
    background: Theme.surface-sunken;
    accessible-role: image;
    accessible-label: title;
    accessible-description: shown != 0 ? note.text
        : scene ? @tr("The picture of the preview scene, the next to go on air")
        : @tr("The live picture of the scene on air");
    note := Text {
        visible: shown != 0;
        width: parent.width - 2 * Tokens.space-4;
        text: shown == 1 ? (scene ? @tr("The preview is starting.") : @tr("The program is starting."))
            : shown == 2 && scene ? @tr("The preview scene's own picture is not available on this platform yet. Its sources are in the Sources panel, and Transition puts it on air.")
            : shown == 2 ? @tr("The program picture is not available on this platform yet.")
            : shown == 3 ? @tr("The program picture cannot be shown in this session, for example over remote desktop.")
            : shown == 4 ? @tr("The picture shows in the main window. Dock this panel back to see it here.")
            : shown == 6 ? @tr("Studio mode is off, so the scene on air shows in the Program panel.")
            : @tr("The studio is not running: {}", Studio.failure);
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    // Selecting, moving and resizing sources on the picture (ADR-0048). Arrow keys move
    // the selected source by 1 canvas pixel, with Shift by 10; Escape clears the
    // selection.
    // In studio mode the preview scene is edited, on the Preview picture only.
    property <bool> editable: here && Studio.state == 1 && (!Studio.studio-mode || scene);
    keys := FocusScope {
        enabled: editable;
        key-pressed(e) => {
            if Studio.selected-source < 0 { return reject; }
            let step = e.modifiers.shift ? 10 : 1;
            if e.text == Key.LeftArrow { Studio.preview-nudge(-step, 0); return accept; }
            if e.text == Key.RightArrow { Studio.preview-nudge(step, 0); return accept; }
            if e.text == Key.UpArrow { Studio.preview-nudge(0, -step); return accept; }
            if e.text == Key.DownArrow { Studio.preview-nudge(0, step); return accept; }
            if e.text == Key.Escape { Studio.preview-deselect(); return accept; }
            reject
        }
    }
    // A right-click on the picture: the menu of the source under the pointer (it
    // becomes the selection), else the panel's own menu.
    property <Point> menu-at;
    menu := CommandMenu {
        context: "preview";
        target: "h=" + round(touch.height / 1px) + "&id=" + root.panel + "&w=" + round(touch.width / 1px)
            + "&x=" + round(root.menu-at.x / 1px) + "&y=" + round(root.menu-at.y / 1px);
    }
    touch := TouchArea {
        enabled: editable;
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { Studio.preview-release(); return; }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                keys.focus();
                root.menu-at = { x: self.mouse-x, y: self.mouse-y };
                menu.open(root.menu-at);
                return;
            }
            if e.button != PointerEventButton.left { return; }
            if e.kind == PointerEventKind.down {
                keys.focus();
                Studio.preview-press(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, e.modifiers.shift, e.modifiers.control || e.modifiers.meta, e.modifiers.alt);
            }
            if e.kind == PointerEventKind.up { Studio.preview-release(); }
        }
        moved => {
            if self.pressed { Studio.preview-drag(self.mouse-x / 1px, self.mouse-y / 1px); }
        }
    }
    // Where no layer shows the picture, the toolkit draws the selection itself, clipped
    // to the panel like the layer's marks.
    if shown != 0 && editable: Rectangle {
        clip: true;
        for m in Studio.marks: Rectangle {
            x: m.x;
            y: m.y;
            width: m.w;
            height: m.h;
            background: m.kind == 2 ? Theme.surface-raised : Theme.accent;
        }
    }
}

// One row of the Sources list (spec Frame, mockup E): the kind's icon, the name (the
// state below it only when something is wrong), and on the right Show/Hide, then on the
// selected row Move up, Move down and Delete source.
component SourceRowView inherits Rectangle {
    in property <SourceData> data;
    // Move up, Move down or Delete source was activated: the list is made again, so
    // the row's buttons and their focus are about to go.
    callback leaving();
    property <bool> selected: Studio.selected-source == data.id;
    property <color> ink: data.visible ? Theme.text-primary : Theme.text-disabled;
    // Layer and delete buttons show while the pointer is over the row, so names keep
    // their room; on a focused row Alt+Up, Alt+Down and Delete do the same.
    property <bool> tools: touch.has-hover && !editing;
    // Another row is dragged over this one: it would take this row's place.
    property <bool> drop-here: drop.has-drag && Studio.dragging-source != data.id;
    height: data.ok ? Tokens.size-control-md : Tokens.size-control-md + Tokens.type-caption-line;
    border-radius: Tokens.radius-md;
    background: selected ? Theme.accent-subtle : touch.has-hover ? Theme.surface-overlay : transparent;
    border-width: selected ? Tokens.size-border : 0px;
    border-color: Theme.accent;
    accessible-role: list-item;
    accessible-label: @tr("{}, {}, {}{}{}", data.name, data.kind, data.status, data.visible ? "" : @tr(", hidden"), data.locked ? @tr(", locked") : "");
    accessible-description: (data.global ? @tr("In every scene. ") : data.in-globals ? @tr("Also in every scene. ") : data.also-in != "" ? @tr("Also in {}. ", data.also-in) : "")
        + (data.picture ? @tr("Alt+Up or Alt+Down changes the layer, F2 renames it, Delete removes it from this scene, the Menu key or Shift+F10 opens its menu") : @tr("F2 renames it, Delete removes it from this scene, the Menu key or Shift+F10 opens its menu"));
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-action-default => { Studio.select-source(data.id); }
    // Return or Space selects the focused row; the TouchArea is after the FocusScope
    // so it gets the press (see Button).
    // Rename: from the menu, a shortcut, F2 or a double-click.
    in-out property <bool> editing;
    property <int> rename-asked: Studio.rename-source-asked;
    changed rename-asked => { root.take-rename(); }
    init => { root.take-rename(); }
    function take-rename() {
        if Studio.renaming-source == data.id { root.editing = true; Studio.renaming-source = -1; }
    }
    menu := CommandMenu {
        context: "source";
        target: "source=" + data.id;
    }
    focus := RingFocus {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { Studio.select-source(data.id); return accept; }
            if e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift) {
                menu.open({ x: Tokens.space-2, y: root.height });
                return accept;
            }
            if e.text == Key.F2 { root.editing = true; return accept; }
            if e.modifiers.alt && e.text == Key.UpArrow && data.picture && data.can-up {
                root.leaving(); Studio.move-source(data.id, true); return accept;
            }
            if e.modifiers.alt && e.text == Key.DownArrow && data.picture && data.can-down {
                root.leaving(); Studio.move-source(data.id, false); return accept;
            }
            if e.text == Key.Delete || e.text == Key.Backspace {
                root.leaving(); Studio.remove-from-scene(data.id); return accept;
            }
            reject
        }
    }
    // Rows of sources with a picture can be dragged onto each other to change the
    // layer order; a press without a drag selects the row.
    drop := DropArea {
        can-drop(e) => {
            return data.picture && Studio.dragging-source >= 0 && Studio.dragging-source != data.id ? DragAction.move : DragAction.none;
        }
        dropped(e) => {
            Studio.move-source-to(Studio.dragging-source, data.id);
            Studio.dragging-source = -1;
            return DragAction.move;
        }
    }
    drag := DragArea {
        allow-move: data.picture;
        data: Studio.source-data(data.id);
        changed dragging => {
            if self.dragging { Studio.dragging-source = data.id; } else { Studio.dragging-source = -1; }
        }
        touch := TouchArea {
            clicked => { focus.focus-pointer(); Studio.select-source(data.id); }
            double-clicked => { root.editing = true; }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    focus.focus-pointer();
                    Studio.select-source(data.id);
                    menu.open({ x: self.mouse-x, y: self.mouse-y });
                }
            }
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-1;
                spacing: Tokens.space-2;
                VerticalLayout {
                    alignment: center;
                    Icon { name: Icons.named(data.icon); ink: data.visible ? Theme.text-primary : Theme.text-disabled; }
                }
                if root.editing: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    TextField {
                        label: @tr("Name of the source {}", data.name);
                        text: data.name;
                        init => { self.focus(); }
                        accepted(t) => {
                            root.editing = false;
                            if t != data.name { Studio.rename-source(data.id, t); }
                        }
                    }
                }
                if !root.editing: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: Tokens.space-1;
                        // A source that is not running (its window closed, its camera
                        // unplugged): the mark and the reason say so, the name is dimmed
                        // (ADR-0077, U7: never colour alone).
                        if !data.ok: VerticalLayout {
                            alignment: center;
                            Icon { name: IconName.warning; ink: Theme.state-warning; }
                        }
                        Text {
                            text: data.name;
                            color: data.ok ? root.ink : Theme.text-disabled;
                            font-size: Tokens.type-body-size;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // In every scene, or also in other scenes (ADR-0065): one
                        // source, one device; the words are in the accessible
                        // description (U7). Hidden while the row tools show, so the
                        // name keeps its room.
                        if !tools && (data.global || data.in-globals): VerticalLayout {
                            alignment: center;
                            Icon { name: IconName.globe; ink: Theme.text-secondary; }
                        }
                        if !tools && !data.global && !data.in-globals && data.also-in != "": VerticalLayout {
                            alignment: center;
                            Icon { name: IconName.link; ink: Theme.text-secondary; }
                        }
                    }
                    // State in words, never colour alone (U7); shown when it needs attention.
                    if !data.ok: Text {
                        text: data.status;
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                        overflow: elide;
                    }
                }
                // Order matters for pictures only: sound has no layer to stack.
                if data.picture && tools: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: IconName.chevron-up;
                        name: @tr("Move {} up", data.name);
                        enabled: data.can-up;
                        clicked => { root.leaving(); Studio.move-source(data.id, true); }
                    }
                }
                if data.picture && tools: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: IconName.chevron-down;
                        name: @tr("Move {} down", data.name);
                        enabled: data.can-down;
                        clicked => { root.leaving(); Studio.move-source(data.id, false); }
                    }
                }
                if tools: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: IconName.close;
                        name: data.global ? @tr("Remove {} from global sources", data.name) : @tr("Remove {} from this scene", data.name);
                        clicked => { root.leaving(); Studio.remove-from-scene(data.id); }
                    }
                }
                // Shown or hidden in the scene: the icon and the accessible state both say it.
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: data.visible ? IconName.eye : IconName.eye-off;
                        name: data.visible ? @tr("Hide {}", data.name) : @tr("Show {}", data.name);
                        checked: !data.visible;
                        clicked => { Studio.set-source-visible(data.id, !data.visible); }
                    }
                }
                // Locked on the picture panel (sources with a picture only).
                if data.picture: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: data.locked ? IconName.lock : IconName.unlock;
                        name: data.locked ? @tr("Unlock {}", data.name) : @tr("Lock {}", data.name);
                        checked: data.locked;
                        clicked => { Studio.set-source-locked(data.id, !data.locked); }
                    }
                }
            }
        }
    }
    // Where a dragged row would go: a line along this row's top.
    if drop-here: Rectangle {
        y: 0;
        height: Tokens.size-focus-ring;
        background: Theme.accent;
    }
    FocusRing { show: focus.ring; border-radius: Tokens.radius-md; }
}

// One scene in the Scenes panel: its number, its name and, on air, a Live badge
// (mockup E). A click puts it on air; Rename and Remove show on hover, and F2 and
// Delete do the same on a focused row.
component SceneRowView inherits Rectangle {
    in property <SceneData> data;
    in property <bool> can-remove;
    // 0 nothing goes out, 1 streaming, 2 recording, 3 both (the shell's live state).
    in property <int> live-state;
    callback leaving();
    property <bool> tools: touch.has-hover || editing;
    in-out property <bool> editing;
    height: Tokens.size-control-md;
    border-radius: Tokens.radius-md;
    // The scene being worked on is marked like a selected row: the one shown, or in
    // studio mode the preview scene (ADR-0061). The live colour and badge only while
    // the scene on air actually goes out (streaming or recording, U12).
    property <bool> studio: Studio.studio-mode;
    property <bool> marked: studio ? data.preview : data.live;
    background: marked ? Theme.accent-subtle : touch.has-hover ? Theme.surface-overlay : transparent;
    // The selection marking only: the badge says the scene is on air (calm, U12).
    border-width: marked ? Tokens.size-border : 0px;
    border-color: Theme.accent;
    accessible-role: list-item;
    accessible-label: @tr("{}{}{}", data.name,
        studio && data.preview ? @tr(", in preview") : "",
        !data.live ? ""
        : root.live-state == 0 ? (studio ? @tr(", program") : @tr(", shown"))
        : root.live-state == 2 ? @tr(", on air and recording")
        : @tr(", on air"));
    accessible-description: Studio.studio-mode
        ? @tr("Return puts it in preview, F2 renames it, Delete removes it, the Menu key or Shift+F10 opens its menu")
        : @tr("Return puts it on air, F2 renames it, Delete removes it, the Menu key or Shift+F10 opens its menu");
    accessible-item-selectable: true;
    accessible-item-selected: data.live;
    accessible-action-default => { Studio.switch-scene(data.id); }
    property <int> rename-asked: Studio.rename-scene-asked;
    changed rename-asked => { root.take-rename(); }
    init => { root.take-rename(); }
    function take-rename() {
        if Studio.renaming-scene == data.id { root.editing = true; Studio.renaming-scene = -1; }
    }
    menu := CommandMenu {
        context: "scene";
        target: "scene=" + data.id;
    }
    focus := RingFocus {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { Studio.switch-scene(data.id); return accept; }
            if e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift) {
                menu.open({ x: Tokens.space-2, y: root.height });
                return accept;
            }
            if e.text == Key.F2 { root.editing = true; return accept; }
            if (e.text == Key.Delete || e.text == Key.Backspace) && root.can-remove {
                root.leaving(); Studio.remove-scene(data.id); return accept;
            }
            reject
        }
    }
    // The row's buttons sit inside its TouchArea, so pointing at them keeps the row
    // hovered; their space is always reserved, so the Live badge never moves (ADR-0059).
    touch := TouchArea {
        clicked => { focus.focus-pointer(); Studio.switch-scene(data.id); }
        double-clicked => { root.editing = true; }
        // A right-click opens the row's menu without putting the scene on air.
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                focus.focus-pointer();
                menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-2;
        Text {
            min-width: Tokens.size-icon-box;
            text: data.number;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            accessible-role: none;
        }
        if !root.editing: Text {
            horizontal-stretch: 1;
            text: data.name;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.editing: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            name-field := TextField {
                label: @tr("Name of the scene {}", data.name);
                text: data.name;
                init => { self.focus(); }
                accepted(t) => {
                    root.editing = false;
                    if t != data.name { Studio.rename-scene(data.id, t); }
                }
            }
        }
        // In studio mode the scene on air says so in neutral colours while nothing
        // goes out (ADR-0061).
        if studio && data.live && root.live-state == 0 && !root.editing: VerticalLayout {
            alignment: center;
            Rectangle {
                height: Tokens.type-caption-line;
                width: program-text.preferred-width + 2 * Tokens.space-2;
                border-radius: self.height / 2;
                background: Theme.surface-overlay;
                program-text := Text {
                    text: @tr("Program");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    font-weight: Tokens.type-label-weight;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
        // On air: in words with a small dot in the live colour (U7, U12), only while
        // it goes out. No filled badge: the live indicator already carries the state.
        if data.live && root.live-state != 0 && !root.editing: HorizontalLayout {
            spacing: Tokens.space-1 / 2;
            VerticalLayout {
                alignment: center;
                Icon { name: IconName.dot; ink: Theme.state-live; }
            }
            Text {
                text: root.live-state == 1 ? @tr("Live") : root.live-state == 2 ? @tr("REC") : @tr("Live · REC");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                font-weight: Tokens.type-label-weight;
                vertical-alignment: center;
            }
        }
        if !root.editing: VerticalLayout {
            alignment: center;
            IconButton {
                visible: root.tools;
                icon: IconName.more;
                name: @tr("Rename {}", data.name);
                clicked => { root.editing = true; }
            }
        }
        if !root.editing: VerticalLayout {
            alignment: center;
            IconButton {
                visible: root.tools && root.can-remove;
                icon: IconName.close;
                name: @tr("Remove scene {}", data.name);
                clicked => { root.leaving(); Studio.remove-scene(data.id); }
            }
        }
    }
    }
    FocusRing { show: focus.ring; border-radius: Tokens.radius-md; }
}

// The scenes the canvas may show (ADR-0059). A click puts one on air (a cut); the `+`
// in the card title row adds one. Removing the scene on air first puts the one
// before it on air; the last scene cannot be removed.
export component ScenesPanel inherits Rectangle {
    background: Theme.surface-raised;
    in property <int> live-state;
    property <int> asked: Studio.add-scene-asked;
    changed asked => { if Studio.state == 1 { Studio.add-scene(); } }
    // A right-click outside the rows: the panel's own menu (Add scene).
    panel-menu := CommandMenu { context: "scenes"; }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                panel-menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
    if Studio.scenes.length == 0: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("No scenes yet");
        message: Studio.state == 0 ? @tr("The studio is starting.") : @tr("The studio is not running.");
    }
    if Studio.scenes.length > 0: flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: max(rows.preferred-height, self.height);
        // Under the rows: the empty space below them opens the panel's menu.
        TouchArea {
            width: flick.content-width;
            height: flick.content-height;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    panel-menu.open({
                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                    });
                }
            }
        }
        rows := VerticalLayout {
            padding: Tokens.space-2;
            spacing: Tokens.space-1;
            alignment: start;
            for sc in Studio.scenes: SceneRowView {
                data: sc;
                can-remove: Studio.scenes.length > 1;
                live-state: root.live-state;
                leaving => { list-focus.focus(); }
            }
        }
    }
    list-focus := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }
}

// A heading in the Sources list: the global sources, then the scene's. While the
// studio is on air the Global heading says that its sources are on air in every scene,
// also while studio mode edits the preview scene (U4).
// The Global group's header (ADR-0065, ADR-0078): the shared SectionHeader with the count,
// closed by default, so the user knows global sources exist without them taking the list.
// While the program is on air the group says so.
component GlobalsHeader inherits Rectangle {
    in property <bool> open;
    height: head.height;
    head := SectionHeader {
        title: @tr("Global ({})", Studio.global-count);
        collapsible: true;
        open: root.open;
        toggled(o) => { Sections.set-closed("sources.global", !o); }
    }
    if Studio.on-air: Rectangle {
        x: parent.width - self.width;
        width: air.preferred-width + 2 * Tokens.space-2;
        height: Tokens.type-caption-line;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: Theme.state-live;
        air := Text {
            text: @tr("On air");
            color: Theme.text-on-live;
            font-size: Tokens.type-caption-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: @tr("On air in every scene");
        }
    }
}

export component SourcesPanel inherits Rectangle {
    background: Theme.surface-raised;
    // Add source lives in the panel card's title row; undo and redo in the Edit menu
    // and the usual keys (U4).
    property <length> header: 0px;
    // The Global group is closed until the user opens it (ADR-0078, ADR-0065).
    property <bool> globals-open: !Sections.closed("sources.global", Sections.rev);
    property <int> asked: Studio.add-source-asked;
    // Whoever asks sets `picker-kind` first: -1 for the list of types, or a type.
    changed asked => {
        if Studio.state == 1 { add-menu.show(); }
    }
    // A right-click outside the rows: the panel's own menu (Add source).
    panel-menu := CommandMenu { context: "sources"; }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                panel-menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
    if Studio.sources.length == 0: EmptyState {
        y: header;
        width: parent.width;
        height: parent.height - header;
        title: @tr("No sources yet");
        message: @tr("Add a screen, window, camera or audio device to the scene.");
        action: Studio.state == 1 ? @tr("Add source") : "";
        act => { Studio.picker-kind = -1; add-menu.show(); }
    }
    if Studio.sources.length > 0: flick := Flickable {
        y: header;
        width: parent.width;
        height: parent.height - header;
        content-height: max(rows.preferred-height, self.height);
        // Under the rows: the empty space below them opens the panel's menu.
        TouchArea {
            width: flick.content-width;
            height: flick.content-height;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    panel-menu.open({
                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                    });
                }
            }
        }
        rows := VerticalLayout {
            padding: Tokens.size-panel-pad;
            // Each entry spaces itself, so a folded global row takes no room.
            spacing: 0;
            alignment: start;
            for s[i] in Studio.sources: VerticalLayout {
                spacing: Tokens.space-1;
                padding-bottom: !s.global || root.globals-open || Studio.selected-source == s.id || i == 0 ? Tokens.space-1 : 0;
                // Global sources come first, under their own heading (ADR-0065): they
                // are drawn above every scene. The group is folded unless opened.
                if s.global && i == 0: GlobalsHeader { open: root.globals-open; }
                if !s.global && i > 0 && Studio.sources[i - 1].global: SectionHeader { title: @tr("This scene"); }
                if !s.global || root.globals-open || Studio.selected-source == s.id: SourceRowView {
                    data: s;
                    leaving => { list-focus.focus(); }
                }
            }
        }
    }
    // Takes the focus from a row that is made again (a layer move) or deleted, so
    // Ctrl+Z / Cmd+Z right after it still reaches the window's undo keys.
    list-focus := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }
    add-menu := AddSourceMenu {
        x: Tokens.space-2;
        y: Tokens.space-1;
    }
}

// One horizontal meter (AudioMeter, U16): bar with three zones, peak-hold line, clip
// box (outlined, filled once clipped), labelled scale under the strip.
component MeterView inherits Rectangle {
    in property <MeterRow> data;
    callback reset();
    // The name column: the kind's icon and the name, as wide as a third of a menu
    // at most (the scale under the bars lines up with it).
    in property <length> name-width;
    height: Tokens.size-control-md;
    accessible-role: progress-indicator;
    accessible-label: data.name;
    accessible-value: data.value;
    HorizontalLayout {
        spacing: Tokens.space-2;
        HorizontalLayout {
            width: root.name-width;
            spacing: Tokens.space-2;
            VerticalLayout {
                alignment: center;
                Icon { name: data.muted ? IconName.speaker-off : Icons.named(data.icon); ink: data.muted ? Theme.text-disabled : Theme.text-secondary; }
            }
            Text {
                text: data.name;
                color: data.muted ? Theme.text-disabled : Theme.text-primary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            bar := Rectangle {
            height: Tokens.space-3;
            background: Theme.surface-sunken;
            border-radius: Tokens.radius-sm;
            clip: true;
            Rectangle { x: parent.width * data.lo-from; width: parent.width * (data.lo-to - data.lo-from); background: Theme.meter-low; }
            Rectangle { x: parent.width * data.mi-from; width: parent.width * (data.mi-to - data.mi-from); background: Theme.meter-mid; }
            Rectangle { x: parent.width * data.hi-from; width: parent.width * (data.hi-to - data.hi-from); background: Theme.meter-high; }
            if data.peak > 0: Rectangle {
                x: max(0px, parent.width * data.peak - Tokens.size-meter-peak);
                width: Tokens.size-meter-peak;
                background: data.peak-zone == 2 ? Theme.meter-high : data.peak-zone == 1 ? Theme.meter-mid : Theme.meter-low;
            }
            }
        }
        clip-box := Rectangle {
            width: Tokens.size-icon-box;
            height: Tokens.size-icon-box;
            y: (root.height - self.height) / 2;
            border-width: Tokens.size-border;
            border-color: Theme.border-strong;
            border-radius: Tokens.radius-sm;
            background: data.clipped ? Theme.meter-clip : transparent;
            accessible-role: button;
            accessible-label: data.clipped ? @tr("Clipped. Reset the clip indicator of {}", data.name) : @tr("Not clipped: {}", data.name);
            accessible-action-default => { root.reset(); }
            TouchArea { clicked => { root.reset(); } }
        }
        // Mute (ADR-0059): the icon and the accessible state both say it (U7).
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: data.muted ? IconName.speaker-off : IconName.speaker;
                name: data.muted ? @tr("Unmute {}", data.name) : @tr("Mute {}", data.name);
                checked: data.muted;
                clicked => { Studio.set-source-muted(data.id, !data.muted); }
            }
        }
        // Hide (ADR-0080): the source leaves the Mixer and is still heard.
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.eye-off;
                name: @tr("Hide {} from the Mixer", data.name);
                clicked => { Studio.set-source-mixer-hidden(data.id, true); }
            }
        }
    }
}

// A hidden source (ADR-0080): its name and a button that shows it in the Mixer again.
component HiddenRow inherits Rectangle {
    in property <MeterRow> data;
    height: Tokens.size-control-md;
    HorizontalLayout {
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            Icon { name: data.muted ? IconName.speaker-off : Icons.named(data.icon); ink: Theme.text-secondary; }
        }
        Text {
            text: data.name;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.eye;
                name: @tr("Show {} in the Mixer", data.name);
                clicked => { Studio.set-source-mixer-hidden(data.id, false); }
            }
        }
    }
}

// One vertical meter strip for a wide, low Mixer (ADR-0078 decision 5): the name, a bar
// with the same three zones, peak line and clip box as MeterView, and the mute button.
component MeterStrip inherits Rectangle {
    in property <MeterRow> data;
    callback reset();
    width: Tokens.size-menu-sm * 0.42;
    background: Theme.surface-sunken;
    border-radius: Tokens.radius-md;
    accessible-role: progress-indicator;
    accessible-label: data.name;
    accessible-value: data.value;
    VerticalLayout {
        padding: Tokens.space-1;
        spacing: Tokens.space-1;
        Text {
            text: data.name;
            color: data.muted ? Theme.text-disabled : Theme.text-primary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;
            bar := Rectangle {
                width: Tokens.space-3;
                background: Theme.surface-base;
                border-radius: Tokens.radius-sm;
                clip: true;
                Rectangle { y: parent.height * (1 - data.lo-to); height: parent.height * (data.lo-to - data.lo-from); background: Theme.meter-low; }
                Rectangle { y: parent.height * (1 - data.mi-to); height: parent.height * (data.mi-to - data.mi-from); background: Theme.meter-mid; }
                Rectangle { y: parent.height * (1 - data.hi-to); height: parent.height * (data.hi-to - data.hi-from); background: Theme.meter-high; }
                if data.peak > 0: Rectangle {
                    y: min(parent.height - Tokens.size-meter-peak, parent.height * (1 - data.peak));
                    height: Tokens.size-meter-peak;
                    background: data.peak-zone == 2 ? Theme.meter-high : data.peak-zone == 1 ? Theme.meter-mid : Theme.meter-low;
                }
            }
        }
        // The clip box and the mute button share a row, so the bar gets the height.
        HorizontalLayout {
            alignment: center;
            spacing: Tokens.space-2;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: Tokens.size-icon-box;
                    height: Tokens.size-icon-box;
                    border-width: Tokens.size-border;
                    border-color: Theme.border-strong;
                    border-radius: Tokens.radius-sm;
                    background: data.clipped ? Theme.meter-clip : transparent;
                    accessible-role: button;
                    accessible-label: data.clipped ? @tr("Clipped. Reset the clip indicator of {}", data.name) : @tr("Not clipped: {}", data.name);
                    accessible-action-default => { root.reset(); }
                    TouchArea { clicked => { root.reset(); } }
                }
            }
            IconButton {
                icon: data.muted ? IconName.speaker-off : IconName.speaker;
                name: data.muted ? @tr("Unmute {}", data.name) : @tr("Mute {}", data.name);
                checked: data.muted;
                clicked => { Studio.set-source-muted(data.id, !data.muted); }
            }
            IconButton {
                icon: IconName.eye-off;
                name: @tr("Hide {} from the Mixer", data.name);
                clicked => { Studio.set-source-mixer-hidden(data.id, true); }
            }
        }
    }
}

// The Mixer (ADR-0078 decision 5): the panel's shape picks the layout. A wide, low panel
// draws vertical strips side by side, a cluster per group with its header above; a tall,
// narrow one draws horizontal rows under full-width headers. The groups are the program
// scene's own sources and the global ones; both headers fold and are saved by id.
export component MixerPanel inherits Rectangle {
    background: Theme.surface-raised;
    property <bool> wide: self.width > self.height * 1.5;
    property <bool> scene-closed: Sections.closed("mixer.scene", Sections.rev);
    property <bool> global-closed: Sections.closed("mixer.global", Sections.rev);
    property <bool> hidden-closed: Sections.closed("mixer.hidden", Sections.rev);
    property <bool> any: Studio.meters.length + Studio.hidden-meters.length > 0;
    property <length> name-width: min(root.width * 0.3, Tokens.size-menu-sm * 0.75);
    if !root.any: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("No audio sources");
        message: @tr("Add an audio input, system audio or application audio to see its levels here.");
        action: Studio.state == 1 ? @tr("Add source") : "";
        act => { Studio.picker-kind = -1; add-menu.show(); }
    }
    // Wide: strips in clusters, scrolling sideways when they do not fit.
    if root.any && root.wide: Flickable {
        width: parent.width;
        height: parent.height;
        content-width: max(clusters.preferred-width, self.width);
        content-height: root.height;
        clusters := HorizontalLayout {
            height: root.height;
            padding: Tokens.size-panel-pad;
            spacing: Tokens.size-section-gap;
            alignment: start;
            if Studio.meter-scenes > 0: VerticalLayout {
                spacing: Tokens.size-field-gap;
                SectionHeader {
                    title: @tr("This scene");
                    collapsible: true;
                    open: !root.scene-closed;
                    toggled(o) => { Sections.set-closed("mixer.scene", !o); }
                }
                if !root.scene-closed: HorizontalLayout {
                    // The height under the header, so the strips fill the panel.
                    height: max(0px, root.height - 2 * Tokens.size-panel-pad - Tokens.size-control-sm - Tokens.size-field-gap);
                    spacing: 0px;
                    for m[i] in Studio.meters: VerticalLayout {
                        padding-right: m.global ? 0px : Tokens.size-field-gap;
                        if !m.global: MeterStrip { data: m; reset => { Studio.reset-clip(i); } }
                    }
                }
            }
            if Studio.meter-globals > 0: VerticalLayout {
                spacing: Tokens.size-field-gap;
                SectionHeader {
                    title: @tr("Global ({})", Studio.meter-globals);
                    collapsible: true;
                    open: !root.global-closed;
                    toggled(o) => { Sections.set-closed("mixer.global", !o); }
                }
                if !root.global-closed: HorizontalLayout {
                    // The height under the header, so the strips fill the panel.
                    height: max(0px, root.height - 2 * Tokens.size-panel-pad - Tokens.size-control-sm - Tokens.size-field-gap);
                    spacing: 0px;
                    for m[i] in Studio.meters: VerticalLayout {
                        padding-right: !m.global ? 0px : Tokens.size-field-gap;
                        if m.global: MeterStrip { data: m; reset => { Studio.reset-clip(i); } }
                    }
                }
            }
            if Studio.hidden-meters.length > 0: VerticalLayout {
                width: Tokens.size-menu-sm;
                spacing: Tokens.size-field-gap;
                SectionHeader {
                    title: @tr("Hidden ({})", Studio.hidden-meters.length);
                    collapsible: true;
                    open: !root.hidden-closed;
                    toggled(o) => { Sections.set-closed("mixer.hidden", !o); }
                }
                if !root.hidden-closed: Flickable {
                    content-height: hidden-rows.preferred-height;
                    hidden-rows := VerticalLayout {
                        for m in Studio.hidden-meters: HiddenRow { data: m; }
                    }
                }
            }
        }
    }
    // Narrow: rows under full-width headers, then the labelled scale (dBFS).
    if root.any && !root.wide: Flickable {
        width: parent.width;
        height: parent.height;
        content-height: strips.preferred-height;
        strips := VerticalLayout {
            padding: Tokens.size-panel-pad;
            // Each entry spaces itself, so a folded group takes no room.
            spacing: 0px;
            alignment: start;
            if Studio.meter-scenes > 0: SectionHeader {
                title: @tr("This scene");
                collapsible: true;
                open: !root.scene-closed;
                toggled(o) => { Sections.set-closed("mixer.scene", !o); }
            }
            for m[i] in Studio.meters: VerticalLayout {
                padding-bottom: m.global || root.scene-closed ? 0px : Tokens.space-1;
                if !m.global && !root.scene-closed: MeterView {
                    name-width: root.name-width;
                    data: m;
                    reset => { Studio.reset-clip(i); }
                }
            }
            if Studio.meter-globals > 0: VerticalLayout {
                padding-top: Studio.meter-scenes > 0 ? Tokens.size-section-gap : 0px;
                SectionHeader {
                    title: @tr("Global ({})", Studio.meter-globals);
                    collapsible: true;
                    open: !root.global-closed;
                    toggled(o) => { Sections.set-closed("mixer.global", !o); }
                }
            }
            for m[i] in Studio.meters: VerticalLayout {
                padding-bottom: !m.global || root.global-closed ? 0px : Tokens.space-1;
                if m.global && !root.global-closed: MeterView {
                    name-width: root.name-width;
                    data: m;
                    reset => { Studio.reset-clip(i); }
                }
            }
            // The labelled scale (dBFS) under the bars, aligned with them.
            HorizontalLayout {
                spacing: Tokens.space-2;
                height: Tokens.type-caption-line;
                Rectangle { width: root.name-width; }
                scale-row := Rectangle {
                    // A narrow panel shows every second or third label, so none overlap.
                    property <int> step: self.width >= Tokens.size-menu-sm ? 1 : self.width >= Tokens.size-menu-sm / 2 ? 2 : 3;
                    for mark[i] in Studio.scale: Text {
                        visible: Math.mod(i, scale-row.step) == 0;
                        x: parent.width * mark.at - self.width / 2;
                        text: mark.label;
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                    }
                }
                Rectangle { width: Tokens.size-icon-box; }
                Rectangle { width: Tokens.size-control-sm; }
                Rectangle { width: Tokens.size-control-sm; }
            }
            if Studio.hidden-meters.length > 0: VerticalLayout {
                padding-top: Tokens.size-section-gap;
                SectionHeader {
                    title: @tr("Hidden ({})", Studio.hidden-meters.length);
                    collapsible: true;
                    open: !root.hidden-closed;
                    toggled(o) => { Sections.set-closed("mixer.hidden", !o); }
                }
                if !root.hidden-closed: VerticalLayout {
                    for m in Studio.hidden-meters: HiddenRow { data: m; }
                }
            }
        }
    }
    add-menu := AddSourceMenu {
        x: Tokens.space-2;
        y: Tokens.space-2;
    }
}

// Live controls: Go live and End stream, Record and Stop recording. The stream and the
// recording run at the same time or alone (ADR-0047). End stream asks first (U4: it
// cannot be undone). Under them, Start and Stop virtual camera (ADR-0066).
// The transition rail or panel (ADR-0061, UI spec Studio mode): the transition's name
// ("Cut", the only one for now) and, in studio mode, the Transition button that puts
// the preview scene on air. Narrower than 40 px it is only the button, floating over
// the bottom edge of the two views.
export component TransitionPanel inherits Rectangle {
    background: Theme.surface-raised;
    property <bool> narrow: root.width < Tokens.size-transition-narrow;
    property <bool> can: Studio.studio-mode && Studio.state == 1;
    if !narrow: VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-2;
        alignment: center;
        Text {
            text: @tr("Cut");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            accessible-role: none;
        }
        if root.can: Button {
            text: root.width < Tokens.size-transition-short ? @tr("Go") : @tr("Transition");
            kind: "primary";
            accessible-name: @tr("Transition: put the preview scene on air");
            clicked => { Studio.transition(); }
        }
        if !Studio.studio-mode && root.width >= Tokens.size-transition-short: Text {
            text: @tr("Turn on studio mode to prepare the next scene in Preview.");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if narrow && root.can: VerticalLayout {
        alignment: end;
        padding-bottom: Tokens.space-2;
        IconButton {
            icon: IconName.chevron-right;
            name: @tr("Transition: put the preview scene on air");
            clicked => { Studio.transition(); }
        }
    }
}

export component LiveControlsPanel inherits Rectangle {
    background: Theme.surface-raised;
    property <bool> recording: Studio.rec-state == 2;
    property <bool> live: Studio.st-state == 2;
    // "End stream" was pressed: the question shows until answered.
    property <bool> confirming: false;
    changed live => { if !live { confirming = false; } }
    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-2;
        alignment: start;
        HorizontalLayout {
            spacing: Tokens.space-2;
            alignment: start;
            Button {
                // While the stream ends the button says so (disabled) until the
                // output closed, so it never offers Go live too early.
                text: Studio.st-state == 3 ? @tr("Ending…") : live ? @tr("End stream") : @tr("Go live");
                kind: live || Studio.st-state == 3 ? "live" : "primary";
                enabled: Studio.state == 1 && !confirming
                    && (live || (Studio.st-state == 0 && Studio.rec-unavailable == ""));
                clicked => {
                    if live { confirming = true; } else { Studio.go-live(); }
                }
            }
            Button {
                // Stopping: the button says so (disabled) until the file is closed;
                // Record comes back only then.
                text: Studio.rec-state == 3 ? @tr("Stopping…") : recording ? @tr("Stop recording") : @tr("Record");
                kind: recording || Studio.rec-state == 3 ? "live" : "secondary";
                enabled: Studio.state == 1 && Studio.rec-unavailable == ""
                    && (recording || Studio.rec-state == 0);
                clicked => {
                    if recording { Studio.stop-recording(); } else { Studio.record(); }
                }
            }
        }
        if confirming: Rectangle {
            border-width: Tokens.size-border;
            border-color: Theme.border-strong;
            border-radius: Tokens.radius-sm;
            accessible-role: groupbox;
            accessible-label: @tr("End the stream?");
            // Keep streaming, the safe answer, has the focus.
            init => { keep.focus(); }
            VerticalLayout {
                padding: Tokens.space-2;
                spacing: Tokens.space-2;
                Text {
                    text: @tr("End the stream? Viewers see it end.");
                    color: Theme.text-primary;
                    font-size: Tokens.type-body-size;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    alignment: start;
                    // Its own name, so assistive technology never confuses it with
                    // the (disabled) End stream button above.
                    Button {
                        text: @tr("Yes, end the stream");
                        kind: "live";
                        clicked => {
                            confirming = false;
                            Studio.end-stream();
                        }
                    }
                    keep := Button {
                        text: @tr("Keep streaming");
                        clicked => { confirming = false; }
                    }
                }
            }
        }
        if Studio.st-text != "": Text {
            // The stream's state in words (U4, U9); the live indicator shows it too.
            text: Studio.st-text;
            color: Studio.st-bad ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        if Studio.st-needs-setup && Studio.st-state == 0: HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("Stream settings");
                clicked => { Studio.open-stream-settings(); }
            }
        }
        Text {
            // State in words (U4, U9); the live indicator shows it everywhere too.
            text: Studio.rec-state == 1 ? @tr("Starting the recording…")
                : Studio.rec-state == 2 ? @tr("Recording to {}", Studio.rec-file)
                : Studio.rec-state == 3 ? @tr("Stopping the recording and closing the file…")
                : Studio.rec-unavailable != "" ? Studio.rec-unavailable
                : Studio.rec-note;
            color: Studio.rec-state == 0 && (Studio.rec-unavailable != "" || Studio.rec-note-bad) ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        if Studio.rec-state == 2 && Studio.rec-note != "": Text {
            text: Studio.rec-note;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            wrap: word-wrap;
        }
        // The virtual camera: stopping asks nothing, the camera then shows its still
        // picture (ADR-0066 decision 12).
        if Studio.vcam-shown: HorizontalLayout {
            alignment: start;
            Button {
                text: Studio.vcam-on ? @tr("Stop virtual camera") : @tr("Start virtual camera");
                kind: Studio.vcam-on ? "live" : "secondary";
                enabled: Studio.vcam-can;
                clicked => { Studio.vcam-toggle(!Studio.vcam-on); }
            }
        }
        if Studio.vcam-shown && Studio.vcam-text != "": Text {
            // State in words (U4); the live indicator says "Virtual camera on" too.
            text: Studio.vcam-text;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
    }
}

// Children shown only while `shown`; takes no room otherwise (layouts have no
// `visible`, and an `if` would hide the popups' `open` from the form). The space
// above (`lead`) is part of it, so a hidden one leaves no gap in a layout with no
// spacing.
component Shown inherits Rectangle {
    in property <bool> shown;
    in property <length> gap: Tokens.space-1;
    in property <length> lead: 0;
    visible: shown;
    height: shown ? inner.preferred-height : 0;
    inner := VerticalLayout {
        padding-top: root.lead;
        spacing: root.gap;
        @children
    }
}

// A one-line explanation under a field (U2: every option explains itself).
component Hint inherits Text {
    color: Theme.text-secondary;
    font-size: Tokens.type-caption-size;
    wrap: word-wrap;
}

// A section title that does not collapse (ADR-0076): the same look as SectionHeader,
// with a rule to the end of the row, but plain text for screen readers.
component SectionTitle inherits HorizontalLayout {
    in property <string> title;
    spacing: Tokens.size-field-gap;
    VerticalLayout {
        alignment: center;
        Text {
            text: title.to-uppercase();
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            font-weight: Tokens.type-label-weight;
            letter-spacing: Tokens.size-tracking-caps;
            accessible-role: text;
            accessible-label: title;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
    }
}

// A collapsible group of fields under a SectionHeader. A closed section draws nothing and
// takes no room. Its state is saved in the workspace file under `id` (ADR-0078).
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> id;
    property <bool> closed: Sections.closed(root.id, Sections.rev);
    spacing: Tokens.size-field-gap;
    SectionHeader {
        title: root.title;
        collapsible: true;
        open: !root.closed;
        toggled(o) => { Sections.set-closed(root.id, !o); }
    }
    // Slint cannot put @children in an `if`, so a closed section is hidden and takes
    // no room (like Shown): it draws and handles no input.
    Rectangle {
        visible: !root.closed;
        height: root.closed ? 0px : inner.preferred-height;
        inner := VerticalLayout {
            spacing: Tokens.size-field-gap;
            @children
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: Tokens.space-1;
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    @children
}

// The encoder fields of one output, shared by the Recording and Stream sections, as
// rows of a settings card: the video encoder, its bitrate or quality level, the audio
// bitrate and, behind "Advanced settings" (U2), every other setting that changes the
// output's quality. `set(field, value)` reports a pick; field codes (rbs-app
// `studio_ui::enc_field`): 0 encoder, 1 video bitrate, 2 audio bitrate, 3 rate
// control, 4 maximum bitrate, 5 quality level, 6 padding (value 0 or 1), 7 keyframe
// interval, 8 preset, 9 profile, 10 B-frames.
component EncoderFields inherits VerticalLayout {
    in property <EncoderData> data;
    // Not while the output runs.
    in property <bool> idle;
    // A stream: the hints speak of the stream instead of files.
    in property <bool> stream;
    callback set(int /* field */, int /* value */);
    // Advanced settings (U2): shown with the button below, in the same place.
    property <bool> advanced: false;
    out property <bool> menu-open: encoder.open || video.open || audio.open || quality.open
        || mode.open || peak.open || keyframe.open || profile.open || bframes.open;
    SettingRow {
        divider: false;
        label: @tr("Video encoder");
        help: @tr("Automatic picks the best one this computer has.");
        enabled: root.idle;
        encoder := Select {
            label: @tr("Video encoder");
            options: root.data.encoders;
            index: root.data.encoder;
            enabled: root.idle;
            selected(i) => { root.set(0, i); }
        }
    }
    // The bitrate (CBR, VBR) or the quality level (constant quality): one slot.
    Shown {
        shown: root.data.rate-kind != 2;
        gap: 0;
        SettingRow {
            label: root.data.bitrate-label;
            help: root.stream ? @tr("Most of the picture's quality. Use what your streaming service recommends.")
                : @tr("Most of the picture's quality; larger values make larger files.");
            enabled: root.idle;
            video := Select {
                label: root.data.bitrate-label;
                options: root.data.video-rates;
                index: root.data.video-rate;
                enabled: root.idle && root.data.rate-kind != 2;
                selected(i) => { root.set(1, i); }
            }
        }
    }
    Shown {
        shown: root.data.rate-kind == 2;
        gap: 0;
        SettingRow {
            label: @tr("Quality level");
            help: @tr("Lower is better quality and larger files.");
            enabled: root.idle;
            quality := Select {
                label: @tr("Quality level");
                options: root.data.qualities;
                index: root.data.quality;
                enabled: root.idle && root.data.rate-kind == 2;
                selected(i) => { root.set(5, i); }
            }
        }
    }
    SettingRow {
        label: @tr("Audio bitrate");
        help: @tr("AAC. 160 kbit/s suits most voices and music.");
        enabled: root.idle;
        audio := Select {
            label: @tr("Audio bitrate");
            options: root.data.audio-rates;
            index: root.data.audio-rate;
            enabled: root.idle;
            selected(i) => { root.set(2, i); }
        }
    }
    SettingRow {
        label: @tr("Advanced settings");
        help: @tr("Rate control, keyframes, preset, profile and B-frames. The defaults suit most uses.");
        fill: false;
        Button {
            text: root.advanced ? @tr("Hide") : @tr("Show");
            accessible-name: root.advanced ? @tr("Hide advanced settings") : @tr("Show advanced settings");
            kind: "secondary";
            icon: root.advanced ? IconName.chevron-up : IconName.chevron-down;
            clicked => { root.advanced = !root.advanced; }
        }
    }
    // Advanced: every other setting that changes the output's quality.
    Shown {
        shown: root.advanced;
        gap: 0;
        SettingRow {
            label: @tr("Rate control");
            help: root.data.rate-kind == 0 ? @tr("CBR: the same bitrate all the time. The default.")
                : root.data.rate-kind == 1 ? @tr("VBR: the bitrate follows the picture, up to the maximum. CBR is the default.")
                : @tr("Constant quality: the same quality all the time; file size varies. CBR is the default.");
            enabled: root.idle;
            mode := Select {
                label: @tr("Rate control");
                options: root.data.rate-modes;
                index: root.data.rate-mode;
                enabled: root.idle && root.advanced;
                selected(i) => { root.set(3, i); }
            }
        }
        Shown {
            shown: root.data.rate-kind == 1;
            gap: 0;
            SettingRow {
                label: @tr("Maximum bitrate");
                help: @tr("The most VBR may use for a moment. Automatic is 1.5 x the target bitrate.");
                enabled: root.idle;
                peak := Select {
                    label: @tr("Maximum bitrate");
                    options: root.data.peaks;
                    index: root.data.peak;
                    enabled: root.idle && root.advanced && root.data.rate-kind == 1;
                    selected(i) => { root.set(4, i); }
                }
            }
        }
        Shown {
            shown: root.data.rate-kind == 0;
            gap: 0;
            SettingRow {
                label: @tr("Pad to the full bitrate");
                help: root.data.padding-available
                    ? @tr("Adds filler data so a still picture still uses the whole bitrate. Off by default.")
                    : @tr("This encoder cannot pad the bitrate.");
                enabled: root.idle && root.data.padding-available;
                fill: false;
                Toggle {
                    label: @tr("Pad to the full bitrate");
                    checked: root.data.padding;
                    enabled: root.idle && root.advanced && root.data.rate-kind == 0 && root.data.padding-available;
                    toggled(on) => { root.set(6, on ? 1 : 0); }
                }
            }
        }
        SettingRow {
            label: @tr("Keyframe interval");
            help: root.stream
                ? @tr("How often a full picture is sent. Most streaming services require 2 s, the default.")
                : @tr("How often a full picture is stored. Shorter makes seeking faster and files larger.");
            enabled: root.idle;
            keyframe := Select {
                label: @tr("Keyframe interval");
                options: root.data.keyframes;
                index: root.data.keyframe;
                enabled: root.idle && root.advanced;
                selected(i) => { root.set(7, i); }
            }
        }
        SettingRow {
            label: @tr("Encoder preset");
            help: @tr("Quality uses more of the GPU's encoder; Speed uses less. Balanced is the default.");
            enabled: root.idle;
            fill: false;
            SegmentedControl {
                label: @tr("Encoder preset");
                options: root.data.presets;
                index: root.data.preset;
                enabled: root.idle && root.advanced;
                selected(i) => { root.set(8, i); }
            }
        }
        SettingRow {
            label: @tr("Profile");
            help: @tr("Automatic lets the encoder pick, the default. Baseline plays on the oldest devices.");
            enabled: root.idle;
            profile := Select {
                label: @tr("Profile");
                options: root.data.profiles;
                index: root.data.profile;
                enabled: root.idle && root.advanced;
                selected(i) => { root.set(9, i); }
            }
        }
        SettingRow {
            label: @tr("B-frames");
            help: root.data.b-frames-note != "" ? root.data.b-frames-note
                : @tr("More B-frames save bits and add a little delay. 0 is the default.");
            enabled: root.idle && root.data.b-frames-note == "";
            bframes := Select {
                label: @tr("B-frames");
                options: root.data.b-frames;
                index: root.data.b-frame;
                enabled: root.idle && root.advanced && root.data.b-frames-note == "";
                selected(i) => { root.set(10, i); }
            }
        }
    }
}

// The selected source's properties. For now: where its picture is on the canvas
// (position and size in canvas pixels). Rotation, crop and filters come later.
// Shape and border of a picture (ADR-0053), under its position and size. Every change
// is one undo step.
component StyleFields inherits Section {
    in property <SourceData> data;
    // The colour that stands. The field's text is set from it whenever it changes,
    // because setting the text after an edit ends the field's binding.
    property <string> colour-text: data.border-color;
    changed colour-text => { colour.text = colour-text; }
    title: @tr("Shape and border");
    id: "properties.shape";
    Field {
        label: @tr("Shape");
        SegmentedControl {
            label: @tr("Shape of {}", data.name);
            options: [@tr("Rectangle"), @tr("Circle"), @tr("Ellipse")];
            index: data.shape;
            selected(i) => {
                Studio.set-source-style(data.id, i, i == 0 ? data.radius : 0, data.border, data.border-width, data.border-color);
            }
        }
    }
    Shown {
        shown: data.shape == 0;
        Field {
            label: @tr("Corner radius");
            NumberField {
                label: @tr("Corner radius of {}", data.name);
                value: data.radius;
                edited(v) => {
                    Studio.set-source-style(data.id, 0, max(v, 0), data.border, data.border-width, data.border-color);
                }
            }
        }
    }
    Hint {
        text: data.shape == 1
            ? @tr("The largest circle that fits in the box, centred. Make the box square for a full circle of the picture.")
            : data.shape == 2 ? @tr("The ellipse that fills the box.")
            : @tr("In canvas pixels. 0 keeps square corners; half the shorter side makes round ends.");
    }
    Checkbox {
        text: @tr("Border");
        checked: data.border;
        toggled(on) => {
            Studio.set-source-style(data.id, data.shape, data.radius, on, data.border-width, data.border-color);
        }
    }
    Shown {
        shown: data.border;
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Field {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Width");
                NumberField {
                    label: @tr("Border width of {}", data.name);
                    value: data.border-width;
                    edited(v) => {
                        if v > 0 {
                            Studio.set-source-style(data.id, data.shape, data.radius, true, v, data.border-color);
                        }
                    }
                }
            }
            Field {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Colour");
                HorizontalLayout {
                    spacing: Tokens.size-field-gap;
                    // The colour as a swatch that opens the colour picker, beside its
                    // text (never colour alone, U7).
                    picker := ColorPicker {
                        label: @tr("Choose the border colour of {}", data.name);
                        value: data.border-swatch;
                        picked(c) => {
                            if c != data.border-color {
                                Studio.set-source-style(data.id, data.shape, data.radius, true, data.border-width, c);
                            }
                        }
                    }
                    colour := TextField {
                        label: @tr("Border colour of {}", data.name);
                        text: data.border-color;
                        accepted(t) => {
                            if t != data.border-color {
                                Studio.set-source-style(data.id, data.shape, data.radius, true, data.border-width, t);
                            }
                            // A refused colour goes back to the one that stands; an
                            // accepted one arrives through `colour-text`.
                            self.text = data.border-color;
                        }
                    }
                }
            }
        }
        Hint {
            text: @tr("Drawn inside the edge, so the box stays the same. Colour as #rrggbb, or #rrggbbaa with transparency.");
        }
    }
}

// Crop of a picture in source pixels (ADR-0058), under its position and size. Every
// change is one undo step and keeps the picture's scale; the Region buttons show a part
// of the picture as large as the canvas allows.
component CropFields inherits Section {
    in property <SourceData> data;
    property <bool> known: data.pic-w > 0;
    title: @tr("Crop");
    id: "properties.crop";
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Left");
            label: @tr("Crop left of {}", data.name);
            value: data.crop-l;
            enabled: known;
            edited(v) => { Studio.set-source-crop(data.id, max(v, 0), data.crop-t, data.crop-r, data.crop-b); }
        }
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Right");
            label: @tr("Crop right of {}", data.name);
            value: data.crop-r;
            enabled: known;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, data.crop-t, max(v, 0), data.crop-b); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Top");
            label: @tr("Crop top of {}", data.name);
            value: data.crop-t;
            enabled: known;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, max(v, 0), data.crop-r, data.crop-b); }
        }
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Bottom");
            label: @tr("Crop bottom of {}", data.name);
            value: data.crop-b;
            enabled: known;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, data.crop-t, data.crop-r, max(v, 0)); }
        }
    }
    Text {
        text: @tr("Show");
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        accessible-role: none;
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Button {
            horizontal-stretch: 1;
            text: @tr("Canvas size");
            kind: "secondary";
            enabled: known;
            accessible-name: @tr("Show the centre of {} at canvas size", data.name);
            clicked => { Studio.set-source-region(data.id, 1); }
        }
        Button {
            horizontal-stretch: 1;
            text: @tr("Whole picture");
            kind: "secondary";
            enabled: known;
            accessible-name: @tr("Show all of {}, fitted to the canvas", data.name);
            clicked => { Studio.set-source-region(data.id, 0); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Button {
            horizontal-stretch: 1;
            text: @tr("Left half");
            kind: "secondary";
            enabled: known;
            accessible-name: @tr("Show the left half of {}", data.name);
            clicked => { Studio.set-source-region(data.id, 2); }
        }
        Button {
            horizontal-stretch: 1;
            text: @tr("Right half");
            kind: "secondary";
            enabled: known;
            accessible-name: @tr("Show the right half of {}", data.name);
            clicked => { Studio.set-source-region(data.id, 3); }
        }
    }
    Hint {
        text: known
            ? @tr("In pixels of the {}x{} picture. The box changes so the picture keeps its scale. Alt-drag a handle on the picture panel to crop there.", data.pic-w, data.pic-h)
            : @tr("Available once the source shows a picture.");
    }
}

// The Transform tab: where the picture is on the canvas, its crop, shape and border.
component TransformFields inherits VerticalLayout {
    in property <SourceData> data;
    spacing: Tokens.size-section-gap;
    alignment: start;
    if data.picture: Section {
        title: @tr("Position and size");
        id: "properties.position";
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            // Equal columns, whatever the values' lengths.
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("X");
                label: @tr("Position X of {}", data.name);
                value: data.x;
                edited(v) => { Studio.set-source-box(data.id, v, data.y, data.w, data.h); }
            }
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("Y");
                label: @tr("Position Y of {}", data.name);
                value: data.y;
                edited(v) => { Studio.set-source-box(data.id, data.x, v, data.w, data.h); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("W");
                label: @tr("Width of {}", data.name);
                value: data.w;
                edited(v) => { Studio.set-source-box(data.id, data.x, data.y, v, data.h); }
            }
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("H");
                label: @tr("Height of {}", data.name);
                value: data.h;
                edited(v) => { Studio.set-source-box(data.id, data.x, data.y, data.w, v); }
            }
        }
        Hint {
            text: @tr("In canvas pixels, from the top-left corner. Up and Down arrows change a value by 1, with Shift by 10.");
        }
    }
    if data.picture: CropFields { data: data; }
    if data.picture: StyleFields { data: data; }
}

// The sound of a source and its sync offset: the Audio tab (ADR-0059, ADR-0062).
// Volume, mute and the offset are live controls, not undo steps.
component AudioFields inherits VerticalLayout {
    in property <SourceData> data;
    spacing: Tokens.size-section-gap;
    alignment: start;
    Section {
        title: @tr("Sound");
        id: "properties.sound";
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Slider {
                horizontal-stretch: 1;
                label: @tr("Volume of {}", data.name);
                value: data.volume;
                value-text: data.volume-text;
                enabled: !data.muted;
                moved(v) => { Studio.set-source-volume(data.id, v); }
            }
            Text {
                min-width: Tokens.size-control-md * 1.5;
                text: data.volume-text;
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                horizontal-alignment: right;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        Checkbox {
            text: @tr("Mute");
            checked: data.muted;
            toggled(on) => { Studio.set-source-muted(data.id, on); }
        }
    }
    Section {
        title: @tr("Sync offset");
        id: "properties.sync";
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Sync offset of {} in milliseconds", data.name);
                value: data.sync-offset;
                step: 10;
                edited(v) => { Studio.set-source-sync-offset(data.id, round(max(-200, min(200, v)))); }
            }
            Text {
                text: @tr("ms");
                color: Theme.text-secondary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        Hint {
            text: @tr("Delays this source's sound (positive) or plays it earlier (negative) to match the picture, from -200 to 200 ms. Playing it earlier is limited by the audio latency.");
        }
    }
}

// One filter in the chain: its on/off Checkbox named after it, then Move up, Move down
// and Remove. A click on the row selects it, so its fields show below the list.
component FilterRowView inherits Rectangle {
    in property <SourceData> source;
    in property <FilterData> data;
    in property <int> index;
    in property <bool> selected;
    height: max(Tokens.size-control-md, row.preferred-height);
    border-radius: Tokens.radius-sm;
    background: selected ? Theme.accent-subtle : touch.has-hover ? Theme.surface-overlay : transparent;
    touch := TouchArea {
        clicked => { Studio.select-filter(source.id, data.id); }
    }
    row := HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-1;
        if data.known: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Checkbox {
                text: data.name;
                checked: data.enabled;
                accessible-label: @tr("Turn {} on or off", data.name);
                toggled(on) => {
                    Studio.select-filter(source.id, data.id);
                    Studio.set-filter-enabled(data.id, on);
                }
            }
        }
        if !data.known: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: data.name;
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                overflow: elide;
            }
            Text {
                text: @tr("Not available in this version");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.chevron-up;
                name: @tr("Move {} up", data.name);
                enabled: data.can-up;
                clicked => { Studio.move-filter(data.id, index - 1); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.chevron-down;
                name: @tr("Move {} down", data.name);
                enabled: data.can-down;
                clicked => { Studio.move-filter(data.id, index + 1); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.close;
                name: @tr("Remove {}", data.name);
                clicked => { Studio.remove-filter(data.id); }
            }
        }
    }
}

// One field of the selected filter, generated from its type's schema.
component FilterFieldView inherits VerticalLayout {
    in property <SourceData> source;
    in property <FilterData> filter;
    in property <FilterFieldData> data;
    in property <int> index;
    // The position while a drag is on, so the value beside the slider follows it.
    property <float> dragged: -1;
    property <bool> dragging: dragged >= 0;
    // The value at a slider position, as the host stores it (on its step).
    function text-at(p: float) -> string {
        let raw = data.min + max(0, min(1, p)) * (data.max - data.min);
        let v = data.snap > 0 ? max(data.min, min(data.max, data.min + round((raw - data.min) / data.snap) * data.snap)) : raw;
        return v.to-fixed(data.decimals) + data.suffix;
    }
    property <string> colour-text: data.colour;
    changed colour-text => { colour.text = colour-text; }
    spacing: Tokens.space-1;
    Text {
        text: data.label;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    if data.kind == 0: HorizontalLayout {
        spacing: Tokens.space-2;
        Slider {
            horizontal-stretch: 1;
            label: @tr("{} of {}", data.label, filter.name);
            value: dragging ? dragged : data.position;
            value-text: dragging ? root.text-at(dragged) : data.value-text;
            step: data.step;
            enabled: filter.known;
            moved(v) => {
                root.dragged = v;
                Studio.preview-filter(filter.id, index, v);
            }
            released => {
                root.dragged = -1;
                Studio.commit-filter(filter.id);
            }
            cancelled => {
                root.dragged = -1;
                Studio.cancel-filter(filter.id);
            }
        }
        Text {
            min-width: Tokens.size-control-md * 1.5;
            text: dragging ? root.text-at(dragged) : data.value-text;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    Shown {
        shown: data.kind == 1;
        HorizontalLayout {
            spacing: Tokens.space-2;
            ColorPicker {
                label: @tr("Choose the {} of {}", data.label, filter.name);
                value: data.swatch;
                picked(c) => {
                    if c != data.colour { Studio.set-filter-colour(filter.id, index, c); }
                }
            }
            colour := TextField {
                horizontal-stretch: 1;
                label: @tr("{} of {}", data.label, filter.name);
                text: data.colour;
                accepted(t) => {
                    if t != data.colour { Studio.set-filter-colour(filter.id, index, t); }
                    self.text = data.colour;
                }
            }
        }
    }
}

// Add filter: a menu button listing the filter types by name. The new filter goes at
// the end of the chain and is selected.
component AddFilterButton inherits Rectangle {
    in property <SourceData> source;
    height: Tokens.size-control-md;
    Button {
        width: root.width;
        height: root.height;
        text: @tr("Add filter");
        accessible-name: @tr("Add a filter to {}", source.name);
        lead: IconName.plus;
        icon: IconName.chevron-down;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        close-policy: close-on-click-outside;
        y: root.height;
        width: root.width;
        MenuSurface {
            width: root.width;
            accessible-role: list;
            accessible-label: @tr("Add a filter to {}", source.name);
            VerticalLayout {
                padding: Tokens.space-2;
                spacing: Tokens.space-1;
                for t[i] in Studio.filter-types: MenuItem {
                    text: t;
                    autofocus: i == 0;
                    activated => { Studio.add-filter(source.id, i); menu.close(); }
                }
            }
        }
    }
}

// The Filters tab: the chain in order, Add filter, and the selected filter's fields.
component FiltersFields inherits VerticalLayout {
    in property <SourceData> data;
    spacing: Tokens.size-field-gap;
    alignment: start;
    SectionTitle { title: @tr("Filters"); }
    if data.filters.length == 0: Rectangle {
        height: empty.preferred-height;
        empty := EmptyState {
            width: parent.width;
            title: @tr("No filters");
            message: @tr("Add filter to change colours, key out a green screen, blur or sharpen this source.");
        }
    }
    for f[i] in data.filters: FilterRowView {
        source: data;
        data: f;
        index: i;
        selected: f.id == data.selected-filter;
    }
    AddFilterButton { source: data; }
    for f[i] in data.filters: VerticalLayout {
        spacing: Tokens.size-field-gap;
        if f.id == data.selected-filter && f.known: VerticalLayout {
            spacing: Tokens.size-field-gap;
            SectionTitle { title: f.name; }
            for field[j] in f.fields: FilterFieldView {
                source: data;
                filter: f;
                data: field;
                index: j;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Reset to defaults");
                    kind: "secondary";
                    accessible-name: @tr("Reset {} to defaults", f.name);
                    clicked => { Studio.reset-filter(f.id); }
                }
            }
        }
    }
}

// The Source tab: what the source captures now, and a list to point it at another target
// (ADR-0077). Reload tries a source that is not running again.
component SourceFields inherits VerticalLayout {
    in property <SourceData> data;
    property <int> source-id: data.id;
    spacing: Tokens.size-field-gap;
    init => { Studio.list-source-targets(data.id); }
    changed source-id => { Studio.list-source-targets(data.id); }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        if !data.ok: VerticalLayout {
            alignment: center;
            Icon { name: IconName.warning; ink: Theme.state-warning; }
        }
        Text {
            horizontal-stretch: 1;
            text: data.status;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        alignment: start;
        Button {
            text: @tr("Reload");
            accessible-name: @tr("Reload {}", data.name);
            dense: true;
            clicked => { Studio.reload-source(data.id); }
        }
        Button {
            text: @tr("Refresh list");
            dense: true;
            clicked => { Studio.list-source-targets(data.id); }
        }
    }
    TextField {
        label: @tr("Search the list");
        placeholder: @tr("Search");
        edited(t) => { Studio.filter-source-targets(t); }
    }
    if Studio.source-targets.length == 0: Text {
        text: @tr("Nothing of this type was found.");
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        wrap: word-wrap;
    }
    VerticalLayout {
        spacing: Tokens.space-1;
        for t in Studio.source-targets: MenuItem {
            text: t.name;
            checked: t.current;
            activated => { Studio.retarget-source(data.id, t.index); }
        }
    }
}

component SourceProperties inherits VerticalLayout {
    in property <SourceData> data;
    // Delete source asks first (ADR-0065).
    property <bool> confirm;
    changed data => { if confirm && Studio.selected-source != data.id { confirm = false; } }
    in property <int> live-state;
    // 0 Transform, 1 Filters, 2 Audio, 3 Source. The Source tab is the first one shown,
    // and opens by itself while the source is not running (ADR-0077).
    property <bool> has-source: data.kind-code >= 0;
    property <int> offset: has-source ? 1 : 0;
    property <int> want: Studio.properties-tab;
    property <int> tab: has-source && (!data.ok || want == 3) ? 3
        : !data.picture ? 2
        : want == 1 ? 1
        : want == 2 && data.audio ? 2
        : 0;
    spacing: Tokens.size-section-gap;
    alignment: start;
    // The source: its kind's icon, its name and kind, and its name as a field.
    VerticalLayout {
        spacing: Tokens.size-field-gap;
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            VerticalLayout {
                alignment: center;
                Icon { name: Icons.named(data.icon); ink: Theme.text-primary; }
            }
            Text {
                horizontal-stretch: 1;
                text: data.name;
                color: Theme.text-primary;
                font-size: Tokens.type-label-size;
                font-weight: Tokens.type-title-weight;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: data.kind;
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
            }
        }
        TextField {
            label: @tr("Name of {}", data.name);
            text: data.name;
            accepted(t) => { if t != data.name { Studio.rename-source(data.id, t); } }
        }
    }
    // Source, Transform, Filters and, for a source with sound, Audio (ADR-0062, ADR-0076, ADR-0077).
    if data.picture || has-source: Tabs {
        label: @tr("Properties of {}", data.name);
        options: has-source
            ? (data.picture
                ? (data.audio ? [@tr("Source"), @tr("Transform"), @tr("Filters"), @tr("Audio")] : [@tr("Source"), @tr("Transform"), @tr("Filters")])
                : [@tr("Source"), @tr("Audio")])
            : (data.audio ? [@tr("Transform"), @tr("Filters"), @tr("Audio")] : [@tr("Transform"), @tr("Filters")]);
        index: tab == 3 ? 0 : data.picture ? offset + tab : offset;
        selected(i) => {
            if has-source && i == 0 { Studio.properties-tab = 3; }
            else if data.picture { Studio.properties-tab = i - offset; }
            else { Studio.properties-tab = 2; }
        }
    }
    // Filters and the sync offset belong to the source: an edit shows on air at once.
    if live-state != 0 && (tab == 1 || tab == 2): HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Rectangle {
            width: on-air.preferred-width + 2 * Tokens.space-2;
            height: Tokens.type-caption-line;
            border-radius: self.height / 2;
            background: Theme.state-live;
            on-air := Text {
                text: @tr("On air");
                color: Theme.text-on-live;
                font-size: Tokens.type-caption-size;
                font-weight: Tokens.type-label-weight;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Changes here show in the program at once.");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    if tab == 3: SourceFields { data: data; }
    if tab == 0: TransformFields { data: data; }
    if tab == 1: FiltersFields { data: data; }
    if tab == 2: AudioFields { data: data; }
    // Global sources (ADR-0065): on, the source is shown and heard in every scene.
    Section {
        title: @tr("Scenes");
        id: "properties.scenes";
        Toggle {
            text: @tr("Show in every scene");
            label: @tr("Show {} in every scene", data.name);
            checked: data.global;
            toggled(on) => { Studio.set-global(data.id, on); }
        }
        Hint {
            text: data.global
                ? @tr("Turning this off moves it into this scene only, and off air until the next transition in studio mode.")
                : @tr("It then leaves the scenes that have it and is drawn above every scene.");
        }
    }
    // Delete source: every scene. With more than one placement it asks first.
    Section {
        title: @tr("Remove");
        id: "properties.remove";
        if !confirm: HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("Delete source");
                accessible-name: @tr("Delete source {}", data.name);
                kind: "danger";
                dense: true;
                clicked => {
                    if data.places > 1 { confirm = true; } else { Studio.delete-source(data.id); }
                }
            }
        }
        if confirm: SettingsCallout {
            label: @tr("Delete {} from every scene?", data.name);
            Text {
                text: data.global || data.in-globals
                    ? (data.places > 2 ? @tr("{} is in every scene and {} more. Delete it from all of them?", data.name, data.places - 1) : data.places == 2 ? @tr("{} is in every scene and 1 more. Delete it from all of them?", data.name) : @tr("{} is in every scene. Delete it?", data.name))
                    : @tr("{} is in {} scenes. Delete it from all of them?", data.name, data.places);
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Tokens.size-field-gap;
                alignment: start;
                Button {
                    text: @tr("Delete source");
                    kind: "danger";
                    dense: true;
                    clicked => { confirm = false; Studio.delete-source(data.id); }
                }
                Button {
                    text: @tr("Cancel");
                    dense: true;
                    clicked => { confirm = false; }
                }
            }
        }
    }
}

// The selected source's properties (mockup E): its icon, name and type, its name as a
// field, then the Transform, Filters and Audio tabs (ADR-0062). A source without a
// picture has only the Audio tab, so no tab control shows. The tab picked last applies
// to whichever source is selected. `live-state`: 0 nothing goes out, else the program
// is on air, and Filters and Audio say that their edits show at once.
export component PropertiesPanel inherits Rectangle {
    in property <int> live-state;
    background: Theme.surface-raised;
    property <bool> any: Studio.selected-source >= 0;
    if !any: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("Nothing selected");
        message: @tr("Select a source in the Sources panel to see its properties.");
    }
    if any: Flickable {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            alignment: start;
            for s in Studio.sources: VerticalLayout {
                spacing: Tokens.size-section-gap;
                if s.id == Studio.selected-source: SourceProperties {
                    data: s;
                    live-state: root.live-state;
                }
            }
        }
    }
}


// The recording's settings (glossary: output profile): the Recording section of the
// Settings window (U17). They apply to the next recording and are saved at once. The
// owner counts `menu-open` as an overlay where a preview layer is shown.
export component RecordingSettings inherits Rectangle {
    property <bool> idle: Studio.rec-state == 0;
    out property <bool> menu-open: fields.menu-open;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        if !idle: SettingsNotice { text: @tr("Changes apply to the next recording."); }
        if Studio.out-note != "": SettingsNotice { text: Studio.out-note; problem: true; }
        SettingsCard {
            title: @tr("Files");
            id: "settings.recording.files";
            SettingRow {
                divider: false;
                label: @tr("Folder");
                help: @tr("Each recording gets a new file named by its date and time; a file is never replaced.");
                enabled: idle;
                control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                folder := TextField {
                    label: @tr("Folder");
                    text: Studio.out-folder;
                    enabled: idle;
                    accepted(t) => { Studio.set-folder(t); }
                }
            }
            SettingRow {
                label: @tr("Format");
                help: @tr("The container of the file.");
                enabled: idle;
                fill: false;
                SegmentedControl {
                    label: @tr("Format");
                    options: Studio.out-formats;
                    index: Studio.out-format;
                    enabled: idle;
                    selected(i) => { Studio.set-format(i); }
                }
            }
        }
        SettingsCard {
            title: @tr("Encoding");
            id: "settings.recording.encoding";
            fields := EncoderFields {
                data: Studio.out-enc;
                idle: idle;
                set(field, value) => { Studio.set-encoding(0, field, value); }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
    // The field shows what Rust set last; typing in it is never overwritten by a sync.
    property <int> folder-serial: Studio.out-folder-serial;
    changed folder-serial => { folder.text = Studio.out-folder; }
}

// Where Go live sends the program and how it is encoded: the Stream section of the
// Settings window (U17). Changes apply to the next stream and are saved at once. The
// stream key is never shown: it goes to the system's credential store.
export component StreamSettings inherits Rectangle {
    property <bool> idle: Studio.st-state == 0;
    out property <bool> menu-open: fields.menu-open || latency.open;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        if !idle: SettingsNotice { text: @tr("Changes apply to the next stream."); }
        if Studio.st-note != "": SettingsNotice { text: Studio.st-note; problem: true; }
        SettingsCard {
            title: @tr("Destination");
            id: "settings.stream.destination";
            SettingRow {
                divider: false;
                label: @tr("Server");
                help: @tr("The address your streaming service gives you, starting with rtmp:// or srt://.");
                enabled: idle;
                control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                server := TextField {
                    label: @tr("Server");
                    text: Studio.st-server;
                    enabled: idle;
                    accepted(t) => { Studio.set-server(t); }
                    edited(t) => { Studio.server-edited(t); }
                }
            }
            SettingRow {
                label: @tr("Stream key");
                help: Studio.st-key-place;
                enabled: idle;
                control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                key := TextField {
                    label: @tr("Stream key");
                    password: true;
                    enabled: idle;
                    accepted(t) => { Studio.save-key(t); }
                }
                Button {
                    horizontal-stretch: 0;
                    text: @tr("Save key");
                    kind: "secondary";
                    enabled: idle && key.text != "";
                    clicked => { Studio.save-key(key.text); }
                }
            }
            SettingRow {
                divider: false;
                fill: false;
                label: "";
                help: "";
                control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                Text {
                    text: Studio.st-key-saved ? @tr("A stream key is saved.") : @tr("No stream key yet.");
                    color: Studio.st-key-saved ? Theme.text-primary : Theme.text-secondary;
                    font-size: Tokens.type-body-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if Studio.st-key-saved: Button {
                    text: @tr("Remove key");
                    kind: "ghost";
                    dense: true;
                    enabled: idle;
                    clicked => { Studio.remove-key(); }
                }
            }
        }
        SettingsCard {
            title: @tr("Connection");
            id: "settings.stream.connection";
            SettingRow {
                divider: false;
                label: @tr("Reconnect when the connection drops");
                help: @tr("Tries up to 10 times, waiting longer each time. On by default.");
                enabled: idle;
                fill: false;
                Toggle {
                    label: @tr("Reconnect when the connection drops");
                    checked: Studio.st-reconnect;
                    enabled: idle;
                    toggled(on) => { Studio.set-reconnect(on); }
                }
            }
            Shown {
                shown: Studio.st-srt;
                gap: 0;
                SettingRow {
                    label: @tr("SRT latency");
                    help: @tr("More latency survives a worse network; viewers see the picture a little later.");
                    enabled: idle;
                    latency := Select {
                        label: @tr("SRT latency");
                        options: Studio.st-latencies;
                        index: Studio.st-latency;
                        enabled: idle && Studio.st-srt;
                        selected(i) => { Studio.set-latency(i); }
                    }
                }
            }
        }
        SettingsCard {
            title: @tr("While live");
            id: "settings.stream.while-live";
            SettingRow {
                divider: false;
                label: @tr("Record when the stream starts");
                help: @tr("Uses the Recording settings. Ending the stream stops this recording. Off by default.");
                enabled: idle;
                fill: false;
                Toggle {
                    label: @tr("Record when the stream starts");
                    checked: Studio.st-auto-record;
                    enabled: idle;
                    toggled(on) => { Studio.set-auto-record(on); }
                }
            }
            if Studio.st-auto-record: SettingsNotice { text: Studio.st-auto-record-note; }
        }
        SettingsCard {
            title: @tr("Encoding");
            id: "settings.stream.encoding";
            fields := EncoderFields {
                data: Studio.st-enc;
                idle: idle;
                stream: true;
                set(field, value) => { Studio.set-encoding(1, field, value); }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
    // The fields show what Rust set last; typing is never overwritten by a sync.
    property <int> server-serial: Studio.st-server-serial;
    changed server-serial => { server.text = Studio.st-server; }
    // A key was saved or removed: the field is emptied (the key is never shown).
    property <int> key-serial: Studio.st-key-serial;
    changed key-serial => { key.text = ""; }
}

// The canvas's size and frame rate: the Video section of the Settings window (U17).
// A change restarts the studio with the new canvas; not while recording.
export component VideoSettings inherits Rectangle {
    property <bool> can-change: Studio.state == 1 && Studio.rec-state == 0 && Studio.st-state == 0 && !Studio.canvas-restarting;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        SettingsNotice {
            text: Studio.rec-state != 0
                ? @tr("Stop the recording to change the canvas.")
                : Studio.st-state != 0
                ? @tr("End the stream to change the canvas.")
                : Studio.canvas-restarting
                ? @tr("The studio is restarting with the new canvas.")
                : @tr("A change restarts the studio: the picture stops for a moment.");
        }
        if Studio.canvas-note != "": SettingsNotice { text: Studio.canvas-note; problem: true; }
        SettingsCard {
            title: @tr("Canvas");
            id: "settings.video.canvas";
            SettingRow {
                divider: false;
                label: @tr("Canvas size");
                help: @tr("The size the studio draws every scene at, in pixels.");
                enabled: can-change;
                Select {
                    label: @tr("Canvas size");
                    options: Studio.canvas-sizes;
                    index: Studio.canvas-size;
                    enabled: can-change;
                    selected(i) => { Studio.set-canvas-size(i); }
                }
            }
            SettingRow {
                label: @tr("Frame rate");
                help: @tr("Frames per second.");
                enabled: can-change;
                fill: false;
                SegmentedControl {
                    label: @tr("Frame rate");
                    options: Studio.canvas-rates;
                    index: Studio.canvas-rate;
                    enabled: can-change;
                    selected(i) => { Studio.set-canvas-rate(i); }
                }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
}

// Settings, General (ADR-0056): what closing the main window does.
export component GeneralSettings inherits Rectangle {
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        SettingsCard {
            title: @tr("Closing the main window");
            id: "settings.general.closing";
            SettingRow {
                divider: false;
                label: @tr("When I close the main window");
                help: Studio.platform == 2 ? @tr("Not available on Linux yet. Closing the main window quits RBS.")
                    : !Studio.way-back ? @tr("Keeping RBS running is not available on this computer yet, so closing the main window quits RBS.")
                    : Studio.platform == 0 ? @tr("Keep RBS running: recording, streaming and remote control go on, and RBS stays in the Dock. Click its Dock icon to get the window back; quit with Cmd+Q. Default on Mac: Keep RBS running.")
                    : @tr("Keep RBS running: recording, streaming and remote control go on, and RBS stays in the notification area. Click its icon there to get the window back, or quit from its menu. Default on Windows: Quit RBS.");
                enabled: Studio.platform != 2;
                fill: false;
                SegmentedControl {
                    label: @tr("When I close the main window");
                    options: [@tr("Quit RBS"), @tr("Keep RBS running")];
                    index: Studio.platform == 2 ? 0 : Studio.on-close;
                    enabled: Studio.platform != 2;
                    selected(i) => { Studio.set-on-close(i); }
                }
            }
        }
    }
    height: form.preferred-height;
}

// Remote control (glossary): the Remote control section of the Settings window (U17).
// Apps on this computer, such as Stream Deck or the user's scripts, control RBS through
// the control API with an access token each. Changes apply at once.
// Settings, Global sources (ADR-0065): sources shown and heard in every scene of the
// canvas. The list, then Add a global source: a kind, then one of its devices or a
// source the scenes already have. Every change is one undo step of the main window.
export component GlobalSourcesSettings inherits Rectangle {
    property <bool> running: Studio.state == 1;
    property <bool> existing-picked: Studio.global-option >= Studio.global-devices;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        if Studio.on-air: SettingsNotice {
            text: @tr("On air: changes here show in the program at once.");
        }
        SettingsCard {
            title: @tr("Global sources");
            id: "settings.sources.global-sources";
            description: @tr("Heard and shown in every scene, above the scene's own sources.");
            if !running: SettingRow {
                divider: false;
                label: @tr("The studio is not running");
                help: @tr("Global sources can be changed once it runs.");
            }
            if running && Studio.global-count == 0: SettingRow {
                divider: false;
                label: @tr("No global sources yet");
                help: @tr("A global source is heard and shown in every scene.");
            }
            for s[i] in Studio.sources: VerticalLayout {
                if s.global: SettingRow {
                    divider: i > 0;
                    label: s.name;
                    help: s.kind;
                    fill: false;
                    Button {
                        text: @tr("Remove");
                        accessible-name: @tr("Remove {} from global sources", s.name);
                        dense: true;
                        clicked => { Studio.remove-global(s.id); }
                    }
                }
            }
        }
        SettingsCard {
            title: @tr("Add a global source");
            id: "settings.sources.add-global";
            SettingRow {
                divider: false;
                label: @tr("Kind");
                help: @tr("What kind of source to add.");
                enabled: running;
                Select {
                    label: @tr("Kind");
                    options: Studio.global-kind-names;
                    index: Studio.global-kind;
                    placeholder: @tr("Choose a kind");
                    enabled: running && Studio.global-kind-names.length > 0;
                    selected(i) => { Studio.pick-global-kind(i); }
                }
            }
            SettingRow {
                label: @tr("Source");
                help: Studio.global-kind < 0 ? @tr("Pick a kind first.")
                    : Studio.global-options.length == 0 ? @tr("Nothing of this kind is available.")
                    : existing-picked ? @tr("A source marked (in scenes) leaves the scenes that have it, since it is then in every scene.")
                    : @tr("A device of this kind, or a source the scenes already have.");
                enabled: running && Studio.global-options.length > 0;
                Select {
                    label: @tr("Source");
                    options: Studio.global-options;
                    index: Studio.global-option;
                    placeholder: Studio.global-kind < 0 ? "" : @tr("Choose a source");
                    enabled: running && Studio.global-options.length > 0;
                    selected(i) => { Studio.global-option = i; }
                }
            }
            SettingRow {
                label: "";
                fill: false;
                Button {
                    text: @tr("Add");
                    accessible-name: @tr("Add as a global source");
                    kind: "primary";
                    enabled: running && Studio.global-option >= 0 && Studio.global-option < Studio.global-options.length;
                    clicked => { Studio.add-global(Studio.global-option); }
                }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
}

export component RemoteControlSettings inherits Rectangle {
    // The access picked for the next token: 1 Control, the default.
    property <int> access: 1;
    // Network access certificate: 0 the one RBS made, 1 the user's own (picked, maybe
    // not yet in use).
    property <bool> own-in-use: Studio.rc-own;
    // "Your own" picked, its files not yet in use.
    property <bool> picking-own;
    property <int> cert-source: (own-in-use || picking-own) ? 1 : 0;
    changed own-in-use => { picking-own = false; }
    // "New key" asks first: every client must pin the new key.
    property <bool> confirming;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        SettingsCard {
            title: @tr("This computer");
            id: "settings.remote.this-computer";
            SettingRow {
                divider: false;
                label: @tr("Allow remote control");
                help: @tr("Lets apps on this computer, such as Stream Deck or your own scripts, control RBS. Off by default.");
                fill: false;
                Toggle {
                    label: @tr("Allow remote control");
                    checked: Studio.rc-enabled;
                    toggled(on) => { Studio.set-rc-enabled(on); }
                }
            }
            if Studio.rc-status != "": SettingsStatus {
                text: Studio.rc-status;
                tone: Studio.rc-status-bad ? 2 : Studio.rc-enabled ? 1 : 0;
            }
            SettingRow {
                label: @tr("Port");
                help: @tr("The port apps connect to. Changing it disconnects connected apps. 4456 is the default.");
                control-width: Tokens.size-menu-sm / 2;
                port := TextField {
                    label: @tr("Port");
                    text: Studio.rc-port;
                    accepted(t) => { Studio.set-rc-port(t); }
                }
            }
        }
        // Network access (ADR-0046): apps on other computers connect over TLS and
        // check the key pin before they send a token.
        SettingsCard {
            title: @tr("Other computers");
            id: "settings.remote.other-computers";
            SettingRow {
                divider: false;
                label: @tr("Allow access from other computers");
                help: @tr("Lets apps on other computers on your network connect over an encrypted connection. Turn it on only on networks you trust. Changing it disconnects connected apps. Windows and macOS ask to allow RBS through the firewall the first time; if that is refused, other computers cannot connect and RBS is not told.");
                enabled: Studio.rc-enabled;
                fill: false;
                Toggle {
                    label: @tr("Allow access from other computers");
                    checked: Studio.rc-network;
                    enabled: Studio.rc-enabled;
                    toggled(on) => { Studio.set-rc-network(on); }
                }
            }
            if Studio.rc-network-status != "": SettingsStatus {
                text: Studio.rc-network-status;
                tone: Studio.rc-network-status-bad ? 2 : Studio.rc-network ? 1 : 0;
            }
            if Studio.rc-network && Studio.rc-key-pin != "": SettingBlock {
                label: @tr("Key pin");
                help: @tr("Apps on other computers must check this before they send a token. It stays the same when the certificate is renewed.");
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface-sunken;
                        border-radius: Tokens.radius-sm;
                        border-width: Tokens.size-border;
                        border-color: Theme.border-subtle;
                        min-height: pin-text.preferred-height + Tokens.space-2 * 2;
                        pin-text := Text {
                            x: Tokens.space-2;
                            width: parent.width - Tokens.space-2 * 2;
                            text: Studio.rc-key-pin;
                            color: Theme.text-primary;
                            font-size: Tokens.type-body-size;
                            wrap: char-wrap;
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                            accessible-label: @tr("Key pin: {}", Studio.rc-key-pin);
                        }
                    }
                    pin := TextField {
                        // Holds the value for Copy only; the text beside it shows it whole.
                        visible: false;
                        width: 0px;
                        label: @tr("Key pin");
                        text: Studio.rc-key-pin;
                        read-only: true;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button {
                            text: @tr("Copy");
                            accessible-name: @tr("Copy key pin");
                            icon: IconName.copy;
                            clicked => { pin.copy-all(); }
                        }
                    }
                }
            }
            if Studio.rc-network && Studio.rc-fingerprint != "": SettingBlock {
                label: @tr("Certificate fingerprint (SHA-256)");
                help: Studio.rc-cert-note;
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface-sunken;
                        border-radius: Tokens.radius-sm;
                        border-width: Tokens.size-border;
                        border-color: Theme.border-subtle;
                        min-height: print-text.preferred-height + Tokens.space-2 * 2;
                        print-text := Text {
                            x: Tokens.space-2;
                            width: parent.width - Tokens.space-2 * 2;
                            text: Studio.rc-fingerprint;
                            color: Theme.text-primary;
                            font-size: Tokens.type-body-size;
                            wrap: char-wrap;
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                            accessible-label: @tr("Certificate fingerprint: {}", Studio.rc-fingerprint);
                        }
                    }
                    print := TextField {
                        visible: false;
                        width: 0px;
                        label: @tr("Certificate fingerprint (SHA-256)");
                        text: Studio.rc-fingerprint;
                        read-only: true;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button {
                            text: @tr("Copy");
                            accessible-name: @tr("Copy certificate fingerprint");
                            icon: IconName.copy;
                            clicked => { print.copy-all(); }
                        }
                    }
                }
            }
            if Studio.rc-network: SettingRow {
                label: @tr("Allow remote admin");
                help: @tr("Lets Full control tokens change settings from other computers too. Off by default. Changing it disconnects connected apps.");
                fill: false;
                Toggle {
                    label: @tr("Allow remote admin");
                    checked: Studio.rc-remote-admin;
                    toggled(on) => { Studio.set-rc-remote-admin(on); }
                }
            }
            if Studio.rc-network: SettingRow {
                label: @tr("Certificate");
                help: root.cert-source == 0
                    ? @tr("RBS made a key and a certificate for this computer. Browser panels on other devices cannot check a key pin: they need your own certificate, one those devices already trust.")
                    : @tr("A certificate chain and its key, as PEM files, for example from your own certificate authority. RBS reads them each time it starts and never copies them. Using other files disconnects connected apps.");
                fill: false;
                SegmentedControl {
                    label: @tr("Certificate");
                    options: [@tr("Made by RBS"), @tr("Your own")];
                    index: root.cert-source;
                    selected(i) => {
                        root.picking-own = i == 1;
                        if i == 0 { Studio.rc-use-generated(); }
                    }
                }
            }
            if Studio.rc-network && root.cert-source == 1: VerticalLayout {
                SettingRow {
                    label: @tr("Certificate file");
                    help: @tr("A full path.");
                    control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                    own-cert := TextField {
                        label: @tr("Certificate file");
                        text: Studio.rc-own-cert;
                    }
                }
                SettingRow {
                    label: @tr("Key file");
                    help: @tr("A full path. On macOS and Linux the key file must be readable by you only.");
                    control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                    own-key := TextField {
                        label: @tr("Key file");
                        text: Studio.rc-own-key;
                    }
                }
                SettingRow {
                    divider: false;
                    fill: false;
                    Button {
                        text: @tr("Use these files");
                        kind: "primary";
                        clicked => { Studio.rc-use-own(own-cert.text, own-key.text); }
                    }
                }
            }
            if Studio.rc-network && Studio.rc-network-note != "": SettingsStatus {
                text: Studio.rc-network-note;
                tone: 2;
            }
            if Studio.rc-network && root.cert-source == 0 && !root.confirming: SettingRow {
                label: @tr("New key");
                help: @tr("Makes a new key, for example if the key may have been copied. Every app on another computer must then check the new key pin.");
                fill: false;
                Button {
                    text: @tr("New key…");
                    clicked => { root.confirming = true; }
                }
            }
            if Studio.rc-network && root.cert-source == 0 && root.confirming: SettingBlock {
                SettingsCallout {
                    label: @tr("Make a new key");
                    Text {
                        text: @tr("Make a new key? Apps on other computers are disconnected and connect again only after they check the new key pin. This cannot be undone.");
                        color: Theme.text-primary;
                        font-size: Tokens.type-body-size;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        alignment: start;
                        Button {
                            text: @tr("Make new key");
                            kind: "primary";
                            clicked => { root.confirming = false; Studio.rc-new-key(); }
                        }
                        Button {
                            text: @tr("Cancel");
                            clicked => { root.confirming = false; }
                        }
                    }
                }
            }
        }
        SettingsCard {
            title: @tr("Access tokens");
            id: "settings.remote.access-tokens";
            description: @tr("Each app needs an access token. Make one per app, so you can revoke it alone. A token is shown only once.");
            if Studio.rc-new-token != "": SettingBlock {
                divider: false;
                SettingsCallout {
                    label: @tr("New access token for {}", Studio.rc-new-token-name);
                    Text {
                        text: @tr("Access token for {}. Copy it into the app now: it is not shown again.", Studio.rc-new-token-name);
                        color: Theme.text-primary;
                        font-size: Tokens.type-body-size;
                        wrap: word-wrap;
                    }
                    secret := TextField {
                        label: @tr("Access token for {}", Studio.rc-new-token-name);
                        text: Studio.rc-new-token;
                        read-only: true;
                    }
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        alignment: start;
                        Button {
                            text: @tr("Copy");
                            kind: "primary";
                            icon: IconName.copy;
                            clicked => { secret.copy-all(); }
                        }
                        Button {
                            text: @tr("Done");
                            clicked => { Studio.dismiss-new-token(); }
                        }
                    }
                }
            }
            SettingRow {
                label: @tr("Name");
                help: @tr("The app the token is for, such as Stream Deck.");
                name := TextField {
                    label: @tr("Name");
                }
            }
            SettingRow {
                label: @tr("Access");
                help: Studio.rc-access-hints[root.access];
                fill: false;
                SegmentedControl {
                    label: @tr("Access");
                    options: Studio.rc-accesses;
                    index: root.access;
                    selected(i) => { root.access = i; }
                }
            }
            SettingRow {
                divider: false;
                fill: false;
                Button {
                    text: @tr("Create access token");
                    kind: "primary";
                    icon: IconName.plus;
                    clicked => { Studio.create-token(name.text, root.access); }
                }
            }
            if Studio.rc-note != "": SettingsStatus { text: Studio.rc-note; tone: 2; }
            if Studio.rc-revoked != "": SettingBlock {
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Text {
                        text: @tr("{} was revoked: apps using it were disconnected.", Studio.rc-revoked);
                        color: Theme.text-secondary;
                        font-size: Tokens.type-body-size;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    Button {
                        horizontal-stretch: 0;
                        text: @tr("Undo");
                        accessible-name: @tr("Undo revoking {}", Studio.rc-revoked);
                        clicked => { Studio.undo-revoke(); }
                    }
                }
            }
            SettingBlock {
                label: @tr("Tokens");
                VerticalLayout {
                    spacing: Tokens.space-1;
                    accessible-role: list;
                    accessible-label: @tr("Access tokens");
                    if Studio.rc-tokens.length == 0: Text {
                        text: @tr("No access tokens yet.");
                        color: Theme.text-secondary;
                        font-size: Tokens.type-body-size;
                    }
                    for t[i] in Studio.rc-tokens: Rectangle {
                        background: Theme.surface-sunken;
                        border-radius: Tokens.radius-md;
                        accessible-role: list-item;
                        accessible-label: @tr("{}, {}", t.name, t.access);
                        HorizontalLayout {
                            padding: Tokens.space-2;
                            padding-left: Tokens.space-3;
                            spacing: Tokens.space-2;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: t.name;
                                    color: Theme.text-primary;
                                    font-size: Tokens.type-label-size;
                                    font-weight: Tokens.type-label-weight;
                                    overflow: elide;
                                }
                                Text {
                                    text: t.access;
                                    color: Theme.text-secondary;
                                    font-size: Tokens.type-caption-size;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Revoke");
                                    accessible-name: @tr("Revoke {}", t.name);
                                    kind: "ghost";
                                    clicked => { Studio.revoke-token(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
    // The field shows what Rust set last; typing in it is never overwritten by a sync.
    property <int> port-serial: Studio.rc-port-serial;
    changed port-serial => { port.text = Studio.rc-port; }
    // A token was made: the name field is ready for the next one.
    property <string> made: Studio.rc-new-token;
    changed made => { if made != "" { name.text = ""; } }
}

// Outputs: what each output will do, in one line each, and the way to its settings.
// Settings live in the Settings window (U17), not in this panel.
export component OutputsPanel inherits Rectangle {
    background: Theme.surface-raised;
    Flickable {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.space-3;
            spacing: Tokens.space-1;
            alignment: start;
            Rectangle {
                accessible-role: list-item;
                accessible-label: @tr("Recording, {}", summary.text);
                VerticalLayout {
                    spacing: Tokens.space-1;
                    Text {
                        text: Studio.rec-state == 2 ? @tr("Recording · recording now") : @tr("Recording");
                        color: Theme.text-primary;
                        font-size: Tokens.type-label-size;
                        font-weight: Tokens.type-label-weight;
                    }
                    summary := Text {
                        text: Studio.out-summary;
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                        wrap: word-wrap;
                    }
                }
            }
            Rectangle {
                accessible-role: list-item;
                accessible-label: @tr("Stream, {}", stream-summary.text);
                VerticalLayout {
                    padding-top: Tokens.space-2;
                    spacing: Tokens.space-1;
                    Text {
                        text: Studio.st-connected ? @tr("Stream · live now")
                            : Studio.st-state != 0 ? @tr("Stream · connecting") : @tr("Stream");
                        color: Theme.text-primary;
                        font-size: Tokens.type-label-size;
                        font-weight: Tokens.type-label-weight;
                    }
                    stream-summary := Text {
                        text: Studio.st-summary;
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                padding-top: Tokens.space-1;
                spacing: Tokens.space-2;
                alignment: start;
                Button {
                    text: @tr("Recording settings");
                    clicked => { Studio.open-settings(); }
                }
                Button {
                    text: @tr("Stream settings");
                    clicked => { Studio.open-stream-settings(); }
                }
            }
        }
    }
}

// One row of the Library: a name, a note and a button, or a thumbnail instead of the note.
component LibraryRow inherits Rectangle {
    in property <string> title;
    in property <string> action;
    in property <bool> enabled: true;
    in property <image> thumb;
    in property <bool> has-thumb: false;
    in property <bool> frame: false;
    callback act();
    accessible-role: list-item;
    accessible-label: title;
    HorizontalLayout {
        padding-top: Tokens.space-1;
        padding-bottom: Tokens.space-1;
        spacing: Tokens.space-2;
        if root.has-thumb: Rectangle {
            width: Tokens.size-library-thumb-w;
            height: Tokens.size-library-thumb-h;
            border-radius: Tokens.radius-sm;
            background: Theme.surface-sunken;
            clip: true;
            Image {
                source: root.thumb;
                width: 100%;
                height: 100%;
                accessible-role: none;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: Tokens.space-1;
            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                overflow: elide;
            }
            if root.has-thumb: Text {
                text: root.frame ? @tr("Frame, on top") : @tr("Background, below");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                overflow: elide;
            }
            if root.has-thumb: HorizontalLayout {
                alignment: start;
                Button {
                    text: root.action;
                    accessible-name: @tr("{}: {}", root.action, root.title);
                    enabled: root.enabled;
                    dense: true;
                    clicked => { root.act(); }
                }
            }
        }
        if !root.has-thumb: VerticalLayout {
            alignment: center;
            Button {
                text: root.action;
                accessible-name: @tr("{}: {}", root.action, root.title);
                enabled: root.enabled;
                dense: true;
                clicked => { root.act(); }
            }
        }
    }
}

// The Library (ADR-0075): built-in looks that change the selected source's colour, effects
// and shape in one undo step, and sample backgrounds and frames that add a picture to
// the scene. Nothing is linked: a look is copied onto the source.
export component LibraryPanel inherits Rectangle {
    background: Theme.surface-raised;
    property <bool> has-selection: Studio.selected-source >= 0;
    init => { Studio.library-shown(); }
    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.space-3;
            spacing: Tokens.space-1;
            alignment: start;
            Text {
                text: @tr("Looks");
                color: Theme.text-primary;
                font-size: Tokens.type-label-size;
                font-weight: Tokens.type-label-weight;
            }
            Text {
                text: has-selection ? @tr("Applies to the selected source. A filter of the same kind is replaced, in every scene that uses the source. Undo puts it back.")
                    : @tr("Select a source in the Sources panel to apply a look.");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                wrap: word-wrap;
            }
            for group[g] in [@tr("Colour"), @tr("Effects"), @tr("Shape")]: VerticalLayout {
                padding-top: Tokens.space-2;
                Text {
                    text: group;
                    color: Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    font-weight: Tokens.type-label-weight;
                }
                for l in Studio.library-looks: VerticalLayout {
                    if l.group == g: LibraryRow {
                        title: l.name;
                        action: @tr("Apply");
                        enabled: root.has-selection;
                        act => { Studio.apply-look(l.id); }
                    }
                }
            }
            VerticalLayout {
                padding-top: Tokens.space-3;
                Text {
                    text: @tr("Backgrounds and frames");
                    color: Theme.text-primary;
                    font-size: Tokens.type-label-size;
                    font-weight: Tokens.type-label-weight;
                }
            }
            Text {
                text: @tr("Adds a picture to the scene you are editing.");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                wrap: word-wrap;
            }
            for s in Studio.library-samples: LibraryRow {
                title: s.name;
                action: @tr("Add");
                has-thumb: true;
                thumb: s.thumb;
                frame: s.frame;
                act => { Studio.add-sample(s.id); }
            }
        }
    }
}

// Stats: the running recording's and stream's counters and the engine's late ticks,
// updated once a second while an output runs (design system: `rbs.stats` 1 Hz).
export component StatsPanel inherits Rectangle {
    background: Theme.surface-raised;
    if Studio.stats.length == 0: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("Nothing to measure yet");
        message: @tr("Statistics show here while you record or stream.");
    }
    if Studio.stats.length > 0: Flickable {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.space-3;
            spacing: Tokens.space-1;
            alignment: start;
            for row in Studio.stats: VerticalLayout {
                if row.heading: Text {
                    text: row.label;
                    color: Theme.text-primary;
                    font-size: Tokens.type-label-size;
                    font-weight: Tokens.type-label-weight;
                    accessible-role: AccessibleRole.text;
                }
                if !row.heading: HorizontalLayout {
                    spacing: Tokens.space-2;
                    accessible-role: AccessibleRole.list-item;
                    accessible-label: @tr("{}: {}", row.label, row.value);
                    Text {
                        text: row.label;
                        color: Theme.text-secondary;
                        font-size: Tokens.type-body-size;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: row.value;
                        color: row.bad ? Theme.state-error : Theme.text-primary;
                        font-size: Tokens.type-body-size;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}
