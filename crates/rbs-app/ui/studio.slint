// Panels connected to the studio (ADR-0041 decision 7): Program, Sources, Mixer, Live
// controls and Outputs.
// Rust pushes state into the `Studio` global of every window and handles its callbacks
// by sending commands to the studio's control thread.
import { Theme, Tokens } from "tokens.slint";
import { Sections, Button, Checkbox, ColorPicker, FocusRing, RingFocus, SectionHeader, Tabs, Icon, IconButton, IconName, Icons, MenuItem, MenuSurface, EmptyState, NumberField, Select, SegmentedControl, SizeBand, SizeNest, Slider, VSlider, LevelText, ValueReadout, TextField, Toggle, InfoHint, FeatureSection, SettingRow } from "components.slint";
import { SettingsCard, SettingBlock, SettingsStatus, SettingsNotice, SettingsCallout, RevealOnShow } from "settings.slint";
import { CommandMenu } from "context_menu.slint";
import { ReplayControls, ReplaySettings } from "replay.slint";

// `picture`: a video source; `x`, `y`, `w`, `h` place its box on the canvas (canvas
// pixels). `can-up` / `can-down`: another source with a picture is above / below it.
// Style (ADR-0053): `shape` 0 rectangle, 1 circle, 2 ellipse; `radius` for rectangles;
// `border` on or off, its `border-width`, its colour as `#rrggbb` or `#rrggbbaa` text
// and as a swatch (the values a border gets when turned on while it is off).
// One field of a filter in the Filters tab (ADR-0062), generated from its type's
// schema: `kind` 0 a number (`position` from 0 to 1 on its slider, `step` one step
// there, `value-text` the value with its unit; `min`, `max`, `snap` (the value's step),
// `decimals` and `suffix` (the unit with its space) for the text while dragging), 1 a colour (`colour` as #rrggbb or
// #rrggbbaa, `swatch` the same colour).
export struct FilterFieldData { label: string, help: string, log: bool, options: [string], choice: int, kind: int, position: float, step: float, value-text: string, min: float, max: float, snap: float, decimals: int, suffix: string, colour: string, swatch: color }
// One filter of a source's chain: `known` false for a type this version lacks (it can
// only be removed); `can-up` / `can-down` false at the ends of the chain.
export struct FilterLevels { input: float, reduction: float }
export struct FilterData { id: int, name: string, enabled: bool, known: bool, gate: bool, bar-label: string, open-pos: float, close-pos: float, can-up: bool, can-down: bool, fields: [FilterFieldData] }
export struct SourceData { id: int, name: string, kind: string, icon: string, status: string, ok: bool, picture: bool, visible: bool, x: float, y: float, w: float, h: float, can-up: bool, can-down: bool, shape: int, radius: float, border: bool, border-width: float, border-color: string, border-swatch: color, crop-l: int, crop-t: int, crop-r: int, crop-b: int, pic-w: int, pic-h: int, locked: bool, flip-h: bool, flip-v: bool, rotation: float, audio: bool, muted: bool, volume: float, volume-text: string, filters: [FilterData], selected-filter: int, sync-offset: int, global: bool, also-in: string, in-globals: bool, places: int, kind-code: int, companion: bool, custom-glide: bool, glide-duration: int, glide-easing: int, solid: bool, fill: string, fill-swatch: color, filled: bool, item-id: int, cap-has: bool, cap-l: int, cap-t: int, cap-r: int, cap-b: int, chrome-on: bool, chrome-t: int, chrome-r: int, chrome-b: int, chrome-l: int, chrome-fill: int, has-work-rect: bool, show-for-ms: int, cue-remaining-ms: int }
// `global`: a global source's row (ADR-0065). `also-in`: the other scenes that place it,
// by name; `in-globals`: it is a global source too; `places`: how many items place it.
// A scene in the Scenes panel (ADR-0059): `live` on air, `number` its place (1 up).
// `live`: the scene on air; `preview`: the preview scene in studio mode (ADR-0061).
export struct SceneData { id: int, name: string, live: bool, preview: bool, number: int }
// A source of the collection for Add source's "Existing source" list.
// A look in the Library (ADR-0075): `group` 0 colour, 1 effect, 2 shape. A sample
// picture: `frame` is true for a frame (transparent in the middle), `thumb` its picture.
export struct LookData { id: string, name: string, group: int }
export struct SampleData { id: string, name: string, frame: bool, slot: int, thumb: image }
export struct KindData { code: int, label: string }
// A filled rectangle of the selection on the preview (outline or handle), in the
// panel's coordinates; kind 0 outline, 1 handle border, 2 handle inside.
export struct MarkData { x: length, y: length, w: length, h: length, kind: int }
// One line of the Source tab's target list: `index` is its place in the answer, `current` marks the source's own target (ADR-0077).
// One mode of a camera in the Source settings window: its size and the frame rates it runs at.
export struct ModeData { label: string, rates: [string] }
// What the Source settings window shows for one source (ADR-0077): the camera's modes with
// the chosen mode and rate, or the rates of a screen or window and its cursor choice.
export struct SourceSettingsData { id: int, name: string, kind-code: int, modes: [ModeData], mode-labels: [string], mode-index: int, rates: [string], rate-index: int, has-cursor: bool, cursor: bool, cap-has: bool, cap-l: int, cap-t: int, cap-r: int, cap-b: int, chrome-on: bool, chrome-t: int, chrome-r: int, chrome-b: int, chrome-l: int, chrome-fill: int, has-work-rect: bool, pic-w: int, pic-h: int, has-region-preview: bool, region-preview: image }
// `heading` is set on the first row of a group ("Same application", "Other").
// `picture` is the target's thumbnail when `has-picture`; `wants-picture` is set for displays and windows, whose rows keep the kind's icon until the picture comes.
export struct SourceTargetData { name: string, current: bool, index: int, heading: string, picture: image, has-picture: bool, wants-picture: bool }
// One meter's moving parts as fractions of the bar (rbs_ui::meter::MeterView::zones),
// its peak-hold position and zone, the clip latch and the accessible value (U16).
export struct MeterRow {
    // The source's id and whether its sound is muted (ADR-0059).
    id: int,
    muted: bool,
    // The fader: its position (0 to 1, the fader law) and the level in words ("-6.0 dB").
    volume: float,
    volume-text: string,
    name: string,
    icon: string,
    lo-from: float, lo-to: float, mi-from: float, mi-to: float, hi-from: float, hi-to: float,
    peak: float, peak-zone: int, clipped: bool, value: string,
    // A global source (ADR-0065): the Mixer groups it apart from the scene's own.
    global: bool,
    // Heard on the monitor (ADR-0097): 0 off, 1 monitor and output, 2 monitor only;
    // and soloed on the monitor.
    monitor: int,
    solo: bool,
    // False while an audio source is not running: the strip stays, the fader does not move.
    live: bool,
}
export struct ScaleMark { label: string, at: float }
// The encoder fields of one output (a recording or a stream): the options offered and
// the one in use (rbs_app::encoder_form). `rate-kind`: 0 CBR, 1 VBR, 2 constant quality.
export struct EncoderData {
    codecs: [string], codec: int,
    encoders: [string], encoder: int,
    video-rates: [string], video-rate: int,
    audio-rates: [string], audio-rate: int,
    rate-modes: [string], rate-mode: int, rate-kind: int, bitrate-label: string,
    peaks: [string], peak: int,
    qualities: [string], quality: int,
    padding: bool, padding-available: bool,
    keyframes: [string], keyframe: int,
    presets: [string], preset: int,
    profiles: [string], profile: int,
    b-frames: [string], b-frame: int, b-frames-note: string,
    // The chosen video bitrate, and the recommendation when it is below that
    // figure (0 when it is not, or when there is no bitrate). The picture is the
    // resolved output size at the canvas frame rate.
    video-kbps: int, recommended-kbps: int,
    out-width: int, out-height: int, out-fps: int,
    // 0 Video (Rec. 709 limited), 1 Screen (sRGB full range).
    delivery: int,
    // Lifts only the darkest tones. Shown while Colour is Video.
    open-shadows: bool,
}
// One access token in the Remote control section: its name and what it allows.
export struct TokenRow { name: string, access: string }
// One line of the Stats panel: a section heading (`heading`, `label` only) or a counter
// with its value; `bad` marks a value that shows a loss (in words too, U7).
export struct StatRow { heading: bool, label: string, value: string, bad: bool }
// An output profile or scene collection in its menu (ADR-0051).
export struct EntryRow { id: string, name: string, current: bool }

export global Studio {
    // 0 starting, 1 running, 2 failed (`failure` says why).
    in property <int> state;
    in property <string> failure;
    in property <[SourceData]> sources;
    in property <[KindData]> kinds;
    // The Source tab's list of what the selected source's kind can capture.
    in property <[SourceTargetData]> source-targets;
    // The Source settings window's content: empty until the host answers, then one entry.
    in property <[SourceSettingsData]> source-settings;
    // The kind `targets` lists; -1 while a list is being made.
    in property <[MeterRow]> meters;
    // Sources kept out of the Mixer, still heard (ADR-0080); no meter runs for them.
    in property <[MeterRow]> hidden-meters;
    // The master strip (ADR-0081): one row while the studio has a mixer, else none.
    in property <[MeterRow]> master-meter;
    // How many of `meters` are the scene's own and how many are global (Mixer groups).
    in property <int> meter-scenes;
    in property <int> meter-globals;
    // The Stats panel's lines; empty while nothing records or streams.
    in property <[StatRow]> stats;
    in property <[ScaleMark]> scale;
    // 0 shown, 1 starting, 2 not on this platform yet, 3 not in this session (remote
    // desktop), 4 shown only in the main window, 5 the studio is not running.
    in property <int> preview-state: 1;
    // Name of the source just deleted (an undo toast shows while it is set);
    // `deleted-from-scene`: only removed from one scene (ADR-0065).
    in property <string> deleted;
    in property <bool> deleted-from-scene;
    // Bumps on each delete, so the toast's countdown starts again.
    in property <int> deleted-generation;
    // Something goes out (a recording or a stream): edits to what is on air show at once.
    out property <bool> on-air: self.rec-state != 0 || self.st-state != 0;
    // The panel the picture shows in: "rbs.program", else "rbs.preview" (without studio
    // mode both show the scene on air); the other one says where it is.
    in property <string> picture-panel: "rbs.program";
    // Studio mode (ADR-0061): Preview shows the preview scene (edited there) and
    // Program the scene on air; `scene-preview-state` is the Preview picture's state,
    // with the codes of `preview-state`.
    in property <bool> studio-mode;
    in property <int> scene-preview-state: 1;
    // The vertical canvas's picture (ADR-0093 decision 7), with the codes of
    // `preview-state`, 7: no vertical canvas exists, 8: its picture did not start.
    in property <int> vertical-preview-state: 1;
    callback set-studio-mode(bool /* on */);
    // The preview scene goes on air and the scene on air to preview (a cut).
    callback transition();
    callback list-targets(int /* kind */);
    callback list-source-targets(int /* source */);
    // The Source settings window opens for a source.
    callback open-source-settings(int /* source */);
    // Apply or OK in the Source settings window: the chosen mode (cameras), rate and cursor.
    callback apply-source-settings(int /* source */, int /* mode */, int /* rate */, bool /* cursor */);
    callback filter-source-targets(string);
    callback retarget-source(int /* source */, int /* index */);
    callback reload-source(int /* source */);
    // Adds or removes the "Capture audio too" companion sound of a display or window (ADR-0096).
    callback set-companion-audio(int /* source */, bool /* on */);
    // Delete source: from every scene and the global sources (ADR-0065).
    callback delete-source(int /* id */);
    // Remove from scene: this scene only (the global sources for a global row); the
    // source goes too when it was its last placement.
    callback remove-from-scene(int /* id */);
    // Delete or Backspace on the editable picture: the source row asks, and the
    // Sources panel opens if it is closed. The selected source is the one to remove.
    callback ask-remove-selected();
    // Show in every scene (ADR-0065): on makes the source global, off moves it into the
    // edited scene.
    callback set-global(int /* id */, bool /* global */);
    // Settings › Global sources: the global sources (rows of `sources` with `global`),
    // the kind picked (an index into `kinds`, -1 none), the Source field's options (the
    // kind's devices, then the collection's sources of that kind that are not global)
    // and how many of them are devices.
    in-out property <int> global-kind: -1;
    in property <[string]> global-options;
    in property <int> global-devices;
    // The kinds Add source offers, by name, for the Kind field; how many global
    // sources there are.
    in property <[string]> global-kind-names;
    in property <int> global-count;
    in-out property <int> global-option: -1;
    callback pick-global-kind(int /* kind index */);
    callback add-global(int /* option */);
    callback remove-global(int /* id */);
    // The source selected in the Sources panel (its id; -1 none). Every window shows
    // the same selection. The Sources rows follow this, including when it is none.
    in property <int> selected-source: -1;
    // The source Properties shows: the selection, else the last selected source that
    // still exists, else the first source in the list. -1 only when there is none.
    in property <int> properties-source: -1;
    callback select-source(int /* id */);
    // One layer up (over the source above it in the list) or down.
    callback move-source(int /* id */, bool /* up */);
    // A Sources row dragged onto another row: it takes that row's place.
    callback move-source-to(int /* id */, int /* to */);
    // The source whose row is being dragged, or -1.
    in-out property <int> dragging-source: -1;
    pure callback source-data(int /* id */) -> data-transfer;
    // One place up or down in the scene list.
    callback move-scene(int /* id */, bool /* up */);
    // A Scenes row dragged onto another row: it takes that row's place.
    callback move-scene-to(int /* id */, int /* to */);
    // The scene whose row is being dragged, or -1.
    in-out property <int> dragging-scene: -1;
    pure callback scene-data(int /* id */) -> data-transfer;
    // The selected source has a picture, so a Library look can be applied.
    in property <bool> looks-ready: false;
    // True when a drag payload is a panel id, so a panel drop is not taken for a source.
    pure callback is-panel(data-transfer) -> bool;
    // Show or hide a source in the program scene.
    callback set-source-visible(int /* id */, bool /* visible */);
    // Lock a source so the picture panel does not move it (ADR-0059).
    callback set-source-locked(int /* id */, bool /* locked */);
    // A source's sound: mute, and the volume as a fader position from 0 to 1.
    callback set-source-muted(int /* id */, bool /* muted */);
    callback set-source-mixer-hidden(int /* id */, bool /* hidden */);
    // The monitor output (ADR-0097): a source's mode (0 off, 1 monitor and output,
    // 2 monitor only) and solo, and the Mixer row's and Settings › Audio's controls.
    callback set-source-monitor(int /* id */, int /* mode */);
    callback set-source-solo(int /* id */, bool /* on */);
    callback end-monitor-solo();
    // The volume as a fader position (sent when a drag ends) and the device by its
    // index in `monitor-devices` (0: System default).
    // The words for a position while a drag runs (`-1` clears them). The host is told
    // only from `set-monitor-volume`, when the pointer is released.
    callback preview-monitor-volume(float);
    callback set-monitor-volume(float);
    callback set-monitor-device(int);
    // A device picker is shown: list the playback devices (only then, ADR-0097).
    callback list-monitor-devices();
    // Some adapter can play on this computer.
    in property <bool> monitor-available;
    // A source is monitored or soloed: the Mixer shows the monitor row.
    in property <bool> monitor-wanted;
    // 0 neutral (not in use, opening), 1 playing, 2 a problem; the state in words, and
    // the latency while it plays ("42 ms").
    in property <int> monitor-tone;
    in property <string> monitor-status;
    in property <string> monitor-latency;
    in property <float> monitor-volume;
    in property <string> monitor-volume-text;
    in property <[string]> monitor-devices;
    in property <int> monitor-device;
    in property <string> monitor-device-name;
    // The soloed sources' names; empty while solo is off.
    in property <string> monitor-solo;
    callback set-source-volume(int /* id */, float /* position */);
    callback rename-source(int /* id */, string /* name */);
    // Collection glide defaults (ADR-0100): duration ms and easing 0 linear / 1 ease-in-out.
    in property <int> glide-duration: 400;
    in property <int> glide-easing: 1;
    callback set-glide(int /* duration_ms */, int /* easing */);
    // Per-source slide override (ADR-0100). `custom` false clears it.
    callback set-source-glide(int /* id */, bool /* custom */, int /* duration_ms */, int /* easing */);
    // The sync offset of a source's sound in milliseconds (ADR-0062): a live control.
    callback set-source-sync-offset(int /* id */, int /* ms */);
    // The Library panel (ADR-0075): the built-in looks and sample pictures. The samples'
    // thumbnails are made when the panel first shows (`library-shown`), not before.
    in property <[LookData]> library-looks;
    in property <[string]> library-look-names;
    in property <[SampleData]> library-samples;
    callback library-shown();
    callback apply-look(string /* look id */);
    callback apply-look-at(int /* index in library-looks */);
    callback add-sample(string /* sample id */);
    callback add-stamp(int /* 0 circle … 6 arrow */);
    callback add-image();
    callback set-source-fill(int /* id */, string /* #rrggbb */);
    callback set-source-filled(int /* id */, bool /* draw the fill */);
    callback open-filter-settings(int /* source */, int /* filter */);
    callback open-shape-settings(int /* source */);
    // The Library gear: open Properties on the look's settings. `look-reveal`
    // counts those asks; the section reports its place in `look-anchor-y`.
    callback open-look-settings(string /* look id */);
    in-out property <int> look-reveal: 0;
    in-out property <int> look-anchor-serial: 0;
    in-out property <length> look-anchor-y: 0px;
    // Filters (ADR-0062).
    // The Properties tab picked last: 0 Transform, 1 Filters, 2 Audio, 3 Source (shown first).
    in-out property <int> properties-tab;
    callback select-filter(int /* source */, int /* filter */);
    callback remove-filter(int /* filter */);
    callback move-filter(int /* filter */, int /* index */);
    callback set-filter-enabled(int /* filter */, bool /* on */);
    // A slider drag shows on the picture; release commits it as one undo step, cancel
    // puts the stored values back.
    callback preview-filter(int /* filter */, int /* field */, float /* position */);
    callback commit-filter(int /* filter */);
    callback cancel-filter(int /* filter */);
    callback set-filter-colour(int /* filter */, int /* field */, string /* colour */);
    callback reset-filter(int /* filter */);
    // A key source picked in a source field: option 0 is none, then the other sound sources.
    callback set-filter-source(int /* filter */, int /* field */, int /* option */);
    // The live levels of a filter's meter as bar positions; read by the gate bar's timer.
    callback filter-levels(int /* filter */) -> FilterLevels;
    // The scenes the canvas may show, in panel order, and what Add source can place
    // again (every source of the collection that the scene does not have yet).
    in property <[SceneData]> scenes;
    callback switch-scene(int /* id */);
    callback add-scene();
    callback remove-scene(int /* id */);
    callback rename-scene(int /* id */, string /* name */);
    // The Scenes panel's `+` in its card title row; each press adds one.
    in-out property <int> add-scene-asked;
    // Rename from a menu or a shortcut: the row of this scene or source starts its
    // name field and sets it back to -1.
    in-out property <int> renaming-scene: -1;
    in-out property <int> renaming-source: -1;
    // Counts the asks, so asking for the same row again is a change too.
    in-out property <int> rename-scene-asked;
    in-out property <int> rename-source-asked;
    // A menu or a shortcut asked to confirm before removing. The row shows its
    // confirm and sets the id back to -1. `confirm-source-kind` 1 removes the source
    // from this scene; 2 deletes it from every scene.
    in-out property <int> confirming-scene: -1;
    in-out property <int> confirm-scene-asked;
    in-out property <int> confirming-source: -1;
    in-out property <int> confirm-source-kind: 0;
    in-out property <int> confirm-source-asked;
    // A video source's box on the canvas, in canvas pixels.
    callback set-source-box(int /* id */, float /* x */, float /* y */, float /* w */, float /* h */);
    // Shape and border of a video source (ADR-0053); a colour that is not #rrggbb or
    // #rrggbbaa is ignored.
    // Source pixels cut from each edge (ADR-0058); the box changes so the scale stays.
    callback set-source-crop(int /* id */, int /* left */, int /* top */, int /* right */, int /* bottom */);
    // 0 full picture, 1 canvas size centred, 2 left half, 3 right half.
    callback set-source-region(int /* id */, int /* region */);
    // Capture region on the source (ADR-0103), not item crop.
    callback set-source-capture-region(int /* id */, bool /* clear */, int /* left */, int /* top */, int /* right */, int /* bottom */);
    // Display chrome (ADR-0104); fill 0 cover, 1 fit.
    callback set-display-chrome(int /* id */, bool /* on */, int /* top */, int /* right */, int /* bottom */, int /* left */, int /* fill */);
    callback fit-display-chrome(int /* id */);
    callback reset-display-chrome(int /* id */);
    // Timed show (ADR-0105): `show_for_ms` 0 clears; `show-item` is live.
    callback set-item-show-for(int /* item */, int /* show_for_ms */);
    callback show-item(int /* item */);
    // 0 flip horizontally, 1 flip vertically, 2 turn 90 clockwise, 3 turn 90 counter-clockwise,
    // 4 reserved (was 180°; use two 90° turns), 5 fit, 6 fill, 7 stretch, 8 centre, 9 reset (ADR-0084).
    callback transform-source(int /* id */, int /* op */);
    // Degrees clockwise about the box centre, wrapped into 0..360. Moves that share a
    // non-zero `gesture` are one undo step. 0 never joins.
    callback set-source-rotation(int /* id */, float /* degrees */, int /* gesture */);
    // Bumped by a drag so each drag has its own gesture. The host never writes it.
    in-out property <int> gesture-serial: 1;
    callback set-source-style(int /* id */, int /* shape */, float /* radius */, bool /* border */, float /* width */, string /* colour */);
    // The selection drawn by the toolkit where no preview layer shows the picture (the
    // layer draws it itself otherwise, ADR-0048).
    in property <[MarkData]> marks;
    // Pointer on the picture panel (panel coordinates, logical pixels; `w`, `h` the
    // panel's size). Shift: free resize at corners; Ctrl or Cmd: no snapping.
    // `crop`: Alt (Option) held, a handle crops instead of resizing (ADR-0058).
    callback preview-press(float /* x */, float /* y */, float /* w */, float /* h */, bool /* shift */, bool /* no-snap */, bool /* crop */);
    callback preview-drag(float /* x */, float /* y */);
    callback preview-release();
    // The picture's context menu opens at `x`, `y` (the picture's own coordinates).
    callback preview-menu-opened(float /* x */, float /* y */);
    // Arrow keys on the picture panel: move the selected source by this many canvas
    // pixels.
    callback preview-nudge(int /* dx */, int /* dy */);
    // Escape on the picture panel.
    callback preview-deselect();
    callback undo-delete();
    callback dismiss-deleted();
    // What Undo and Redo would apply to the scene now: 0 nothing, 1 adding, 2 deleting,
    // 3 the layer order, 4 moving or resizing the source named `undo-name` /
    // `redo-name` (U4). Separate from the layout history (U21).
    in property <int> undo-kind;
    in property <string> undo-name;
    in property <int> redo-kind;
    in property <string> redo-name;
    // Undo (true) or redo (false) the newest scene edit.
    callback undo-edit(bool /* back */);
    callback reset-clip(int /* source id */);
    callback reset-master-clip();
    // The master's fader position (0 to 1, the strips' fader law) and its mute (ADR-0081).
    callback set-master-volume(float);
    callback set-master-muted(bool);
    // The fader position (0 to 1) of a level the user typed, such as "-6 dB"; -1 when the
    // text is not a level. Pure: it reads nothing from the app.
    pure callback level-position(string) -> float;

    // Recording: 0 off, 1 starting, 2 recording, 3 stopping.
    in property <int> rec-state;
    // The file being recorded (name only).
    in property <string> rec-file;
    // The last recording's outcome or why one did not start; `rec-note-bad` marks a problem.
    in property <string> rec-note;
    in property <bool> rec-note-bad;
    // Why this system cannot record; empty when it can.
    in property <string> rec-unavailable;
    callback record();
    callback stop-recording();

    // The canvas whose settings the Recording and Stream sections show (ADR-0093
    // decision 6): 0 main, 1 vertical. The selector is shown only while the vertical
    // canvas exists (`settings-canvases` has two entries).
    in property <[string]> settings-canvases;
    in property <int> settings-canvas;
    callback set-settings-canvas(int);
    // The picked canvas's recording, and its stream, do not run: its settings can change.
    in property <bool> rec-form-idle: true;
    in property <bool> st-form-idle: true;
    // The vertical canvas has no recording settings of its own yet: it uses the main ones.
    in property <bool> out-uses-main;

    // Output settings of the next recording.
    in-out property <string> out-folder;
    // Bumped by Rust when `out-folder` is set from outside the field.
    in-out property <int> out-folder-serial;
    in property <[string]> out-formats;
    in property <int> out-format;
    // Output size of the next recording (ADR-0102): a switch, then nested frames.
    in property <bool> out-same;
    in property <bool> out-portrait;
    in property <[SizeBand]> out-bands;
    in property <[SizeBand]> out-extras;
    in property <int> out-choice;
    in property <string> out-value;
    // The long side the field shows: the stored size, or the canvas when it is the same.
    in property <int> out-long;
    // The recording's encoder fields.
    in property <EncoderData> out-enc;
    // A problem with the settings or their file; empty when none.
    in property <string> out-note;
    callback set-folder(string);
    callback set-format(int);
    // An Output size chip of an output (0 recording, 1 stream) was picked.
    callback set-output-size(int /* output */, int /* index */);
    // A long side was typed for that output. The short side follows the canvas.
    callback set-output-long-side(int /* output */, float);
    // Same as canvas was turned on or off for that output.
    callback set-output-same(int /* output */, bool);
    // An encoder field of an output (0 recording, 1 stream) was picked: `field` is an
    // `EncoderFields` code, `value` the picked index (padding: 0 off, 1 on).
    callback set-encoding(int /* output */, int /* field */, int /* value */);
    // One line: format, encoder, bitrates and folder of the next recording.
    in property <string> out-summary;
    // Opens the Settings window at its Recording section.
    callback open-settings();

    // Streaming (Live controls, Settings > Stream): 0 off, 1 starting, 2 live, 3 ending.
    in property <int> st-state;
    // Live and connected: the program reaches the server.
    in property <bool> st-connected;
    // The stream's state or last outcome in words, for Live controls; `st-bad` marks a
    // problem.
    in property <string> st-text;
    in property <bool> st-bad;
    // No server or stream key yet: Live controls offer "Stream settings".
    in property <bool> st-needs-setup;
    callback go-live();
    callback end-stream();

    // The virtual camera in Live controls (ADR-0066 decision 12): shown where this
    // platform has one; `vcam-can` while it is added (or sends) and the studio runs.
    // End stream ends the vertical stream too ("Main + vertical", ADR-0111): the
    // question names both.
    in property <bool> st-end-both;
    in property <bool> vcam-shown;
    in property <bool> vcam-can;
    in property <bool> vcam-on;
    // Its state in words under the button; empty when the button says enough.
    in property <string> vcam-text;
    // Start (true) or stop sending.
    callback vcam-toggle(bool);
    // Opens the Settings window at its Stream section.
    callback open-stream-settings();
    // Stream settings: the server URL field's text, bumped serial when Rust sets it.
    in property <string> st-server;
    in property <int> st-server-serial;
    // Whether a key is saved, and where keys are kept (the hint).
    in property <bool> st-key-saved;
    in property <string> st-key-place;
    // Bumped when a key was saved or removed: the key field is emptied.
    in property <int> st-key-serial;
    in property <bool> st-reconnect;
    // "Record when the stream starts", and what it costs (shown while it is on).
    in property <bool> st-auto-record;
    in property <string> st-auto-record-note;
    // The server is srt://: the latency field shows.
    in property <bool> st-srt;
    in property <[string]> st-latencies;
    in property <int> st-latency;
    in property <EncoderData> st-enc;
    // Output size of the next stream (ADR-0102): a switch, then nested frames.
    in property <bool> st-same;
    in property <[SizeBand]> st-bands;
    in property <[SizeBand]> st-extras;
    in property <int> st-choice;
    in property <string> st-value;
    in property <int> st-long;
    // A problem with the stream settings, the key or their file; empty when none.
    in property <string> st-note;
    // One line: protocol, server, encoder and bitrates of the next stream.
    in property <string> st-summary;
    // The Outputs panel's labelled rows (recording, then stream).
    in property <string> out-kind;
    in property <string> out-encoder-name;
    in property <string> out-video-line;
    in property <string> out-audio-line;
    in property <string> out-where;
    in property <string> st-kind;
    in property <string> st-where;
    in property <string> st-encoder-name;
    in property <string> st-video-line;
    in property <string> st-audio-line;
    callback set-server(string);
    // The server field changed but is not confirmed yet: confirmed when Settings
    // closes or Go live is pressed.
    callback server-edited(string);
    callback save-key(string);
    callback remove-key();
    callback set-reconnect(bool);
    callback set-auto-record(bool);
    callback set-latency(int);

    // The canvas (Settings, Video): tiles for the current orientation, the one in
    // use (-1 when the size matches none), the fields, and "W × H" for the status bar.
    in property <[SizeBand]> canvas-bands;
    in property <[SizeBand]> canvas-extras;
    in property <int> canvas-choice;
    in property <string> canvas-value;
    in property <int> canvas-width;
    in property <int> canvas-height;
    in property <bool> canvas-portrait;
    in property <string> canvas-label;
    in property <[string]> canvas-rates;
    in property <int> canvas-rate;
    // The studio restarts with a new canvas; true until it runs again.
    in property <bool> canvas-restarting;
    // A problem with the canvas or its file; empty when none.
    in property <string> canvas-note;
    callback set-canvas-sides(float, float);
    callback set-canvas-portrait(bool);
    callback set-canvas-rate(int);

    // General (Settings, General): leave the RBS windows out of a screen recording.
    in property <bool> exclude-own-window: true;
    callback set-exclude-own-window(bool);
    // General (Settings, General, ADR-0056): what closing the main window does.
    // 0 Quit RBS, 1 Keep RBS running.
    in property <int> on-close;
    // 0 macOS, 1 Windows, 2 elsewhere (the setting is not available there).
    in property <int> platform;
    // A hidden window can be brought back on this platform now; without it, closing
    // the window quits.
    in property <bool> way-back;
    callback set-on-close(int);
    // Studio mode (Settings, General, ADR-0098): a transition also puts the old
    // program scene in preview. Off by default.
    in property <bool> swap-after-transition;
    callback set-swap-after-transition(bool);

    // Remote control (Settings, Remote control): other apps control RBS through the
    // control API. Off by default.
    in property <bool> rc-enabled;
    // The port field's text; set by Rust on load and when a typed port is refused.
    in property <string> rc-port;
    // Bumped by Rust when `rc-port` is set from outside the field.
    in property <int> rc-port-serial;
    // Where apps connect, or why remote control is not running; `rc-status-bad` marks a
    // problem.
    in property <string> rc-status;
    in property <bool> rc-status-bad;
    in property <[TokenRow]> rc-tokens;
    // Access choices and the one-line explanation of each.
    in property <[string]> rc-accesses;
    in property <[string]> rc-access-hints;
    // A token just made: shown once, until dismissed. Empty when none.
    in property <string> rc-new-token;
    in property <string> rc-new-token-name;
    // A problem with a token or the settings file; empty when none.
    in property <string> rc-note;
    callback set-rc-enabled(bool);
    callback set-rc-port(string);
    callback create-token(string /* name */, int /* access */);
    callback revoke-token(int);
    callback dismiss-new-token();
    // The access token revoked last; empty when none. "Undo" puts it back.
    in property <string> rc-revoked;
    callback undo-revoke();

    // Network access (ADR-0046): other computers connect over TLS. Off by default.
    in property <bool> rc-network;
    // "Allow remote admin": Full control tokens keep admin from other computers.
    in property <bool> rc-remote-admin;
    // Other computers can connect now: the frame shows it in every workspace.
    in property <bool> rc-network-on;
    // Where other computers connect, or why they cannot; `-bad` marks a problem.
    in property <string> rc-network-status;
    in property <bool> rc-network-status-bad;
    // What clients check: the key pin, and the certificate fingerprint.
    in property <string> rc-key-pin;
    in property <string> rc-fingerprint;
    // Where the certificate came from, and whether it was just renewed.
    in property <string> rc-cert-note;
    // A problem with a network access change (files, new key); empty when none.
    in property <string> rc-network-note;
    // The user's own certificate is used, and its files.
    in property <bool> rc-own;
    in property <string> rc-own-cert;
    in property <string> rc-own-key;
    callback set-rc-network(bool);
    callback set-rc-remote-admin(bool);
    callback rc-use-own(string /* certificate */, string /* key */);
    callback rc-use-generated();
    callback rc-new-key();

    // Output profiles and scene collections (ADR-0051): the entries, the one in use,
    // and the menu actions. Actions: 0 new, 1 duplicate (both with a name and then
    // used), 2 rename the one in use, 3 delete the one in use, 4 import a file,
    // 5 export the one in use to a file.
    in property <[EntryRow]> profiles;
    in property <string> profile-name;
    in property <[EntryRow]> collections;
    in property <string> collection-name;
    // A scene collection switch is running (the studio restarts).
    in property <bool> switching;
}

// The canvas as the viewers see it. The picture is a native layer the app places over
// this rectangle; Slint draws only the background and the letterbox bars.
export component ProgramPanel inherits Rectangle {
    // "rbs.program" or "rbs.preview".
    in property <string> panel;
    in property <string> title;
    // In studio mode both panels have a picture: Preview the preview scene, Program the
    // scene on air (ADR-0061).
    property <bool> scene: Studio.studio-mode && panel == "rbs.preview";
    property <bool> here: Studio.studio-mode || Studio.picture-panel == panel;
    property <int> shown: !here ? 6 : scene ? Studio.scene-preview-state : Studio.preview-state;
    background: Theme.surface-sunken;
    accessible-role: image;
    accessible-label: title;
    accessible-description: shown != 0 ? note.text
        : scene ? @tr("The picture of the preview scene, the next to go on air")
        : @tr("The live picture of the scene on air");
    note := Text {
        visible: shown != 0;
        width: parent.width - 2 * Tokens.space-4;
        text: shown == 1 ? (scene ? @tr("The preview is starting.") : @tr("The program is starting."))
            : shown == 2 && scene ? @tr("The preview scene's own picture is not available on this platform yet. Its sources are in the Sources panel, and Transition puts it on air.")
            : shown == 2 ? @tr("The program picture is not available on this platform yet.")
            : shown == 3 ? @tr("The program picture cannot be shown in this session, for example over remote desktop.")
            : shown == 4 ? @tr("The picture shows in the main window. Dock this panel back to see it here.")
            : shown == 6 ? @tr("Studio mode is off, so the scene on air shows in the Program panel.")
            : @tr("The studio is not running: {}", Studio.failure);
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    // Selecting, moving and resizing sources on the picture (ADR-0048). Arrow keys move
    // the selected source by 1 canvas pixel, with Shift by 10; Escape clears the
    // selection. Delete or Backspace asks with the source row's confirmation: a bar
    // drawn on the picture would sit under the live picture.
    // In studio mode the preview scene is edited, on the Preview picture only.
    property <bool> editable: here && Studio.state == 1 && (!Studio.studio-mode || scene);
    keys := FocusScope {
        focus-on-click: false;
        enabled: editable;
        key-pressed(e) => {
            if Studio.selected-source < 0 { return reject; }
            let step = e.modifiers.shift ? 10 : 1;
            if e.text == Key.LeftArrow { Studio.preview-nudge(-step, 0); return accept; }
            if e.text == Key.RightArrow { Studio.preview-nudge(step, 0); return accept; }
            if e.text == Key.UpArrow { Studio.preview-nudge(0, -step); return accept; }
            if e.text == Key.DownArrow { Studio.preview-nudge(0, step); return accept; }
            if e.text == Key.Escape { Studio.preview-deselect(); return accept; }
            if e.text == Key.Delete || e.text == Key.Backspace {
                Studio.ask-remove-selected();
                return accept;
            }
            reject
        }
    }
    // A right-click on the picture: the menu of the source under the pointer (it
    // becomes the selection), else the panel's own menu.
    property <Point> menu-at;
    menu := CommandMenu {
        context: "preview";
        target: "h=" + round(touch.height / 1px) + "&id=" + root.panel + "&w=" + round(touch.width / 1px)
            + "&x=" + round(root.menu-at.x / 1px) + "&y=" + round(root.menu-at.y / 1px);
    }
    touch := TouchArea {
        enabled: editable;
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { Studio.preview-release(); return; }
            // The menu opens when the right button goes up, not down, so the press it
            // opened on has its release. On Windows the click that closes a system menu
            // reaches the picture as a press at the place the menu opened (the moves
            // made while it was open never arrive) and without its release; the app
            // tells it from a real press by the cursor's place (`preview-menu-opened`).
            if e.button == PointerEventButton.right {
                if e.kind == PointerEventKind.up {
                    keys.focus();
                    root.menu-at = { x: self.mouse-x, y: self.mouse-y };
                    Studio.preview-menu-opened(self.mouse-x / 1px, self.mouse-y / 1px);
                    menu.open(root.menu-at);
                }
                return;
            }
            if e.button != PointerEventButton.left { return; }
            if e.kind == PointerEventKind.down {
                keys.focus();
                Studio.preview-press(self.pressed-x / 1px, self.pressed-y / 1px, self.width / 1px, self.height / 1px, e.modifiers.shift, e.modifiers.control || e.modifiers.meta, e.modifiers.alt);
            }
            if e.kind == PointerEventKind.up { Studio.preview-release(); }
        }
        moved => {
            if self.pressed { Studio.preview-drag(self.mouse-x / 1px, self.mouse-y / 1px); }
        }
    }
    // Where no layer shows the picture, the toolkit draws the selection itself, clipped
    // to the panel like the layer's marks.
    if shown != 0 && editable: Rectangle {
        clip: true;
        for m in Studio.marks: Rectangle {
            x: m.x;
            y: m.y;
            width: m.w;
            height: m.h;
            background: m.kind == 2 ? Theme.surface-raised : Theme.accent;
        }
    }
}

// The vertical canvas as its viewers see it (ADR-0093 decision 7), view only. The
// picture is a native layer placed over this rectangle, made only while the panel shows.
export component VerticalPanel inherits Rectangle {
    in property <string> title;
    property <int> shown: Studio.vertical-preview-state;
    background: Theme.surface-sunken;
    accessible-role: image;
    accessible-label: title;
    accessible-description: shown != 0 ? note.text : @tr("The live picture of the vertical canvas");
    note := Text {
        visible: shown != 0;
        width: parent.width - 2 * Tokens.space-4;
        text: shown == 1 ? @tr("The vertical picture is starting.")
            : shown == 2 ? @tr("The vertical picture is not available on this platform yet. Its recording and stream work as usual.")
            : shown == 3 ? @tr("The vertical picture cannot be shown in this session, for example over remote desktop.")
            : shown == 4 ? @tr("The picture shows in the main window. Dock this panel back to see it here.")
            : shown == 7 ? @tr("There is no vertical canvas. Add a vertical output to see it here.")
            : shown == 8 ? @tr("The vertical picture did not start. Hide and show this panel to try again.")
            : @tr("The studio is not running: {}", Studio.failure);
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

// One row of the Sources list (spec Frame, mockup E): the kind's icon, the name (the
// state below it only when something is wrong), and on the right Show/Hide and, for a
// picture, Lock. Move up, Move down and Remove are in the row's menu; Delete asks first.
component SourceRowView inherits Rectangle {
    in property <SourceData> data;
    // Move up, Move down or Remove was confirmed: the list is made again, so
    // the row's focus is about to go.
    callback leaving();
    property <bool> selected: Studio.selected-source == data.id;
    property <color> ink: data.visible ? Theme.text-primary : Theme.text-disabled;
    // Delete or Backspace asks first; a second Delete, Return or Remove confirms.
    // `delete-all`: the confirm removes the source from every scene (Delete source).
    property <bool> confirm;
    // A menu or the Delete key leaves the row without focus, and a touch area
    // under the confirm buttons takes the first click. The row takes the focus
    // again, and its own press is off while it asks.
    changed confirm => {
        if root.confirm { focus.focus(); }
    }
    property <bool> delete-all;
    property <int> confirm-asked: Studio.confirm-source-asked;
    changed confirm-asked => { root.take-confirm(); }
    function take-confirm() {
        if Studio.confirming-source == data.id {
            root.delete-all = Studio.confirm-source-kind == 2;
            root.confirm = true;
            Studio.confirming-source = -1;
        }
    }
    // Another source row is dragged over this one: it would take this row's place.
    property <bool> drop-here: drop.has-drag && Studio.dragging-source >= 0 && Studio.dragging-source != data.id;
    height: data.ok ? Tokens.size-control-md : Tokens.size-control-md + Tokens.type-caption-line;
    border-radius: Tokens.radius-sm;
    border-width: selected ? Tokens.size-border : 0px;
    border-color: Theme.accent;
    background: selected || touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: list-item;
    accessible-label: @tr("{}, {}, {}{}{}", data.name, data.kind, data.status, data.visible ? "" : @tr(", hidden"), data.locked ? @tr(", locked") : "");
    accessible-description: (data.global ? @tr("In every scene. ") : data.in-globals ? @tr("Also in every scene. ") : data.also-in != "" ? @tr("Also in {}. ", data.also-in) : "")
        + (data.picture ? @tr("Alt+Up or Alt+Down changes the layer, F2 renames it, double-click opens Source settings when available, Delete asks before removing it from this scene, the Menu key or Shift+F10 opens its menu") : @tr("F2 renames it, double-click opens Source settings when available, Delete asks before removing it from this scene, the Menu key or Shift+F10 opens its menu"));
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-action-default => { Studio.select-source(data.id); }
    // Return or Space selects the focused row; the TouchArea is after the FocusScope
    // so it gets the press (see Button).
    // Rename: from the menu, a shortcut or F2. Double-click opens Source settings
    // when the source has one (screens, windows and cameras).
    in-out property <bool> editing;
    property <int> rename-asked: Studio.rename-source-asked;
    changed rename-asked => { root.take-rename(); }
    init => { root.take-confirm(); root.take-rename(); }
    function take-rename() {
        if Studio.renaming-source == data.id { root.editing = true; Studio.renaming-source = -1; }
    }
    menu := CommandMenu {
        context: "source";
        target: "source=" + data.id;
    }
    focus := RingFocus {
        focus-on-click: false;
        key-pressed(e) => {
            if root.confirm && e.text == Key.Escape { root.confirm = false; return accept; }
            if root.confirm && (e.text == Key.Return || e.text == Key.Delete || e.text == Key.Backspace) {
                root.leaving();
                if root.delete-all { Studio.delete-source(data.id); } else { Studio.remove-from-scene(data.id); }
                return accept;
            }
            if e.text == Key.Return || e.text == " " { Studio.select-source(data.id); return accept; }
            if e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift) {
                menu.open({ x: Tokens.space-2, y: root.height });
                return accept;
            }
            if e.text == Key.F2 { root.editing = true; return accept; }
            if e.modifiers.alt && e.text == Key.UpArrow && data.picture && data.can-up {
                root.leaving(); Studio.move-source(data.id, true); return accept;
            }
            if e.modifiers.alt && e.text == Key.DownArrow && data.picture && data.can-down {
                root.leaving(); Studio.move-source(data.id, false); return accept;
            }
            if e.text == Key.Delete || e.text == Key.Backspace {
                root.delete-all = false;
                root.confirm = true;
                return accept;
            }
            reject
        }
    }
    // Rows of sources with a picture can be dragged onto each other to change the
    // layer order; a press without a drag selects the row.
    drop := DropArea {
        // Off while a panel is dragged, so the drop reaches the dock under the row.
        enabled: Studio.dragging-source >= 0;
        can-drop(e) => {
            if Studio.is-panel(e.data) || Studio.dragging-source < 0 { return DragAction.none; }
            return data.picture && Studio.dragging-source != data.id ? DragAction.move : DragAction.none;
        }
        dropped(e) => {
            if Studio.is-panel(e.data) || Studio.dragging-source < 0 { return DragAction.none; }
            Studio.move-source-to(Studio.dragging-source, data.id);
            Studio.dragging-source = -1;
            return DragAction.move;
        }
    }
    drag := DragArea {
        allow-move: data.picture && !root.confirm;
        data: Studio.source-data(data.id);
        changed dragging => {
            if self.dragging { Studio.dragging-source = data.id; } else { Studio.dragging-source = -1; }
        }
        touch := TouchArea {
            enabled: !root.confirm;
            clicked => { if !root.confirm { focus.focus-pointer(); Studio.select-source(data.id); } }
            double-clicked => {
                Studio.select-source(data.id);
                // Screens, windows and cameras (kind-code 0–2) have a Source settings
                // window; other kinds keep the selection only (Rename stays on F2 / menu).
                if data.kind-code >= 0 && data.kind-code <= 2 {
                    Studio.open-source-settings(data.id);
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    focus.focus-pointer();
                    Studio.select-source(data.id);
                    menu.open({ x: self.mouse-x, y: self.mouse-y });
                }
            }
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-1;
                spacing: Tokens.space-2;
                VerticalLayout {
                    alignment: center;
                    Icon { name: Icons.named(data.icon); ink: data.visible ? Theme.text-primary : Theme.text-disabled; }
                }
                if root.editing: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    TextField {
                        label: @tr("Name of the source {}", data.name);
                        text: data.name;
                        init => { self.focus(); }
                        accepted(t) => {
                            root.editing = false;
                            if t != data.name { Studio.rename-source(data.id, t); }
                        }
                    }
                }
                if !root.editing: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: Tokens.space-1;
                        // A source that is not running (its window closed, its camera
                        // unplugged): the mark and the reason say so, the name is dimmed
                        // (ADR-0077, U7: never colour alone).
                        if !data.ok: VerticalLayout {
                            alignment: center;
                            Icon { name: IconName.warning; ink: Theme.state-warning; }
                        }
                        Text {
                            text: data.name;
                            color: data.ok ? root.ink : Theme.text-disabled;
                            font-size: Tokens.type-body-size;
                            font-weight: root.selected ? Tokens.type-title-weight : Tokens.type-body-weight;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // In every scene, or also in other scenes (ADR-0065): one
                        // source, one device; the words are in the accessible
                        // description (U7).
                        if data.global || data.in-globals: VerticalLayout {
                            alignment: center;
                            Icon { name: IconName.globe; ink: Theme.text-secondary; }
                        }
                        if !data.global && !data.in-globals && data.also-in != "": VerticalLayout {
                            alignment: center;
                            Icon { name: IconName.link; ink: Theme.text-secondary; }
                        }
                    }
                    // State in words, never colour alone (U7); shown when it needs attention.
                    if !data.ok: Text {
                        text: data.status;
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                        overflow: elide;
                    }
                }
                // Eye = lasting hide/show (undoable). Hourglass = timed show (ADR-0105).
                VerticalLayout {
                    alignment: center;
                    spacing: Tokens.space-1;
                    IconButton {
                        icon: data.show-for-ms > 0
                            ? IconName.hourglass
                            : (data.visible ? IconName.eye : IconName.eye-off);
                        name: data.show-for-ms > 0
                            ? (data.visible
                                ? @tr("Hide {}", data.name)
                                : @tr("Timed show {} for {} ms", data.name, data.show-for-ms))
                            : (data.visible
                                ? @tr("Hide {}", data.name)
                                : @tr("Show {}", data.name));
                        checked: data.show-for-ms > 0 ? false : !data.visible;
                        clicked => {
                            if data.show-for-ms > 0 {
                                if data.visible {
                                    Studio.set-source-visible(data.id, false);
                                } else {
                                    Studio.show-item(data.item-id);
                                }
                            } else {
                                Studio.set-source-visible(data.id, !data.visible);
                            }
                        }
                    }
                    if data.picture && data.show-for-ms > 0 && data.cue-remaining-ms > 0: Text {
                        text: data.cue-remaining-ms + @tr(" ms left");
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                        horizontal-alignment: center;
                    }
                }
                // Locked on the picture panel (sources with a picture only).
                if data.picture: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: data.locked ? IconName.lock : IconName.unlock;
                        name: data.locked ? @tr("Unlock {}", data.name) : @tr("Lock {}", data.name);
                        checked: data.locked;
                        clicked => { Studio.set-source-locked(data.id, !data.locked); }
                    }
                }
            }
        }
    }
    if root.confirm: Rectangle {
        y: 0;
        width: parent.width;
        height: parent.height;
        clip: true;
        background: Theme.surface-overlay;
        border-radius: Tokens.radius-sm;
        border-width: Tokens.size-border;
        border-color: Theme.accent;
        HorizontalLayout {
            height: parent.height;
            padding-left: Tokens.space-2;
            padding-right: Tokens.space-1;
            spacing: Tokens.space-1;
            Text {
                text: root.delete-all ? @tr("Delete {} from every scene?", data.name)
                    : data.global ? @tr("Remove {} from global sources?", data.name)
                    : @tr("Remove {} from this scene?", data.name);
                color: Theme.text-primary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    kind: "danger";
                    name: root.delete-all ? @tr("Delete {}", data.name)
                        : data.global ? @tr("Remove {} from global sources", data.name)
                        : @tr("Remove {} from this scene", data.name);
                    clicked => {
                        root.leaving();
                        if root.delete-all { Studio.delete-source(data.id); } else { Studio.remove-from-scene(data.id); }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: IconName.close;
                    name: @tr("Cancel");
                    clicked => { root.confirm = false; }
                }
            }
        }
    }
    // Where a dragged row would go: a line along this row's top.
    if drop-here: Rectangle {
        y: 0;
        height: Tokens.size-focus-ring;
        background: Theme.accent;
    }
    FocusRing { show: focus.ring; border-radius: Tokens.radius-md; }
}

// One scene in the Scenes panel: its number, its name and, on air, a Live badge
// (mockup E). A click puts it on air. Rename shows on hover. Delete asks first.
component SceneRowView inherits Rectangle {
    in property <SceneData> data;
    in property <bool> can-remove;
    // 0 nothing goes out, 1 streaming, 2 recording, 3 both (the shell's live state).
    in property <int> live-state;
    callback leaving();
    property <bool> tools: touch.has-hover || editing;
    property <bool> confirm;
    // Same as a source row: the menu or Delete key drops the focus, so the row
    // takes it again and ignores its own press while it asks.
    changed confirm => {
        if root.confirm { focus.focus(); }
    }
    property <int> confirm-asked: Studio.confirm-scene-asked;
    changed confirm-asked => { root.take-scene-confirm(); }
    function take-scene-confirm() {
        if Studio.confirming-scene == data.id {
            root.confirm = true;
            Studio.confirming-scene = -1;
        }
    }
    in-out property <bool> editing;
    height: Tokens.size-control-md;
    border-radius: Tokens.radius-sm;
    border-width: marked ? Tokens.size-border : 0px;
    border-color: Theme.accent;
    // The scene being worked on is marked like a selected row: the one shown, or in
    // studio mode the preview scene (ADR-0061). The live colour and badge only while
    // the scene on air actually goes out (streaming or recording, U12).
    property <bool> studio: Studio.studio-mode;
    property <bool> marked: studio ? data.preview : data.live;
    // Another scene row is dragged over this one: it would take this row's place.
    property <bool> drop-here: drop.has-drag && Studio.dragging-scene >= 0 && Studio.dragging-scene != data.id;
    background: marked || touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: list-item;
    accessible-label: @tr("{}{}{}", data.name,
        studio && data.preview ? @tr(", in preview") : "",
        !data.live ? ""
        : root.live-state == 0 ? (studio ? @tr(", program") : @tr(", shown"))
        : root.live-state == 2 ? @tr(", on air and recording")
        : @tr(", on air"));
    accessible-description: Studio.studio-mode
        ? @tr("Return puts it in preview, F2 renames it, Delete asks before removing it, the Menu key or Shift+F10 opens its menu")
        : @tr("Return puts it on air, F2 renames it, Delete asks before removing it, the Menu key or Shift+F10 opens its menu");
    accessible-item-selectable: true;
    accessible-item-selected: data.live;
    accessible-action-default => { Studio.switch-scene(data.id); }
    property <int> rename-asked: Studio.rename-scene-asked;
    changed rename-asked => { root.take-rename(); }
    init => { root.take-scene-confirm(); root.take-rename(); }
    function take-rename() {
        if Studio.renaming-scene == data.id { root.editing = true; Studio.renaming-scene = -1; }
    }
    menu := CommandMenu {
        context: "scene";
        target: "scene=" + data.id;
    }
    focus := RingFocus {
        focus-on-click: false;
        key-pressed(e) => {
            if root.confirm && e.text == Key.Escape { root.confirm = false; return accept; }
            if root.confirm && (e.text == Key.Return || e.text == Key.Delete || e.text == Key.Backspace) {
                root.leaving(); Studio.remove-scene(data.id); return accept;
            }
            if e.text == Key.Return || e.text == " " { Studio.switch-scene(data.id); return accept; }
            if e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift) {
                menu.open({ x: Tokens.space-2, y: root.height });
                return accept;
            }
            if e.text == Key.F2 { root.editing = true; return accept; }
            if (e.text == Key.Delete || e.text == Key.Backspace) && root.can-remove {
                root.confirm = true;
                return accept;
            }
            reject
        }
    }
    // The row's buttons sit inside its TouchArea, so pointing at them keeps the row
    // hovered; their space is always reserved, so the Live badge never moves (ADR-0059).
    // Dragging the row reorders the scene list. A panel drag is not a scene.
    drop := DropArea {
        width: parent.width;
        height: parent.height;
        enabled: Studio.dragging-scene >= 0;
        can-drop(e) => {
            if Studio.is-panel(e.data) || Studio.dragging-scene < 0 || Studio.dragging-scene == data.id {
                return DragAction.none;
            }
            return DragAction.move;
        }
        dropped(e) => {
            if Studio.is-panel(e.data) || Studio.dragging-scene < 0 { return DragAction.none; }
            Studio.move-scene-to(Studio.dragging-scene, data.id);
            Studio.dragging-scene = -1;
            return DragAction.move;
        }
    }
    drag := DragArea {
        allow-move: !root.editing && !root.confirm;
        data: Studio.scene-data(data.id);
        changed dragging => {
            if self.dragging { Studio.dragging-scene = data.id; } else { Studio.dragging-scene = -1; }
        }
    touch := TouchArea {
        enabled: !root.confirm;
        clicked => { if !root.confirm { focus.focus-pointer(); Studio.switch-scene(data.id); } }
        double-clicked => { root.editing = true; }
        // A right-click opens the row's menu without putting the scene on air.
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                focus.focus-pointer();
                menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-2;
        Text {
            min-width: Tokens.size-icon-box;
            text: data.number;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            accessible-role: none;
        }
        if !root.editing: Text {
            horizontal-stretch: 1;
            text: data.name;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            font-weight: root.marked ? Tokens.type-title-weight : Tokens.type-body-weight;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.editing: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            name-field := TextField {
                label: @tr("Name of the scene {}", data.name);
                text: data.name;
                init => { self.focus(); }
                accepted(t) => {
                    root.editing = false;
                    if t != data.name { Studio.rename-scene(data.id, t); }
                }
            }
        }
        // In studio mode the scene on air says so in neutral colours while nothing
        // goes out (ADR-0061).
        if studio && data.live && root.live-state == 0 && !root.editing: VerticalLayout {
            alignment: center;
            Rectangle {
                height: Tokens.type-caption-line;
                width: program-text.preferred-width + 2 * Tokens.space-2;
                border-radius: self.height / 2;
                background: Theme.surface-overlay;
                program-text := Text {
                    text: @tr("Program");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    font-weight: Tokens.type-label-weight;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
        // On air: in words with a small dot in the live colour (U7, U12), only while
        // it goes out. No filled badge: the live indicator already carries the state.
        if data.live && root.live-state != 0 && !root.editing: HorizontalLayout {
            spacing: Tokens.space-1 / 2;
            VerticalLayout {
                alignment: center;
                Icon { name: IconName.dot; ink: Theme.state-live; }
            }
            Text {
                text: root.live-state == 1 ? @tr("Live") : root.live-state == 2 ? @tr("REC") : @tr("Live · REC");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                font-weight: Tokens.type-label-weight;
                vertical-alignment: center;
            }
        }
        if !root.editing: VerticalLayout {
            alignment: center;
            IconButton {
                visible: root.tools;
                icon: IconName.more;
                name: @tr("Actions for {}", data.name);
                clicked => {
                    menu.open({
                        x: self.absolute-position.x - menu.absolute-position.x,
                        y: self.absolute-position.y - menu.absolute-position.y + self.height,
                    });
                }
            }
        }
        if !root.editing: VerticalLayout {
            alignment: center;
            IconButton {
                visible: root.tools && root.can-remove;
                icon: IconName.close;
                name: @tr("Remove scene {}", data.name);
                clicked => { focus.focus-pointer(); root.confirm = true; }
            }
        }
    }
    }
    }
    if root.confirm: Rectangle {
        y: 0;
        width: parent.width;
        height: parent.height;
        clip: true;
        background: Theme.surface-overlay;
        border-radius: Tokens.radius-sm;
        border-width: Tokens.size-border;
        border-color: Theme.accent;
        HorizontalLayout {
            height: parent.height;
            padding-left: Tokens.space-2;
            padding-right: Tokens.space-1;
            spacing: Tokens.space-1;
            Text {
                text: @tr("Remove {}?", data.name);
                color: Theme.text-primary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    kind: "danger";
                    name: @tr("Remove scene {}", data.name);
                    clicked => { root.leaving(); Studio.remove-scene(data.id); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: IconName.close;
                    name: @tr("Cancel");
                    clicked => { root.confirm = false; }
                }
            }
        }
    }
    // Where a dragged scene would go: a line along this row's top.
    if drop-here: Rectangle {
        y: 0;
        height: Tokens.size-focus-ring;
        width: parent.width;
        background: Theme.accent;
    }
    FocusRing { show: focus.ring; border-radius: Tokens.radius-md; }
}

// The scenes the canvas may show (ADR-0059). A click puts one on air (a cut); the `+`
// in the card title row adds one. Removing the scene on air first puts the one
// before it on air; the last scene cannot be removed.
export component ScenesPanel inherits Rectangle {
    background: Theme.surface-raised;
    in property <int> live-state;
    property <int> asked: Studio.add-scene-asked;
    changed asked => { if Studio.state == 1 { Studio.add-scene(); } }
    // A right-click outside the rows: the panel's own menu (Add scene).
    panel-menu := CommandMenu { context: "scenes"; }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                panel-menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
    if Studio.scenes.length == 0: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("No scenes yet");
        message: Studio.state == 0 ? @tr("The studio is starting.") : @tr("The studio is not running.");
    }
    if Studio.scenes.length > 0: flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: max(rows.preferred-height, self.height);
        // A list that can pan holds a press briefly, so a quick click on a confirm
        // button never arrives and the next one does. The wheel still scrolls.
        mouse-drag-pan-enabled: false;
        // Under the rows: the empty space below them opens the panel's menu.
        TouchArea {
            width: flick.content-width;
            height: flick.content-height;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    panel-menu.open({
                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                    });
                }
            }
        }
        rows := VerticalLayout {
            padding: Tokens.space-2;
            spacing: Tokens.space-1;
            alignment: start;
            for sc in Studio.scenes: SceneRowView {
                data: sc;
                can-remove: Studio.scenes.length > 1;
                live-state: root.live-state;
                leaving => { list-focus.focus(); }
            }
        }
    }
    list-focus := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }
}

// A heading in the Sources list: the global sources, then the scene's. While the
// studio is on air the Global heading says that its sources are on air in every scene,
// also while studio mode edits the preview scene (U4).
// The Global group's header (ADR-0065, ADR-0078): the shared SectionHeader with the count,
// closed by default, so the user knows global sources exist without them taking the list.
// While the program is on air the group says so.
component GlobalsHeader inherits Rectangle {
    in property <bool> open;
    height: head.height;
    head := SectionHeader {
        title: @tr("Global ({})", Studio.global-count);
        collapsible: true;
        open: root.open;
        toggled(o) => { Sections.set-closed("sources.global", !o); }
    }
    if Studio.on-air: Rectangle {
        x: parent.width - self.width;
        width: air.preferred-width + 2 * Tokens.space-2;
        height: Tokens.type-caption-line;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: Theme.state-live;
        air := Text {
            text: @tr("On air");
            color: Theme.text-on-live;
            font-size: Tokens.type-caption-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: @tr("On air in every scene");
        }
    }
}

export component SourcesPanel inherits Rectangle {
    background: Theme.surface-raised;
    // Add source lives in the panel card's title row; undo and redo in the Edit menu
    // and the usual keys (U4).
    property <length> header: 0px;
    // The Global group is closed until the user opens it (ADR-0078, ADR-0065).
    property <bool> globals-open: !Sections.closed("sources.global", Sections.rev);
    // A right-click outside the rows: the panel's own menu (Add source).
    panel-menu := CommandMenu { context: "sources"; }
    // The empty state's Add source: the source types as a menu (ADR-0094 B1).
    add-menu := CommandMenu { context: "add-source"; }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                panel-menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
    if Studio.sources.length == 0: EmptyState {
        y: header;
        width: parent.width;
        height: parent.height - header;
        title: @tr("No sources yet");
        message: @tr("Add a screen, window, camera or audio device to the scene.");
        action: Studio.state == 1 ? @tr("Add source") : "";
        act => { add-menu.open({ x: self.x + self.width / 2, y: self.y + self.height / 2 }); }
    }
    if Studio.sources.length > 0: flick := Flickable {
        y: header;
        width: parent.width;
        height: parent.height - header;
        content-height: max(rows.preferred-height, self.height);
        // A list that can pan holds a press briefly, so a quick click on a confirm
        // button never arrives and the next one does. The wheel still scrolls.
        mouse-drag-pan-enabled: false;
        // Under the rows: the empty space below them opens the panel's menu.
        TouchArea {
            width: flick.content-width;
            height: flick.content-height;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    panel-menu.open({
                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                    });
                }
            }
        }
        rows := VerticalLayout {
            padding: Tokens.size-panel-pad;
            // Each entry spaces itself, so a folded global row takes no room.
            spacing: 0;
            alignment: start;
            for s[i] in Studio.sources: VerticalLayout {
                spacing: Tokens.space-1;
                padding-bottom: !s.global || root.globals-open || Studio.selected-source == s.id || i == 0 ? Tokens.space-1 : 0;
                // Global sources come first, under their own heading (ADR-0065): they
                // are drawn above every scene. The group is folded unless opened.
                if s.global && i == 0: GlobalsHeader { open: root.globals-open; }
                if !s.global && i > 0 && Studio.sources[i - 1].global: SectionHeader { title: @tr("This scene"); }
                if !s.global || root.globals-open || Studio.selected-source == s.id: SourceRowView {
                    data: s;
                    leaving => { list-focus.focus(); }
                }
            }
        }
    }
    // Takes the focus from a row that is made again (a layer move) or deleted, so
    // Ctrl+Z / Cmd+Z right after it still reaches the window's undo keys.
    list-focus := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }
}

// The headphones button of a Mixer strip (ADR-0097 decision 5): a click turns the
// source's monitor on (Monitor and output) or off; Alt-click (Option-click on macOS)
// solos it on the monitor; a right-click opens the monitor menu, which the strip's own
// menu has too. Monitor only adds a dot (warning colour while no device plays, so the
// source still goes to the outputs), solo an "S"; the accessible name says both (U7).
component MonitorButton inherits Rectangle {
    in property <MeterRow> data;
    in property <string> title;
    property <string> mode-text: data.monitor == 2 ? @tr("Monitor only") : data.monitor == 1 ? @tr("Monitor and output") : @tr("Monitor off");
    property <string> state-text: data.monitor == 2 && Studio.monitor-tone != 1
        ? @tr("{}; it goes to the outputs until the monitor plays", root.mode-text)
        : root.mode-text;
    width: button.width;
    height: button.height;
    button := IconButton {
        icon: data.monitor == 0 && !data.solo ? IconName.headphones-off : IconName.headphones;
        name: data.solo ? @tr("Monitor of {}: {}, soloed", root.title, root.state-text) : @tr("Monitor of {}: {}", root.title, root.state-text);
        checked: data.monitor != 0 || data.solo;
        alt-click: true;
        clicked => { Studio.set-source-monitor(data.id, data.monitor == 0 ? 1 : 0); }
        alt-clicked => { Studio.set-source-solo(data.id, !data.solo); }
        context-requested(x, y) => {
            menu.open({
                x: x - menu.absolute-position.x,
                y: y - menu.absolute-position.y,
            });
        }
    }
    if data.monitor == 2: Rectangle {
        x: root.width - self.width;
        y: root.height - self.height;
        width: Tokens.space-2;
        height: Tokens.space-2;
        border-radius: self.width / 2;
        background: Studio.monitor-tone == 1 ? Theme.accent : Theme.state-warning;
    }
    if data.solo: Text {
        x: root.width - self.width;
        y: 0;
        // "S" for solo; the accessible name says it in words.
        text: @tr("S");
        color: Theme.text-primary;
        font-size: Tokens.type-caption-size;
        font-weight: Tokens.type-label-weight;
        accessible-role: none;
    }
    menu := CommandMenu {
        context: "mixer-monitor";
        target: "source=" + data.id;
    }
}

// The monitor in the Mixer's narrow layout (ADR-0097): one row under the scale, shown
// only while a source is monitored or soloed. The headphones in the state's colour, the
// monitor volume (sent when a drag ends), the device, the latency or the problem in
// words; the solo chip that ends solo goes on its own line below.
component MonitorRow inherits VerticalLayout {
    // The fader position while a drag runs; -1 otherwise. Cleared once the host
    // reports that position, so the knob does not jump back before the answer.
    property <float> drag: -1;
    property <float> shown-volume: Studio.monitor-volume;
    changed shown-volume => {
        if root.drag >= 0 && Math.abs(root.shown-volume - root.drag) < 0.02 {
            root.drag = -1;
        }
    }
    spacing: Tokens.space-1;
    HorizontalLayout {
        height: Tokens.size-control-md;
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            Icon {
                name: IconName.headphones;
                ink: Studio.monitor-tone == 2 ? Theme.state-warning : Studio.monitor-tone == 1 ? Theme.accent : Theme.text-secondary;
            }
        }
        Text {
            text: @tr("Monitor");
            color: Theme.text-primary;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
            accessible-role: none;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: Tokens.size-menu-sm * 0.25;
            max-width: Tokens.size-menu-sm * 0.5;
            Slider {
                label: @tr("Monitor volume");
                value: root.drag >= 0 ? root.drag : Studio.monitor-volume;
                value-text: Studio.monitor-volume-text;
                moved(v) => { root.drag = v; Studio.preview-monitor-volume(v); }
                released => { if root.drag >= 0 { Studio.set-monitor-volume(root.drag); } }
                cancelled => { root.drag = -1; Studio.preview-monitor-volume(-1); }
                reset => { root.drag = -1; Studio.set-monitor-volume(1); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: Tokens.size-menu-sm * 0.4;
            max-width: Tokens.size-menu-sm * 0.8;
            Select {
                label: @tr("Monitor device");
                options: Studio.monitor-devices;
                index: Studio.monitor-device;
                selected(i) => { Studio.set-monitor-device(i); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Studio.monitor-tone == 1 ? Studio.monitor-latency : Studio.monitor-status;
            color: Studio.monitor-tone == 2 ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            InfoHint {
                label: @tr("Monitor");
                text: @tr("Sources with their monitor on play here, after their fader and mute and before the master. The monitor goes through the mix, so it lags the sound by the latency shown: for playing live, use your audio interface's direct monitoring.");
                detail: @tr("Monitor only takes a source off the stream and the recording while the monitor plays. Alt-click (Option-click) a headphones button to solo a source.");
            }
        }
    }
    if Studio.monitor-solo != "": HorizontalLayout {
        alignment: start;
        Button {
            dense: true;
            text: @tr("Solo: {}", Studio.monitor-solo);
            icon: IconName.close;
            accessible-name: @tr("End solo of {}", Studio.monitor-solo);
            tooltip: @tr("End solo");
            clicked => { Studio.end-monitor-solo(); }
        }
    }
}

// The monitor in the Mixer's wide layout (ADR-0097): the same controls as
// MonitorRow, stacked in a column after the master.
component MonitorBox inherits VerticalLayout {
    // The fader position while a drag runs; -1 otherwise. Cleared once the host
    // reports that position, so the knob does not jump back before the answer.
    property <float> drag: -1;
    property <float> shown-volume: Studio.monitor-volume;
    changed shown-volume => {
        if root.drag >= 0 && Math.abs(root.shown-volume - root.drag) < 0.02 {
            root.drag = -1;
        }
    }
    spacing: Tokens.space-2;
    alignment: start;
    HorizontalLayout {
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            Icon {
                name: IconName.headphones;
                ink: Studio.monitor-tone == 2 ? Theme.state-warning : Studio.monitor-tone == 1 ? Theme.accent : Theme.text-secondary;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Studio.monitor-tone == 1 ? Studio.monitor-latency : Studio.monitor-status;
            color: Studio.monitor-tone == 2 ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            overflow: elide;
        }
        InfoHint {
            label: @tr("Monitor");
            text: @tr("Sources with their monitor on play here, after their fader and mute and before the master. The monitor goes through the mix, so it lags the sound by the latency shown: for playing live, use your audio interface's direct monitoring.");
            detail: @tr("Monitor only takes a source off the stream and the recording while the monitor plays. Alt-click (Option-click) a headphones button to solo a source.");
        }
    }
    Select {
        label: @tr("Monitor device");
        options: Studio.monitor-devices;
        index: Studio.monitor-device;
        selected(i) => { Studio.set-monitor-device(i); }
    }
    HorizontalLayout {
        spacing: Tokens.space-2;
        Slider {
            horizontal-stretch: 1;
            label: @tr("Monitor volume");
            value: root.drag >= 0 ? root.drag : Studio.monitor-volume;
            value-text: Studio.monitor-volume-text;
            moved(v) => { root.drag = v; Studio.preview-monitor-volume(v); }
            released => { if root.drag >= 0 { Studio.set-monitor-volume(root.drag); } }
            cancelled => { root.drag = -1; Studio.preview-monitor-volume(-1); }
            reset => { root.drag = -1; Studio.set-monitor-volume(1); }
        }
        Text {
            width: Tokens.size-control-lg * 4;
            horizontal-stretch: 0;
            text: Studio.monitor-volume-text;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    if Studio.monitor-solo != "": HorizontalLayout {
        alignment: start;
        Button {
            dense: true;
            text: @tr("Solo: {}", Studio.monitor-solo);
            icon: IconName.close;
            accessible-name: @tr("End solo of {}", Studio.monitor-solo);
            tooltip: @tr("End solo");
            clicked => { Studio.end-monitor-solo(); }
        }
    }
}

// The mixer's level in words ("0 dB", "−6.0 dB", "Silent"). A fixed width, so a longer
// reading does not resize the fader. Not a field: the fader is the only control.
// The accessible name includes the level.
component LevelReadout inherits Rectangle {
    in property <string> text;
    in property <string> title;
    in property <bool> muted;
    // Rows: fixed `size.meter.readout` so a longer reading does not resize the fader.
    // Columns control column: `compact` — caption size in `size.mixer.controls`.
    in property <bool> fixed: true;
    in property <bool> compact: false;
    width: root.compact ? Tokens.size-mixer-controls : Tokens.size-meter-readout;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("Volume of {}, {}", title, text);
    if !root.compact: HorizontalLayout {
        width: parent.width;
        ValueReadout {
            text: root.text;
            color: root.muted ? Theme.text-disabled : Theme.text-secondary;
        }
    }
    if root.compact: Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.muted ? Theme.text-disabled : Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// Name, level, clip box and icon buttons, in one order for a row and a column.
// A control the strip does not have (the master's monitor and more) is left out,
// so it takes no space and does not leave a hole.
component StripControls inherits HorizontalLayout {
    in property <MeterRow> data;
    in property <bool> master;
    in property <string> title;
    // Columns: the readout shrinks with the strip. Rows keep it fixed.
    in property <bool> fixed-readout: true;
    // Columns put the name above the fader, so this row is only the readout and buttons.
    in property <bool> show-name: true;
    callback reset();
    callback toggle-muted();
    // The "more" button (sources only): its lower left, in window coordinates.
    callback open-menu(length, length);
    spacing: Tokens.space-1;
    width: 100%;
    min-width: 0px;
    // Name (and icon) on the left, readout and buttons on the right — never centred
    // in a wide panel.
    alignment: stretch;
    if root.show-name: VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        Icon { name: data.muted ? IconName.speaker-off : Icons.named(data.icon); ink: data.muted ? Theme.text-disabled : Theme.text-secondary; }
    }
    if root.show-name: VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        min-width: 0px;
        Text {
            text: root.title;
            color: data.muted ? Theme.text-disabled : Theme.text-primary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
    }
    // Columns put the name above: a spacer keeps the readout and buttons on the right.
    if !root.show-name: Rectangle {
        horizontal-stretch: 1;
        min-width: 0px;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        min-width: 0px;
        LevelReadout { text: data.volume-text; title: root.title; muted: data.muted; fixed: root.fixed-readout; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        Rectangle {
            width: Tokens.size-icon-box;
            height: Tokens.size-icon-box;
            border-width: Tokens.size-border;
            border-color: Theme.border-strong;
            border-radius: Tokens.radius-sm;
            background: data.clipped ? Theme.meter-clip : transparent;
            accessible-role: button;
            accessible-label: data.clipped ? @tr("Clipped. Reset the clip indicator of {}", root.title) : @tr("Not clipped: {}", root.title);
            accessible-action-default => { root.reset(); }
            TouchArea { clicked => { root.reset(); } }
        }
    }
    if !root.master: VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        MonitorButton { data: data; title: root.title; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        IconButton {
            icon: data.muted ? IconName.speaker-off : IconName.speaker;
            name: data.muted ? @tr("Unmute {}", root.title) : @tr("Mute {}", root.title);
            checked: data.muted;
            framed: true;
            clicked => { root.toggle-muted(); }
        }
    }
    if !root.master: VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        IconButton {
            icon: IconName.more;
            name: @tr("More options for {}", root.title);
            clicked => { root.open-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
}

// One horizontal meter (AudioMeter, U16) in the rows arrangement. Two lines, so the
// fader can be as long as the row and the row stays inside the panel: the icon, name,
// level, clip box and icon buttons on the first line, then the bar and the fader.
component MeterView inherits Rectangle {
    in property <MeterRow> data;
    callback reset();
    // The master strip (ADR-0081): its own callbacks, no menu, no "more" button.
    in property <bool> master;
    property <string> title: root.master ? @tr("Master") : data.name;
    function set-volume(v: float) {
        if root.master { Studio.set-master-volume(v); } else { Studio.set-source-volume(data.id, v); }
    }
    function toggle-muted() {
        if root.master { Studio.set-master-muted(!data.muted); } else { Studio.set-source-muted(data.id, !data.muted); }
    }
    accessible-role: progress-indicator;
    accessible-label: root.title;
    accessible-value: data.value;
    // The source's menu (ADR-0080): the "more" button, a right-click or the Menu key.
    menu := CommandMenu {
        context: "mixer-source";
        target: "source=" + data.id;
    }
    TouchArea {
        pointer-event(e) => {
            if !root.master && e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
    VerticalLayout {
        width: 100%;
        spacing: Tokens.space-1;
        // First line, and it does not wrap: icon, name, level, clip box, then the
        // icon buttons the strip actually has. Full width so the name stays left and
        // the buttons stay right in a wide Mixer.
        StripControls {
            height: Tokens.size-control-md;
            spacing: Tokens.space-2;
            data: data;
            master: root.master;
            title: root.title;
            reset => { root.reset(); }
            toggle-muted => { root.toggle-muted(); }
            open-menu(x, y) => {
                menu.open({
                    x: x - menu.absolute-position.x,
                    y: y - menu.absolute-position.y,
                });
            }
        }
        // Second line: the meter and the fader, both as long as the row. The fader's
        // own minimum would force the row wider than a narrow panel.
        VerticalLayout {
            width: 100%;
            spacing: 0px;
            bar := Rectangle {
                height: Tokens.size-meter-bar;
                background: Theme.surface-sunken;
                border-width: Tokens.size-border;
                border-color: Theme.border-subtle;
                border-radius: Tokens.radius-sm;
                clip: true;
                Rectangle { x: parent.width * data.lo-from; width: parent.width * (data.lo-to - data.lo-from); background: Theme.meter-low; }
                Rectangle { x: parent.width * data.mi-from; width: parent.width * (data.mi-to - data.mi-from); background: Theme.meter-mid; }
                Rectangle { x: parent.width * data.hi-from; width: parent.width * (data.hi-to - data.hi-from); background: Theme.meter-high; }
                if data.peak > 0: Rectangle {
                    x: max(0px, parent.width * data.peak - Tokens.size-meter-peak);
                    width: Tokens.size-meter-peak;
                    background: data.peak-zone == 2 ? Theme.meter-high : data.peak-zone == 1 ? Theme.meter-mid : Theme.meter-low;
                }
            }
            // The fader under the bar, the same width (ADR-0059 fader law, -60 to 0 dB).
            Slider {
                min-width: 0px;
                label: @tr("Volume of {}", root.title);
                value: data.volume;
                value-text: data.volume-text;
                enabled: data.live && !data.muted;
                moved(v) => { root.set-volume(v); }
                reset => { root.set-volume(1); }
            }
        }
    }
}

// A hidden source in the columns arrangement: the same width as a strip, name on top,
// the Show button at the bottom. No meter and no fader (ADR-0080: it is still heard).
component HiddenStrip inherits Rectangle {
    in property <MeterRow> data;
    width: Tokens.size-mixer-strip;
    horizontal-stretch: 0;
    clip: true;
    property <length> pad: Tokens.space-1;
    property <length> name-h: Tokens.size-control-sm;
    menu := CommandMenu {
        context: "mixer-source";
        target: "source=" + data.id;
    }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
    HorizontalLayout {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad;
        height: root.name-h;
        spacing: root.pad;
        Icon { name: data.muted ? IconName.speaker-off : Icons.named(data.icon); ink: Theme.text-secondary; }
        Text {
            text: data.name;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
    }
    IconButton {
        x: (root.width - self.width) / 2;
        y: root.height - root.pad - self.height;
        icon: IconName.eye;
        name: @tr("Show {} in the Mixer", data.name);
        clicked => { Studio.set-source-mixer-hidden(data.id, false); }
    }
}

// A hidden source in the rows arrangement (ADR-0080): its name and a button that shows
// it in the Mixer again.
component HiddenRow inherits Rectangle {
    in property <MeterRow> data;
    height: Tokens.size-control-md;
    menu := CommandMenu {
        context: "mixer-source";
        target: "source=" + data.id;
    }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
    HorizontalLayout {
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            Icon { name: data.muted ? IconName.speaker-off : Icons.named(data.icon); ink: Theme.text-secondary; }
        }
        Text {
            text: data.name;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.eye;
                name: @tr("Show {} in the Mixer", data.name);
                clicked => { Studio.set-source-mixer-hidden(data.id, false); }
            }
        }
    }
}

// One vertical strip. The panel assigns the box (width `size.mixer.strip`, height the
// row). Positions are explicit, so a stretch pass cannot collapse the fader or float
// the buttons. The five control slots share one height; Master leaves monitor and more
// empty so "0 dB" lines up.
component MeterStrip inherits Rectangle {
    in property <MeterRow> data;
    callback reset();
    // The master strip (ADR-0081): its own callbacks, no menu, no "more" button.
    in property <bool> master;
    property <string> title: root.master ? @tr("Master") : data.name;
    function set-volume(v: float) {
        if root.master { Studio.set-master-volume(v); } else { Studio.set-source-volume(data.id, v); }
    }
    function toggle-muted() {
        if root.master { Studio.set-master-muted(!data.muted); } else { Studio.set-source-muted(data.id, !data.muted); }
    }
    // The panel sets the height. Width stays the token, so a long name cannot widen the column.
    // VSlider centres its track in its own width, so that width stays `size.control.sm`.
    width: Tokens.size-mixer-strip;
    horizontal-stretch: 0;
    clip: true;
    property <bool> quiet: data.muted || (!root.master && !data.live);
    property <length> pad: Tokens.space-1;
    property <length> gap: Tokens.space-1;
    property <length> name-h: Tokens.size-control-sm;
    property <length> slot: Tokens.size-control-sm;
    property <length> controls-w: Tokens.size-mixer-controls;
    // Five slots and the four gaps between them. Master keeps the empty ones.
    property <length> controls-h: 5 * root.slot + 4 * root.gap;
    property <length> body-y: root.pad + root.name-h + root.gap;
    property <length> body-h: max(0px, root.height - root.body-y - root.pad);
    property <length> controls-y: max(root.body-y, root.height - root.pad - root.controls-h);
    property <length> controls-x: root.width - root.pad - root.controls-w;
    property <length> step: root.slot + root.gap;
    accessible-role: progress-indicator;
    accessible-label: root.title;
    accessible-value: data.live ? data.value : data.volume-text;
    menu := CommandMenu {
        context: "mixer-source";
        target: "source=" + data.id;
    }
    TouchArea {
        pointer-event(e) => {
            if !root.master && e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                menu.open({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }
    HorizontalLayout {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad;
        height: root.name-h;
        spacing: root.gap;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Icon {
                name: data.muted ? IconName.speaker-off : Icons.named(data.icon);
                ink: root.quiet ? Theme.text-disabled : Theme.text-secondary;
            }
        }
        Text {
            text: root.title;
            color: root.quiet ? Theme.text-disabled : Theme.text-primary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
    }
    bar := Rectangle {
        x: root.pad;
        y: root.body-y;
        width: Tokens.size-meter-bar;
        height: root.body-h;
        background: Theme.surface-sunken;
        border-width: Tokens.size-border;
        border-color: Theme.border-subtle;
        border-radius: Tokens.radius-sm;
        clip: true;
        Rectangle { y: parent.height * (1 - data.lo-to); height: parent.height * (data.lo-to - data.lo-from); background: Theme.meter-low; }
        Rectangle { y: parent.height * (1 - data.mi-to); height: parent.height * (data.mi-to - data.mi-from); background: Theme.meter-mid; }
        Rectangle { y: parent.height * (1 - data.hi-to); height: parent.height * (data.hi-to - data.hi-from); background: Theme.meter-high; }
        if data.peak > 0: Rectangle {
            y: min(parent.height - Tokens.size-meter-peak, parent.height * (1 - data.peak));
            height: Tokens.size-meter-peak;
            background: data.peak-zone == 2 ? Theme.meter-high : data.peak-zone == 1 ? Theme.meter-mid : Theme.meter-low;
        }
    }
    VSlider {
        x: root.pad + Tokens.size-meter-bar + root.gap;
        y: root.body-y;
        width: Tokens.size-control-sm;
        height: root.body-h;
        horizontal-stretch: 0;
        label: @tr("Volume of {}", root.title);
        value: data.volume;
        value-text: data.volume-text;
        enabled: (root.master || data.live) && !data.muted;
        moved(v) => { root.set-volume(v); }
        reset => { root.set-volume(1); }
    }
    // Five slots, anchored to the bottom. Missing widgets leave their slot empty, so
    // Master (no monitor, no more) keeps the same readout position as a source.
    LevelReadout {
        x: root.controls-x;
        y: root.controls-y;
        height: root.slot;
        text: data.volume-text;
        title: root.title;
        muted: root.quiet;
        compact: true;
    }
    Rectangle {
        x: root.controls-x + (root.controls-w - root.slot) / 2;
        y: root.controls-y + root.step;
        width: root.slot;
        height: root.slot;
        border-width: Tokens.size-border;
        border-color: Theme.border-strong;
        border-radius: Tokens.radius-sm;
        background: data.clipped ? Theme.meter-clip : transparent;
        accessible-role: button;
        accessible-label: data.clipped ? @tr("Clipped. Reset the clip indicator of {}", root.title) : @tr("Not clipped: {}", root.title);
        accessible-action-default => { root.reset(); }
        TouchArea { clicked => { root.reset(); } }
    }
    if !root.master: MonitorButton {
        x: root.controls-x + (root.controls-w - self.width) / 2;
        y: root.controls-y + 2 * root.step;
        data: data;
        title: root.title;
    }
    IconButton {
        x: root.controls-x + (root.controls-w - self.width) / 2;
        y: root.controls-y + 3 * root.step;
        icon: data.muted ? IconName.speaker-off : IconName.speaker;
        name: data.muted ? @tr("Unmute {}", root.title) : @tr("Mute {}", root.title);
        checked: data.muted;
        framed: true;
        clicked => { root.toggle-muted(); }
    }
    if !root.master: IconButton {
        x: root.controls-x + (root.controls-w - self.width) / 2;
        y: root.controls-y + 4 * root.step;
        icon: IconName.more;
        name: @tr("More options for {}", root.title);
        clicked => {
            menu.open({
                x: self.absolute-position.x - menu.absolute-position.x,
                y: self.absolute-position.y + self.height - menu.absolute-position.y,
            });
        }
    }
}

// Compact group caption for columns: uppercase, elides to the pane width, never sets
// the pane's preferred width (This scene / Global stay open in columns).
component MixerCaption inherits Rectangle {
    in property <string> title;
    height: Tokens.size-control-sm;
    min-width: 0px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.title.to-uppercase();
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        font-weight: Tokens.type-label-weight;
        letter-spacing: Tokens.size-tracking-caps;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// One columns group. Width is the strip count times the strip width: the caption elides
// inside that and never widens the group. Height is the row's inner height, passed in,
// so every strip (including Master) gets the same box.
component MixerGroupCluster inherits Rectangle {
    in property <string> title;
    // 0 = This scene, 1 = Global, 2 = Master.
    in property <int> kind;
    in property <length> col-h;
    property <int> count: root.kind == 2 ? Studio.master-meter.length : root.kind == 0 ? Studio.meter-scenes : Studio.meter-globals;
    property <length> strip-w: Tokens.size-mixer-strip + Tokens.size-field-gap;
    property <length> body-y: Tokens.size-control-sm + Tokens.size-field-gap;
    width: root.count > 0 ? (root.kind == 2 ? Tokens.size-mixer-strip : root.count * root.strip-w) : 0px;
    height: root.col-h;
    horizontal-stretch: 0;
    clip: true;
    MixerCaption {
        y: 0;
        width: parent.width;
        title: root.title;
    }
    if root.kind == 2 && Studio.master-meter.length > 0: MeterStrip {
        x: 0;
        y: root.body-y;
        height: root.height - root.body-y;
        master: true;
        data: Studio.master-meter[0];
        reset => { Studio.reset-master-clip(); }
    }
    if root.kind != 2: HorizontalLayout {
        x: 0;
        y: root.body-y;
        width: parent.width;
        height: root.height - root.body-y;
        spacing: 0px;
        alignment: start;
        for m in Studio.meters: Rectangle {
            property <bool> show: (root.kind == 0 && !m.global) || (root.kind == 1 && m.global);
            // A source in the other group keeps a zero-wide cell, so it cannot open a hole
            // or push this group's strips apart.
            width: show ? root.strip-w : 0px;
            height: parent.height;
            horizontal-stretch: 0;
            clip: true;
            MeterStrip {
                x: 0;
                y: 0;
                height: parent.height;
                data: m;
                reset => { Studio.reset-clip(m.id); }
            }
        }
    }
}

// A group closed in the columns arrangement (Hidden only): a vertical strip as wide as
// a collapsed stack. The title runs along the strip; the chevron points right.
component MixerGroupStrip inherits Rectangle {
    in property <string> title;
    callback open();
    width: Tokens.size-control-lg;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    border-radius: Tokens.radius-sm;
    background: touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: button;
    accessible-label: title;
    accessible-expanded: false;
    accessible-action-default => { root.open(); }
    forward-focus: focus;
    property <length> label-room: max(0px, root.height - Tokens.size-icon-box - 3 * Tokens.space-1);
    Icon {
        x: (parent.width - self.width) / 2;
        y: Tokens.space-1;
        name: IconName.chevron-right;
        ink: Theme.text-secondary;
    }
    label := Text {
        width: min(self.preferred-width, root.label-room);
        height: self.preferred-height;
        x: (parent.width - self.width) / 2;
        y: Tokens.size-icon-box + 2 * Tokens.space-1 + (self.width - self.height) / 2;
        transform-rotation: 90deg;
        text: root.title.to-uppercase();
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        font-weight: Tokens.type-label-weight;
        letter-spacing: Tokens.size-tracking-caps;
        overflow: elide;
        accessible-role: none;
    }
    focus := RingFocus {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.open(); return accept; }
            reject
        }
    }
    touch := TouchArea {
        clicked => { focus.focus-pointer(); root.open(); }
    }
    FocusRing { show: focus.ring; border-radius: Tokens.radius-sm; }
}

// The Mixer (ADR-0078 / ADR-0083 / ADR-0101): wide = fixed strips side by side with
// horizontal scroll; tall = rows under foldable headers.
export component MixerPanel inherits Rectangle {
    background: Theme.surface-raised;
    // ADR-0083: a fixed layout never reflows by size; auto follows the panel's shape.
    property <bool> wide: Sections.mixer-orientation == 2 || (Sections.mixer-orientation == 0 && self.width > self.height * 1.5);
    property <bool> hidden-closed: Sections.closed("mixer.hidden", Sections.rev);
    // Rows still fold This scene / Global; columns keep them open.
    property <bool> scene-closed: Sections.closed("mixer.scene", Sections.rev);
    property <bool> global-closed: Sections.closed("mixer.global", Sections.rev);
    property <bool> any: Studio.meters.length + Studio.hidden-meters.length > 0;
    if !root.any: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("No audio sources");
        message: @tr("Add an audio input, system audio or application audio to see its levels here.");
        action: Studio.state == 1 ? @tr("Add source") : "";
        act => { add-menu.open({ x: self.x + self.width / 2, y: self.y + self.height / 2 }); }
    }
    // Columns: a clipped panel with one absolutely positioned row at its preferred
    // width. Flickable/layout children otherwise fill the panel and stretch Master away
    // from the sources (x/y take the row out of that fill behaviour).
    if root.any && root.wide: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;
        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    mixer-menu.open({
                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                    });
                }
            }
        }
        flick := Flickable {
            width: parent.width;
            height: parent.height;
            content-width: row.preferred-width;
            // Taller than the viewport only when the viewport is shorter than a strip
            // plus its caption: then the row scrolls so the buttons can be reached.
            content-height: row.height;
            mouse-drag-pan-enabled: false;
            // x/y: do not fill the Flickable viewport (that was spreading the strips).
            row := HorizontalLayout {
                // Caption, the gap under it, the strip's own minimum, and the panel padding.
                property <length> col-min: Tokens.size-control-sm + Tokens.size-field-gap + Tokens.size-mixer-min-h + 2 * Tokens.size-panel-pad;
                property <length> col-h: self.height - 2 * Tokens.size-panel-pad;
                x: 0;
                y: 0;
                height: max(flick.height, self.col-min);
                width: self.preferred-width;
                padding: Tokens.size-panel-pad;
                spacing: Tokens.size-field-gap;
                alignment: start;
                if Studio.meter-scenes > 0: MixerGroupCluster {
                    title: @tr("This scene");
                    kind: 0;
                    col-h: row.col-h;
                }
                if Studio.meter-globals > 0: MixerGroupCluster {
                    title: @tr("Global ({})", Studio.meter-globals);
                    kind: 1;
                    col-h: row.col-h;
                }
                if Studio.master-meter.length > 0: Rectangle {
                    width: Tokens.size-border;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    background: Theme.border-subtle;
                }
                if Studio.master-meter.length > 0: MixerGroupCluster {
                    title: @tr("Master");
                    kind: 2;
                    col-h: row.col-h;
                }
                if Studio.monitor-wanted: Rectangle {
                    width: Tokens.size-border;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    background: Theme.border-subtle;
                }
                if Studio.monitor-wanted: VerticalLayout {
                    width: Tokens.size-menu-sm;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    spacing: Tokens.size-field-gap;
                    MixerCaption { title: @tr("Monitor"); }
                    MonitorBox { }
                }
                if Studio.hidden-meters.length > 0 && root.hidden-closed: MixerGroupStrip {
                    height: row.col-h;
                    title: @tr("Hidden ({})", Studio.hidden-meters.length);
                    open => { Sections.set-closed("mixer.hidden", false); }
                }
                if Studio.hidden-meters.length > 0 && !root.hidden-closed: Rectangle {
                    property <length> strip-w: Tokens.size-mixer-strip + Tokens.size-field-gap;
                    property <length> body-y: Tokens.size-control-sm + Tokens.size-field-gap;
                    width: Studio.hidden-meters.length * strip-w;
                    height: row.col-h;
                    horizontal-stretch: 0;
                    clip: true;
                    HorizontalLayout {
                        y: 0;
                        width: parent.width;
                        height: Tokens.size-control-sm;
                        spacing: Tokens.space-1;
                        IconButton {
                            icon: IconName.chevron-down;
                            name: @tr("Hide the Hidden section");
                            clicked => { Sections.set-closed("mixer.hidden", true); }
                        }
                        Text {
                            text: @tr("Hidden ({})", Studio.hidden-meters.length);
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            font-weight: Tokens.type-label-weight;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        x: 0;
                        y: body-y;
                        width: parent.width;
                        height: parent.height - body-y;
                        spacing: 0px;
                        alignment: start;
                        for m in Studio.hidden-meters: HiddenStrip {
                            height: parent.height;
                            data: m;
                        }
                    }
                }
            }
        }
    }
    // Narrow: rows under full-width headers, then the labelled scale (dBFS). The
    // content is exactly as wide as the panel, so a narrow panel never scrolls
    // sideways; a long list still scrolls down. A drag on a fader does not pan this.
    if root.any && !root.wide: Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: max(strips.preferred-height, self.height);
        mouse-drag-pan-enabled: false;
        TouchArea {
            width: root.width;
            height: max(strips.preferred-height, root.height);
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    // Relative to the panel, where the menu is, whatever the scroll.
                    mixer-menu.open({
                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                    });
                }
            }
        }
        strips := VerticalLayout {
            width: parent.width;
            padding: Tokens.size-panel-pad;
            // Each entry spaces itself, so a folded group takes no room: it closes
            // upward to its title row.
            spacing: 0px;
            alignment: start;
            if Studio.meter-scenes > 0: SectionHeader {
                title: @tr("This scene");
                collapsible: true;
                open: !root.scene-closed;
                toggled(o) => { Sections.set-closed("mixer.scene", !o); }
            }
            for m in Studio.meters: VerticalLayout {
                padding-bottom: m.global || root.scene-closed ? 0px : Tokens.space-1;
                if !m.global && !root.scene-closed: MeterView {
                    data: m;
                    reset => { Studio.reset-clip(m.id); }
                }
            }
            if Studio.meter-globals > 0: VerticalLayout {
                padding-top: Studio.meter-scenes > 0 ? Tokens.size-section-gap : 0px;
                SectionHeader {
                    title: @tr("Global ({})", Studio.meter-globals);
                    collapsible: true;
                    open: !root.global-closed;
                    toggled(o) => { Sections.set-closed("mixer.global", !o); }
                }
            }
            for m in Studio.meters: VerticalLayout {
                padding-bottom: !m.global || root.global-closed ? 0px : Tokens.space-1;
                if m.global && !root.global-closed: MeterView {
                    data: m;
                    reset => { Studio.reset-clip(m.id); }
                }
            }
            // The master (ADR-0081): after the groups, under a divider, so the scale
            // below serves it too.
            if Studio.master-meter.length > 0: VerticalLayout {
                padding-top: Tokens.size-section-gap;
                spacing: Tokens.size-field-gap;
                Rectangle {
                    height: Tokens.size-border;
                    background: Theme.border-subtle;
                }
                MeterView {
                    master: true;
                    data: Studio.master-meter[0];
                    reset => { Studio.reset-master-clip(); }
                }
            }
            // The labelled scale (dBFS) under the faders, which are as wide as the row.
            scale-row := Rectangle {
                height: Tokens.size-meter-scale-line;
                // A narrow panel shows every second or third label, so none overlap.
                property <int> step: self.width >= Tokens.size-menu-sm ? 1 : self.width >= Tokens.size-menu-sm / 2 ? 2 : 3;
                for mark[i] in Studio.scale: Text {
                    visible: Math.mod(i, scale-row.step) == 0;
                    x: parent.width * mark.at - self.width / 2;
                    height: parent.height;
                    text: mark.label;
                    color: Theme.text-secondary;
                    font-size: Tokens.size-meter-scale;
                    vertical-alignment: center;
                }
            }
            // The monitor (ADR-0097), under the scale while it is wanted.
            if Studio.monitor-wanted: VerticalLayout {
                padding-top: Tokens.size-section-gap;
                MonitorRow { }
            }
            if Studio.hidden-meters.length > 0: VerticalLayout {
                padding-top: Tokens.size-section-gap;
                SectionHeader {
                    title: @tr("Hidden ({})", Studio.hidden-meters.length);
                    collapsible: true;
                    open: !root.hidden-closed;
                    toggled(o) => { Sections.set-closed("mixer.hidden", !o); }
                }
                if !root.hidden-closed: VerticalLayout {
                    for m in Studio.hidden-meters: HiddenRow { data: m; }
                }
            }
        }
    }
    // The Mixer's own menu (ADR-0080): a right-click outside any strip or row.
    mixer-menu := CommandMenu { context: "mixer"; }
    // The empty state's Add source: the source types as a menu (ADR-0094 B1).
    add-menu := CommandMenu { context: "add-source"; }
}

// Live controls: Go live and End stream, Record and Stop recording. The stream and the
// recording run at the same time or alone (ADR-0047). End stream asks first (U4: it
// cannot be undone). Under them, Start and Stop virtual camera (ADR-0066).
// The transition rail or panel (ADR-0061, UI spec Studio mode): the transition's name
// ("Cut", the only one for now) and, in studio mode, the Transition button that puts
// the preview scene on air. Narrower than 40 px it is only the button, floating over
// the bottom edge of the two views. Collection glide is Settings › General; a
// per-source override is Properties (ADR-0100) — not on this panel.
export component TransitionPanel inherits Rectangle {
    background: Theme.surface-raised;
    property <bool> narrow: root.width < Tokens.size-transition-narrow;
    property <bool> can: Studio.studio-mode && Studio.state == 1;
    if !narrow: VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-2;
        alignment: center;
        Text {
            text: @tr("Cut");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            accessible-role: none;
        }
        if root.can: Button {
            text: root.width < Tokens.size-transition-short ? @tr("Go") : @tr("Transition");
            kind: "primary";
            accessible-name: @tr("Transition: put the preview scene on air");
            clicked => { Studio.transition(); }
        }
        if !Studio.studio-mode && root.width >= Tokens.size-transition-short: Text {
            text: @tr("Turn on studio mode to prepare the next scene in Preview.");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if narrow && root.can: VerticalLayout {
        alignment: end;
        padding-bottom: Tokens.space-2;
        IconButton {
            icon: IconName.chevron-right;
            name: @tr("Transition: put the preview scene on air");
            clicked => { Studio.transition(); }
        }
    }
}

export component LiveControlsPanel inherits Rectangle {
    background: Theme.surface-raised;
    property <bool> recording: Studio.rec-state == 2;
    property <bool> live: Studio.st-state == 2;
    // "End stream" was pressed: the question shows until answered.
    property <bool> confirming: false;
    changed live => { if !live { confirming = false; } }
    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-2;
        alignment: start;
        HorizontalLayout {
            spacing: Tokens.space-2;
            alignment: start;
            Button {
                // While the stream ends the button says so (disabled) until the
                // output closed, so it never offers Go live too early.
                text: Studio.st-state == 3 ? @tr("Ending…") : live ? @tr("End stream") : @tr("Go live");
                kind: live || Studio.st-state == 3 ? "live" : "primary";
                enabled: Studio.state == 1 && !confirming
                    && (live || (Studio.st-state == 0 && Studio.rec-unavailable == ""));
                clicked => {
                    if live { confirming = true; } else { Studio.go-live(); }
                }
            }
            Button {
                // Stopping: the button says so (disabled) until the file is closed;
                // Record comes back only then.
                text: Studio.rec-state == 3 ? @tr("Stopping…") : recording ? @tr("Stop recording") : @tr("Record");
                kind: recording || Studio.rec-state == 3 ? "live" : "secondary";
                enabled: Studio.state == 1 && Studio.rec-unavailable == ""
                    && (recording || Studio.rec-state == 0);
                clicked => {
                    if recording { Studio.stop-recording(); } else { Studio.record(); }
                }
            }
        }
        if confirming: Rectangle {
            border-width: Tokens.size-border;
            border-color: Theme.border-subtle;
            border-radius: Tokens.radius-sm;
            accessible-role: groupbox;
            accessible-label: @tr("End the stream?");
            // Keep streaming, the safe answer, has the focus.
            init => { keep.focus(); }
            VerticalLayout {
                padding: Tokens.space-2;
                spacing: Tokens.space-2;
                Text {
                    text: Studio.st-end-both ? @tr("End both streams, main and vertical? Viewers see them end.") : @tr("End the stream? Viewers see it end.");
                    color: Theme.text-primary;
                    font-size: Tokens.type-body-size;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    alignment: start;
                    // Its own name, so assistive technology never confuses it with
                    // the (disabled) End stream button above.
                    Button {
                        text: Studio.st-end-both ? @tr("Yes, end both streams") : @tr("Yes, end the stream");
                        kind: "live";
                        clicked => {
                            confirming = false;
                            Studio.end-stream();
                        }
                    }
                    keep := Button {
                        text: @tr("Keep streaming");
                        clicked => { confirming = false; }
                    }
                }
            }
        }
        if Studio.st-text != "": Text {
            // The stream's state in words (U4, U9); the live indicator shows it too.
            text: Studio.st-text;
            color: Studio.st-bad ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        if Studio.st-needs-setup && Studio.st-state == 0: HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("Stream settings");
                clicked => { Studio.open-stream-settings(); }
            }
        }
        Text {
            // State in words (U4, U9); the live indicator shows it everywhere too.
            text: Studio.rec-state == 1 ? @tr("Starting the recording…")
                : Studio.rec-state == 2 ? @tr("Recording to {}", Studio.rec-file)
                : Studio.rec-state == 3 ? @tr("Stopping the recording and closing the file…")
                : Studio.rec-unavailable != "" ? Studio.rec-unavailable
                : Studio.rec-note;
            color: Studio.rec-state == 0 && (Studio.rec-unavailable != "" || Studio.rec-note-bad) ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        if Studio.rec-state == 2 && Studio.rec-note != "": Text {
            text: Studio.rec-note;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            wrap: word-wrap;
        }
        // The virtual camera: stopping asks nothing, the camera then shows its still
        // picture (ADR-0066 decision 12).
        if Studio.vcam-shown: HorizontalLayout {
            alignment: start;
            Button {
                text: Studio.vcam-on ? @tr("Stop virtual camera") : @tr("Start virtual camera");
                kind: Studio.vcam-on ? "live" : "secondary";
                enabled: Studio.vcam-can;
                clicked => { Studio.vcam-toggle(!Studio.vcam-on); }
            }
        }
        if Studio.vcam-shown && Studio.vcam-text != "": Text {
            // State in words (U4); the live indicator says "Virtual camera on" too.
            text: Studio.vcam-text;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        // The replay buffer: arm it, save a clip (ADR-0088).
        ReplayControls { }
    }
}

// Children shown only while `shown`; takes no room otherwise (layouts have no
// `visible`, and an `if` would hide the popups' `open` from the form). The space
// above (`lead`) is part of it, so a hidden one leaves no gap in a layout with no
// spacing.
component Shown inherits Rectangle {
    in property <bool> shown;
    in property <length> gap: Tokens.space-1;
    in property <length> lead: 0;
    visible: shown;
    height: shown ? inner.preferred-height : 0;
    inner := VerticalLayout {
        padding-top: root.lead;
        spacing: root.gap;
        @children
    }
}

// A one-line explanation under a field (U2: every option explains itself).
component Hint inherits Text {
    color: Theme.text-secondary;
    font-size: Tokens.type-caption-size;
    wrap: word-wrap;
}

// A section title that does not collapse (ADR-0076): the same look as SectionHeader,
// with a rule to the end of the row, but plain text for screen readers.
component SectionTitle inherits HorizontalLayout {
    in property <string> title;
    spacing: Tokens.size-field-gap;
    VerticalLayout {
        alignment: center;
        Text {
            text: title.to-uppercase();
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            font-weight: Tokens.type-label-weight;
            letter-spacing: Tokens.size-tracking-caps;
            accessible-role: text;
            accessible-label: title;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
    }
}

// A collapsible group of fields under a SectionHeader. A closed section draws nothing and
// takes no room. Its state is saved in the workspace file under `id` (ADR-0078).
component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> id;
    // The explanation behind an info button at the end of the header (ADR-0094 rule A1);
    // empty draws no button.
    in property <string> hint;
    property <bool> closed: Sections.closed(root.id, Sections.rev);
    spacing: Tokens.size-field-gap;
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        SectionHeader {
            horizontal-stretch: 1;
            title: root.title;
            collapsible: true;
            open: !root.closed;
            toggled(o) => { Sections.set-closed(root.id, !o); }
        }
        if root.hint != "" && !root.closed: InfoHint {
            label: root.title;
            text: root.hint;
        }
    }
    // Slint cannot put @children in an `if`, so a closed section is hidden and takes
    // no room (like Shown): it draws and handles no input. Width follows the section
    // so a stretched slider (volume) fills the panel instead of staying at preferred width.
    Rectangle {
        visible: !root.closed;
        width: 100%;
        height: root.closed ? 0px : inner.preferred-height;
        inner := VerticalLayout {
            width: 100%;
            spacing: Tokens.size-field-gap;
            @children
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: Tokens.space-1;
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    @children
}

// The encoder fields of one output, shared by the Recording and Stream sections, as
// rows of a settings card: the video encoder, its bitrate or quality level, the audio
// bitrate and, behind "Advanced settings" (U2), every other setting that changes the
// output's quality. `set(field, value)` reports a pick; field codes (rbs-app
// `studio_ui::enc_field`): 0 encoder, 1 video bitrate, 2 audio bitrate, 3 rate
// control, 4 maximum bitrate, 5 quality level, 6 padding (value 0 or 1), 7 keyframe
// interval, 8 preset, 9 profile, 10 B-frames, 11 video codec, 12 colour,
// 13 open shadows.
component EncoderFields inherits VerticalLayout {
    in property <EncoderData> data;
    // Not while the output runs.
    in property <bool> idle;
    // A stream: the hints speak of the stream instead of files.
    in property <bool> stream;
    callback set(int /* field */, int /* value */);
    // Advanced settings (U2): shown with the button below, in the same place.
    property <bool> advanced: false;
    SettingRow {
        label: @tr("Video codec");
        help: root.stream
            ? @tr("A stream uses H.264. RTMP does not carry HEVC yet.")
            : @tr("H.264 plays everywhere. HEVC makes a smaller file and needs a newer player.");
        enabled: root.idle && root.data.codecs.length > 1;
        codec := Select {
            label: @tr("Video codec");
            options: root.data.codecs;
            index: root.data.codec;
            enabled: root.idle && root.data.codecs.length > 1;
            selected(i) => { root.set(11, i); }
        }
    }
    SettingRow {
        label: @tr("Colour");
        help: root.data.delivery == 0
            ? @tr("Rec. 709 limited range, for YouTube, TV and streams.")
            : @tr("sRGB full range. Matches the app on screen; a poor choice for YouTube.");
        enabled: root.idle;
        colour := Select {
            label: @tr("Colour");
            options: [@tr("Video"), @tr("Screen")];
            index: root.data.delivery;
            enabled: root.idle;
            selected(i) => { root.set(12, i); }
        }
    }
    Shown {
        shown: root.data.delivery == 0;
        gap: 0;
        SettingRow {
            label: @tr("Open shadows");
            help: root.stream
                ? @tr("Lifts only the darkest tones so they stay visible on YouTube and TV. The stream stays Rec. 709. Off by default.")
                : @tr("Lifts only the darkest tones so they stay visible on YouTube and TV. The file stays Rec. 709. Off by default.");
            enabled: root.idle;
            fill: false;
            Toggle {
                label: @tr("Open shadows");
                checked: root.data.open-shadows;
                enabled: root.idle && root.data.delivery == 0;
                toggled(on) => { root.set(13, on ? 1 : 0); }
            }
        }
    }
    SettingRow {
        label: @tr("Video encoder");
        help: @tr("Automatic picks the best one this computer has.");
        enabled: root.idle;
        encoder := Select {
            label: @tr("Video encoder");
            options: root.data.encoders;
            index: root.data.encoder;
            enabled: root.idle;
            selected(i) => { root.set(0, i); }
        }
    }
    // The bitrate (CBR, VBR) or the quality level (constant quality): one slot.
    Shown {
        shown: root.data.rate-kind != 2;
        gap: 0;
        SettingRow {
            label: root.data.bitrate-label;
            help: root.data.recommended-kbps > 0
                ? @tr("{} kbit/s is below the {} kbit/s recommended for this output size ({} x {} at {} fps).", root.data.video-kbps, root.data.recommended-kbps, root.data.out-width, root.data.out-height, root.data.out-fps)
                : root.stream ? @tr("Most of the picture's quality. Use what your streaming service recommends.")
                : @tr("Most of the picture's quality; larger values make larger files.");
            help-is-warning: root.data.recommended-kbps > 0;
            enabled: root.idle;
            video := Select {
                label: root.data.recommended-kbps > 0
                    ? @tr("{}, warning: {} kbit/s is below the {} kbit/s recommended for this output size ({} x {} at {} fps).", root.data.bitrate-label, root.data.video-kbps, root.data.recommended-kbps, root.data.out-width, root.data.out-height, root.data.out-fps)
                    : root.data.bitrate-label;
                options: root.data.video-rates;
                index: root.data.video-rate;
                enabled: root.idle && root.data.rate-kind != 2;
                selected(i) => { root.set(1, i); }
            }
        }
    }
    Shown {
        shown: root.data.rate-kind == 2;
        gap: 0;
        SettingRow {
            label: @tr("Quality level");
            help: @tr("Lower is better quality and larger files.");
            enabled: root.idle;
            quality := Select {
                label: @tr("Quality level");
                options: root.data.qualities;
                index: root.data.quality;
                enabled: root.idle && root.data.rate-kind == 2;
                selected(i) => { root.set(5, i); }
            }
        }
    }
    SettingRow {
        label: @tr("Audio bitrate");
        help: @tr("AAC. 160 kbit/s suits most voices and music.");
        enabled: root.idle;
        audio := Select {
            label: @tr("Audio bitrate");
            options: root.data.audio-rates;
            index: root.data.audio-rate;
            enabled: root.idle;
            selected(i) => { root.set(2, i); }
        }
    }
    SettingRow {
        label: @tr("Advanced settings");
        help: @tr("Rate control, keyframes, preset, profile and B-frames. The defaults suit most uses.");
        fill: false;
        Button {
            text: root.advanced ? @tr("Hide") : @tr("Show");
            accessible-name: root.advanced ? @tr("Hide advanced settings") : @tr("Show advanced settings");
            kind: "secondary";
            icon: root.advanced ? IconName.chevron-up : IconName.chevron-down;
            clicked => { root.advanced = !root.advanced; }
        }
    }
    // Advanced: every other setting that changes the output's quality.
    Shown {
        shown: root.advanced;
        gap: 0;
        SettingRow {
            label: @tr("Rate control");
            help: root.data.rate-kind == 0 ? @tr("CBR: the same bitrate all the time. The default.")
                : root.data.rate-kind == 1 ? @tr("VBR: the bitrate follows the picture, up to the maximum. CBR is the default.")
                : @tr("Constant quality: the same quality all the time; file size varies. CBR is the default.");
            enabled: root.idle;
            mode := Select {
                label: @tr("Rate control");
                options: root.data.rate-modes;
                index: root.data.rate-mode;
                enabled: root.idle && root.advanced;
                selected(i) => { root.set(3, i); }
            }
        }
        Shown {
            shown: root.data.rate-kind == 1;
            gap: 0;
            SettingRow {
                label: @tr("Maximum bitrate");
                help: @tr("The most VBR may use for a moment. Automatic is 1.5 x the target bitrate.");
                enabled: root.idle;
                peak := Select {
                    label: @tr("Maximum bitrate");
                    options: root.data.peaks;
                    index: root.data.peak;
                    enabled: root.idle && root.advanced && root.data.rate-kind == 1;
                    selected(i) => { root.set(4, i); }
                }
            }
        }
        Shown {
            shown: root.data.rate-kind == 0;
            gap: 0;
            SettingRow {
                label: @tr("Pad to the full bitrate");
                help: root.data.padding-available
                    ? @tr("Adds filler data so a still picture still uses the whole bitrate. Off by default.")
                    : @tr("This encoder cannot pad the bitrate.");
                enabled: root.idle && root.data.padding-available;
                fill: false;
                Toggle {
                    label: @tr("Pad to the full bitrate");
                    checked: root.data.padding;
                    enabled: root.idle && root.advanced && root.data.rate-kind == 0 && root.data.padding-available;
                    toggled(on) => { root.set(6, on ? 1 : 0); }
                }
            }
        }
        SettingRow {
            label: @tr("Keyframe interval");
            help: root.stream
                ? @tr("How often a full picture is sent. Most streaming services require 2 s, the default.")
                : @tr("How often a full picture is stored. Shorter makes seeking faster and files larger.");
            enabled: root.idle;
            keyframe := Select {
                label: @tr("Keyframe interval");
                options: root.data.keyframes;
                index: root.data.keyframe;
                enabled: root.idle && root.advanced;
                selected(i) => { root.set(7, i); }
            }
        }
        SettingRow {
            label: @tr("Encoder preset");
            help: @tr("Quality uses more of the GPU's encoder; Speed uses less. Balanced is the default.");
            enabled: root.idle;
            fill: false;
            SegmentedControl {
                label: @tr("Encoder preset");
                options: root.data.presets;
                index: root.data.preset;
                enabled: root.idle && root.advanced;
                selected(i) => { root.set(8, i); }
            }
        }
        SettingRow {
            label: @tr("Profile");
            help: @tr("Automatic lets the encoder pick, the default. Baseline plays on the oldest devices.");
            enabled: root.idle;
            profile := Select {
                label: @tr("Profile");
                options: root.data.profiles;
                index: root.data.profile;
                enabled: root.idle && root.advanced;
                selected(i) => { root.set(9, i); }
            }
        }
        SettingRow {
            label: @tr("B-frames");
            help: root.data.b-frames-note != "" ? root.data.b-frames-note
                : @tr("More B-frames save bits and add a little delay. 0 is the default.");
            enabled: root.idle && root.data.b-frames-note == "";
            bframes := Select {
                label: @tr("B-frames");
                options: root.data.b-frames;
                index: root.data.b-frame;
                enabled: root.idle && root.advanced && root.data.b-frames-note == "";
                selected(i) => { root.set(10, i); }
            }
        }
    }
}

// Reports its place when the Library gear asks, so Properties can scroll to it.
component LookAnchor inherits Rectangle {
    height: 0px;
    property <int> ask: Studio.look-reveal;
    property <int> reported: -1;
    function report() {
        if root.ask <= 0 || self.absolute-position.y <= 0px || root.reported == root.ask {
            return;
        }
        root.reported = root.ask;
        Studio.look-anchor-y = self.absolute-position.y;
        Studio.look-anchor-serial += 1;
    }
    changed ask => { root.reported = -1; root.report(); }
    changed y => { root.report(); }
}

// The selected source's properties. For now: where its picture is on the canvas
// (position and size in canvas pixels). Rotation, crop and filters come later.
// The colour code of a colour source: a short field, and Copy while the pointer is over
// it or it has focus. Pasting a whole code sets the colour.
component ColourCode inherits Rectangle {
    in property <SourceData> data;
    property <string> fill-text: data.fill;
    property <bool> show-copy: cover.has-hover || fill-field.has-focus || copy.pointed;
    width: Tokens.size-color-code;
    height: Tokens.size-control-md;
    fill-field := TextField {
        width: parent.width;
        height: parent.height;
        // The copy button is drawn over this end of the field.
        end-inset: Tokens.size-control-sm + Tokens.space-1;
        label: @tr("Fill of {}", data.name);
        text: data.fill;
        // A later fill copies in. An unfinished edit does not change `fill-text`,
        // so this does not wipe what is being typed.
        property <string> copied: root.fill-text;
        changed copied => { self.text = self.copied; }
        enabled: !data.locked;
        accepted(t) => {
            if t != data.fill { Studio.set-source-fill(data.id, t); }
            self.text = data.fill;
        }
        edited(t) => { if t != data.fill { Studio.set-source-fill(data.id, t); } }
    }
    copy := IconButton {
        x: parent.width - self.width - Tokens.space-1;
        y: (parent.height - self.height) / 2;
        opacity: root.show-copy ? 1 : 0;
        icon: IconName.copy;
        name: @tr("Copy the fill of {}", data.name);
        clicked => { fill-field.copy-all(); }
    }
    // Over the text only, and only until the field is focused, so a click focuses it
    // and the copy button stays clickable.
    cover := TouchArea {
        width: parent.width - Tokens.size-control-sm - Tokens.space-1;
        height: parent.height;
        enabled: !fill-field.has-focus;
        clicked => { fill-field.focus(); }
    }
}

// Fill on one row: the checkbox at the start, the swatch and the code at the end.
// Alignment is stretch so the gap goes to the spacer. Center would keep every
// item at its preferred width and pack the row in the middle of the panel.
component FillLine inherits HorizontalLayout {
    in property <SourceData> data;
    spacing: Tokens.size-field-gap;
    alignment: stretch;
    // The swatch is shorter than the checkbox. Center keeps it square; stretch
    // would give it the row height.
    cross-axis-alignment: center;
    Checkbox {
        text: @tr("Fill");
        checked: data.filled;
        enabled: !data.locked;
        toggled(on) => { Studio.set-source-filled(data.id, on); }
    }
    Rectangle {
        horizontal-stretch: 1;
        min-width: 0px;
        preferred-width: 0px;
    }
    if data.filled: ColorPicker {
        // Four fifths of a control: the swatch stays a square, a step smaller than the field.
        width: Tokens.size-control-md * 4 / 5;
        height: Tokens.size-control-md * 4 / 5;
        label: @tr("Choose the fill of {}", data.name);
        value: data.fill-swatch;
        enabled: !data.locked;
        picked(c) => { if c != data.fill { Studio.set-source-fill(data.id, c); } }
    }
    if data.filled: ColourCode { data: root.data; }
}

// Shape and border of a picture (ADR-0053), under its position and size. Every change
// is one undo step.
component StyleFields inherits Section {
    in property <SourceData> data;
    LookAnchor { }
    // The colour that stands. The field's text is set from it whenever it changes,
    // because setting the text after an edit ends the field's binding.
    property <string> colour-text: data.border-color;
    changed colour-text => { colour.text = colour-text; }
    title: @tr("Shape and border");
    id: "properties.shape";
    hint: data.locked ? @tr("Unlock the source to change its shape and border.") : "";
    Field {
        label: @tr("Shape");
        // Five names do not fit a segmented control in a narrow panel.
        Select {
            label: @tr("Shape of {}", data.name);
            options: [@tr("Rectangle"), @tr("Circle"), @tr("Ellipse"), @tr("Triangle"), @tr("Arrow")];
            index: data.shape;
            enabled: !data.locked;
            selected(i) => {
                Studio.set-source-style(data.id, i, i == 0 ? data.radius : 0, data.border, data.border-width, data.border-color);
            }
        }
    }
    Shown {
        shown: data.shape == 0;
        Field {
            label: @tr("Corner radius");
            NumberField {
                label: @tr("Corner radius of {}", data.name);
                value: data.radius;
                enabled: !data.locked;
                edited(v) => {
                    Studio.set-source-style(data.id, 0, max(v, 0), data.border, data.border-width, data.border-color);
                }
            }
        }
    }
    Hint {
        text: data.shape == 1
            ? @tr("The largest circle that fits in the box, centred. Make the box square for a full circle of the picture.")
            : data.shape == 2 ? @tr("The ellipse that fills the box.")
            : data.shape == 3 ? @tr("The tip is the top edge of the box. Flip the source to point it the other way.")
            : data.shape == 4 ? @tr("The arrow points at the right edge of the box. Flip the source to point it the other way.")
            : @tr("In canvas pixels. 0 keeps square corners; half the shorter side makes round ends.");
    }
    // A colour source can be an outline. The colour stays, so turning Fill back on
    // restores it. Off with no border would draw nothing, so the host adds a border.
    if data.solid: FillLine { data: root.data; }
    if data.solid: Rectangle {
        horizontal-stretch: 1;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    Checkbox {
        text: @tr("Border");
        checked: data.border;
        enabled: !data.locked;
        toggled(on) => {
            Studio.set-source-style(data.id, data.shape, data.radius, on, data.border-width, data.border-color);
        }
    }
    Shown {
        shown: data.border;
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Field {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Width");
                NumberField {
                    label: @tr("Border width of {}", data.name);
                    value: data.border-width;
                    enabled: !data.locked;
                    edited(v) => {
                        if v > 0 {
                            Studio.set-source-style(data.id, data.shape, data.radius, true, v, data.border-color);
                        }
                    }
                }
            }
            Field {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Colour");
                HorizontalLayout {
                    spacing: Tokens.size-field-gap;
                    // The colour as a swatch that opens the colour picker, beside its
                    // text (never colour alone, U7).
                    picker := ColorPicker {
                        label: @tr("Choose the border colour of {}", data.name);
                        value: data.border-swatch;
                        enabled: !data.locked;
                        picked(c) => {
                            if c != data.border-color {
                                Studio.set-source-style(data.id, data.shape, data.radius, true, data.border-width, c);
                            }
                        }
                    }
                    colour := TextField {
                        label: @tr("Border colour of {}", data.name);
                        text: data.border-color;
                        enabled: !data.locked;
                        accepted(t) => {
                            if t != data.border-color {
                                Studio.set-source-style(data.id, data.shape, data.radius, true, data.border-width, t);
                            }
                            // A refused colour goes back to the one that stands; an
                            // accepted one arrives through `colour-text`.
                            self.text = data.border-color;
                        }
                    }
                }
            }
        }
        Hint {
            text: @tr("Drawn inside the edge, so the box stays the same. Colour as #rrggbb, or #rrggbbaa with transparency.");
        }
    }
}

// Flip, rotate, fit and centre a picture (ADR-0084), under its position and size. Every
// button is one undo step.
component ArrangeFields inherits Section {
    in property <SourceData> data;
    property <bool> known: data.pic-w > 0;
    title: @tr("Flip, rotate & fit");
    id: "properties.arrange";
    hint: data.locked
        ? @tr("Unlock the source to change its transform.")
        : @tr("Drag the rotation, or turn by 90 with the buttons.");
    // Icon-only buttons: two short rows (ADR-0084). Center H/V stay in the menus so
    // this section does not grow.
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        alignment: start;
        IconButton {
            icon: IconName.flip-h;
            name: @tr("Flip {} horizontally", data.name);
            checked: data.flip-h;
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 0); }
        }
        IconButton {
            icon: IconName.flip-v;
            name: @tr("Flip {} vertically", data.name);
            checked: data.flip-v;
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 1); }
        }
        IconButton {
            icon: IconName.rotate-ccw;
            name: @tr("Rotate {} 90 degrees counter-clockwise", data.name);
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 3); }
        }
        IconButton {
            icon: IconName.rotate-cw;
            name: @tr("Rotate {} 90 degrees clockwise", data.name);
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 2); }
        }
        IconButton {
            icon: IconName.center;
            name: @tr("Center {} on the canvas", data.name);
            enabled: !data.locked;
            clicked => { Studio.transform-source(data.id, 8); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        alignment: start;
        IconButton {
            icon: IconName.fit;
            name: @tr("Fit {} inside the canvas", data.name);
            enabled: known && !data.locked;
            clicked => { Studio.transform-source(data.id, 5); }
        }
        IconButton {
            icon: IconName.fill-canvas;
            name: @tr("Fill the canvas with {}", data.name);
            enabled: known && !data.locked;
            clicked => { Studio.transform-source(data.id, 6); }
        }
        IconButton {
            icon: IconName.stretch;
            name: @tr("Stretch {} to the canvas", data.name);
            enabled: known && !data.locked;
            clicked => { Studio.transform-source(data.id, 7); }
        }
        IconButton {
            icon: IconName.reset;
            name: @tr("Reset the transform of {}", data.name);
            enabled: known && !data.locked;
            clicked => { Studio.transform-source(data.id, 9); }
        }
    }
    // Under the buttons: drag sets the angle. The number is the value, not a field.
    // One drag is one undo step.
    property <int> spin: 0;
    property <float> shown: -1;
    property <float> from: 0;
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Slider {
            horizontal-stretch: 1;
            label: @tr("Rotation of {}", data.name);
            value: (root.shown >= 0 ? root.shown : data.rotation) / 360;
            value-text: round(root.shown >= 0 ? root.shown : data.rotation) + "°";
            // One degree. Shift moves ten.
            step: 1.0 / 360;
            enabled: !data.locked;
            moved(v) => {
                if root.spin == 0 {
                    root.from = data.rotation;
                    Studio.gesture-serial += 1;
                    root.spin = Studio.gesture-serial;
                }
                root.shown = v * 360;
                Studio.set-source-rotation(data.id, root.shown, root.spin);
            }
            released => { root.shown = -1; root.spin = 0; }
            cancelled => {
                if root.spin != 0 { Studio.set-source-rotation(data.id, root.from, root.spin); }
                root.shown = -1;
                root.spin = 0;
            }
            reset => {
                Studio.gesture-serial += 1;
                Studio.set-source-rotation(data.id, 0, Studio.gesture-serial);
            }
        }
        Text {
            min-width: Tokens.size-control-lg * 2;
            text: round(root.shown >= 0 ? root.shown : data.rotation) + "°";
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// Crop of a picture in source pixels (ADR-0058), under its position and size. Every
// change is one undo step and keeps the picture's scale; the Region buttons show a part
// of the picture as large as the canvas allows.
component CropFields inherits Section {
    in property <SourceData> data;
    property <bool> known: data.pic-w > 0;
    property <bool> can-edit: known && !data.locked;
    title: @tr("Crop");
    id: "properties.crop";
    hint: data.locked
        ? @tr("Unlock the source to change its crop.")
        : known
        ? @tr("In pixels of the {}x{} picture. The box changes so the picture keeps its scale. Alt-drag a handle on the picture panel to crop there.", data.pic-w, data.pic-h)
        : @tr("Available once the source shows a picture.");
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Left");
            label: @tr("Crop left of {}", data.name);
            value: data.crop-l;
            enabled: can-edit;
            edited(v) => { Studio.set-source-crop(data.id, max(v, 0), data.crop-t, data.crop-r, data.crop-b); }
        }
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Right");
            label: @tr("Crop right of {}", data.name);
            value: data.crop-r;
            enabled: can-edit;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, data.crop-t, max(v, 0), data.crop-b); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Top");
            label: @tr("Crop top of {}", data.name);
            value: data.crop-t;
            enabled: can-edit;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, max(v, 0), data.crop-r, data.crop-b); }
        }
        NumberField {
            horizontal-stretch: 1;
            preferred-width: 0;
            prefix: @tr("Bottom");
            label: @tr("Crop bottom of {}", data.name);
            value: data.crop-b;
            enabled: can-edit;
            edited(v) => { Studio.set-source-crop(data.id, data.crop-l, data.crop-t, data.crop-r, max(v, 0)); }
        }
    }
    Text {
        text: @tr("Show");
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        accessible-role: none;
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Button {
            horizontal-stretch: 1;
            text: @tr("Canvas size");
            kind: "secondary";
            enabled: can-edit;
            accessible-name: @tr("Show the centre of {} at canvas size", data.name);
            clicked => { Studio.set-source-region(data.id, 1); }
        }
        Button {
            horizontal-stretch: 1;
            text: @tr("Whole picture");
            kind: "secondary";
            enabled: can-edit;
            accessible-name: @tr("Show all of {}, fitted to the canvas", data.name);
            clicked => { Studio.set-source-region(data.id, 0); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Button {
            horizontal-stretch: 1;
            text: @tr("Left half");
            kind: "secondary";
            enabled: can-edit;
            accessible-name: @tr("Show the left half of {}", data.name);
            clicked => { Studio.set-source-region(data.id, 2); }
        }
        Button {
            horizontal-stretch: 1;
            text: @tr("Right half");
            kind: "secondary";
            enabled: can-edit;
            accessible-name: @tr("Show the right half of {}", data.name);
            clicked => { Studio.set-source-region(data.id, 3); }
        }
    }
}

// The Transform tab: where the picture is on the canvas, its crop, shape and border.
component TransformFields inherits VerticalLayout {
    in property <SourceData> data;
    spacing: Tokens.size-section-gap;
    alignment: start;
    if data.picture: Section {
        title: @tr("Position and size");
        id: "properties.position";
        hint: data.locked
            ? @tr("Unlock the source to change its position and size.")
            : @tr("In canvas pixels, from the top-left corner. Up and Down arrows change a value by 1, with Shift by 10.");
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            // Equal columns, whatever the values' lengths.
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("X");
                label: @tr("Position X of {}", data.name);
                value: data.x;
                enabled: !data.locked;
                edited(v) => { Studio.set-source-box(data.id, v, data.y, data.w, data.h); }
            }
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("Y");
                label: @tr("Position Y of {}", data.name);
                value: data.y;
                enabled: !data.locked;
                edited(v) => { Studio.set-source-box(data.id, data.x, v, data.w, data.h); }
            }
        }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("W");
                label: @tr("Width of {}", data.name);
                value: data.w;
                enabled: !data.locked;
                edited(v) => { Studio.set-source-box(data.id, data.x, data.y, v, data.h); }
            }
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                prefix: @tr("H");
                label: @tr("Height of {}", data.name);
                value: data.h;
                enabled: !data.locked;
                edited(v) => { Studio.set-source-box(data.id, data.x, data.y, data.w, v); }
            }
        }
    }
    if data.picture: ArrangeFields { data: data; }
    if data.picture: CropFields { data: data; }
    if data.picture: StyleFields { data: data; }
}

// One filter in the chain: its on/off Checkbox named after it, then Move up, Move down
// and Remove. A click on the row selects it, so its fields show below the list.
component FilterRowView inherits Rectangle {
    in property <SourceData> source;
    in property <FilterData> data;
    in property <int> index;
    in property <bool> selected;
    // The Library asks for a gear that opens this filter in Properties. The Filters
    // tab leaves it off: the fields are already under the row.
    in property <bool> jump: false;
    callback open-settings();
    horizontal-stretch: 1;
    // One step above the field height, so the name has room; it still wraps only
    // when it does not fit on one line.
    height: max(Tokens.size-control-lg, row.preferred-height);
    border-radius: Tokens.radius-sm;
    border-width: selected ? Tokens.size-border : 0px;
    border-color: Theme.accent;
    background: selected || touch.has-hover ? Theme.surface-overlay : transparent;
    touch := TouchArea {
        enabled: !root.confirm;
        clicked => { Studio.select-filter(source.id, data.id); }
    }
    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-1;
        if data.known: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Checkbox {
                text: data.name;
                checked: data.enabled;
                emphasis: selected;
                accessible-label: @tr("Turn {} on or off", data.name);
                toggled(on) => {
                    Studio.select-filter(source.id, data.id);
                    Studio.set-filter-enabled(data.id, on);
                }
            }
        }
        if !data.known: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: data.name;
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                overflow: elide;
            }
            Text {
                text: @tr("Not available in this version");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.chevron-up;
                name: @tr("Move {} up", data.name);
                enabled: data.can-up;
                clicked => { Studio.move-filter(data.id, index - 1); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.chevron-down;
                name: @tr("Move {} down", data.name);
                enabled: data.can-down;
                clicked => { Studio.move-filter(data.id, index + 1); }
            }
        }
        if root.jump: VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.gear;
                name: @tr("Open settings for {}", data.name);
                clicked => { root.open-settings(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.close;
                name: @tr("Remove {}", data.name);
                clicked => { root.confirm = true; }
            }
        }
    }
    // Remove asks first, in the row (the same trash and close icons as a source row).
    property <bool> confirm;
    changed confirm => { if root.confirm { confirm-focus.focus(); } }
    confirm-focus := RingFocus {
        enabled: root.confirm;
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Escape { root.confirm = false; return accept; }
            if e.text == Key.Return || e.text == Key.Delete || e.text == Key.Backspace {
                Studio.remove-filter(data.id);
                return accept;
            }
            reject
        }
    }
    if root.confirm: Rectangle {
        y: 0;
        width: parent.width;
        height: parent.height;
        clip: true;
        background: Theme.surface-overlay;
        border-radius: Tokens.radius-sm;
        border-width: Tokens.size-border;
        border-color: Theme.accent;
        HorizontalLayout {
            height: parent.height;
            padding-left: Tokens.space-2;
            padding-right: Tokens.space-1;
            spacing: Tokens.space-1;
            Text {
                text: @tr("Remove {}?", data.name);
                color: Theme.text-primary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    kind: "danger";
                    name: @tr("Remove {}", data.name);
                    clicked => { Studio.remove-filter(data.id); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: IconName.close;
                    name: @tr("Cancel");
                    clicked => { root.confirm = false; }
                }
            }
        }
    }
}

// One field of the selected filter, generated from its type's schema.
component FilterFieldView inherits VerticalLayout {
    in property <SourceData> source;
    in property <FilterData> filter;
    in property <FilterFieldData> data;
    in property <int> index;
    // The position while a drag is on, so the value beside the slider follows it.
    property <float> dragged: -1;
    property <bool> dragging: dragged >= 0;
    // The value at a slider position, as the host stores it (on its step).
    function text-at(p: float) -> string {
        let q = max(0, min(1, p));
        let raw = data.log ? data.min * Math.pow(data.max / data.min, q) : data.min + q * (data.max - data.min);
        let v = data.snap > 0 ? max(data.min, min(data.max, data.min + round((raw - data.min) / data.snap) * data.snap)) : raw;
        return v.to-fixed(data.decimals) + data.suffix;
    }
    property <string> colour-text: data.colour;
    changed colour-text => { colour.text = colour-text; }
    spacing: Tokens.space-1;
    HorizontalLayout {
        spacing: Tokens.space-1;
        Text {
            text: data.label;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            accessible-role: none;
        }
        if data.help != "": InfoHint { label: data.label; text: data.help; }
    }
    if data.kind == 0: HorizontalLayout {
        spacing: Tokens.space-2;
        Slider {
            horizontal-stretch: 1;
            label: @tr("{} of {}", data.label, filter.name);
            value: dragging ? dragged : data.position;
            value-text: dragging ? root.text-at(dragged) : data.value-text;
            step: data.step;
            enabled: filter.known;
            moved(v) => {
                root.dragged = v;
                Studio.preview-filter(filter.id, index, v);
            }
            released => {
                root.dragged = -1;
                Studio.commit-filter(filter.id);
            }
            cancelled => {
                root.dragged = -1;
                Studio.cancel-filter(filter.id);
            }
        }
        Text {
            width: Tokens.size-control-lg * 3;
            horizontal-stretch: 0;
            text: dragging ? root.text-at(dragged) : data.value-text;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    Shown {
        shown: data.kind == 1;
        HorizontalLayout {
            spacing: Tokens.space-2;
            ColorPicker {
                label: @tr("Choose the {} of {}", data.label, filter.name);
                value: data.swatch;
                picked(c) => {
                    if c != data.colour { Studio.set-filter-colour(filter.id, index, c); }
                }
            }
            colour := TextField {
                horizontal-stretch: 1;
                label: @tr("{} of {}", data.label, filter.name);
                text: data.colour;
                accepted(t) => {
                    if t != data.colour { Studio.set-filter-colour(filter.id, index, t); }
                    self.text = data.colour;
                }
            }
        }
    }
    // A source of the collection (a ducker's key): "None", then the other sound sources.
    Shown {
        shown: data.kind == 3;
        Select {
            label: @tr("{} of {}", data.label, filter.name);
            options: data.options;
            index: data.choice;
            placeholder: @tr("Not in this scene");
            selected(i) => { Studio.set-filter-source(filter.id, index, i); }
        }
    }
}

// Add filter: a button that opens the filter types by name as a CommandMenu (ADR-0094
// rule B1). The new filter goes at the end of the chain and is selected.
component AddFilterButton inherits Rectangle {
    in property <SourceData> source;
    // The audio filter types instead of the picture ones (the Audio tab).
    in property <bool> audio;
    height: Tokens.size-control-md;
    Button {
        width: root.width;
        height: root.height;
        text: @tr("Add filter");
        accessible-name: @tr("Add a filter to {}", source.name);
        lead: IconName.plus;
        icon: IconName.chevron-down;
        clicked => { menu.open({ x: 0px, y: root.height }); }
    }
    menu := CommandMenu {
        context: "add-filter";
        target: "source=" + source.id + (root.audio ? "&audio=1" : "");
    }
}

// The live level of a noise gate (ADR-0082): the input level as a bar with the open and
// close thresholds as lines on it, and under it how far the gate is turning the sound down.
// It exists only while the gate's section is open, and so does its 30 Hz timer.
component GateBar inherits VerticalLayout {
    in property <FilterData> filter;
    property <FilterLevels> levels;
    spacing: Tokens.space-1;
    Timer {
        interval: 33ms; // literal: the meters' 30 Hz refresh (U16), not a design value
        running: true;
        triggered => { root.levels = Studio.filter-levels(root.filter.id); }
    }
    Text {
        text: root.filter.bar-label;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    Rectangle {
        height: Tokens.space-3;
        background: Theme.surface-sunken;
        border-width: Tokens.size-border;
        border-color: Theme.border-subtle;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: progress-indicator;
        accessible-label: @tr("Input level of {}", root.filter.name);
        Rectangle { width: parent.width * root.levels.input; background: Theme.meter-low; }
        Rectangle {
            x: max(0px, parent.width * root.filter.close-pos - Tokens.size-meter-peak);
            width: Tokens.size-meter-peak;
            background: Theme.text-secondary;
        }
        Rectangle {
            x: max(0px, parent.width * root.filter.open-pos - Tokens.size-meter-peak);
            width: Tokens.size-meter-peak;
            background: Theme.accent;
        }
    }
    Text {
        text: @tr("Gain reduction");
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        accessible-role: none;
    }
    Rectangle {
        height: Tokens.space-1;
        background: Theme.surface-sunken;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: progress-indicator;
        accessible-label: @tr("Gain reduction of {}", root.filter.name);
        Rectangle { width: parent.width * root.levels.reduction; background: Theme.meter-mid; }
    }
}

// The Filters tab: the chain in order, Add filter, and the selected filter's fields.
component FiltersFields inherits VerticalLayout {
    in property <SourceData> data;
    // The Filters section of the Audio tab (ADR-0082): audio filter types, and a note
    // about the short dip when the chain's tail changes.
    in property <bool> audio;
    spacing: Tokens.size-field-gap;
    alignment: start;
    if !audio: SectionTitle { title: @tr("Filters"); }
    if data.filters.length == 0: Rectangle {
        height: empty.preferred-height;
        empty := EmptyState {
            width: parent.width;
            title: @tr("No filters");
            message: audio ? @tr("Add filter to raise or lower the level of this source or to gate out its background noise.") : @tr("Add filter to change colours, key out a green screen, blur or sharpen this source.");
        }
    }
    for f[i] in data.filters: FilterRowView {
        source: data;
        data: f;
        index: i;
        selected: f.id == data.selected-filter;
    }
    HorizontalLayout {
        spacing: Tokens.space-1;
        AddFilterButton { source: data; audio: audio; horizontal-stretch: 1; }
        if audio: InfoHint {
            label: @tr("Changing filters");
            text: @tr("Adding, removing or reordering a filter can cause a brief dip (10 to 20 ms) in this source's sound. Changing a setting never does.");
        }
    }
    for f[i] in data.filters: VerticalLayout {
        spacing: Tokens.size-field-gap;
        if f.id == data.selected-filter && f.known: VerticalLayout {
            spacing: Tokens.size-field-gap;
            LookAnchor { }
            FeatureSection {
                title: f.name;
                id: "properties.filter-settings";
                has-toggle: false;
                if f.gate: GateBar { filter: f; }
                for field[j] in f.fields: FilterFieldView {
                    source: data;
                    filter: f;
                    data: field;
                    index: j;
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: @tr("Reset to defaults");
                        kind: "secondary";
                        accessible-name: @tr("Reset {} to defaults", f.name);
                        clicked => { Studio.reset-filter(f.id); }
                    }
                }
            }
        }
    }
}

// The sound of a source and its sync offset: the Audio tab (ADR-0059, ADR-0062).
// Volume, mute and the offset are live controls, not undo steps.
component AudioFields inherits VerticalLayout {
    in property <SourceData> data;
    spacing: Tokens.size-section-gap;
    alignment: start;
    Section {
        title: @tr("Sound");
        id: "properties.sound";
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            alignment: stretch;
            // Slot takes every leftover pixel; the readout stays a fixed token width on the right.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                height: Tokens.size-control-sm;
                Slider {
                    width: parent.width;
                    height: parent.height;
                    label: @tr("Volume of {}", data.name);
                    value: data.volume;
                    value-text: data.volume-text;
                    enabled: !data.muted;
                    moved(v) => { Studio.set-source-volume(data.id, v); }
                }
            }
            ValueReadout {
                horizontal-stretch: 0;
                text: data.volume-text;
                color: data.muted ? Theme.text-disabled : Theme.text-secondary;
                accessible-label: @tr("Volume of {}, {}", data.name, data.volume-text);
            }
        }
        Checkbox {
            text: @tr("Mute");
            checked: data.muted;
            toggled(on) => { Studio.set-source-muted(data.id, on); }
        }
    }
    Section {
        title: @tr("Sync offset");
        id: "properties.sync";
        hint: @tr("Delays this source's sound (positive) or plays it earlier (negative) to match the picture, from -200 to 200 ms. Playing it earlier is limited by the audio latency.");
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Sync offset of {} in milliseconds", data.name);
                value: data.sync-offset;
                step: 10;
                edited(v) => { Studio.set-source-sync-offset(data.id, round(max(-200, min(200, v)))); }
            }
            Text {
                text: @tr("ms");
                color: Theme.text-secondary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
    // Audio filters belong to a source with only sound (ADR-0082).
    if !data.picture: Section {
        title: @tr("Filters");
        id: "properties.audio-filters";
        FiltersFields { data: data; audio: true; }
    }
}

// The Source tab: what the source captures now, and a list to point it at another target
// (ADR-0077). Reload tries a source that is not running again.
component SourceFields inherits VerticalLayout {
    in property <SourceData> data;
    property <int> source-id: data.id;
    spacing: Tokens.size-field-gap;
    init => { Studio.list-source-targets(data.id); }
    changed source-id => { Studio.list-source-targets(data.id); }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        if !data.ok: VerticalLayout {
            alignment: center;
            Icon { name: IconName.warning; ink: Theme.state-warning; }
        }
        Text {
            horizontal-stretch: 1;
            text: data.status;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        alignment: start;
        Button {
            text: @tr("Reload");
            accessible-name: @tr("Reload {}", data.name);
            dense: true;
            clicked => { Studio.reload-source(data.id); }
        }
        Button {
            text: @tr("Refresh list");
            dense: true;
            clicked => { Studio.list-source-targets(data.id); }
        }
    }
    // Screens, windows and cameras have more settings (ADR-0077).
    if data.kind-code >= 0 && data.kind-code <= 2: HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("Source settings…");
            accessible-name: @tr("Open the source settings of {}", data.name);
            dense: true;
            clicked => { Studio.open-source-settings(data.id); }
        }
    }
    // A display or a window can bring its sound along (ADR-0096).
    if data.kind-code == 0 || data.kind-code == 1: HorizontalLayout {
        spacing: Tokens.space-1;
        Checkbox {
            horizontal-stretch: 1;
            text: @tr("Capture audio too");
            checked: data.companion;
            toggled(on) => { Studio.set-companion-audio(data.id, on); }
        }
        InfoHint {
            label: @tr("Capture audio too");
            text: data.kind-code == 0
                ? @tr("Adds the system sound as its own audio source, without RBS's own sound. Capturing the system sound and another app's sound can play the same audio twice.")
                : @tr("Adds this window's application sound as its own audio source. Capturing it and the system sound can play the same audio twice.");
        }
    }
    TextField {
        label: @tr("Search the list");
        placeholder: @tr("Search");
        edited(t) => { Studio.filter-source-targets(t); }
    }
    if Studio.source-targets.length == 0: Text {
        text: @tr("Nothing of this type was found.");
        color: Theme.text-secondary;
        font-size: Tokens.type-body-size;
        wrap: word-wrap;
    }
    VerticalLayout {
        spacing: Tokens.space-1;
        for t in Studio.source-targets: VerticalLayout {
            spacing: Tokens.space-1;
            if t.heading != "": Text {
                text: t.heading;
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                font-weight: Tokens.type-label-weight;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Tokens.space-2;
                if t.wants-picture: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: Tokens.size-target-thumb-w;
                        height: Tokens.size-target-thumb-h;
                        border-radius: Tokens.radius-sm;
                        background: Theme.surface-sunken;
                        clip: true;
                        if t.has-picture: Image {
                            source: t.picture;
                            width: 100%;
                            height: 100%;
                            accessible-role: none;
                        }
                        if !t.has-picture: Icon {
                            name: Icons.named(data.icon);
                            ink: Theme.text-secondary;
                        }
                    }
                }
                MenuItem {
                    horizontal-stretch: 1;
                    text: t.name;
                    checked: t.current;
                    activated => { Studio.retarget-source(data.id, t.index); }
                }
            }
        }
    }
}

component SourceProperties inherits VerticalLayout {
    in property <SourceData> data;
    // Delete source asks first (ADR-0065).
    property <bool> confirm;
    changed data => { if confirm && Studio.selected-source != data.id { confirm = false; } }
    in property <int> live-state;
    // 0 Transform, 1 Filters, 2 Audio, 3 Source. The Source tab is the last one shown;
    // the first tab opens, except while the source is not running, when the Source tab
    // opens by itself (ADR-0077).
    property <bool> has-source: data.kind-code >= 0;
    // The tabs before Source: Transform, Filters and Audio for a source with a picture
    // and sound, without Audio when it has none, only Audio for sound alone.
    property <int> before-source: data.picture ? (data.audio ? 3 : 2) : 1;
    property <int> want: Studio.properties-tab;
    property <int> tab: has-source && (!data.ok || want == 3) ? 3
        : !data.picture ? 2
        : want == 1 ? 1
        : want == 2 && data.audio ? 2
        : 0;
    spacing: Tokens.size-section-gap;
    alignment: start;
    // The source: its kind's icon, its name and kind, and its name as a field.
    VerticalLayout {
        spacing: Tokens.size-field-gap;
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            VerticalLayout {
                alignment: center;
                Icon { name: Icons.named(data.icon); ink: Theme.text-primary; }
            }
            Text {
                horizontal-stretch: 1;
                text: data.name;
                color: Theme.text-primary;
                font-size: Tokens.type-label-size;
                font-weight: Tokens.type-title-weight;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: data.kind;
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
            }
            IconButton {
                name: @tr("Delete {}", data.name);
                kind: "danger";
                clicked => { root.confirm = true; }
            }
        }
        if root.confirm: SettingsCallout {
            label: @tr("Delete {} from every scene?", data.name);
            Text {
                text: data.global || data.in-globals
                    ? (data.places > 2 ? @tr("{} is in every scene and {} more. Delete it from all of them?", data.name, data.places - 1) : data.places == 2 ? @tr("{} is in every scene and 1 more. Delete it from all of them?", data.name) : @tr("{} is in every scene. Delete it?", data.name))
                    : data.places > 1 ? @tr("{} is in {} scenes. Delete it from all of them?", data.name, data.places)
                    : @tr("Delete {}? It is only in this scene.", data.name);
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Tokens.size-field-gap;
                alignment: start;
                Button {
                    text: @tr("Delete source");
                    kind: "danger";
                    dense: true;
                    clicked => { root.confirm = false; Studio.delete-source(data.id); }
                }
                Button {
                    text: @tr("Cancel");
                    dense: true;
                    clicked => { root.confirm = false; }
                }
            }
        }
        TextField {
            label: @tr("Name of {}", data.name);
            text: data.name;
            accepted(t) => { if t != data.name { Studio.rename-source(data.id, t); } }
        }
    }
    // Transform, Filters and, for a source with sound, Audio, then Source (ADR-0062, ADR-0076, ADR-0077).
    if data.picture || has-source: Tabs {
        label: @tr("Properties of {}", data.name);
        options: has-source
            ? (data.picture
                ? (data.audio ? [@tr("Transform"), @tr("Filters"), @tr("Audio"), @tr("Source")] : [@tr("Transform"), @tr("Filters"), @tr("Source")])
                : [@tr("Audio"), @tr("Source")])
            : (data.audio ? [@tr("Transform"), @tr("Filters"), @tr("Audio")] : [@tr("Transform"), @tr("Filters")]);
        index: tab == 3 ? before-source : data.picture ? tab : 0;
        selected(i) => {
            if has-source && i == before-source { Studio.properties-tab = 3; }
            else if data.picture { Studio.properties-tab = i; }
            else { Studio.properties-tab = 2; }
        }
    }
    // Filters and the sync offset belong to the source: an edit shows on air at once.
    if live-state != 0 && (tab == 1 || tab == 2): HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Rectangle {
            width: on-air.preferred-width + 2 * Tokens.space-2;
            height: Tokens.type-caption-line;
            border-radius: self.height / 2;
            background: Theme.state-live;
            on-air := Text {
                text: @tr("On air");
                color: Theme.text-on-live;
                font-size: Tokens.type-caption-size;
                font-weight: Tokens.type-label-weight;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Changes here show in the program at once.");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    if tab == 3: SourceFields { data: data; }
    if tab == 0: TransformFields { data: data; }
    if tab == 1: FiltersFields { data: data; }
    if tab == 2: AudioFields { data: data; }
    if data.picture: Section {
        title: @tr("Timed show");
        id: "properties.timed-show";
        hint: @tr("Hide with the hourglass in Sources if you need to, or press Show now here. It appears for the duration and hides again without Undo. Leave Show duration at 0 and use the eye in Sources for a lasting show.");
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            NumberField {
                horizontal-stretch: 1;
                preferred-width: 0;
                label: @tr("Show duration of {} in milliseconds", data.name);
                value: data.show-for-ms;
                edited(v) => { Studio.set-item-show-for(data.item-id, max(0, min(600000, round(v)))); }
            }
            Text {
                text: @tr("ms");
                color: Theme.text-secondary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        HorizontalLayout {
            spacing: Tokens.size-field-gap;
            Button {
                text: @tr("Show now");
                kind: "primary";
                dense: true;
                enabled: data.show-for-ms > 0 && !data.visible;
                clicked => { Studio.show-item(data.item-id); }
            }
            Button {
                text: @tr("Clear");
                dense: true;
                enabled: data.show-for-ms > 0;
                clicked => { Studio.set-item-show-for(data.item-id, 0); }
            }
        }
        if data.cue-remaining-ms > 0: Text {
            text: data.cue-remaining-ms + @tr(" ms left on Program");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            wrap: word-wrap;
        }
    }
    // Global sources (ADR-0065): on, the source is shown and heard in every scene.
    // Custom glide (ADR-0100): only for a picture source with more than one place.
    Section {
        title: @tr("Scenes");
        id: "properties.scenes";
        hint: data.global
            ? @tr("Turning this off moves it into this scene only, and off air until the next transition in studio mode.")
            : @tr("It then leaves the scenes that have it and is drawn above every scene.");
        Toggle {
            text: @tr("Show in every scene");
            label: @tr("Show {} in every scene", data.name);
            checked: data.global;
            toggled(on) => { Studio.set-global(data.id, on); }
        }
        if data.picture && data.places > 1: VerticalLayout {
            spacing: Tokens.size-field-gap;
            Toggle {
                text: @tr("Custom glide");
                label: @tr("Custom glide for {}", data.name);
                checked: data.custom-glide;
                toggled(on) => {
                    Studio.set-source-glide(
                        data.id,
                        on,
                        on ? (data.custom-glide ? data.glide-duration : Studio.glide-duration) : 0,
                        on ? (data.custom-glide ? data.glide-easing : Studio.glide-easing) : 0
                    );
                }
            }
            if data.custom-glide: Field {
                label: @tr("Duration");
                NumberField {
                    label: @tr("Glide duration of {} in milliseconds", data.name);
                    prefix: @tr("ms");
                    value: data.glide-duration;
                    edited(v) => {
                        Studio.set-source-glide(data.id, true, max(0, min(5000, round(v))), data.glide-easing);
                    }
                }
            }
            if data.custom-glide: Field {
                label: @tr("Easing");
                SegmentedControl {
                    label: @tr("Glide easing of {}", data.name);
                    options: [@tr("Linear"), @tr("Ease in-out")];
                    index: data.glide-easing;
                    selected(i) => { Studio.set-source-glide(data.id, true, data.glide-duration, i); }
                }
            }
        }
    }
}

// The selected source's properties (mockup E): its icon, name and type, its name as a
// field, then the Transform, Filters and Audio tabs (ADR-0062). A source without a
// picture has only the Audio tab, so no tab control shows. The tab picked last applies
// to whichever source is selected. `live-state`: 0 nothing goes out, else the program
// is on air, and Filters and Audio say that their edits show at once.
export component PropertiesPanel inherits Rectangle {
    in property <int> live-state;
    background: Theme.surface-raised;
    property <bool> any: Studio.properties-source >= 0;
    if !any: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("Nothing selected");
        message: @tr("Select a source in the Sources panel to see its properties.");
    }
    if any: props := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        // A list that can pan holds a press briefly, so a quick click on a confirm
        // button never arrives and the next one does. The wheel still scrolls.
        mouse-drag-pan-enabled: false;
        property <int> anchor: Studio.look-anchor-serial;
        // The gear's section has just reported its place: move it on screen.
        changed anchor => {
            if anchor <= 0 { return; }
            let margin = Tokens.space-2;
            let y = Studio.look-anchor-y - list.absolute-position.y;
            let h = Tokens.size-control-lg * 4;
            if y + props.content-y < margin {
                props.content-y = min(0px, margin - y);
            } else if y + h + props.content-y > props.height - margin {
                props.content-y = min(0px, props.height - margin - y - h);
            }
        }
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            alignment: start;
            for s in Studio.sources: VerticalLayout {
                spacing: Tokens.size-section-gap;
                if s.id == Studio.properties-source: SourceProperties {
                    data: s;
                    live-state: root.live-state;
                }
            }
        }
    }
}


// Which canvas's settings the Recording and Stream sections show, while the studio has
// a vertical canvas (ADR-0093 decision 6): one row at the top of each section.
component SettingsCanvasPicker inherits HorizontalLayout {
    spacing: Tokens.space-2;
    alignment: start;
    Text {
        text: @tr("Settings for");
        color: Theme.text-primary;
        font-size: Tokens.type-label-size;
        font-weight: Tokens.type-label-weight;
        vertical-alignment: center;
        accessible-role: none;
    }
    Select {
        width: Tokens.size-menu-sm;
        label: @tr("Settings for");
        options: Studio.settings-canvases;
        index: Studio.settings-canvas;
        selected(i) => { Studio.set-settings-canvas(i); }
    }
    VerticalLayout {
        alignment: center;
        InfoHint {
            label: @tr("Settings for");
            text: @tr("Each canvas records and streams with its own settings: its own folder, encoder, server and stream key.");
        }
    }
}

// The recording's settings (glossary: output profile): the Recording section of the
// Settings window (U17). They apply to the next recording and are saved at once.
export component RecordingSettings inherits Rectangle {
    property <bool> idle: Studio.rec-form-idle;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        if Studio.settings-canvases.length > 1: SettingsCanvasPicker { }
        if Studio.out-uses-main: SettingsNotice { text: @tr("Uses the main recording settings until changed."); }
        if !idle: SettingsNotice { text: @tr("Changes apply to the next recording."); }
        if Studio.out-note != "": SettingsNotice { text: Studio.out-note; problem: true; }
        SettingsCard {
            title: @tr("Files");
            id: "settings.recording.files";
            SettingRow {
                divider: false;
                label: @tr("Folder");
                help: @tr("Each recording gets a new file named by its date and time; a file is never replaced.");
                enabled: idle;
                control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                folder := TextField {
                    label: @tr("Folder");
                    text: Studio.out-folder;
                    enabled: idle;
                    accepted(t) => { Studio.set-folder(t); }
                }
            }
            SettingRow {
                label: @tr("Format");
                help: @tr("The container of the file.");
                enabled: idle;
                fill: false;
                SegmentedControl {
                    label: @tr("Format");
                    options: Studio.out-formats;
                    index: Studio.out-format;
                    enabled: idle;
                    selected(i) => { Studio.set-format(i); }
                }
            }
        }
        SettingsCard {
            title: @tr("Encoding");
            id: "settings.recording.encoding";
            SettingBlock {
                divider: false;
                label: @tr("Output size");
                help: @tr("Same as canvas keeps this canvas's size. Turn it off to pick another, or type a long side. It applies to the next recording.");
                HorizontalLayout {
                    alignment: center;
                    spacing: Tokens.space-3;
                    Toggle {
                        label: @tr("Same as canvas");
                        text: @tr("Same as canvas");
                        checked: Studio.out-same;
                        enabled: idle;
                        toggled(on) => { Studio.set-output-same(0, on); }
                    }
                    if Studio.out-same: Text {
                        text: Studio.out-value;
                        color: Theme.text-primary;
                        font-size: Tokens.type-caption-size;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                if !Studio.out-same: SizeNest {
                    label: @tr("Output size");
                    bands: Studio.out-bands;
                    extras: Studio.out-extras;
                    index: Studio.out-choice;
                    portrait: Studio.out-portrait;
                    value: Studio.out-value;
                    enabled: idle;
                    selected(i, w, h) => { Studio.set-output-size(0, i); }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-2;
                        Text {
                            text: @tr("Long side");
                            color: idle ? Theme.text-secondary : Theme.text-disabled;
                            font-size: Tokens.type-caption-size;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        NumberField {
                            label: @tr("Long side");
                            preferred-width: Tokens.size-field-compact;
                            value: Studio.out-long;
                            step: 2;
                            enabled: idle;
                            edited(v) => { Studio.set-output-long-side(0, v); }
                        }
                    }
                }
            }
            fields := EncoderFields {
                data: Studio.out-enc;
                idle: idle;
                set(field, value) => { Studio.set-encoding(0, field, value); }
            }
        }
        // The replay buffer belongs to the main canvas (ADR-0093 decision 6).
        if Studio.settings-canvas == 0: ReplaySettings { }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
    // The field shows what Rust set last; typing in it is never overwritten by a sync.
    property <int> folder-serial: Studio.out-folder-serial;
    changed folder-serial => { folder.text = Studio.out-folder; }
}

// Where Go live sends the program and how it is encoded: the Stream section of the
// Settings window (U17). Changes apply to the next stream and are saved at once. The
// stream key is never shown: it goes to the system's credential store.
export component StreamSettings inherits Rectangle {
    property <bool> idle: Studio.st-form-idle;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        if Studio.settings-canvases.length > 1: SettingsCanvasPicker { }
        if !idle: SettingsNotice { text: @tr("Changes apply to the next stream."); }
        if Studio.st-note != "": SettingsNotice { text: Studio.st-note; problem: true; }
        SettingsCard {
            title: @tr("Destination");
            id: "settings.stream.destination";
            SettingRow {
                divider: false;
                label: @tr("Server");
                help: @tr("The address your streaming service gives you, starting with rtmp:// or srt://.");
                enabled: idle;
                control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                server := TextField {
                    label: @tr("Server");
                    text: Studio.st-server;
                    enabled: idle;
                    accepted(t) => { Studio.set-server(t); }
                    edited(t) => { Studio.server-edited(t); }
                }
            }
            SettingRow {
                label: @tr("Stream key");
                help: Studio.st-key-place;
                enabled: idle;
                control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                key := TextField {
                    label: @tr("Stream key");
                    password: true;
                    enabled: idle;
                    accepted(t) => { Studio.save-key(t); }
                }
                Button {
                    horizontal-stretch: 0;
                    text: @tr("Save key");
                    kind: "secondary";
                    enabled: idle && key.text != "";
                    clicked => { Studio.save-key(key.text); }
                }
            }
            SettingRow {
                divider: false;
                fill: false;
                label: "";
                help: "";
                control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                Text {
                    text: Studio.st-key-saved ? @tr("A stream key is saved.") : @tr("No stream key yet.");
                    color: Studio.st-key-saved ? Theme.text-primary : Theme.text-secondary;
                    font-size: Tokens.type-body-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if Studio.st-key-saved: Button {
                    text: @tr("Remove key");
                    kind: "ghost";
                    dense: true;
                    enabled: idle;
                    clicked => { Studio.remove-key(); }
                }
            }
        }
        SettingsCard {
            title: @tr("Connection");
            id: "settings.stream.connection";
            SettingRow {
                divider: false;
                label: @tr("Reconnect when the connection drops");
                help: @tr("Tries up to 10 times, waiting longer each time. On by default.");
                enabled: idle;
                fill: false;
                Toggle {
                    label: @tr("Reconnect when the connection drops");
                    checked: Studio.st-reconnect;
                    enabled: idle;
                    toggled(on) => { Studio.set-reconnect(on); }
                }
            }
            Shown {
                shown: Studio.st-srt;
                gap: 0;
                SettingRow {
                    label: @tr("SRT latency");
                    help: @tr("More latency survives a worse network; viewers see the picture a little later.");
                    enabled: idle;
                    latency := Select {
                        label: @tr("SRT latency");
                        options: Studio.st-latencies;
                        index: Studio.st-latency;
                        enabled: idle && Studio.st-srt;
                        selected(i) => { Studio.set-latency(i); }
                    }
                }
            }
        }
        SettingsCard {
            title: @tr("While live");
            id: "settings.stream.while-live";
            SettingRow {
                divider: false;
                label: @tr("Record when the stream starts");
                help: @tr("Uses the Recording settings. Ending the stream stops this recording. Off by default.");
                enabled: idle;
                fill: false;
                Toggle {
                    label: @tr("Record when the stream starts");
                    checked: Studio.st-auto-record;
                    enabled: idle;
                    toggled(on) => { Studio.set-auto-record(on); }
                }
            }
            if Studio.st-auto-record: SettingsNotice { text: Studio.st-auto-record-note; }
        }
        SettingsCard {
            title: @tr("Encoding");
            id: "settings.stream.encoding";
            SettingBlock {
                divider: false;
                label: @tr("Output size");
                help: @tr("Same as canvas keeps this canvas's size. Turn it off to pick another, or type a long side. It applies to the next stream.");
                HorizontalLayout {
                    alignment: center;
                    spacing: Tokens.space-3;
                    Toggle {
                        label: @tr("Same as canvas");
                        text: @tr("Same as canvas");
                        checked: Studio.st-same;
                        enabled: idle;
                        toggled(on) => { Studio.set-output-same(1, on); }
                    }
                    if Studio.st-same: Text {
                        text: Studio.st-value;
                        color: Theme.text-primary;
                        font-size: Tokens.type-caption-size;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                if !Studio.st-same: SizeNest {
                    label: @tr("Output size");
                    bands: Studio.st-bands;
                    extras: Studio.st-extras;
                    index: Studio.st-choice;
                    portrait: Studio.out-portrait;
                    value: Studio.st-value;
                    enabled: idle;
                    selected(i, w, h) => { Studio.set-output-size(1, i); }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-2;
                        Text {
                            text: @tr("Long side");
                            color: idle ? Theme.text-secondary : Theme.text-disabled;
                            font-size: Tokens.type-caption-size;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        NumberField {
                            label: @tr("Long side");
                            preferred-width: Tokens.size-field-compact;
                            value: Studio.st-long;
                            step: 2;
                            enabled: idle;
                            edited(v) => { Studio.set-output-long-side(1, v); }
                        }
                    }
                }
            }
            fields := EncoderFields {
                data: Studio.st-enc;
                idle: idle;
                stream: true;
                set(field, value) => { Studio.set-encoding(1, field, value); }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
    // The fields show what Rust set last; typing is never overwritten by a sync.
    property <int> server-serial: Studio.st-server-serial;
    changed server-serial => { server.text = Studio.st-server; }
    // A key was saved or removed: the field is emptied (the key is never shown).
    property <int> key-serial: Studio.st-key-serial;
    changed key-serial => { key.text = ""; }
}

// The canvas's size and frame rate: the Video section of the Settings window (U17).
// A change restarts the studio with the new canvas; not while recording.
export component VideoSettings inherits Rectangle {
    property <bool> can-change: Studio.state == 1 && Studio.rec-state == 0 && Studio.st-state == 0 && !Studio.canvas-restarting;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        SettingsNotice {
            text: Studio.rec-state != 0
                ? @tr("Stop the recording to change the canvas.")
                : Studio.st-state != 0
                ? @tr("End the stream to change the canvas.")
                : Studio.canvas-restarting
                ? @tr("The studio is restarting with the new canvas.")
                : @tr("A change restarts the studio: the picture stops for a moment.");
        }
        if Studio.canvas-note != "": SettingsNotice { text: Studio.canvas-note; problem: true; }
        SettingsCard {
            title: @tr("Canvas");
            id: "settings.video.canvas";
            SettingBlock {
                divider: false;
                label: @tr("Canvas size");
                help: @tr("720p, 1080p, 1440p and 4K share one corner. Or type a size. Portrait swaps the sides.");
                SizeNest {
                    label: @tr("Canvas size");
                    bands: Studio.canvas-bands;
                    extras: Studio.canvas-extras;
                    index: Studio.canvas-choice;
                    portrait: Studio.canvas-portrait;
                    value: Studio.canvas-value;
                    enabled: can-change;
                    selected(i, w, h) => { Studio.set-canvas-sides(w, h); }
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        NumberField {
                            label: @tr("Canvas width");
                            prefix: "W";
                            preferred-width: Tokens.size-field-compact;
                            value: Studio.canvas-width;
                            step: 2;
                            enabled: can-change;
                            edited(v) => { Studio.set-canvas-sides(v, Studio.canvas-height); }
                        }
                        NumberField {
                            label: @tr("Canvas height");
                            prefix: "H";
                            preferred-width: Tokens.size-field-compact;
                            value: Studio.canvas-height;
                            step: 2;
                            enabled: can-change;
                            edited(v) => { Studio.set-canvas-sides(Studio.canvas-width, v); }
                        }
                    }
                    Toggle {
                        label: @tr("Portrait canvas");
                        text: @tr("Portrait");
                        checked: Studio.canvas-portrait;
                        enabled: can-change;
                        toggled(on) => { Studio.set-canvas-portrait(on); }
                    }
                }
            }
            SettingRow {
                label: @tr("Frame rate");
                help: @tr("Frames per second.");
                enabled: can-change;
                fill: false;
                SegmentedControl {
                    label: @tr("Frame rate");
                    options: Studio.canvas-rates;
                    index: Studio.canvas-rate;
                    enabled: can-change;
                    selected(i) => { Studio.set-canvas-rate(i); }
                }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
}

// Settings, General (ADR-0056, ADR-0098, ADR-0100): what closing the main window does,
// screen capture, studio mode swap, and collection glide (also outside studio mode).
export component GeneralSettings inherits Rectangle {
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        SettingsCard {
            title: @tr("Closing the main window");
            id: "settings.general.closing";
            SettingRow {
                divider: false;
                label: @tr("When I close the main window");
                help: Studio.platform == 2 ? @tr("Not available on Linux yet. Closing the main window quits RBS.")
                    : !Studio.way-back ? @tr("Keeping RBS running is not available on this computer yet, so closing the main window quits RBS.")
                    : Studio.platform == 0 ? @tr("Keep RBS running: recording, streaming and remote control go on, and RBS stays in the Dock. Click its Dock icon to get the window back; quit with Cmd+Q. Default on Mac: Keep RBS running.")
                    : @tr("Keep RBS running: recording, streaming and remote control go on, and RBS stays in the notification area. Click its icon there to get the window back, or quit from its menu. Default on Windows: Quit RBS.");
                enabled: Studio.platform != 2;
                fill: false;
                SegmentedControl {
                    label: @tr("When I close the main window");
                    options: [@tr("Quit RBS"), @tr("Keep RBS running")];
                    index: Studio.platform == 2 ? 0 : Studio.on-close;
                    enabled: Studio.platform != 2;
                    selected(i) => { Studio.set-on-close(i); }
                }
            }
        }
        SettingsCard {
            title: @tr("Screen capture");
            id: "settings.general.capture";
            SettingRow {
                divider: false;
                label: @tr("Leave RBS out of screen recordings");
                help: Studio.platform == 2 ? @tr("Not available on this system yet. A screen recording can include the RBS windows.")
                    : Studio.platform == 0 ? @tr("macOS leaves the RBS windows out of screen recordings and screen sharing. Turn this off to record the RBS window itself.")
                    : @tr("Windows skips the RBS windows when a screen or a window is captured, including a recording RBS makes of the display. Turn this off to record the RBS window itself.");
                enabled: Studio.platform != 2;
                fill: false;
                Toggle {
                    label: @tr("Leave RBS out of screen recordings");
                    checked: Studio.platform != 2 && Studio.exclude-own-window;
                    enabled: Studio.platform != 2;
                    toggled(on) => { Studio.set-exclude-own-window(on); }
                }
            }
        }
        SettingsCard {
            title: @tr("Studio mode");
            id: "settings.general.studio";
            SettingRow {
                divider: false;
                label: @tr("Swap scenes after a transition");
                help: @tr("After Transition, Preview shows the scene that was on air. Off: Preview keeps the scene that went on air.");
                fill: false;
                Toggle {
                    label: @tr("Swap scenes after a transition");
                    checked: Studio.swap-after-transition;
                    toggled(on) => { Studio.set-swap-after-transition(on); }
                }
            }
        }
        SettingsCard {
            title: @tr("Scene changes");
            id: "settings.general.glide";
            description: @tr("How shared sources move when the program scene changes, including outside studio mode.");
            SettingRow {
                label: @tr("Glide");
                help: @tr("Shared sources slide to their new place; new sources fade in. Off: every scene change is instant.");
                fill: false;
                Toggle {
                    label: @tr("Glide");
                    checked: Studio.glide-duration > 0;
                    toggled(on) => {
                        Studio.set-glide(on ? (Studio.glide-duration > 0 ? Studio.glide-duration : 400) : 0, Studio.glide-easing);
                    }
                }
            }
            SettingRow {
                label: @tr("Duration");
                help: @tr("Milliseconds. 0 is the same as turning Glide off.");
                enabled: Studio.glide-duration > 0;
                NumberField {
                    label: @tr("Glide duration in milliseconds");
                    prefix: @tr("ms");
                    value: Studio.glide-duration;
                    enabled: Studio.glide-duration > 0;
                    edited(v) => {
                        Studio.set-glide(max(0, min(5000, round(v))), Studio.glide-easing);
                    }
                }
            }
            SettingRow {
                divider: false;
                label: @tr("Easing");
                help: @tr("How a slide eases. Fade-ins stay linear.");
                enabled: Studio.glide-duration > 0;
                fill: false;
                SegmentedControl {
                    label: @tr("Glide easing");
                    options: [@tr("Linear"), @tr("Ease in-out")];
                    index: Studio.glide-easing;
                    enabled: Studio.glide-duration > 0;
                    selected(i) => { Studio.set-glide(Studio.glide-duration, i); }
                }
            }
        }
    }
    height: form.preferred-height;
}

// Remote control (glossary): the Remote control section of the Settings window (U17).
// Apps on this computer, such as Stream Deck or the user's scripts, control RBS through
// the control API with an access token each. Changes apply at once.
// Settings, Global sources (ADR-0065): sources shown and heard in every scene of the
// canvas. The list, then Add a global source: a kind, then one of its devices or a
// source the scenes already have. Every change is one undo step of the main window.
export component GlobalSourcesSettings inherits Rectangle {
    property <bool> running: Studio.state == 1;
    property <bool> existing-picked: Studio.global-option >= Studio.global-devices;
    // Remove asks first. -1 while it does not.
    property <int> confirm-id: -1;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        if Studio.on-air: SettingsNotice {
            text: @tr("On air: changes here show in the program at once.");
        }
        SettingsCard {
            title: @tr("Global sources");
            id: "settings.sources.global-sources";
            description: @tr("Heard and shown in every scene, above the scene's own sources.");
            if !running: SettingRow {
                divider: false;
                label: @tr("The studio is not running");
                help: @tr("Global sources can be changed once it runs.");
            }
            if running && Studio.global-count == 0: SettingRow {
                divider: false;
                label: @tr("No global sources yet");
                help: @tr("A global source is heard and shown in every scene.");
            }
            for s[i] in Studio.sources: VerticalLayout {
                if s.global: SettingRow {
                    divider: i > 0;
                    label: s.name;
                    help: s.kind;
                    fill: false;
                    Button {
                        text: @tr("Remove");
                        accessible-name: @tr("Remove {} from global sources", s.name);
                        dense: true;
                        clicked => { root.confirm-id = s.id; }
                    }
                }
                if s.global && root.confirm-id == s.id: SettingsCallout {
                    label: @tr("Remove {} from global sources?", s.name);
                    Text {
                        text: s.places <= 1
                            ? @tr("Remove {} from global sources? No scene has it, so it is deleted.", s.name)
                            : @tr("Remove {} from global sources? It stays in the scenes that have it.", s.name);
                        color: Theme.text-primary;
                        font-size: Tokens.type-body-size;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Tokens.size-field-gap;
                        alignment: start;
                        Button {
                            text: @tr("Remove");
                            kind: "danger";
                            dense: true;
                            clicked => { root.confirm-id = -1; Studio.remove-global(s.id); }
                        }
                        Button {
                            text: @tr("Cancel");
                            dense: true;
                            clicked => { root.confirm-id = -1; }
                        }
                    }
                }
            }
        }
        SettingsCard {
            title: @tr("Add a global source");
            id: "settings.sources.add-global";
            SettingRow {
                divider: false;
                label: @tr("Kind");
                help: @tr("What kind of source to add.");
                enabled: running;
                Select {
                    label: @tr("Kind");
                    options: Studio.global-kind-names;
                    index: Studio.global-kind;
                    placeholder: @tr("Choose a kind");
                    enabled: running && Studio.global-kind-names.length > 0;
                    selected(i) => { Studio.pick-global-kind(i); }
                }
            }
            SettingRow {
                label: @tr("Source");
                help: Studio.global-kind < 0 ? @tr("Pick a kind first.")
                    : Studio.global-options.length == 0 ? @tr("Nothing of this kind is available.")
                    : existing-picked ? @tr("A source marked (in scenes) leaves the scenes that have it, since it is then in every scene.")
                    : @tr("A device of this kind, or a source the scenes already have.");
                enabled: running && Studio.global-options.length > 0;
                Select {
                    label: @tr("Source");
                    options: Studio.global-options;
                    index: Studio.global-option;
                    placeholder: Studio.global-kind < 0 ? "" : @tr("Choose a source");
                    enabled: running && Studio.global-options.length > 0;
                    selected(i) => { Studio.global-option = i; }
                }
            }
            SettingRow {
                label: "";
                fill: false;
                Button {
                    text: @tr("Add");
                    accessible-name: @tr("Add as a global source");
                    kind: "primary";
                    enabled: running && Studio.global-option >= 0 && Studio.global-option < Studio.global-options.length;
                    clicked => { Studio.add-global(Studio.global-option); }
                }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
}

export component RemoteControlSettings inherits Rectangle {
    // The access picked for the next token: 1 Control, the default.
    property <int> access: 1;
    // Network access certificate: 0 the one RBS made, 1 the user's own (picked, maybe
    // not yet in use).
    property <bool> own-in-use: Studio.rc-own;
    // "Your own" picked, its files not yet in use.
    property <bool> picking-own;
    property <int> cert-source: (own-in-use || picking-own) ? 1 : 0;
    changed own-in-use => { picking-own = false; }
    // "New key" asks first: every client must pin the new key.
    property <bool> confirming;
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        SettingsCard {
            title: @tr("This computer");
            id: "settings.remote.this-computer";
            SettingRow {
                divider: false;
                label: @tr("Allow remote control");
                help: @tr("Lets apps on this computer, such as Stream Deck or your own scripts, control RBS. Off by default.");
                fill: false;
                Toggle {
                    label: @tr("Allow remote control");
                    checked: Studio.rc-enabled;
                    toggled(on) => { Studio.set-rc-enabled(on); }
                }
            }
            if Studio.rc-status != "": SettingsStatus {
                text: Studio.rc-status;
                tone: Studio.rc-status-bad ? 2 : Studio.rc-enabled ? 1 : 0;
            }
            SettingRow {
                label: @tr("Port");
                help: @tr("The port apps connect to. Changing it disconnects connected apps. 4456 is the default.");
                control-width: Tokens.size-menu-sm / 2;
                port := TextField {
                    label: @tr("Port");
                    text: Studio.rc-port;
                    accepted(t) => { Studio.set-rc-port(t); }
                }
            }
        }
        // Network access (ADR-0046): apps on other computers connect over TLS and
        // check the key pin before they send a token.
        SettingsCard {
            title: @tr("Other computers");
            id: "settings.remote.other-computers";
            SettingRow {
                divider: false;
                label: @tr("Allow access from other computers");
                help: @tr("Lets apps on other computers on your network connect over an encrypted connection. Turn it on only on networks you trust. Changing it disconnects connected apps. Windows and macOS ask to allow RBS through the firewall the first time; if that is refused, other computers cannot connect and RBS is not told.");
                enabled: Studio.rc-enabled;
                fill: false;
                Toggle {
                    label: @tr("Allow access from other computers");
                    checked: Studio.rc-network;
                    enabled: Studio.rc-enabled;
                    toggled(on) => { Studio.set-rc-network(on); }
                }
            }
            if Studio.rc-network-status != "": SettingsStatus {
                text: Studio.rc-network-status;
                tone: Studio.rc-network-status-bad ? 2 : Studio.rc-network ? 1 : 0;
            }
            if Studio.rc-network && Studio.rc-key-pin != "": SettingBlock {
                label: @tr("Key pin");
                help: @tr("Apps on other computers must check this before they send a token. It stays the same when the certificate is renewed.");
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface-sunken;
                        border-radius: Tokens.radius-sm;
                        border-width: Tokens.size-border;
                        border-color: Theme.border-subtle;
                        min-height: pin-text.preferred-height + Tokens.space-2 * 2;
                        pin-text := Text {
                            x: Tokens.space-2;
                            width: parent.width - Tokens.space-2 * 2;
                            text: Studio.rc-key-pin;
                            color: Theme.text-primary;
                            font-size: Tokens.type-body-size;
                            wrap: char-wrap;
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                            accessible-label: @tr("Key pin: {}", Studio.rc-key-pin);
                        }
                    }
                    pin := TextField {
                        // Holds the value for Copy only; the text beside it shows it whole.
                        visible: false;
                        width: 0px;
                        label: @tr("Key pin");
                        text: Studio.rc-key-pin;
                        read-only: true;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button {
                            text: @tr("Copy");
                            accessible-name: @tr("Copy key pin");
                            icon: IconName.copy;
                            clicked => { pin.copy-all(); }
                        }
                    }
                }
            }
            if Studio.rc-network && Studio.rc-fingerprint != "": SettingBlock {
                label: @tr("Certificate fingerprint (SHA-256)");
                help: Studio.rc-cert-note;
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface-sunken;
                        border-radius: Tokens.radius-sm;
                        border-width: Tokens.size-border;
                        border-color: Theme.border-subtle;
                        min-height: print-text.preferred-height + Tokens.space-2 * 2;
                        print-text := Text {
                            x: Tokens.space-2;
                            width: parent.width - Tokens.space-2 * 2;
                            text: Studio.rc-fingerprint;
                            color: Theme.text-primary;
                            font-size: Tokens.type-body-size;
                            wrap: char-wrap;
                            vertical-alignment: center;
                            accessible-role: AccessibleRole.text;
                            accessible-label: @tr("Certificate fingerprint: {}", Studio.rc-fingerprint);
                        }
                    }
                    print := TextField {
                        visible: false;
                        width: 0px;
                        label: @tr("Certificate fingerprint (SHA-256)");
                        text: Studio.rc-fingerprint;
                        read-only: true;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button {
                            text: @tr("Copy");
                            accessible-name: @tr("Copy certificate fingerprint");
                            icon: IconName.copy;
                            clicked => { print.copy-all(); }
                        }
                    }
                }
            }
            if Studio.rc-network: SettingRow {
                label: @tr("Allow remote admin");
                help: @tr("Lets Full control tokens change settings from other computers too. Off by default. Changing it disconnects connected apps.");
                fill: false;
                Toggle {
                    label: @tr("Allow remote admin");
                    checked: Studio.rc-remote-admin;
                    toggled(on) => { Studio.set-rc-remote-admin(on); }
                }
            }
            if Studio.rc-network: SettingRow {
                label: @tr("Certificate");
                help: root.cert-source == 0
                    ? @tr("RBS made a key and a certificate for this computer. Browser panels on other devices cannot check a key pin: they need your own certificate, one those devices already trust.")
                    : @tr("A certificate chain and its key, as PEM files, for example from your own certificate authority. RBS reads them each time it starts and never copies them. Using other files disconnects connected apps.");
                fill: false;
                SegmentedControl {
                    label: @tr("Certificate");
                    options: [@tr("Made by RBS"), @tr("Your own")];
                    index: root.cert-source;
                    selected(i) => {
                        root.picking-own = i == 1;
                        if i == 0 { Studio.rc-use-generated(); }
                    }
                }
            }
            if Studio.rc-network && root.cert-source == 1: VerticalLayout {
                SettingRow {
                    label: @tr("Certificate file");
                    help: @tr("A full path.");
                    control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                    own-cert := TextField {
                        label: @tr("Certificate file");
                        text: Studio.rc-own-cert;
                    }
                }
                SettingRow {
                    label: @tr("Key file");
                    help: @tr("A full path. On macOS and Linux the key file must be readable by you only.");
                    control-width: Tokens.size-menu-md + Tokens.size-menu-sm / 2;
                    own-key := TextField {
                        label: @tr("Key file");
                        text: Studio.rc-own-key;
                    }
                }
                SettingRow {
                    divider: false;
                    fill: false;
                    Button {
                        text: @tr("Use these files");
                        kind: "primary";
                        clicked => { Studio.rc-use-own(own-cert.text, own-key.text); }
                    }
                }
            }
            if Studio.rc-network && Studio.rc-network-note != "": SettingsStatus {
                text: Studio.rc-network-note;
                tone: 2;
            }
            if Studio.rc-network && root.cert-source == 0 && !root.confirming: SettingRow {
                label: @tr("New key");
                help: @tr("Makes a new key, for example if the key may have been copied. Every app on another computer must then check the new key pin.");
                fill: false;
                Button {
                    text: @tr("New key…");
                    clicked => { root.confirming = true; }
                }
            }
            if Studio.rc-network && root.cert-source == 0 && root.confirming: SettingBlock {
                RevealOnShow { }
                SettingsCallout {
                    label: @tr("Make a new key");
                    Text {
                        text: @tr("Make a new key? Apps on other computers are disconnected and connect again only after they check the new key pin. This cannot be undone.");
                        color: Theme.text-primary;
                        font-size: Tokens.type-body-size;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        alignment: start;
                        Button {
                            text: @tr("Make new key");
                            kind: "primary";
                            clicked => { root.confirming = false; Studio.rc-new-key(); }
                        }
                        Button {
                            text: @tr("Cancel");
                            clicked => { root.confirming = false; }
                        }
                    }
                }
            }
        }
        SettingsCard {
            title: @tr("Access tokens");
            id: "settings.remote.access-tokens";
            description: @tr("Each app needs an access token. Make one per app, so you can revoke it alone. A token is shown only once.");
            if Studio.rc-new-token != "": SettingBlock {
                divider: false;
                SettingsCallout {
                    label: @tr("New access token for {}", Studio.rc-new-token-name);
                    Text {
                        text: @tr("Access token for {}. Copy it into the app now: it is not shown again.", Studio.rc-new-token-name);
                        color: Theme.text-primary;
                        font-size: Tokens.type-body-size;
                        wrap: word-wrap;
                    }
                    secret := TextField {
                        label: @tr("Access token for {}", Studio.rc-new-token-name);
                        text: Studio.rc-new-token;
                        read-only: true;
                    }
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        alignment: start;
                        Button {
                            text: @tr("Copy");
                            kind: "primary";
                            icon: IconName.copy;
                            clicked => { secret.copy-all(); }
                        }
                        Button {
                            text: @tr("Done");
                            clicked => { Studio.dismiss-new-token(); }
                        }
                    }
                }
            }
            SettingRow {
                label: @tr("Name");
                help: @tr("The app the token is for, such as Stream Deck.");
                name := TextField {
                    label: @tr("Name");
                }
            }
            SettingRow {
                label: @tr("Access");
                help: Studio.rc-access-hints[root.access];
                fill: false;
                SegmentedControl {
                    label: @tr("Access");
                    options: Studio.rc-accesses;
                    index: root.access;
                    selected(i) => { root.access = i; }
                }
            }
            SettingRow {
                divider: false;
                fill: false;
                Button {
                    text: @tr("Create access token");
                    kind: "primary";
                    icon: IconName.plus;
                    clicked => { Studio.create-token(name.text, root.access); }
                }
            }
            if Studio.rc-note != "": SettingsStatus { text: Studio.rc-note; tone: 2; }
            if Studio.rc-revoked != "": SettingBlock {
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Text {
                        text: @tr("{} was revoked: apps using it were disconnected.", Studio.rc-revoked);
                        color: Theme.text-secondary;
                        font-size: Tokens.type-body-size;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    Button {
                        horizontal-stretch: 0;
                        text: @tr("Undo");
                        accessible-name: @tr("Undo revoking {}", Studio.rc-revoked);
                        clicked => { Studio.undo-revoke(); }
                    }
                }
            }
            SettingBlock {
                label: @tr("Tokens");
                VerticalLayout {
                    spacing: Tokens.space-1;
                    accessible-role: list;
                    accessible-label: @tr("Access tokens");
                    if Studio.rc-tokens.length == 0: Text {
                        text: @tr("No access tokens yet.");
                        color: Theme.text-secondary;
                        font-size: Tokens.type-body-size;
                    }
                    for t[i] in Studio.rc-tokens: Rectangle {
                        background: Theme.surface-sunken;
                        border-radius: Tokens.radius-md;
                        accessible-role: list-item;
                        accessible-label: @tr("{}, {}", t.name, t.access);
                        HorizontalLayout {
                            padding: Tokens.space-2;
                            padding-left: Tokens.space-3;
                            spacing: Tokens.space-2;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: t.name;
                                    color: Theme.text-primary;
                                    font-size: Tokens.type-label-size;
                                    font-weight: Tokens.type-label-weight;
                                    overflow: elide;
                                }
                                Text {
                                    text: t.access;
                                    color: Theme.text-secondary;
                                    font-size: Tokens.type-caption-size;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Revoke");
                                    accessible-name: @tr("Revoke {}", t.name);
                                    kind: "ghost";
                                    clicked => { Studio.revoke-token(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
    // The field shows what Rust set last; typing in it is never overwritten by a sync.
    property <int> port-serial: Studio.rc-port-serial;
    changed port-serial => { port.text = Studio.rc-port; }
    // A token was made: the name field is ready for the next one.
    property <string> made: Studio.rc-new-token;
    changed made => { if made != "" { name.text = ""; } }
}

// One labelled fact in an output card: the name in secondary, the value in the body size.
component OutputFact inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: Tokens.space-2;
    Text {
        text: label;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        vertical-alignment: center;
        min-width: Tokens.size-control-lg * 3;
    }
    Text {
        text: value;
        color: Theme.text-primary;
        font-size: Tokens.type-body-size;
        font-weight: Tokens.type-label-weight;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

// One output: a title, its facts, and the button that opens its settings.
component OutputCard inherits Rectangle {
    in property <string> title;
    in property <string> kind;
    in property <string> encoder;
    in property <string> video;
    in property <string> audio;
    in property <string> where;
    in property <string> where-label;
    in property <string> action;
    callback open();
    background: Theme.surface-sunken;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    border-radius: Tokens.radius-md;
    accessible-role: list-item;
    accessible-label: @tr("{}, {}, {}", title, kind, where);
    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.size-field-gap;
        Text {
            text: title;
            color: Theme.text-primary;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-title-weight;
        }
        OutputFact { label: @tr("Format"); value: kind; }
        OutputFact { label: @tr("Encoder"); value: encoder; }
        OutputFact { label: @tr("Video"); value: video; }
        OutputFact { label: @tr("Audio"); value: audio; }
        OutputFact { label: where-label; value: where; }
        HorizontalLayout {
            alignment: start;
            Button { text: action; clicked => { root.open(); } }
        }
    }
}

// Outputs: what the recording and the stream will do, each as a card, and the way
// to its settings. Settings live in the Settings window (U17), not in this panel.
export component OutputsPanel inherits Rectangle {
    background: Theme.surface-raised;
    Flickable {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            spacing: Tokens.size-section-gap;
            alignment: start;
            OutputCard {
                title: Studio.rec-state == 2 ? @tr("Recording now") : @tr("Recording");
                kind: Studio.out-kind;
                encoder: Studio.out-encoder-name;
                video: Studio.out-video-line;
                audio: Studio.out-audio-line;
                where: Studio.out-where;
                where-label: @tr("Folder");
                action: @tr("Recording settings");
                open => { Studio.open-settings(); }
            }
            OutputCard {
                title: Studio.st-connected ? @tr("Stream live")
                    : Studio.st-state != 0 ? @tr("Stream connecting") : @tr("Stream");
                kind: Studio.st-kind;
                encoder: Studio.st-encoder-name;
                video: Studio.st-video-line;
                audio: Studio.st-audio-line;
                where: Studio.st-where;
                where-label: @tr("Server");
                action: @tr("Stream settings");
                open => { Studio.open-stream-settings(); }
            }
        }
    }
}

// One shape in Add. The cell is the button: an outline icon and the name on one row,
// growing to a second line only when the name wraps. It fills its grid cell.
component LibraryShape inherits Rectangle {
    in property <string> title;
    in property <IconName> icon;
    callback act();
    horizontal-stretch: 1;
    min-width: 0px;
    height: max(Tokens.size-control-lg, body.preferred-height);
    border-radius: Tokens.radius-sm;
    background: touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: button;
    accessible-label: @tr("Add {}", title);
    accessible-action-default => { root.act(); }
    body := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: Tokens.space-1;
        padding-right: Tokens.space-1;
        padding-top: Tokens.space-1;
        padding-bottom: Tokens.space-1;
        spacing: Tokens.space-1;
        alignment: start;
        cross-axis-alignment: center;
        Icon {
            name: root.icon;
            ink: Theme.text-primary;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.title;
            color: Theme.text-primary;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    touch := TouchArea { clicked => { root.act(); } }
}

// The selected source's shape, when it is not a plain rectangle. It is the shape
// itself, not a look: no checkbox and no remove, so turning it off cannot flatten
// the picture back to a rectangle. A gear still opens the border and fill.
component AppliedShape inherits Rectangle {
    in property <SourceData> source;
    in property <string> title;
    horizontal-stretch: 1;
    // A fixed height. A height taken from a row whose width is this plate loops, and
    // the gear then sits beside the words while the plate itself is full width.
    height: Tokens.size-control-lg + Tokens.space-3;
    border-radius: Tokens.radius-sm;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    background: Theme.surface-sunken;
    accessible-role: text;
    accessible-label: @tr("Shape of {}: {}", source.name, root.title);
    // Not a layout: a layout inside this plate stays as wide as the words, so the
    // gear never reaches the plate's trailing end. The plate's width is set to 100%
    // where it is used, the same way a filter row is.
    words := VerticalLayout {
        x: Tokens.space-2;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - Tokens.space-2 - Tokens.space-1 * 2 - Tokens.size-control-sm;
        spacing: 0px;
        Text {
            text: @tr("Shape");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            overflow: elide;
            accessible-role: none;
        }
    }
    IconButton {
        x: parent.width - self.width - Tokens.space-1;
        y: (parent.height - self.height) / 2;
        icon: IconName.gear;
        name: @tr("Open Shape and border for {}", source.name);
        clicked => { Studio.open-shape-settings(source.id); }
    }
}

// One sample in the Add grid. The picture stays at most the library thumb size and
// never wider than the column, so two columns fit a narrow panel.
component LibraryCell inherits Rectangle {
    in property <string> title;
    in property <image> thumb;
    callback act();
    border-radius: Tokens.radius-sm;
    background: touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: button;
    accessible-label: @tr("Add {}", title);
    accessible-action-default => { root.act(); }
    VerticalLayout {
        padding: Tokens.space-1;
        spacing: Tokens.space-1;
        alignment: start;
        well := Rectangle {
            // A fixed height, not a ratio of the width: the column's width depends on
            // the grid's height, so a height taken from the width would loop.
            width: 100%;
            max-width: Tokens.size-library-thumb-w;
            height: Tokens.size-library-thumb-h;
            x: (parent.width - self.width) / 2;
            border-radius: Tokens.radius-sm;
            border-width: Tokens.size-border;
            border-color: Theme.border-subtle;
            background: Theme.surface-sunken;
            clip: true;
            Image {
                source: root.thumb;
                width: 100%;
                height: 100%;
                image-fit: contain;
                accessible-role: none;
            }
        }
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Tokens.type-caption-size;
            overflow: elide;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.act(); } }
}

// Two columns of one kind of sample. A hidden kind adds no row.
component SampleGrid inherits HorizontalLayout {
    in property <bool> frames;
    spacing: Tokens.size-field-gap;
    // Spacing stays 0: a sample of the other kind is an empty layout and must not
    // open a gap. A shown cell pads itself.
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 0px;
        alignment: start;
        for s in Studio.library-samples: VerticalLayout {
            if s.frame == root.frames && s.id != "lower-third" && Math.mod(s.slot, 2) == 0: VerticalLayout {
                padding-bottom: Tokens.space-1;
                LibraryCell {
                    title: s.name;
                    thumb: s.thumb;
                    act => { Studio.add-sample(s.id); }
                }
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 0px;
        alignment: start;
        for s in Studio.library-samples: VerticalLayout {
            if s.frame == root.frames && s.id != "lower-third" && Math.mod(s.slot, 2) == 1: VerticalLayout {
                padding-bottom: Tokens.space-1;
                LibraryCell {
                    title: s.name;
                    thumb: s.thumb;
                    act => { Studio.add-sample(s.id); }
                }
            }
        }
    }
}

// The Library (ADR-0075): Style copies a look onto the selected source; Add puts a
// background or a frame in the scene. Nothing is linked: a look is copied.
export component LibraryPanel inherits Rectangle {
    background: Theme.surface-raised;
    clip: true;
    property <bool> has-selection: Studio.selected-source >= 0;
    // A look changes a picture. An audio-only selection cannot take one.
    property <bool> can-apply: Studio.looks-ready;
    // 0 Style, 1 Add.
    property <int> mode: 0;
    // Which look the Add button copies.
    property <int> pick: 0;
    // 0 Background, 1 Frame.
    property <int> sample-kind: 0;
    init => { Studio.library-shown(); }
    // The list has no width, and the flickable has no content-width. A `width: 100%`
    // here is the preferred width of the contents, so a short control stays short
    // (design system: filling a row). Properties uses the same shape.
    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            spacing: Tokens.size-section-gap;
            alignment: start;
            SegmentedControl {
                label: @tr("Library");
                options: [@tr("Style"), @tr("Add")];
                index: root.mode;
                selected(i) => { root.mode = i; }
            }
            // Hint, the look row, the shape and the filters are separate groups.
            if root.mode == 0: VerticalLayout {
                width: 100%;
                horizontal-stretch: 1;
                spacing: Tokens.size-section-gap;
                alignment: start;
                Text {
                    text: !has-selection ? @tr("Select a source, then add a look.")
                        : !can-apply ? @tr("This source has no picture. Looks change a picture, so they stay off until you select one that has.")
                        : @tr("Adds a filter or a shape. A filter of the same kind is replaced. Turn it off, remove it, or open its settings.");
                    color: has-selection && !can-apply ? Theme.state-warning : Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    wrap: word-wrap;
                }
                // The rectangle takes the row. The layout is then given that width, and the
                // select stretches inside it. A preferred width of 0 hides the select.
                if root.can-apply: Rectangle {
                    horizontal-stretch: 1;
                    height: look-row.preferred-height;
                    look-row := HorizontalLayout {
                        width: parent.width;
                        spacing: Tokens.size-field-gap;
                        Select {
                            horizontal-stretch: 1;
                            label: @tr("Look");
                            options: Studio.library-look-names;
                            index: root.pick;
                            selected(i) => { root.pick = i; }
                        }
                        Button {
                            text: @tr("Add");
                            accessible-name: @tr("Add the selected look");
                            clicked => { Studio.apply-look-at(root.pick); }
                        }
                    }
                }
                if root.can-apply: VerticalLayout {
                    width: 100%;
                    horizontal-stretch: 1;
                    spacing: 0px;
                    alignment: start;
                    for s in Studio.sources: VerticalLayout {
                        width: 100%;
                        horizontal-stretch: 1;
                        spacing: 0px;
                        alignment: start;
                        if s.id == Studio.selected-source: VerticalLayout {
                            width: 100%;
                            horizontal-stretch: 1;
                            spacing: Tokens.size-section-gap;
                            alignment: start;
                            if s.shape != 0 || s.radius > 0 || s.border: AppliedShape {
                                // Same as the filter row under it. Without this, the plate
                                // paints full width but parent.width stays the words' width,
                                // and the gear sits beside them.
                                width: 100%;
                                horizontal-stretch: 1;
                                source: s;
                                title: @tr("Shape and border");
                            }
                            VerticalLayout {
                                width: 100%;
                                horizontal-stretch: 1;
                                spacing: Tokens.size-field-gap;
                                alignment: start;
                            for f[i] in s.filters: FilterRowView {
                                width: 100%;
                                horizontal-stretch: 1;
                                source: s;
                                data: f;
                                index: i;
                                selected: f.id == s.selected-filter;
                                jump: true;
                                open-settings => { Studio.open-filter-settings(s.id, f.id); }
                            }
                            }
                        }
                    }
                }
            }
            // Pictures and shapes are different categories, so a section gap and a
            // SectionTitle sit between them (the same rule as a Properties section).
            if root.mode == 1: VerticalLayout {
                horizontal-stretch: 1;
                spacing: Tokens.size-section-gap;
                alignment: start;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Tokens.size-section-gap;
                    alignment: start;
                    Button {
                        width: 100%;
                        horizontal-stretch: 1;
                        text: @tr("Choose a PNG file…");
                        accessible-name: @tr("Choose a PNG file");
                        clicked => { Studio.add-image(); }
                    }
                    Text {
                        text: root.sample-kind == 1
                            ? @tr("A frame is added on top. A plain frame's thickness is its border.")
                            : @tr("A background is added behind the scene.");
                        color: Theme.text-secondary;
                        font-size: Tokens.type-caption-size;
                        wrap: word-wrap;
                    }
                    SegmentedControl {
                        label: @tr("Add");
                        options: [@tr("Background"), @tr("Frame")];
                        index: root.sample-kind;
                        selected(i) => { root.sample-kind = i; }
                    }
                    SampleGrid { frames: root.sample-kind == 1; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Tokens.size-section-gap;
                    alignment: start;
                    SectionTitle { title: @tr("Shapes"); }
                    // Two equal columns. The six short names share cells; the long name
                    // takes the row under them so it is not crushed in a narrow panel.
                    GridLayout {
                        width: 100%;
                        horizontal-stretch: 1;
                        spacing: Tokens.size-field-gap;
                        LibraryShape { row: 0; col: 0; icon: IconName.circle; title: @tr("Circle"); act => { Studio.add-stamp(0); } }
                        LibraryShape { row: 0; col: 1; icon: IconName.square; title: @tr("Square"); act => { Studio.add-stamp(1); } }
                        LibraryShape { row: 1; col: 0; icon: IconName.rectangle; title: @tr("Rectangle"); act => { Studio.add-stamp(2); } }
                        LibraryShape { row: 1; col: 1; icon: IconName.ellipse; title: @tr("Ellipse"); act => { Studio.add-stamp(4); } }
                        LibraryShape { row: 2; col: 0; icon: IconName.triangle; title: @tr("Triangle"); act => { Studio.add-stamp(5); } }
                        LibraryShape { row: 2; col: 1; icon: IconName.arrow-right; title: @tr("Arrow"); act => { Studio.add-stamp(6); } }
                        LibraryShape { row: 3; col: 0; colspan: 2; icon: IconName.rounded-rectangle; title: @tr("Rounded rectangle"); act => { Studio.add-stamp(3); } }
                    }
                }
            }
        }
    }
}

// One measured number on its own row, or a group name. A full-width row keeps the
// label and the number readable in a narrow panel (a grid column was collapsing
// them to nothing).
component StatLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> bad;
    in property <bool> heading;
    min-height: heading ? Tokens.size-control-sm : Tokens.size-control-md;
    background: heading ? transparent : Theme.surface-sunken;
    border-width: heading ? 0px : Tokens.size-border;
    border-color: Theme.border-subtle;
    border-radius: Tokens.radius-sm;
    if heading: Text {
        text: label;
        color: Theme.text-primary;
        font-size: Tokens.type-label-size;
        font-weight: Tokens.type-title-weight;
        vertical-alignment: center;
        accessible-role: AccessibleRole.text;
    }
    if !heading: HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;
        Text {
            text: label;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
            accessible-role: none;
        }
        Text {
            text: value;
            color: bad ? Theme.state-error : Theme.text-primary;
            font-size: Tokens.type-body-size;
            font-weight: Tokens.type-title-weight;
            vertical-alignment: center;
            horizontal-alignment: right;
            accessible-role: AccessibleRole.text;
            accessible-label: @tr("{}: {}", label, value);
        }
    }
}

// Stats: the running recording's and stream's counters and the engine's late ticks,
// updated once a second while an output runs (design system: `rbs.stats` 1 Hz).
// Each number is one full-width row, so a narrow panel never clips the text.
export component StatsPanel inherits Rectangle {
    background: Theme.surface-raised;
    if Studio.stats.length == 0: EmptyState {
        width: parent.width;
        height: parent.height;
        title: @tr("Nothing to measure yet");
        message: @tr("Statistics show here while you record or stream.");
    }
    if Studio.stats.length > 0: Flickable {
        width: parent.width;
        height: parent.height;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: Tokens.size-panel-pad;
            spacing: Tokens.size-field-gap;
            alignment: start;
            for row in Studio.stats: StatLine {
                label: row.label;
                value: row.value;
                bad: row.bad;
                heading: row.heading;
            }
        }
    }
}
