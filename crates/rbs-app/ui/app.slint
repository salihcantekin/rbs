                for c in Menus.choices[4]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[8];
                icon: Menus.icons[8];
                enabled: Menus.enabled[8];
                for c in Menus.choices[5]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[9];
                icon: Menus.icons[9];
                enabled: Menus.enabled[9];
                for c in Menus.choices[6]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
        }
        Menu {
            title: @tr("Scene");
            Menu {
                title: Menus.titles[10];
                icon: Menus.icons[10];
                enabled: Menus.enabled[10];
                for c in Menus.choices[7]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuItem { title: Menus.titles[11]; icon: Menus.icons[11]; enabled: Menus.enabled[11]; activated => { Menus.run("scene.previous"); } }
            MenuItem { title: Menus.titles[12]; icon: Menus.icons[12]; enabled: Menus.enabled[12]; activated => { Menus.run("scene.next"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[13]; icon: Menus.icons[13]; enabled: Menus.enabled[13]; activated => { Menus.run("scene.add"); } }
            Menu {
                title: Menus.titles[14];
                icon: Menus.icons[14];
                enabled: Menus.enabled[14];
                for c in Menus.choices[8]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[15]; icon: Menus.icons[15]; enabled: Menus.enabled[15]; checkable: true; checked: Menus.checked[15]; activated => { Menus.run("canvas.studio_mode.toggle"); } }
            MenuItem { title: Menus.titles[16]; icon: Menus.icons[16]; enabled: Menus.enabled[16]; activated => { Menus.run("canvas.transition"); } }
        }
        Menu {
            title: @tr("Source");
            Menu {
                title: Menus.titles[17];
                icon: Menus.icons[17];
                enabled: Menus.enabled[17];
                for c in Menus.choices[9]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            Menu {
                title: Menus.titles[18];
                icon: Menus.icons[18];
                enabled: Menus.enabled[18];
                for c in Menus.choices[10]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[19];
                icon: Menus.icons[19];
                enabled: Menus.enabled[19];
                for c in Menus.choices[11]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[20];
                icon: Menus.icons[20];
                enabled: Menus.enabled[20];
                for c in Menus.choices[12]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[21];
                icon: Menus.icons[21];
                enabled: Menus.enabled[21];
                for c in Menus.choices[13]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[22]; icon: Menus.icons[22]; enabled: Menus.enabled[22]; activated => { Menus.run("item.remove"); } }
            MenuItem { title: Menus.titles[23]; icon: Menus.icons[23]; enabled: Menus.enabled[23]; activated => { Menus.run("source.delete"); } }
            MenuSeparator { }
            Menu {
                title: Menus.titles[24];
                icon: Menus.icons[24];
                enabled: Menus.enabled[24];
                for c in Menus.choices[14]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
        }
        Menu {
            title: @tr("Output");
            MenuItem { title: Menus.titles[25]; icon: Menus.icons[25]; enabled: Menus.enabled[25]; checkable: true; checked: Menus.checked[25]; activated => { Menus.run("stream.toggle"); } }
            MenuItem { title: Menus.titles[26]; icon: Menus.icons[26]; enabled: Menus.enabled[26]; checkable: true; checked: Menus.checked[26]; activated => { Menus.run("record.toggle"); } }
            Menu {
                title: Menus.titles[27];
                icon: Menus.icons[27];
                enabled: Menus.enabled[27];
                for c in Menus.choices[15]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[28]; icon: Menus.icons[28]; enabled: Menus.enabled[28]; checkable: true; checked: Menus.checked[28]; activated => { Menus.run("vcam.toggle"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[29]; icon: Menus.icons[29]; enabled: Menus.enabled[29]; checkable: true; checked: Menus.checked[29]; activated => { Menus.run("replay.toggle"); } }
            MenuItem { title: Menus.titles[30]; icon: Menus.icons[30]; enabled: Menus.enabled[30]; activated => { Menus.run("replay.save"); } }
        }
        Menu {
            title: @tr("Window");
            Menu {
                title: Menus.titles[31];
                icon: Menus.icons[31];
                enabled: Menus.enabled[31];
                for c in Menus.choices[16]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[32]; icon: Menus.icons[32]; enabled: Menus.enabled[32]; checkable: true; checked: Menus.checked[32]; activated => { Menus.run("ui.panel.maximize?id=rbs.preview"); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: Menus.titles[33]; icon: Menus.icons[33]; enabled: Menus.enabled[33]; activated => { Menus.run("ui.app_menu.open"); } }
        }
    }
    // END generated menu bar
    preferred-width: Tokens.size-floating-w;
    preferred-height: Tokens.size-floating-h;
    // The window ground (ADR-0112 decision 1).
    background: Theme.surface-base;
    default-font-size: Tokens.type-body-size;
    // Shortcuts (ADR-0060), as in the main window.
    edit-keys := FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if Shortcuts.press(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, e.repeat) { return accept; }
            reject
        }
        VerticalLayout {
            Rectangle {
                height: Tokens.size-control-md + 2 * Tokens.space-1;
                HorizontalLayout {
                    padding: Tokens.space-1;
                    alignment: start;
                    Button { text: @tr("Dock back"); clicked => { Shell.dock(root.window); } }
                    if Shell.end-stream-confirm: EndStreamConfirm { }
                    if Shell.end-vertical-confirm && !Shell.end-stream-confirm: EndStreamConfirm { vertical: true; }
                }
            }
            DockArea {
                window: root.window;
                stacks: root.stacks;
                handles: root.handles;
                floating: true;
            }
        }
    }
    // The info hint and tooltip layer, drawn last (ADR-0094).
    OverlayHost { width: parent.width; height: parent.height; }
}

// The Settings window (U17): a list of sections and the chosen one. Search comes when
// there are more.
export component SettingsWindow inherits Window {
    default-font-family: Theme.font-family;
    title: @tr("RBS settings");
    icon: @image-url("../assets/brand/icon-win-256.png");
    preferred-width: Tokens.size-settings-w;
    preferred-height: Tokens.size-settings-h;
    min-width: Tokens.size-menu-sm + Tokens.size-floating-w / 2 + Tokens.size-menu-md;
    min-height: Tokens.size-floating-h;
    background: Theme.surface-base;
    default-font-size: Tokens.type-body-size;
    // 0 Video, 1 Recording, 2 Stream, 3 Remote control, 4 General (listed first),
    // 5 Appearance (second), 6 Shortcuts (third), 7 Global sources, 8 Virtual camera.
    in-out property <int> section: 1;
    // The section list shows icons only (the collapse button at its top).
    in-out property <bool> nav-collapsed;
    // Escape was pressed: the window closes, as with its close button.
    callback dismiss();
    // Another section is shown (the Appearance page reads its files when shown).
    callback section-shown(int);
    changed section => { root.section-shown(root.section); }
    // Same menu bar as the main window so the macOS system menu bar stays filled
    // while Settings is key (spec, "Menu bar").
    // BEGIN generated menu bar (menu_bar.rs; do not edit)
    if Shell.native-menu-bar: MenuBar {
        Menu {
            title: @tr("File");
            Menu {
                title: Menus.titles[0];
                icon: Menus.icons[0];
                enabled: Menus.enabled[0];
                for c in Menus.choices[0]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[1];
                icon: Menus.icons[1];
                enabled: Menus.enabled[1];
                for c in Menus.choices[1]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[2]; icon: Menus.icons[2]; enabled: Menus.enabled[2]; activated => { Menus.run("ui.settings.open"); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: Menus.titles[3]; icon: Menus.icons[3]; enabled: Menus.enabled[3]; activated => { Menus.run("edit.undo"); } }
            MenuItem { title: Menus.titles[4]; icon: Menus.icons[4]; enabled: Menus.enabled[4]; activated => { Menus.run("edit.redo"); } }
        }
        Menu {
            title: @tr("View");
            Menu {
                title: Menus.titles[5];
                icon: Menus.icons[5];
                enabled: Menus.enabled[5];
                for c in Menus.choices[2]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            Menu {
                title: Menus.titles[6];
                icon: Menus.icons[6];
                enabled: Menus.enabled[6];
                for c in Menus.choices[3]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[7];
                icon: Menus.icons[7];
                enabled: Menus.enabled[7];
                for c in Menus.choices[4]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[8];
                icon: Menus.icons[8];
                enabled: Menus.enabled[8];
                for c in Menus.choices[5]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[9];
                icon: Menus.icons[9];
                enabled: Menus.enabled[9];
                for c in Menus.choices[6]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
        }
        Menu {
            title: @tr("Scene");
            Menu {
                title: Menus.titles[10];
                icon: Menus.icons[10];
                enabled: Menus.enabled[10];
                for c in Menus.choices[7]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuItem { title: Menus.titles[11]; icon: Menus.icons[11]; enabled: Menus.enabled[11]; activated => { Menus.run("scene.previous"); } }
            MenuItem { title: Menus.titles[12]; icon: Menus.icons[12]; enabled: Menus.enabled[12]; activated => { Menus.run("scene.next"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[13]; icon: Menus.icons[13]; enabled: Menus.enabled[13]; activated => { Menus.run("scene.add"); } }
            Menu {
                title: Menus.titles[14];
                icon: Menus.icons[14];
                enabled: Menus.enabled[14];
                for c in Menus.choices[8]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[15]; icon: Menus.icons[15]; enabled: Menus.enabled[15]; checkable: true; checked: Menus.checked[15]; activated => { Menus.run("canvas.studio_mode.toggle"); } }
            MenuItem { title: Menus.titles[16]; icon: Menus.icons[16]; enabled: Menus.enabled[16]; activated => { Menus.run("canvas.transition"); } }
        }
        Menu {
            title: @tr("Source");
            Menu {
                title: Menus.titles[17];
                icon: Menus.icons[17];
                enabled: Menus.enabled[17];
                for c in Menus.choices[9]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            Menu {
                title: Menus.titles[18];
                icon: Menus.icons[18];
                enabled: Menus.enabled[18];
                for c in Menus.choices[10]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[19];
                icon: Menus.icons[19];
                enabled: Menus.enabled[19];
                for c in Menus.choices[11]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[20];
                icon: Menus.icons[20];
                enabled: Menus.enabled[20];
                for c in Menus.choices[12]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[21];
                icon: Menus.icons[21];
                enabled: Menus.enabled[21];
                for c in Menus.choices[13]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[22]; icon: Menus.icons[22]; enabled: Menus.enabled[22]; activated => { Menus.run("item.remove"); } }
            MenuItem { title: Menus.titles[23]; icon: Menus.icons[23]; enabled: Menus.enabled[23]; activated => { Menus.run("source.delete"); } }
            MenuSeparator { }
            Menu {
                title: Menus.titles[24];
                icon: Menus.icons[24];
                enabled: Menus.enabled[24];
                for c in Menus.choices[14]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
        }
        Menu {
            title: @tr("Output");
            MenuItem { title: Menus.titles[25]; icon: Menus.icons[25]; enabled: Menus.enabled[25]; checkable: true; checked: Menus.checked[25]; activated => { Menus.run("stream.toggle"); } }
            MenuItem { title: Menus.titles[26]; icon: Menus.icons[26]; enabled: Menus.enabled[26]; checkable: true; checked: Menus.checked[26]; activated => { Menus.run("record.toggle"); } }
            Menu {
                title: Menus.titles[27];
                icon: Menus.icons[27];
                enabled: Menus.enabled[27];
                for c in Menus.choices[15]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[28]; icon: Menus.icons[28]; enabled: Menus.enabled[28]; checkable: true; checked: Menus.checked[28]; activated => { Menus.run("vcam.toggle"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[29]; icon: Menus.icons[29]; enabled: Menus.enabled[29]; checkable: true; checked: Menus.checked[29]; activated => { Menus.run("replay.toggle"); } }
            MenuItem { title: Menus.titles[30]; icon: Menus.icons[30]; enabled: Menus.enabled[30]; activated => { Menus.run("replay.save"); } }
        }
        Menu {
            title: @tr("Window");
            Menu {
                title: Menus.titles[31];
                icon: Menus.icons[31];
                enabled: Menus.enabled[31];
                for c in Menus.choices[16]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[32]; icon: Menus.icons[32]; enabled: Menus.enabled[32]; checkable: true; checked: Menus.checked[32]; activated => { Menus.run("ui.panel.maximize?id=rbs.preview"); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: Menus.titles[33]; icon: Menus.icons[33]; enabled: Menus.enabled[33]; activated => { Menus.run("ui.app_menu.open"); } }
        }
    }
    // END generated menu bar
    forward-focus: keys;
    // Keys a field does not take come up here: Escape closes the window (U7: every
    // action is reachable by keyboard).
    keys := FocusScope {
        key-pressed(e) => {
            // While "Keep this look?" is asked, Escape is Undo (themes spec).
            if e.text == Key.Escape && Appearance.keep-asking { Appearance.undo(); return accept; }
            if e.text == Key.Escape { root.dismiss(); return accept; }
            reject
        }
        HorizontalLayout {
            // The section list, in groups (U17: a flat list, never nested). It collapses to
            // a rail of icons (the names stay their accessible names) and expands again.
            Rectangle {
                width: root.nav-collapsed ? Tokens.size-control-lg + Tokens.space-3 * 2 : Tokens.size-menu-sm;
                background: Theme.surface-raised;
                Rectangle {
                    x: parent.width - self.width;
                    width: Tokens.size-border;
                    background: Theme.border-subtle;
                }
                VerticalLayout {
                    padding: Tokens.space-3;
                    padding-top: Tokens.space-4;
                    spacing: Tokens.space-1;
                    alignment: start;
                    accessible-role: list;
                    accessible-label: @tr("Settings sections");
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        alignment: root.nav-collapsed ? LayoutAlignment.center : LayoutAlignment.stretch;
                        if !root.nav-collapsed: Text {
                            horizontal-stretch: 1;
                            text: @tr("Settings");
                            color: Theme.text-primary;
                            font-size: Tokens.type-title-size;
                            font-weight: Tokens.type-title-weight;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        IconButton {
                            horizontal-stretch: 0;
                            icon: root.nav-collapsed ? IconName.chevron-right : IconName.chevron-left;
                            name: root.nav-collapsed ? @tr("Expand the section list") : @tr("Collapse the section list");
                            clicked => { root.nav-collapsed = !root.nav-collapsed; }
                        }
                    }
                    Rectangle { height: Tokens.space-2; }
                    if !root.nav-collapsed: SettingsNavGroup { title: @tr("App"); }
                    if root.nav-collapsed: Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
                    SettingsNavItem {
                        text: @tr("General");
                        icon: IconName.sliders;
                        compact: root.nav-collapsed;
                        current: root.section == 4;
                        activated => { root.section = 4; }
                    }
                    SettingsNavItem {
                        text: @tr("Audio");
                        icon: IconName.headphones;
                        compact: root.nav-collapsed;
                        current: root.section == 9;
                        activated => { root.section = 9; }
                    }
                    SettingsNavItem {
                        text: @tr("Appearance");
                        icon: IconName.palette;
                        compact: root.nav-collapsed;
                        current: root.section == 5;
                        activated => { root.section = 5; }
                    }
                    SettingsNavItem {
                        text: @tr("Shortcuts");
                        icon: IconName.keyboard;
                        compact: root.nav-collapsed;
                        current: root.section == 6;
                        activated => { root.section = 6; }
                    }
                    Rectangle { height: Tokens.space-2; }
                    if !root.nav-collapsed: SettingsNavGroup { title: @tr("Output"); }
                    if root.nav-collapsed: Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
                    SettingsNavItem {
                        text: @tr("Video");
                        icon: IconName.monitor;
                        compact: root.nav-collapsed;
                        current: root.section == 0;
                        activated => { root.section = 0; }
                    }
                    SettingsNavItem {
                        text: @tr("Global sources");
                        icon: IconName.globe;
                        compact: root.nav-collapsed;
                        current: root.section == 7;
                        activated => { root.section = 7; }
                    }
                    SettingsNavItem {
                        text: @tr("Recording");
                        icon: IconName.dot;
                        compact: root.nav-collapsed;
                        current: root.section == 1;
                        activated => { root.section = 1; }
                    }
                    SettingsNavItem {
                        text: @tr("Stream");
                        icon: IconName.broadcast;
                        compact: root.nav-collapsed;
                        current: root.section == 2;
                        activated => { root.section = 2; }
                    }
                    SettingsNavItem {
                        text: @tr("Virtual camera");
                        icon: IconName.camera;
                        compact: root.nav-collapsed;
                        current: root.section == 8;
                        activated => { root.section = 8; }
                    }
                    Rectangle { height: Tokens.space-2; }
                    if !root.nav-collapsed: SettingsNavGroup { title: @tr("Control"); }
                    if root.nav-collapsed: Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
                    SettingsNavItem {
                        text: @tr("Remote control");
                        icon: IconName.link;
                        compact: root.nav-collapsed;
                        current: root.section == 3;
                        activated => { root.section = 3; }
                    }
                }
            }
            flick := ScrollArea {
                horizontal-stretch: 1;
                content-height: page.preferred-height;
                page := VerticalLayout {
                    padding: Tokens.space-6;
                    // The bar sits in the trailing padding, so both sides look alike.
                    padding-right: max(0px, Tokens.space-6 - flick.bar-room);
                    spacing: Tokens.space-4;
                    alignment: start;
                    SettingsHeader {
                        group: root.section == 0 ? "settings.video." : root.section == 1 ? "settings.recording." : root.section == 2 ? "settings.stream." : root.section == 3 ? "settings.remote." : root.section == 4 ? "settings.general." : root.section == 5 ? "settings.appearance." : root.section == 7 ? "settings.sources." : root.section == 8 ? "settings.vcam." : root.section == 9 ? "settings.audio." : "";
                        title: root.section == 0 ? @tr("Video") : root.section == 1 ? @tr("Recording") : root.section == 2 ? @tr("Stream") : root.section == 3 ? @tr("Remote control") : root.section == 5 ? @tr("Appearance") : root.section == 6 ? @tr("Shortcuts") : root.section == 7 ? @tr("Global sources") : root.section == 8 ? @tr("Virtual camera") : root.section == 9 ? @tr("Audio") : @tr("General");
                        subtitle: root.section == 0 ? @tr("The canvas every scene is drawn on.")
                            : root.section == 1 ? @tr("Where recordings are saved and how they are encoded. Changes are saved at once.")
                            : root.section == 2 ? @tr("Where Go live sends the program and how it is encoded. Changes are saved at once.")
                            : root.section == 3 ? @tr("Let Stream Deck, panels and your own scripts control RBS.")
                            : root.section == 5 ? @tr("Themes for every RBS window, and your own themes.")
                            : root.section == 6 ? @tr("Keys that run commands, in RBS and, for global shortcuts, in any app.")
                            : root.section == 7 ? @tr("Sources heard and shown in every scene, such as your microphone.")
                            : root.section == 8 ? @tr("Meeting apps can pick RBS as a camera.")
                            : root.section == 9 ? @tr("Listening on this computer: the monitor's device and volume.")
                            : @tr("How RBS behaves on this computer.");
                    }
                    if root.section == 0: VideoSettings { }
                    if root.section == 1: RecordingSettings { }
                    if root.section == 2: StreamSettings { }
                    if root.section == 3: RemoteControlSettings { }
                    if root.section == 4: GeneralSettings { }
                    if root.section == 5: AppearanceSettings { }
                    if root.section == 6: ShortcutsSettings { }
                    if root.section == 7: GlobalSourcesSettings { }
                    if root.section == 8: VirtualCameraSettings { }
                    if root.section == 9: AudioSettings { }
                }
            }
        }
    }
    // The info hint and tooltip layer, drawn last (ADR-0094).
    OverlayHost { width: parent.width; height: parent.height; }
    property <int> scroll-serial: SettingsScroll.serial;
    changed scroll-serial => { root.show-revealed(); }
    function show-revealed() {
        if SettingsScroll.h <= 0px { return; }
        let margin = Tokens.space-4;
        let y = SettingsScroll.y - page.absolute-position.y;
        let h = SettingsScroll.h;
        flick.scroll-into-view(y - margin, h + 2 * margin);
    }
}
