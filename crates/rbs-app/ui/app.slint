// The RBS desktop shell. Layout geometry comes from the toolkit-neutral rbs-ui
// crate: Slint has no recursive components, so Rust flattens each window's
// layout tree into tab stacks and splitter handles with absolute positions.
import { Theme, Tokens } from "tokens.slint";
import { Button, IconButton, Icon, IconName, Icons, FocusRing, MenuItem as MenuRow, MenuSurface, EmptyState } from "components.slint";
import { SettingsNavItem, SettingsNavGroup, SettingsHeader } from "settings.slint";
import { Appearance, AppearanceSettings, ThemeOption, ThemeTokenRow } from "appearance.slint";
import { Shortcuts, ShortcutsSettings, ShortcutRow, ShortcutChip } from "shortcuts.slint";
import { Studio, EntryRow, SourceData, FilterData, FilterFieldData, MarkData, KindData, TargetData, MeterRow, ScaleMark, EncoderData, ProgramPanel, ScenesPanel, SourcesPanel, PropertiesPanel, MixerPanel, LiveControlsPanel, TransitionPanel, OutputsPanel, StatsPanel, RecordingSettings, StreamSettings, VideoSettings, RemoteControlSettings, GeneralSettings } from "studio.slint";

export { Theme, Tokens, Appearance, ThemeOption, ThemeTokenRow, Shortcuts, ShortcutRow, ShortcutChip, Studio, EntryRow, SourceData, FilterData, FilterFieldData, MarkData, KindData, TargetData, MeterRow, ScaleMark, EncoderData }

export struct TabData { id: string, title: string, known: bool, icon: string }
export struct StackData { window: int, stack: int, x: length, y: length, w: length, h: length, tabs: [TabData], active: int, collapsed: bool, can-collapse: bool, can-hide: bool }
export struct HandleData { window: int, index: int, x: length, y: length, w: length, h: length, horizontal: bool, percent: int }
export struct PanelEntry { id: string, title: string, open: bool }
export struct WorkspaceEntry { name: string, built-in: bool, current: bool }
// A toolbar item (ADR-0050). kind: 0 command, 1 the workspace picker, 2 separator,
// 3 flexible space, 4 an item this version cannot run (shown disabled).
export struct ToolbarData { id: string, title: string, kind: int, enabled: bool, checked: bool, live: bool, icon: string, icon-only: bool }
// An auto-hidden panel's edge tab (ADR-0049 decision 2); `size` is its flyout's
// width, or height on the bottom edge.
export struct EdgeTabData { id: string, title: string, icon: string, size: length }

// Edges, as passed to Shell.move-edge.
export global Edges {
    out property <int> left: 0;
    out property <int> right: 1;
    out property <int> top: 2;
    out property <int> bottom: 3;
}

// State and commands shared by every window. Slint globals are per window, so
// A rectangle in window coordinates.
export struct Cover {
    x: length,
    y: length,
    width: length,
    height: length,
}

// Rust pushes the same state into each window's copy.
// The menu bar's run-time values (menu_bar.rs): titles, enabled and checked states
// indexed in the generated items' order, and each choice submenu's choices.
export struct MenuChoice { title: string, id: string, checked: bool }
export global Menus {
    in property <[string]> titles;
    in property <[bool]> enabled;
    in property <[bool]> checked;
    in property <[[MenuChoice]]> choices;
    // Runs a command registry id (ADR-0050).
    callback run(string);
}

export global Shell {
    // 0 not live, 1 live, 2 recording, 3 live and recording.
    in property <int> live-state;
    in property <string> live-duration;
    in property <string> live-outputs;
    in property <[PanelEntry]> panels;
    in property <[WorkspaceEntry]> workspaces;
    in property <string> workspace-name;
    in property <bool> workspace-built-in;
    in property <bool> locked;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // 0 none, 1 "<subject> closed." (undo), 2 automatic switch from workspace <subject>.
    in property <int> toast-kind;
    in property <string> toast-subject;
    // 0 none, 1 layout locked, 2 other error with <error-detail>, 3 a notice whose
    // <error-detail> is the whole text (ADR-0055: a caught panic, an unclean last exit).
    in property <int> error-kind;
    in property <string> error-detail;
    // Where the bottom toast and the top error bar are while they show (the main
    // window's): the preview layer hides only while one overlaps the picture.
    in-out property <Cover> bottom-toast;
    in-out property <Cover> top-toast;
    // The main window was closed while a stream runs: the frame asks first (U4).
    in property <bool> quit-confirm;
    // The first Close to the background says once where RBS went (ADR-0056): 0 none,
    // 1 macOS (the Dock), 2 Windows (the notification area).
    in property <int> background-notice;
    callback background-notice-ok();
    // Cmd+W on macOS: Close, as the main window's close button (ADR-0056).
    callback close-main();
    callback quit-end-stream();
    callback quit-keep();
    // The toolbar's items, whether it is shown, and whether it has a flexible space.
    in property <[ToolbarData]> toolbar;
    in property <bool> toolbar-visible: true;
    in property <bool> toolbar-has-space;
    // End stream from the menu bar: the frame asks first (U4).
    in property <bool> end-stream-confirm;
    // The gap between panel cards and around them: the layout's divider thickness.
    in property <length> gap: 6px;
    // Edge tabs of auto-hidden panels on the left, right and bottom edges.
    in property <[EdgeTabData]> left-tabs;
    in property <[EdgeTabData]> right-tabs;
    in property <[EdgeTabData]> bottom-tabs;
    // Every edge tab's panel id, joined: changes when one is added, pinned or closed.
    in property <string> edge-ids;
    // The slid-out auto-hide panel's rectangle while one is out (the preview layer
    // leaves it out, ADR-0054).
    in-out property <bool> flyout-open;
    in-out property <Cover> flyout;
    callback end-stream-answer(bool /* end */);

    // Dragging a tab (ADR-0049 decision 5): the payload names the panel; the dock area
    // under the pointer reports moves and the drop in its own coordinates, and Rust
    // answers with the guide: the part of window <drop-window> the drop would fill.
    pure callback panel-data(string /* panel */) -> data-transfer;
    callback drag-over(int /* window */, data-transfer, length, length);
    callback drag-drop(int /* window */, data-transfer, length, length);
    callback drag-leave();
    // The maximized panel's id, or empty (ADR-0049 decision 2; not saved).
    in property <string> maximized;
    in property <int> drop-window: -1;
    in property <Cover> drop-guide;
    // The guide in window surface coordinates while it shows: the preview layer cuts it out.
    in-out property <bool> drop-open;
    in-out property <Cover> drop-cover;
    // A window's dock area: its position in the window and its size.
    callback relayout(int /* window */, length, length, length, length);
    callback collapse(string, bool /* collapsed */);
    callback auto-hide(string);
    callback pin(string);
    callback activate-tab(int /* window */, int /* stack */, int /* tab */);
    callback close-panel(string);
    callback toggle-panel(string);
    callback move-edge(string, int /* window */, int /* edge */);
    callback move-next-stack(string);
    callback float-panel(string);
    callback dock(int /* window */);
    // Wanted position of the handle along its axis, in the dock area.
    callback drag(int /* window */, int /* handle */, length);
    callback drag-end();
    callback nudge(int /* window */, int /* handle */, length);
    callback switch-workspace(string);
    callback save-workspace();
    callback save-workspace-as(string);
    callback restore-workspace();
    callback set-locked(bool);
    callback undo();
    callback redo();
    callback toast-undo();
    callback toast-dismiss();
    callback dismiss-error();
}

// Live indicator (rules U4, U21): state, duration and outputs in text, never colour alone.
component LiveIndicator inherits Rectangle {
    property <bool> active: Shell.live-state != 0;
    property <string> state-text: Shell.live-state == 1 ? @tr("Live")
        : Shell.live-state == 2 ? @tr("Recording")
        : Shell.live-state == 3 ? @tr("Live and recording")
        : @tr("Not live");
    property <string> full: active
        ? state-text + " " + Shell.live-duration + (Shell.live-outputs != "" ? " · " + Shell.live-outputs : "")
        : state-text;
    height: Tokens.size-control-md;
    width: content.preferred-width + 2 * Tokens.space-3;
    border-radius: Tokens.radius-sm;
    background: active ? Theme.state-live : transparent;
    border-width: active ? 0px : Tokens.size-border;
    border-color: Theme.border-strong;
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("Live status: {}", full);
    content := HorizontalLayout {
        alignment: center;
        spacing: Tokens.space-1;
        VerticalLayout {
            alignment: center;
            Icon {
                name: active ? IconName.dot : IconName.ring;
                ink: active ? Theme.text-on-live : Theme.text-secondary;
            }
        }
        Text {
            text: full;
            color: active ? Theme.text-on-live : Theme.text-secondary;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
        }
    }
}

// A panel's content: the panels connected to the studio, a placeholder for the others.
component PanelContent inherits Rectangle {
    in property <TabData> tab;
    property <bool> connected: tab.id == "rbs.program" || tab.id == "rbs.transition" || tab.id == "rbs.scenes" || tab.id == "rbs.sources" || tab.id == "rbs.properties" || tab.id == "rbs.mixer" || tab.id == "rbs.preview" || tab.id == "rbs.live-controls" || tab.id == "rbs.outputs" || tab.id == "rbs.stats";
    background: Theme.surface-raised;
    if tab.id == "rbs.program" || tab.id == "rbs.preview": ProgramPanel {
        width: parent.width;
        height: parent.height;
        panel: tab.id;
        title: tab.title;
    }
    if tab.id == "rbs.scenes": ScenesPanel {
        width: parent.width;
        height: parent.height;
        live-state: Shell.live-state;
    }
    if tab.id == "rbs.sources": SourcesPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.properties": PropertiesPanel {
        width: parent.width;
        height: parent.height;
        live-state: Shell.live-state;
    }
    if tab.id == "rbs.mixer": MixerPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.transition": TransitionPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.live-controls": LiveControlsPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.outputs": OutputsPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.stats": StatsPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.known && !connected: EmptyState {
        width: parent.width;
        height: parent.height;
        title: tab.title;
        message: @tr("Not connected to the engine yet.");
    }
    if !tab.known: EmptyState {
        width: parent.width;
        height: parent.height;
        title: tab.title;
        message: @tr("This panel comes from a plugin that is not installed. Close it from its tab menu.");
    }
}

component PanelMenu inherits PopupWindow {
    in property <string> panel;
    in property <string> title;
    in property <bool> floating;
    in property <bool> collapsed;
    in property <bool> can-collapse;
    in property <bool> can-hide;
    in property <int> window;
    MenuSurface {
        VerticalLayout {
            padding: Tokens.space-1;
            if can-collapse: MenuRow { text: collapsed ? @tr("Expand") : @tr("Collapse"); activated => { Shell.collapse(panel, !collapsed); root.close(); } }
            if can-hide: MenuRow { text: @tr("Auto-hide to the edge"); activated => { Shell.auto-hide(panel); root.close(); } }
            MenuRow {
                text: Shell.maximized == panel ? @tr("Restore layout") : @tr("Maximize {}", title);
                activated => { Menus.run("ui.panel.maximize?id=" + panel); root.close(); }
            }
            MenuRow { autofocus: true; text: @tr("Move to left edge"); activated => { Shell.move-edge(panel, window, Edges.left); root.close(); } }
            MenuRow { text: @tr("Move to right edge"); activated => { Shell.move-edge(panel, window, Edges.right); root.close(); } }
            MenuRow { text: @tr("Move to top edge"); activated => { Shell.move-edge(panel, window, Edges.top); root.close(); } }
            MenuRow { text: @tr("Move to bottom edge"); activated => { Shell.move-edge(panel, window, Edges.bottom); root.close(); } }
            MenuRow { text: @tr("Move to next tab stack"); activated => { Shell.move-next-stack(panel); root.close(); } }
            if !floating: MenuRow { text: @tr("Float in its own window"); activated => { Shell.float-panel(panel); root.close(); } }
            if floating: MenuRow { text: @tr("Dock back"); activated => { Shell.dock(window); root.close(); } }
            MenuRow { text: @tr("Close {}", title); activated => { Shell.close-panel(panel); root.close(); } }
        }
    }
}

// A tab in a panel header: its title, underlined in the accent colour while it is the
// shown one (no tab background, spec Frame).
component Tab inherits Rectangle {
    in property <TabData> tab;
    in property <bool> selected;
    callback activate();
    callback open-menu();
    callback close();
    // Double-click, or Shift+Escape (Escape alone stays with dialogs and fields).
    callback maximize();
    height: Tokens.size-control-lg;
    width: title.preferred-width + 2 * Tokens.space-2;
    accessible-role: AccessibleRole.tab;
    accessible-label: tab.title;
    accessible-item-selected: selected;
    accessible-description: @tr("Menu key or Shift+F10 opens panel actions; Delete or Backspace closes it; Shift+Escape maximizes or restores it");
    accessible-action-default => { activate(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { activate(); return accept; }
            if e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift) { open-menu(); return accept; }
            if e.text == Key.Delete || e.text == Key.Backspace { close(); return accept; }
            if e.text == Key.Escape && e.modifiers.shift { maximize(); return accept; }
            reject
        }
    }
    // The TouchArea comes after the FocusScope so it is on top: a FocusScope
    // under the pointer takes the press for itself (focus-on-click).
    // Dragging the tab moves the panel (ADR-0049 decision 5); a press without a drag
    // reaches the TouchArea inside as a click. Not while the layout is locked.
    drag := DragArea {
        allow-move: !Shell.locked;
        data: Shell.panel-data(tab.id);
        touch := TouchArea {
            clicked => { focus.focus(); activate(); }
            double-clicked => { maximize(); }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right { open-menu(); }
            }
        }
    }
    title := Text {
        x: Tokens.space-2;
        text: tab.title;
        color: selected || touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-size: Tokens.type-label-size;
        font-weight: selected ? Tokens.type-title-weight : Tokens.type-label-weight;
        vertical-alignment: center;
    }
    Rectangle {
        x: Tokens.space-1;
        width: parent.width - 2 * Tokens.space-1;
        y: parent.height - Tokens.size-focus-ring;
        height: Tokens.size-focus-ring;
        background: selected ? Theme.accent : transparent;
    }
    Rectangle {
        border-width: focus.has-focus ? Tokens.size-focus-ring : 0px;
        border-color: Theme.border-focus;
        border-radius: Tokens.radius-sm;
    }
}

// A panel card (spec Frame): a rounded card with a header of the stack's tabs and its
// actions (auto-hide, collapse, more), then the shown panel. Collapsed, only the
// header is drawn; in a horizontal split it is a strip as wide as the header is high.
component StackView inherits Rectangle {
    in property <StackData> data;
    in property <bool> floating;
    property <length> bar: Tokens.size-control-lg;
    property <bool> strip: data.collapsed && data.h > data.w;
    property <bool> has-tabs: data.tabs.length > 0;
    property <string> active-id: has-tabs ? data.tabs[data.active].id : "";
    property <string> active-title: has-tabs ? data.tabs[data.active].title : "";
    property <string> menu-panel;
    property <string> menu-title;
    background: Theme.surface-raised;
    border-color: Theme.border-subtle;
    border-width: Tokens.size-border;
    border-radius: Tokens.radius-md;
    clip: true;
    if !strip: Rectangle {
        x: Tokens.size-border;
        y: 0;
        width: parent.width - 2 * Tokens.size-border;
        height: bar;
        HorizontalLayout {
            padding-left: Tokens.space-1;
            padding-right: Tokens.space-1;
            Flickable {
                horizontal-stretch: 1;
                content-width: tabs.preferred-width;
                interactive: false;
                tabs := HorizontalLayout {
                    accessible-role: tab-list;
                    alignment: start;
                    for t[i] in data.tabs: Tab {
                        tab: t;
                        selected: i == data.active && !data.collapsed;
                        activate => {
                            if data.collapsed { Shell.collapse(t.id, false); }
                            Shell.activate-tab(data.window, data.stack, i);
                        }
                        close => { Shell.close-panel(t.id); }
                        maximize => { Menus.run("ui.panel.maximize?id=" + t.id); }
                        open-menu => {
                            menu-panel = t.id;
                            menu-title = t.title;
                            menu.show();
                        }
                    }
                }
            }
            if has-tabs: HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                padding-top: (bar - Tokens.size-control-sm) / 2;
                padding-bottom: (bar - Tokens.size-control-sm) / 2;
                // A panel's own action in its title row: Add source on Sources.
                if active-id == "rbs.scenes" && !data.collapsed: IconButton {
                    icon: IconName.plus;
                    name: @tr("Add scene");
                    enabled: Studio.state == 1;
                    clicked => { Studio.add-scene-asked += 1; }
                }
                if active-id == "rbs.sources" && !data.collapsed: IconButton {
                    icon: IconName.plus;
                    name: @tr("Add source");
                    enabled: Studio.state == 1;
                    clicked => { Studio.picker-kind = -1; Studio.add-source-asked += 1; }
                }
                // Picture panels: Maximize or Restore in the title row, as in design E.
                if (active-id == "rbs.preview" || active-id == "rbs.program") && !data.collapsed: IconButton {
                    icon: IconName.expand;
                    name: Shell.maximized == active-id ? @tr("Restore layout") : @tr("Maximize {}", active-title);
                    checked: Shell.maximized == active-id;
                    clicked => { Menus.run("ui.panel.maximize?id=" + active-id); }
                }
                if data.can-hide && Shell.maximized == "": IconButton {
                    icon: IconName.pin;
                    name: @tr("Auto-hide {}", active-title);
                    clicked => { Shell.auto-hide(active-id); }
                }
                if data.can-collapse && Shell.maximized == "": IconButton {
                    icon: data.collapsed ? IconName.chevron-right : IconName.chevron-down;
                    name: data.collapsed ? @tr("Expand {}", active-title) : @tr("Collapse {}", active-title);
                    accessible-expandable: true;
                    accessible-expanded: !data.collapsed;
                    clicked => { Shell.collapse(active-id, !data.collapsed); }
                }
                IconButton {
                    icon: IconName.more;
                    name: @tr("Actions for {}", active-title);
                    clicked => {
                        menu-panel = active-id;
                        menu-title = active-title;
                        menu.show();
                    }
                }
            }
        }
    }
    if !strip && !data.collapsed: Rectangle {
        x: Tokens.size-border;
        y: bar;
        width: parent.width - 2 * Tokens.size-border;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    // A collapsed stack in a horizontal split: its expand button and the tabs' icons,
    // named for screen readers (no rotated text).
    if strip: VerticalLayout {
        padding-top: (bar - Tokens.size-control-sm) / 2;
        padding-left: (parent.width - Tokens.size-control-sm) / 2;
        spacing: Tokens.space-2;
        alignment: start;
        accessible-role: groupbox;
        accessible-label: active-title;
        IconButton {
            icon: IconName.chevron-right;
            name: @tr("Expand {}", active-title);
            accessible-expandable: true;
            accessible-expanded: false;
            clicked => { Shell.collapse(active-id, false); }
        }
        for t[i] in data.tabs: IconButton {
            icon: Icons.named(t.icon);
            name: t.title;
            clicked => {
                Shell.collapse(t.id, false);
                Shell.activate-tab(data.window, data.stack, i);
            }
        }
    }
    if has-tabs && !data.collapsed: PanelContent {
        x: Tokens.size-border;
        y: bar + Tokens.size-border;
        width: parent.width - 2 * Tokens.size-border;
        height: max(0px, parent.height - bar - 2 * Tokens.size-border);
        tab: data.tabs[data.active];
    }
    menu := PanelMenu {
        x: Tokens.space-2;
        y: bar;
        panel: menu-panel;
        title: menu-title;
        floating: root.floating;
        collapsed: data.collapsed;
        can-collapse: data.can-collapse;
        can-hide: data.can-hide;
        window: data.window;
    }
}

// Splitter between two cards: the gap itself, shown in the accent colour while hovered,
// dragged or focused. Drag with the pointer, or focus it and use the arrow keys.
component Splitter inherits Rectangle {
    in property <HandleData> data;
    background: focus.has-focus || touch.has-hover || touch.pressed ? Theme.accent : transparent;
    border-radius: Tokens.radius-sm;
    accessible-role: slider;
    accessible-label: data.horizontal ? @tr("Resize panes left and right") : @tr("Resize panes up and down");
    accessible-value: data.percent;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if (data.horizontal && e.text == Key.LeftArrow) || (!data.horizontal && e.text == Key.UpArrow) {
                Shell.nudge(data.window, data.index, e.modifiers.shift ? -Tokens.step-nudge-large : -Tokens.step-nudge);
                return accept;
            }
            if (data.horizontal && e.text == Key.RightArrow) || (!data.horizontal && e.text == Key.DownArrow) {
                Shell.nudge(data.window, data.index, e.modifiers.shift ? Tokens.step-nudge-large : Tokens.step-nudge);
                return accept;
            }
            reject
        }
    }
    // The TouchArea comes after the FocusScope so it is on top: a FocusScope
    // under the pointer takes the press for itself (focus-on-click).
    touch := TouchArea {
        mouse-cursor: data.horizontal ? ew-resize : ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { focus.focus(); }
            if e.kind == PointerEventKind.up { Shell.drag-end(); }
        }
        moved => {
            // The handle's wanted position in the dock area: idempotent however many
            // move events arrive before the layout catches up.
            Shell.drag(data.window, data.index, data.horizontal ? data.x + self.mouse-x - self.pressed-x : data.y + self.mouse-y - self.pressed-y);
        }
    }
}

// A window's panel cards and dividers. It tells Rust where it is in the window (the
// preview layer is placed from that) and how big it is (the layout is flattened to it).
component DockArea inherits Rectangle {
    in property <int> window;
    in property <[StackData]> stacks;
    in property <[HandleData]> handles;
    in property <bool> floating;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    changed window => { report(); }
    changed width => { report(); }
    changed height => { report(); }
    changed ax => { report(); }
    changed ay => { report(); }
    init => { report(); }
    function report() {
        Shell.relayout(window, ax, ay, self.width, self.height);
    }
    // Under the stacks: the stacks' own items ignore drag events, so every drag over
    // the dock area reaches it.
    drop := DropArea {
        can-drop(e) => {
            Shell.drag-over(root.window, e.data, e.position.x, e.position.y);
            return DragAction.move;
        }
        dropped(e) => {
            Shell.drag-drop(root.window, e.data, e.position.x, e.position.y);
            return DragAction.move;
        }
        changed has-drag => {
            if !self.has-drag { Shell.drag-leave(); }
        }
    }
    for s in stacks: StackView {
        x: s.x;
        y: s.y;
        width: s.w;
        height: s.h;
        data: s;
        floating: root.floating;
    }
    for h in handles: Splitter {
        x: h.x;
        y: h.y;
        width: h.w;
        height: h.h;
        data: h;
    }
    // The drop guide: the part of the window the drop would fill.
    if drop.has-drag && Shell.drop-window == root.window && Shell.drop-guide.width > 0: Rectangle {
        x: Shell.drop-guide.x;
        y: Shell.drop-guide.y;
        width: Shell.drop-guide.width;
        height: Shell.drop-guide.height;
        property <Cover> rect: { x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height };
        init => { Shell.drop-cover = rect; Shell.drop-open = true; }
        changed rect => { Shell.drop-cover = rect; }
        background: Theme.accent-subtle.with-alpha(0.6);
        border-radius: Tokens.radius-md;
        border-width: Tokens.size-focus-ring;
        border-color: Theme.accent;
    }
}

// One edge tab of an auto-hidden panel (ADR-0049 decision 2): its icon and title, the
// title turned to run along a left or right edge. Clicking it, or Enter or Space,
// slides the panel out or back.
component EdgeTab inherits Rectangle {
    in property <EdgeTabData> data;
    in property <bool> vertical;
    in property <bool> open;
    callback toggle();
    property <length> along: label.preferred-width + Tokens.size-icon-box + 2 * Tokens.space-2 + Tokens.space-1;
    width: vertical ? Tokens.size-control-md : along;
    height: vertical ? along : Tokens.size-control-md;
    border-radius: Tokens.radius-md;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    background: open ? Theme.accent-subtle : touch.has-hover ? Theme.surface-overlay : Theme.surface-raised;
    accessible-role: AccessibleRole.tab;
    accessible-label: data.title;
    accessible-expandable: true;
    accessible-expanded: open;
    accessible-action-default => { toggle(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { toggle(); return accept; }
            reject
        }
    }
    touch := TouchArea { clicked => { focus.focus(); toggle(); } }
    Icon {
        x: vertical ? (parent.width - self.width) / 2 : Tokens.space-2;
        y: vertical ? Tokens.space-2 : (parent.height - self.height) / 2;
        name: Icons.named(data.icon);
        ink: open ? Theme.text-primary : Theme.text-secondary;
    }
    label := Text {
        // Laid out unturned, then turned about its centre.
        width: self.preferred-width;
        height: self.preferred-height;
        x: vertical ? (parent.width - self.width) / 2 : Tokens.size-icon-box + Tokens.space-2 + Tokens.space-1;
        y: vertical ? Tokens.size-icon-box + Tokens.space-2 + Tokens.space-1 + (self.width - self.height) / 2 : (parent.height - self.height) / 2;
        transform-rotation: vertical ? 90deg : 0deg;
        text: data.title;
        color: open || touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        font-weight: Tokens.type-label-weight;
    }
    FocusRing { show: focus.has-focus; border-radius: Tokens.radius-md; }
}

// The edge tabs on one edge. `open-id` is the slid-out panel, if it is on this edge.
component EdgeStrip inherits Rectangle {
    in property <[EdgeTabData]> tabs;
    in property <bool> vertical;
    in property <string> open-id;
    callback toggle(EdgeTabData);
    // Fixed across its edge, free along it.
    min-width: vertical ? Tokens.size-control-md : 0px;
    max-width: vertical ? Tokens.size-control-md : 100000px;
    min-height: vertical ? 0px : Tokens.size-control-md;
    max-height: vertical ? 100000px : Tokens.size-control-md;
    accessible-role: tab-list;
    if vertical: VerticalLayout {
        spacing: Tokens.space-1;
        alignment: start;
        for t in tabs: EdgeTab {
            data: t;
            vertical: true;
            open: t.id == open-id;
            toggle => { root.toggle(t); }
        }
    }
    if !vertical: HorizontalLayout {
        spacing: Tokens.space-1;
        alignment: start;
        for t in tabs: EdgeTab {
            data: t;
            vertical: false;
            open: t.id == open-id;
            toggle => { root.toggle(t); }
        }
    }
}

// A slid-out auto-hide panel: a card over the dock area along its edge, with Pin and
// Hide. Escape slides it back. A direct child of the window, so it reports its own
// rectangle for the preview layer (ADR-0054).
component Flyout inherits Rectangle {
    in property <EdgeTabData> data;
    callback hide();
    // In window surface coordinates, as the preview layer is placed.
    property <Cover> rect: { x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height };
    init => { Shell.flyout = rect; Shell.flyout-open = true; focus.focus(); }
    changed rect => { Shell.flyout = rect; }
    background: Theme.surface-raised;
    border-color: Theme.border-strong;
    border-width: Tokens.size-border;
    border-radius: Tokens.radius-md;
    clip: true;
    accessible-role: groupbox;
    accessible-label: data.title;
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.hide(); return accept; }
            reject
        }
        VerticalLayout {
            Rectangle {
                height: Tokens.size-control-lg;
                HorizontalLayout {
                    padding-left: Tokens.space-3;
                    padding-right: Tokens.space-1;
                    spacing: Tokens.space-1;
                    Text {
                        text: data.title;
                        color: Theme.text-primary;
                        font-size: Tokens.type-label-size;
                        font-weight: Tokens.type-title-weight;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: IconName.pin;
                            name: @tr("Pin {}", data.title);
                            clicked => { Shell.pin(data.id); root.hide(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: IconName.close;
                            name: @tr("Hide {}", data.title);
                            clicked => { root.hide(); }
                        }
                    }
                }
            }
            Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
            PanelContent { tab: { id: data.id, title: data.title, known: true, icon: data.icon }; }
        }
    }
}

component WorkspaceMenu inherits PopupWindow {
    close-policy: close-on-click-outside;
    width: Tokens.size-menu-md;
    MenuSurface {
        width: Tokens.size-menu-md;
        VerticalLayout {
            padding: Tokens.space-2;
            spacing: Tokens.space-1;
            for w[i] in Shell.workspaces: MenuRow {
                autofocus: i == 0;
                text: w.name;
                checked: w.current;
                activated => { Shell.switch-workspace(w.name); root.close(); }
            }
            Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
            MenuRow { text: @tr("Save changes to {}", Shell.workspace-name); activated => { Shell.save-workspace(); root.close(); } }
            MenuRow {
                text: @tr("Restore default of {}", Shell.workspace-name);
                enabled: Shell.workspace-built-in;
                activated => { Shell.restore-workspace(); root.close(); }
            }
            MenuRow {
                text: Shell.locked ? @tr("Unlock layout") : @tr("Lock layout");
                checked: Shell.locked;
                activated => { Shell.set-locked(!Shell.locked); root.close(); }
            }
            MenuRow { text: @tr("Undo layout change"); enabled: Shell.can-undo; activated => { Shell.undo(); root.close(); } }
            MenuRow { text: @tr("Redo layout change"); enabled: Shell.can-redo; activated => { Shell.redo(); root.close(); } }
            Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
            HorizontalLayout {
                spacing: Tokens.space-2;
                Rectangle {
                    border-width: Tokens.size-border;
                    border-radius: Tokens.radius-sm;
                    border-color: name.has-focus ? Theme.border-focus : Theme.border-strong;
                    background: Theme.surface-sunken;
                    height: Tokens.size-control-md;
                    name := TextInput {
                        // Visible caret: see TextField.
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.text-inverse;
                        text-cursor-width: Tokens.size-focus-ring;
                        x: Tokens.space-2;
                        width: parent.width - 2 * Tokens.space-2;
                        color: Theme.text-primary;
                        font-size: Tokens.type-body-size;
                        vertical-alignment: center;
                        accessible-label: @tr("New workspace name");
                        accepted => { if self.text != "" { Shell.save-workspace-as(self.text); root.close(); } }
                    }
                }
                Button {
                    text: @tr("Save as new");
                    enabled: name.text != "";
                    clicked => { Shell.save-workspace-as(name.text); root.close(); }
                }
            }
        }
    }
}

// The Output profile and Scene collection menus (ADR-0051): the entries to switch to,
// then New, Duplicate and Rename with the name typed below, and Delete, which asks
// first (U4) because it cannot be undone here.
component EntryMenu inherits PopupWindow {
    in property <[EntryRow]> entries;
    in property <string> current;
    // "output profile" or "scene collection", for labels.
    in property <string> what;
    in property <bool> busy;
    callback pick(string /* id */);
    // 0 new, 1 duplicate, 2 rename (with the name typed), 3 delete the one in use,
    // 4 import from a file, 5 export the one in use to a file.
    callback act(int, string);
    property <bool> confirm-delete;
    close-policy: close-on-click-outside;
    width: Tokens.size-menu-md;
    MenuSurface {
        width: Tokens.size-menu-md;
        VerticalLayout {
            padding: Tokens.space-2;
            spacing: Tokens.space-1;
            for e[i] in root.entries: MenuRow {
                autofocus: i == 0;
                text: e.name;
                checked: e.current;
                enabled: !root.busy;
                activated => { root.pick(e.id); root.close(); }
            }
            Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
            MenuRow {
                text: @tr("Import…");
                activated => { root.act(4, ""); root.close(); }
            }
            MenuRow {
                text: @tr("Export {}…", root.current);
                activated => { root.act(5, ""); root.close(); }
            }
            if !root.confirm-delete: MenuRow {
                text: @tr("Delete {}…", root.current);
                enabled: root.entries.length > 1 && !root.busy;
                activated => { root.confirm-delete = true; }
            }
            if root.confirm-delete: HorizontalLayout {
                spacing: Tokens.space-2;
                accessible-role: groupbox;
                accessible-label: @tr("Delete {}?", root.current);
                Text {
                    text: @tr("Delete {}?", root.current);
                    color: Theme.text-primary;
                    font-size: Tokens.type-body-size;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                Button {
                    text: @tr("Delete");
                    clicked => { root.act(3, ""); root.confirm-delete = false; root.close(); }
                }
                Button {
                    text: @tr("Keep");
                    clicked => { root.confirm-delete = false; }
                }
            }
            Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
            Rectangle {
                border-width: Tokens.size-border;
                border-radius: Tokens.radius-sm;
                border-color: name.has-focus ? Theme.border-focus : Theme.border-strong;
                background: Theme.surface-sunken;
                height: Tokens.size-control-md;
                name := TextInput {
                    // Visible caret: see TextField.
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.text-inverse;
                    text-cursor-width: Tokens.size-focus-ring;
                    x: Tokens.space-2;
                    width: parent.width - 2 * Tokens.space-2;
                    color: Theme.text-primary;
                    font-size: Tokens.type-body-size;
                    vertical-alignment: center;
                    accessible-label: @tr("Name for a new or renamed {}", root.what);
                    accepted => { if self.text != "" && !root.busy { root.act(0, self.text); root.close(); } }
                }
            }
            HorizontalLayout {
                spacing: Tokens.space-2;
                Button {
                    text: @tr("New");
                    enabled: name.text != "" && !root.busy;
                    clicked => { root.act(0, name.text); root.close(); }
                }
                Button {
                    text: @tr("Duplicate");
                    enabled: name.text != "" && !root.busy;
                    clicked => { root.act(1, name.text); root.close(); }
                }
                Button {
                    text: @tr("Rename");
                    enabled: name.text != "";
                    clicked => { root.act(2, name.text); root.close(); }
                }
            }
        }
    }
}

// End stream picked in the menu bar asks first (U4), in the frame of the window
// whose menu it was picked from; Keep streaming has the focus.
component EndStreamConfirm inherits HorizontalLayout {
    horizontal-stretch: 0;
    spacing: Tokens.space-2;
    accessible-role: groupbox;
    accessible-label: @tr("End the stream?");
    init => { keep-stream.focus(); }
    Text {
        text: @tr("End the stream? Viewers see it end.");
        color: Theme.text-primary;
        font-size: Tokens.type-body-size;
        vertical-alignment: center;
    }
    Button {
        text: @tr("Yes, end the stream");
        kind: "live";
        clicked => { Shell.end-stream-answer(true); }
    }
    keep-stream := Button {
        text: @tr("Keep streaming");
        clicked => { Shell.end-stream-answer(false); }
    }
}

// The workspace picker in the toolbar: "Workspace" and the current one's name.
component WorkspacePicker inherits Rectangle {
    callback clicked();
    height: Tokens.size-control-md;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Tokens.radius-sm;
    background: touch.has-hover ? Theme.surface-overlay : Theme.surface-raised;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    accessible-role: button;
    accessible-label: @tr("Workspace: {}", Shell.workspace-name);
    accessible-action-default => { clicked(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    touch := TouchArea { clicked => { focus.focus(); root.clicked(); } }
    row := HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;
        Text {
            text: @tr("Workspace");
            color: Theme.text-secondary;
            font-size: Tokens.type-label-size;
            vertical-alignment: center;
        }
        Text {
            text: Shell.workspace-name;
            color: Theme.text-primary;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon { name: IconName.chevron-down; ink: Theme.text-secondary; }
        }
    }
    FocusRing { show: focus.has-focus; }
}

// One toolbar item: a command button with its icon (a toggle that is on is tinted;
// one that stops a live output is in the live colour, U12), the workspace picker, a
// separator or the flexible space. Go live is the one primary button.
component ToolbarCell inherits HorizontalLayout {
    in property <ToolbarData> item;
    // The workspace picker was clicked, at this window x.
    callback open-workspaces(length);
    property <bool> go-live: item.id == "stream.toggle" && !item.live;
    property <bool> record: item.id == "record.toggle" && !item.live;
    horizontal-stretch: item.kind == 3 ? 1 : 0;
    if (item.kind == 0 || item.kind == 4) && item.icon-only: Button {
        width: Tokens.size-control-lg;
        accessible-name: item.title;
        lead: Icons.named(item.icon);
        lead-ink: item.checked ? Theme.text-primary : Theme.text-secondary;
        kind: "ghost";
        enabled: item.enabled;
        checked: item.checked;
        clicked => { Menus.run(item.id); }
    }
    if (item.kind == 0 || item.kind == 4) && !item.icon-only: Button {
        text: item.title;
        lead: Icons.named(item.icon);
        // Checked means recording, and then the button itself is in the live colour.
        lead-ink: record && !item.checked ? Theme.state-live : self.ink;
        enabled: item.enabled;
        checked: item.checked && !item.live;
        kind: item.live ? "live" : go-live ? "primary" : record ? "secondary" : "ghost";
        clicked => { Menus.run(item.id); }
    }
    if item.kind == 1: WorkspacePicker {
        clicked => { root.open-workspaces(self.absolute-position.x); }
    }
    if item.kind == 2: VerticalLayout {
        padding-top: Tokens.space-1;
        padding-bottom: Tokens.space-1;
        Rectangle {
            width: Tokens.size-border;
            background: Theme.border-subtle;
        }
    }
    // The flexible space: an empty layout cannot grow, a rectangle can.
    if item.kind == 3: Rectangle { }
}

// The window frame's toolbar row (ADR-0049, ADR-0050): the workspace's toolbar items
// and, at its right end, the live indicator (U4, U21). It stays in every workspace,
// even with every panel closed.
component FrameBar inherits Rectangle {
    // Where the workspace menu opens: under the toolbar's Workspace item.
    property <length> ws-menu-x;
    height: Tokens.size-control-md + 2 * Tokens.space-1 + Tokens.size-border;
    background: Theme.surface-base;
    Rectangle {
        y: parent.height - Tokens.size-border;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    HorizontalLayout {
        height: parent.height - Tokens.size-border;
        y: 0;
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        padding-top: Tokens.space-1;
        padding-bottom: Tokens.space-1;
        spacing: Tokens.space-2;
        // The workspace's toolbar items (ADR-0050); hidden, the row stays with the
        // live indicator at its right end.
        for item in Shell.toolbar-visible ? Shell.toolbar : []: ToolbarCell {
            item: item;
            open-workspaces(x) => {
                root.ws-menu-x = x - root.absolute-position.x;
                ws-menu.show();
            }
        }
        // Closing while live ends the stream: asked first, in the frame (U4).
        if Shell.quit-confirm: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Tokens.space-2;
            accessible-role: groupbox;
            accessible-label: @tr("End the stream and quit?");
            init => { keep-live.focus(); }
            Text {
                text: @tr("End the stream and quit?");
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
            }
            Button {
                text: @tr("End stream and quit");
                kind: "live";
                clicked => { Shell.quit-end-stream(); }
            }
            keep-live := Button {
                text: @tr("Keep streaming");
                clicked => { Shell.quit-keep(); }
            }
        }
        // End stream from the menu bar asks first, in the frame (U4).
        if Shell.end-stream-confirm && !Shell.quit-confirm: EndStreamConfirm { }
        // Network access (ADR-0046 decision 7): shown in every workspace while other
        // computers can connect, in words.
        if Studio.rc-network-on: Text {
            horizontal-stretch: 0;
            text: @tr("Reachable from other computers");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
            accessible-label: @tr("Remote control: reachable from other computers");
        }
        if Shell.locked: Text {
            horizontal-stretch: 0;
            text: @tr("Layout locked");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
        // Takes the free width unless the toolbar has its own flexible space.
        Rectangle {
            horizontal-stretch: Shell.toolbar-visible && Shell.toolbar-has-space ? 0 : 1;
        }
        // Live indicator (U4, U21): the right end of this row in every workspace.
        LiveIndicator { horizontal-stretch: 0; }
    }
    ws-menu := WorkspaceMenu {
        x: root.ws-menu-x;
        y: parent.height;
    }
}

// A status bar item that opens a menu: "<label> <value>".
component StatusPicker inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Tokens.radius-sm;
    background: touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: button;
    accessible-label: @tr("{}: {}", label, value);
    accessible-action-default => { clicked(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    touch := TouchArea { clicked => { focus.focus(); root.clicked(); } }
    row := HorizontalLayout {
        padding-left: Tokens.space-1;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-1;
        Text {
            text: label;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
        Text {
            text: value;
            color: Theme.text-primary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
    }
    FocusRing { show: focus.has-focus; }
}

// The status bar (spec Frame): live and recording state in words, the Output profile
// and Scene collection in use (each opens its menu), and the canvas. It shows values
// the app already has; it polls nothing (P13).
component StatusBar inherits Rectangle {
    property <string> state-text: Shell.live-state == 1 ? @tr("Live {} · not recording", Shell.live-duration)
        : Shell.live-state == 2 ? @tr("Not live · recording {}", Shell.live-duration)
        : Shell.live-state == 3 ? @tr("Live and recording {}", Shell.live-duration)
        : @tr("Not live · not recording");
    height: Tokens.size-control-sm + 2 * Tokens.size-border;
    background: Theme.surface-sunken;
    Rectangle {
        y: 0;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-3;
        padding-top: Tokens.size-border;
        spacing: Tokens.space-4;
        Text {
            horizontal-stretch: 0;
            text: state-text;
            color: Shell.live-state != 0 ? Theme.text-primary : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
        if Studio.st-text != "": Text {
            horizontal-stretch: 0;
            text: Studio.st-text;
            color: Studio.st-bad ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        profile-button := StatusPicker {
            label: @tr("Output profile");
            value: Studio.profile-name;
            clicked => { profile-menu.show(); }
        }
        collection-button := StatusPicker {
            label: @tr("Scene collection");
            value: Studio.collection-name;
            clicked => { collection-menu.show(); }
        }
        if Studio.canvas-sizes.length > Studio.canvas-size && Studio.canvas-size >= 0: Text {
            horizontal-stretch: 0;
            text: Studio.canvas-rates.length > Studio.canvas-rate && Studio.canvas-rate >= 0
                ? @tr("{} · {} fps", Studio.canvas-sizes[Studio.canvas-size], Studio.canvas-rates[Studio.canvas-rate])
                : Studio.canvas-sizes[Studio.canvas-size];
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
    }
    // The menus open upwards, over the dock area.
    profile-menu := EntryMenu {
        x: min(profile-button.x, root.width - Tokens.size-menu-md);
        y: -self.height;
        entries: Studio.profiles;
        current: Studio.profile-name;
        what: @tr("output profile");
        pick(id) => { Studio.switch-profile(id); }
        act(a, text) => { Studio.profile-action(a, text); }
    }
    collection-menu := EntryMenu {
        x: min(collection-button.x, root.width - Tokens.size-menu-md);
        y: -self.height;
        entries: Studio.collections;
        current: Studio.collection-name;
        what: @tr("scene collection");
        busy: Studio.switching;
        pick(id) => { Studio.switch-collection(id); }
        act(a, text) => { Studio.collection-action(a, text); }
    }
}

component Toast inherits Rectangle {
    in property <string> text;
    in property <string> action;
    // Reports its rectangle as `Shell.top-toast` (the error bar) instead of
    // `Shell.bottom-toast`.
    in property <bool> top;
    callback act();
    callback dismiss();
    // A direct child of the window, so its own coordinates are the window's.
    property <Cover> rect: { x: self.x, y: self.y, width: self.width, height: self.height };
    init => { report(); }
    changed rect => { report(); }
    function report() {
        if top { Shell.top-toast = rect; } else { Shell.bottom-toast = rect; }
    }
    height: Tokens.size-control-lg + 2 * Tokens.space-2;
    width: row.preferred-width;
    background: Theme.surface-overlay;
    border-color: Theme.border-strong;
    border-width: Tokens.size-border;
    border-radius: Tokens.radius-md;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    row := HorizontalLayout {
        padding: Tokens.space-2;
        padding-left: Tokens.space-3;
        spacing: Tokens.space-3;
        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
        }
        if action != "": Button { text: root.action; kind: "primary"; clicked => { act(); } }
        Button { text: @tr("Dismiss"); kind: "ghost"; clicked => { dismiss(); } }
    }
}

export component MainWindow inherits Window {
    default-font-family: Theme.font-family;
    title: @tr("RBS");
    preferred-width: Tokens.size-window-w;
    preferred-height: Tokens.size-window-h;
    min-width: Tokens.size-window-min-w;
    min-height: Tokens.size-window-min-h;
    background: Theme.surface-sunken;
    default-font-size: Tokens.type-body-size;
    in property <[StackData]> stacks;
    in property <[HandleData]> handles;
    forward-focus: edit-keys;
    // BEGIN generated menu bar (menu_bar.rs; do not edit)
    MenuBar {
        Menu {
            title: @tr("File");
            Menu {
                title: Menus.titles[0];
                enabled: Menus.enabled[0];
                for c in Menus.choices[0]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[1];
                enabled: Menus.enabled[1];
                for c in Menus.choices[1]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[2]; enabled: Menus.enabled[2]; activated => { Menus.run("ui.settings.open"); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: Menus.titles[3]; enabled: Menus.enabled[3]; activated => { Menus.run("edit.undo"); } }
            MenuItem { title: Menus.titles[4]; enabled: Menus.enabled[4]; activated => { Menus.run("edit.redo"); } }
        }
        Menu {
            title: @tr("View");
            Menu {
                title: Menus.titles[5];
                enabled: Menus.enabled[5];
                for c in Menus.choices[2]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[6]; enabled: Menus.enabled[6]; checkable: true; checked: Menus.checked[6]; activated => { Menus.run("ui.area.toggle?area=left"); } }
            MenuItem { title: Menus.titles[7]; enabled: Menus.enabled[7]; checkable: true; checked: Menus.checked[7]; activated => { Menus.run("ui.area.toggle?area=right"); } }
            MenuItem { title: Menus.titles[8]; enabled: Menus.enabled[8]; checkable: true; checked: Menus.checked[8]; activated => { Menus.run("ui.area.toggle?area=bottom"); } }
            MenuItem { title: Menus.titles[9]; enabled: Menus.enabled[9]; activated => { Menus.run("ui.area.hide_all"); } }
            MenuItem { title: Menus.titles[10]; enabled: Menus.enabled[10]; activated => { Menus.run("ui.area.show_all"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[11]; enabled: Menus.enabled[11]; activated => { Menus.run("ui.layout.reset_sizes"); } }
            MenuItem { title: Menus.titles[12]; enabled: Menus.enabled[12]; activated => { Menus.run("ui.toolbar.reset"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[13]; enabled: Menus.enabled[13]; activated => { Menus.run("ui.theme.reload"); } }
        }
        Menu {
            title: @tr("Scene");
            Menu {
                title: Menus.titles[14];
                enabled: Menus.enabled[14];
                for c in Menus.choices[3]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[15]; enabled: Menus.enabled[15]; activated => { Menus.run("scene.previous"); } }
            MenuItem { title: Menus.titles[16]; enabled: Menus.enabled[16]; activated => { Menus.run("scene.next"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[17]; enabled: Menus.enabled[17]; checkable: true; checked: Menus.checked[17]; activated => { Menus.run("canvas.studio_mode.toggle"); } }
            MenuItem { title: Menus.titles[18]; enabled: Menus.enabled[18]; activated => { Menus.run("canvas.transition"); } }
        }
        Menu {
            title: @tr("Source");
            Menu {
                title: Menus.titles[19];
                enabled: Menus.enabled[19];
                for c in Menus.choices[4]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
        }
        Menu {
            title: @tr("Output");
            MenuItem { title: Menus.titles[20]; enabled: Menus.enabled[20]; checkable: true; checked: Menus.checked[20]; activated => { Menus.run("stream.toggle"); } }
            MenuItem { title: Menus.titles[21]; enabled: Menus.enabled[21]; checkable: true; checked: Menus.checked[21]; activated => { Menus.run("record.toggle"); } }
        }
        Menu {
            title: @tr("Window");
            Menu {
                title: Menus.titles[22];
                enabled: Menus.enabled[22];
                for c in Menus.choices[5]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[23]; enabled: Menus.enabled[23]; checkable: true; checked: Menus.checked[23]; activated => { Menus.run("ui.panel.maximize?id=rbs.preview"); } }
        }
    }
    // END generated menu bar
    // Shortcuts (ADR-0060): keys a focused control does not take come up here, and a
    // click where no control takes it focuses this scope, so they work from any panel
    // of this window. Text fields keep their own editing keys. No KeyBinding here: a
    // KeyBinding accepts its keys even when it does nothing.
    edit-keys := FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            // Cmd+W closes the main window on macOS, as its close button does
            // (ADR-0056); reserved there, free on Windows.
            if Studio.platform == 0 && e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt && !e.modifiers.meta && (e.text == "w" || e.text == "W") {
                Shell.close-main();
                return accept;
            }
            if Shortcuts.press(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, e.repeat) { return accept; }
            reject
        }
        VerticalLayout {
            frame := FrameBar { }
            HorizontalLayout {
                padding: Shell.gap;
                spacing: Shell.gap;
                if Shell.left-tabs.length > 0: EdgeStrip {
                    tabs: Shell.left-tabs;
                    vertical: true;
                    open-id: root.flyout-edge == 0 ? root.flyout-tab.id : "";
                    toggle(t) => { root.toggle-flyout(0, t); }
                }
                VerticalLayout {
                    spacing: Shell.gap;
                    dock := DockArea {
                        window: 0;
                        stacks: root.stacks;
                        handles: root.handles;
                    }
                    if Shell.bottom-tabs.length > 0: EdgeStrip {
                        tabs: Shell.bottom-tabs;
                        vertical: false;
                        open-id: root.flyout-edge == 2 ? root.flyout-tab.id : "";
                        toggle(t) => { root.toggle-flyout(2, t); }
                    }
                }
                if Shell.right-tabs.length > 0: EdgeStrip {
                    tabs: Shell.right-tabs;
                    vertical: true;
                    open-id: root.flyout-edge == 1 ? root.flyout-tab.id : "";
                    toggle(t) => { root.toggle-flyout(1, t); }
                }
            }
            StatusBar { }
        }
    }
    // The slid-out auto-hide panel, over the dock area along its edge (0 left, 1 right,
    // 2 bottom; -1 none). Sliding out and back is not a layout change (ADR-0049).
    property <int> flyout-edge: -1;
    property <EdgeTabData> flyout-tab;
    function toggle-flyout(edge: int, t: EdgeTabData) {
        if flyout-edge == edge && flyout-tab.id == t.id {
            hide-flyout();
        } else {
            flyout-tab = t;
            flyout-edge = edge;
        }
    }
    function hide-flyout() {
        flyout-edge = -1;
        Shell.flyout-open = false;
    }
    // Pinning, closing or adding an auto-hidden panel slides the flyout back.
    property <string> edge-ids: Shell.edge-ids;
    changed edge-ids => { hide-flyout(); }
    if flyout-edge >= 0: Flyout {
        property <length> size: min(flyout-tab.size, flyout-edge == 2 ? dock.height : dock.width);
        // The dock area's place in the window, from the layout around it.
        property <length> dock-x: Shell.gap + (Shell.left-tabs.length > 0 ? Tokens.size-control-md + Shell.gap : 0px);
        property <length> dock-y: frame.height + Shell.gap;
        x: flyout-edge == 1 ? dock-x + dock.width - size : dock-x;
        y: flyout-edge == 2 ? dock-y + dock.height - size : dock-y;
        width: flyout-edge == 2 ? dock.width : size;
        height: flyout-edge == 2 ? size : dock.height;
        data: flyout-tab;
        hide => { root.hide-flyout(); }
    }
    if Shell.toast-kind != 0: Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Tokens.space-6;
        text: Shell.toast-kind == 1 ? @tr("{} closed.", Shell.toast-subject) : @tr("Switched workspace automatically from {}.", Shell.toast-subject);
        action: @tr("Undo");
        act => { Shell.toast-undo(); }
        dismiss => { Shell.toast-dismiss(); }
    }
    if Studio.deleted != "" && Shell.toast-kind == 0: Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Tokens.space-6;
        text: @tr("{} deleted.", Studio.deleted);
        action: @tr("Undo");
        act => { Studio.undo-delete(); }
        dismiss => { Studio.dismiss-deleted(); }
    }
    // The first Close with Keep RBS running says once where RBS goes, in the error
    // bar's place over the window (ADR-0056); OK (or Dismiss) hides the windows.
    if Shell.background-notice != 0: Toast {
        x: (parent.width - self.width) / 2;
        y: frame.height + Tokens.space-2;
        top: true;
        text: Shell.background-notice == 1 ? @tr("RBS keeps running in the Dock. Quit with Cmd+Q.")
            : @tr("RBS keeps running in the notification area (under the ^ arrow until you pin it). Quit it from the RBS icon there.");
        action: @tr("OK");
        act => { Shell.background-notice-ok(); }
        dismiss => { Shell.background-notice-ok(); }
    }
    if Shell.error-kind != 0 && Shell.background-notice == 0: Toast {
        x: (parent.width - self.width) / 2;
        y: frame.height + Tokens.space-2;
        top: true;
        text: Shell.error-kind == 1 ? @tr("The layout is locked. Unlock it from the workspace menu.")
            : Shell.error-kind == 3 ? Shell.error-detail
            : @tr("That did not work: {}", Shell.error-detail);
        action: "";
        dismiss => { Shell.dismiss-error(); }
    }
}

// A floating panel window. Its title names its panels for screen readers and F6-style switching.
export component FloatWindow inherits Window {
    default-font-family: Theme.font-family;
    in property <int> window;
    in property <string> panel-names;
    in property <[StackData]> stacks;
    in property <[HandleData]> handles;
    title: @tr("RBS – {}", panel-names);
    forward-focus: edit-keys;
    // BEGIN generated menu bar (menu_bar.rs; do not edit)
    MenuBar {
        Menu {
            title: @tr("File");
            Menu {
                title: Menus.titles[0];
                enabled: Menus.enabled[0];
                for c in Menus.choices[0]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[1];
                enabled: Menus.enabled[1];
                for c in Menus.choices[1]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[2]; enabled: Menus.enabled[2]; activated => { Menus.run("ui.settings.open"); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: Menus.titles[3]; enabled: Menus.enabled[3]; activated => { Menus.run("edit.undo"); } }
            MenuItem { title: Menus.titles[4]; enabled: Menus.enabled[4]; activated => { Menus.run("edit.redo"); } }
        }
        Menu {
            title: @tr("View");
            Menu {
                title: Menus.titles[5];
                enabled: Menus.enabled[5];
                for c in Menus.choices[2]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[6]; enabled: Menus.enabled[6]; checkable: true; checked: Menus.checked[6]; activated => { Menus.run("ui.area.toggle?area=left"); } }
            MenuItem { title: Menus.titles[7]; enabled: Menus.enabled[7]; checkable: true; checked: Menus.checked[7]; activated => { Menus.run("ui.area.toggle?area=right"); } }
            MenuItem { title: Menus.titles[8]; enabled: Menus.enabled[8]; checkable: true; checked: Menus.checked[8]; activated => { Menus.run("ui.area.toggle?area=bottom"); } }
            MenuItem { title: Menus.titles[9]; enabled: Menus.enabled[9]; activated => { Menus.run("ui.area.hide_all"); } }
            MenuItem { title: Menus.titles[10]; enabled: Menus.enabled[10]; activated => { Menus.run("ui.area.show_all"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[11]; enabled: Menus.enabled[11]; activated => { Menus.run("ui.layout.reset_sizes"); } }
            MenuItem { title: Menus.titles[12]; enabled: Menus.enabled[12]; activated => { Menus.run("ui.toolbar.reset"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[13]; enabled: Menus.enabled[13]; activated => { Menus.run("ui.theme.reload"); } }
        }
        Menu {
            title: @tr("Scene");
            Menu {
                title: Menus.titles[14];
                enabled: Menus.enabled[14];
                for c in Menus.choices[3]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[15]; enabled: Menus.enabled[15]; activated => { Menus.run("scene.previous"); } }
            MenuItem { title: Menus.titles[16]; enabled: Menus.enabled[16]; activated => { Menus.run("scene.next"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[17]; enabled: Menus.enabled[17]; checkable: true; checked: Menus.checked[17]; activated => { Menus.run("canvas.studio_mode.toggle"); } }
            MenuItem { title: Menus.titles[18]; enabled: Menus.enabled[18]; activated => { Menus.run("canvas.transition"); } }
        }
        Menu {
            title: @tr("Source");
            Menu {
                title: Menus.titles[19];
                enabled: Menus.enabled[19];
                for c in Menus.choices[4]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
        }
        Menu {
            title: @tr("Output");
            MenuItem { title: Menus.titles[20]; enabled: Menus.enabled[20]; checkable: true; checked: Menus.checked[20]; activated => { Menus.run("stream.toggle"); } }
            MenuItem { title: Menus.titles[21]; enabled: Menus.enabled[21]; checkable: true; checked: Menus.checked[21]; activated => { Menus.run("record.toggle"); } }
        }
        Menu {
            title: @tr("Window");
            Menu {
                title: Menus.titles[22];
                enabled: Menus.enabled[22];
                for c in Menus.choices[5]: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[23]; enabled: Menus.enabled[23]; checkable: true; checked: Menus.checked[23]; activated => { Menus.run("ui.panel.maximize?id=rbs.preview"); } }
        }
    }
    // END generated menu bar
    preferred-width: Tokens.size-floating-w;
    preferred-height: Tokens.size-floating-h;
    background: Theme.surface-sunken;
    default-font-size: Tokens.type-body-size;
    // Shortcuts (ADR-0060), as in the main window.
    edit-keys := FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if Shortcuts.press(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, e.repeat) { return accept; }
            reject
        }
        VerticalLayout {
            Rectangle {
                height: Tokens.size-control-md + 2 * Tokens.space-1;
                HorizontalLayout {
                    padding: Tokens.space-1;
                    alignment: start;
                    Button { text: @tr("Dock back"); clicked => { Shell.dock(root.window); } }
                    if Shell.end-stream-confirm: EndStreamConfirm { }
                }
            }
            DockArea {
                window: root.window;
                stacks: root.stacks;
                handles: root.handles;
                floating: true;
            }
        }
    }
}

// The Settings window (U17): a list of sections and the chosen one. Search comes when
// there are more.
export component SettingsWindow inherits Window {
    default-font-family: Theme.font-family;
    title: @tr("RBS settings");
    preferred-width: Tokens.size-settings-w;
    preferred-height: Tokens.size-settings-h;
    min-width: Tokens.size-menu-sm + Tokens.size-floating-w / 2 + Tokens.size-menu-md;
    min-height: Tokens.size-floating-h;
    background: Theme.surface-base;
    default-font-size: Tokens.type-body-size;
    // 0 Video, 1 Recording, 2 Stream, 3 Remote control, 4 General (listed first),
    // 5 Appearance (second), 6 Shortcuts (third).
    in-out property <int> section: 1;
    // Escape was pressed: the window closes, as with its close button.
    callback dismiss();
    // Another section is shown (the Appearance page reads its files when shown).
    callback section-shown(int);
    changed section => { root.section-shown(root.section); }
    forward-focus: keys;
    // Keys a field does not take come up here: Escape closes the window (U7: every
    // action is reachable by keyboard).
    keys := FocusScope {
        key-pressed(e) => {
            // While "Keep this look?" is asked, Escape is Undo (themes spec).
            if e.text == Key.Escape && Appearance.keep-asking { Appearance.undo(); return accept; }
            if e.text == Key.Escape { root.dismiss(); return accept; }
            reject
        }
        HorizontalLayout {
            // The section list, in groups (U17: a flat list, never nested).
            Rectangle {
                width: Tokens.size-menu-sm;
                background: Theme.surface-raised;
                Rectangle {
                    x: parent.width - self.width;
                    width: Tokens.size-border;
                    background: Theme.border-subtle;
                }
                VerticalLayout {
                    padding: Tokens.space-3;
                    padding-top: Tokens.space-4;
                    spacing: Tokens.space-1;
                    alignment: start;
                    accessible-role: list;
                    accessible-label: @tr("Settings sections");
                    Text {
                        text: @tr("Settings");
                        color: Theme.text-primary;
                        font-size: Tokens.type-title-size;
                        font-weight: Tokens.type-title-weight;
                        accessible-role: none;
                    }
                    Rectangle { height: Tokens.space-2; }
                    SettingsNavGroup { title: @tr("App"); }
                    SettingsNavItem {
                        text: @tr("General");
                        icon: IconName.sliders;
                        current: root.section == 4;
                        activated => { root.section = 4; }
                    }
                    SettingsNavItem {
                        text: @tr("Appearance");
                        icon: IconName.palette;
                        current: root.section == 5;
                        activated => { root.section = 5; }
                    }
                    SettingsNavItem {
                        text: @tr("Shortcuts");
                        icon: IconName.keyboard;
                        current: root.section == 6;
                        activated => { root.section = 6; }
                    }
                    Rectangle { height: Tokens.space-2; }
                    SettingsNavGroup { title: @tr("Output"); }
                    SettingsNavItem {
                        text: @tr("Video");
                        icon: IconName.monitor;
                        current: root.section == 0;
                        activated => { root.section = 0; }
                    }
                    SettingsNavItem {
                        text: @tr("Recording");
                        icon: IconName.dot;
                        current: root.section == 1;
                        activated => { root.section = 1; }
                    }
                    SettingsNavItem {
                        text: @tr("Stream");
                        icon: IconName.broadcast;
                        current: root.section == 2;
                        activated => { root.section = 2; }
                    }
                    Rectangle { height: Tokens.space-2; }
                    SettingsNavGroup { title: @tr("Control"); }
                    SettingsNavItem {
                        text: @tr("Remote control");
                        icon: IconName.link;
                        current: root.section == 3;
                        activated => { root.section = 3; }
                    }
                }
            }
            Flickable {
                content-height: page.preferred-height;
                content-width: self.width;
                page := VerticalLayout {
                    padding: Tokens.space-6;
                    spacing: Tokens.space-4;
                    alignment: start;
                    SettingsHeader {
                        title: root.section == 0 ? @tr("Video") : root.section == 1 ? @tr("Recording") : root.section == 2 ? @tr("Stream") : root.section == 3 ? @tr("Remote control") : root.section == 5 ? @tr("Appearance") : root.section == 6 ? @tr("Shortcuts") : @tr("General");
                        subtitle: root.section == 0 ? @tr("The canvas every scene is drawn on.")
                            : root.section == 1 ? @tr("Where recordings are saved and how they are encoded. Changes are saved at once.")
                            : root.section == 2 ? @tr("Where Go live sends the program and how it is encoded. Changes are saved at once.")
                            : root.section == 3 ? @tr("Let Stream Deck, panels and your own scripts control RBS.")
                            : root.section == 5 ? @tr("Themes for every RBS window, and your own themes.")
                            : root.section == 6 ? @tr("Keys that run commands, in RBS and, for global shortcuts, in any app.")
                            : @tr("How RBS behaves on this computer.");
                    }
                    if root.section == 0: VideoSettings { }
                    if root.section == 1: RecordingSettings { }
                    if root.section == 2: StreamSettings { }
                    if root.section == 3: RemoteControlSettings { }
                    if root.section == 4: GeneralSettings { }
                    if root.section == 5: AppearanceSettings { }
                    if root.section == 6: ShortcutsSettings { }
                }
            }
        }
    }
}
