                for c in Menus.choices[4]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[8];
                icon: Menus.icons[8];
                enabled: Menus.enabled[8];
                for c in Menus.choices[5]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[9];
                icon: Menus.icons[9];
                enabled: Menus.enabled[9];
                for c in Menus.choices[6]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
        }
        Menu {
            title: @tr("Scene");
            Menu {
                title: Menus.titles[10];
                icon: Menus.icons[10];
                enabled: Menus.enabled[10];
                for c in Menus.choices[7]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuItem { title: Menus.titles[11]; icon: Menus.icons[11]; enabled: Menus.enabled[11]; activated => { Menus.run("scene.previous"); } }
            MenuItem { title: Menus.titles[12]; icon: Menus.icons[12]; enabled: Menus.enabled[12]; activated => { Menus.run("scene.next"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[13]; icon: Menus.icons[13]; enabled: Menus.enabled[13]; activated => { Menus.run("scene.add"); } }
            Menu {
                title: Menus.titles[14];
                icon: Menus.icons[14];
                enabled: Menus.enabled[14];
                for c in Menus.choices[8]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[15]; icon: Menus.icons[15]; enabled: Menus.enabled[15]; checkable: true; checked: Menus.checked[15]; activated => { Menus.run("canvas.studio_mode.toggle"); } }
            MenuItem { title: Menus.titles[16]; icon: Menus.icons[16]; enabled: Menus.enabled[16]; activated => { Menus.run("canvas.transition"); } }
        }
        Menu {
            title: @tr("Source");
            Menu {
                title: Menus.titles[17];
                icon: Menus.icons[17];
                enabled: Menus.enabled[17];
                for c in Menus.choices[9]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            Menu {
                title: Menus.titles[18];
                icon: Menus.icons[18];
                enabled: Menus.enabled[18];
                for c in Menus.choices[10]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[19];
                icon: Menus.icons[19];
                enabled: Menus.enabled[19];
                for c in Menus.choices[11]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[20];
                icon: Menus.icons[20];
                enabled: Menus.enabled[20];
                for c in Menus.choices[12]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[21];
                icon: Menus.icons[21];
                enabled: Menus.enabled[21];
                for c in Menus.choices[13]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[22]; icon: Menus.icons[22]; enabled: Menus.enabled[22]; activated => { Menus.run("item.remove"); } }
            MenuItem { title: Menus.titles[23]; icon: Menus.icons[23]; enabled: Menus.enabled[23]; activated => { Menus.run("source.delete"); } }
            MenuSeparator { }
            Menu {
                title: Menus.titles[24];
                icon: Menus.icons[24];
                enabled: Menus.enabled[24];
                for c in Menus.choices[14]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
        }
        Menu {
            title: @tr("Output");
            MenuItem { title: Menus.titles[25]; icon: Menus.icons[25]; enabled: Menus.enabled[25]; checkable: true; checked: Menus.checked[25]; activated => { Menus.run("stream.toggle"); } }
            MenuItem { title: Menus.titles[26]; icon: Menus.icons[26]; enabled: Menus.enabled[26]; checkable: true; checked: Menus.checked[26]; activated => { Menus.run("record.toggle"); } }
            Menu {
                title: Menus.titles[27];
                icon: Menus.icons[27];
                enabled: Menus.enabled[27];
                for c in Menus.choices[15]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[28]; icon: Menus.icons[28]; enabled: Menus.enabled[28]; checkable: true; checked: Menus.checked[28]; activated => { Menus.run("vcam.toggle"); } }
            MenuSeparator { }
            MenuItem { title: Menus.titles[29]; icon: Menus.icons[29]; enabled: Menus.enabled[29]; checkable: true; checked: Menus.checked[29]; activated => { Menus.run("replay.toggle"); } }
            MenuItem { title: Menus.titles[30]; icon: Menus.icons[30]; enabled: Menus.enabled[30]; activated => { Menus.run("replay.save"); } }
        }
        Menu {
            title: @tr("Window");
            Menu {
                title: Menus.titles[31];
                icon: Menus.icons[31];
                enabled: Menus.enabled[31];
                for c in Menus.choices[16]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
            MenuItem { title: Menus.titles[32]; icon: Menus.icons[32]; enabled: Menus.enabled[32]; checkable: true; checked: Menus.checked[32]; activated => { Menus.run("ui.panel.maximize?id=rbs.preview"); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: Menus.titles[33]; icon: Menus.icons[33]; enabled: Menus.enabled[33]; activated => { Menus.run("ui.app_menu.open"); } }
        }
    }
    // END generated menu bar
    // Shortcuts (ADR-0060): keys a focused control does not take come up here, and a
    // click where no control takes it focuses this scope, so they work from any panel
    // of this window. Text fields keep their own editing keys. No KeyBinding here: a
    // KeyBinding accepts its keys even when it does nothing.
    edit-keys := FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            // Cmd+W closes the main window on macOS, as its close button does
            // (ADR-0056); reserved there, free on Windows.
            if Studio.platform == 0 && e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt && !e.modifiers.meta && (e.text == "w" || e.text == "W") {
                Shell.close-main();
                return accept;
            }
            // F10 opens the RBS menu where it replaces the menu bar (Windows, Linux).
            if !Shell.native-menu-bar && e.text == Key.F10 && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && !e.modifiers.meta {
                Shell.app-menu-asked += 1;
                return accept;
            }
            // Escape answers the End stream card as Keep streaming (U4, U7).
            if e.text == Key.Escape && !Shell.quit-confirm && (Shell.end-stream-confirm || Shell.end-vertical-confirm) {
                if Shell.end-stream-confirm { Shell.end-stream-answer(false); } else { Shell.end-vertical-answer(false); }
                return accept;
            }
            if Shortcuts.press(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, e.repeat) { return accept; }
            reject
        }
        VerticalLayout {
            frame := FrameBar { }
            HorizontalLayout {
                padding: Shell.gap;
                spacing: Shell.gap;
                if Shell.left-tabs.length > 0: EdgeStrip {
                    tabs: Shell.left-tabs;
                    vertical: true;
                    open-id: root.flyout-edge == 0 ? root.flyout-tab.id : "";
                    toggle(t) => { root.toggle-flyout(0, t); }
                }
                VerticalLayout {
                    spacing: Shell.gap;
                    dock := DockArea {
                        window: 0;
                        stacks: root.stacks;
                        handles: root.handles;
                        rail: root.rail;
                    }
                    if Shell.bottom-tabs.length > 0: EdgeStrip {
                        tabs: Shell.bottom-tabs;
                        vertical: false;
                        open-id: root.flyout-edge == 2 ? root.flyout-tab.id : "";
                        toggle(t) => { root.toggle-flyout(2, t); }
                    }
                }
                if Shell.right-tabs.length > 0: EdgeStrip {
                    tabs: Shell.right-tabs;
                    vertical: true;
                    open-id: root.flyout-edge == 1 ? root.flyout-tab.id : "";
                    toggle(t) => { root.toggle-flyout(1, t); }
                }
            }
            StatusBar { }
        }
    }
    // The slid-out auto-hide panel, over the dock area along its edge (0 left, 1 right,
    // 2 bottom; -1 none). Sliding out and back is not a layout change (ADR-0049).
    property <int> flyout-edge: -1;
    property <EdgeTabData> flyout-tab;
    function toggle-flyout(edge: int, t: EdgeTabData) {
        if flyout-edge == edge && flyout-tab.id == t.id {
            hide-flyout();
        } else {
            flyout-tab = t;
            flyout-edge = edge;
        }
    }
    function hide-flyout() {
        flyout-edge = -1;
        Shell.flyout-open = false;
    }
    // Pinning, closing or adding an auto-hidden panel slides the flyout back.
    property <string> edge-ids: Shell.edge-ids;
    changed edge-ids => { hide-flyout(); }
    // Opening an auto-hidden panel (its menu, or Properties from a source) slides
    // it out. Any other command slides it back.
    property <int> reveal-serial: Shell.reveal-serial;
    changed reveal-serial => {
        if Shell.reveal-edge >= 0 {
            root.flyout-tab = Shell.reveal-tab;
            root.flyout-edge = Shell.reveal-edge;
        } else {
            root.hide-flyout();
        }
    }
    // A click on the dock, outside the slid-out panel, slides it back. The flyout
    // is a later sibling, so it stays above this and keeps its own clicks.
    if root.flyout-edge >= 0: TouchArea {
        x: Shell.gap + (Shell.left-tabs.length > 0 ? Tokens.size-control-md + Shell.gap : 0px);
        y: frame.height + Shell.gap;
        width: dock.width;
        height: dock.height;
        clicked => { root.hide-flyout(); }
    }
    if flyout-edge >= 0: Flyout {
        property <length> size: min(flyout-tab.size, flyout-edge == 2 ? dock.height : dock.width);
        // The dock area's place in the window, from the layout around it.
        property <length> dock-x: Shell.gap + (Shell.left-tabs.length > 0 ? Tokens.size-control-md + Shell.gap : 0px);
        property <length> dock-y: frame.height + Shell.gap;
        x: flyout-edge == 1 ? dock-x + dock.width - size : dock-x;
        y: flyout-edge == 2 ? dock-y + dock.height - size : dock-y;
        width: flyout-edge == 2 ? dock.width : size;
        height: flyout-edge == 2 ? size : dock.height;
        data: flyout-tab;
        hide => { root.hide-flyout(); }
    }
    if Shell.toast-kind != 0: Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Tokens.space-6;
        text: Shell.toast-kind == 1 ? @tr("{} closed.", Shell.toast-subject) : @tr("Switched workspace automatically from {}.", Shell.toast-subject);
        action: @tr("Undo");
        action-icon: IconName.undo;
        mark: IconName.undo;
        generation: Shell.toast-generation;
        act => { Shell.toast-undo(); }
        dismiss => { Shell.toast-dismiss(); }
    }
    if Studio.deleted != "" && Shell.toast-kind == 0: Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Tokens.space-6;
        text: Studio.deleted-from-scene ? @tr("{} removed from this scene.", Studio.deleted) : @tr("{} deleted.", Studio.deleted);
        action: @tr("Undo");
        action-icon: IconName.undo;
        generation: Studio.deleted-generation;
        act => { Studio.undo-delete(); }
        dismiss => { Studio.dismiss-deleted(); }
    }
    // The main output stopped and its vertical one runs on (ADR-0111 decision 6): once
    // per such stop, not modal; Stop ends that output (a stream asks first, U4).
    if Shell.vertical-left != 0 && Shell.toast-kind == 0 && Studio.deleted == "": Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Tokens.space-6;
        mark: IconName.canvas-vertical;
        text: Shell.vertical-left == 1 ? @tr("Vertical recording still on")
            : @tr("Vertical stream still live");
        action: Shell.vertical-left == 1 ? @tr("Stop it") : @tr("End it");
        action-icon: IconName.stop;
        act => { Shell.vertical-left-stop(); }
        dismiss => { Shell.vertical-left-dismiss(); }
    }
    // End stream asks first (U4), in a card under Go live and Record.
    if (Shell.end-stream-confirm || Shell.end-vertical-confirm) && !Shell.quit-confirm: EndStreamCard {
        x: parent.width - self.width - Tokens.space-2;
        // Under the error bar while one shows, so neither covers the other.
        y: Shell.error-kind != 0 || Shell.background-notice != 0
            ? Shell.top-toast.y + Shell.top-toast.height + Tokens.space-2
            : frame.height + Tokens.space-1;
        vertical: !Shell.end-stream-confirm;
    }
    // The first Close with Keep RBS running says once where RBS goes, in the error
    // bar's place over the window (ADR-0056); OK (or Dismiss) hides the windows.
    if Shell.background-notice != 0: Toast {
        x: (parent.width - self.width) / 2;
        y: frame.height + Tokens.space-2;
        top: true;
        // Closing this one hides the windows, so it waits for OK or Dismiss.
        timed: false;
        text: Shell.background-notice == 1 ? @tr("RBS keeps running in the Dock. Quit with Cmd+Q.")
            : @tr("RBS keeps running in the notification area (under the ^ arrow until you pin it). Quit it from the RBS icon there.");
        action: @tr("OK");
        action-icon: IconName.check;
        act => { Shell.background-notice-ok(); }
        dismiss => { Shell.background-notice-ok(); }
    }
    if Shell.error-kind != 0 && Shell.background-notice == 0: Toast {
        x: (parent.width - self.width) / 2;
        y: frame.height + Tokens.space-2;
        top: true;
        generation: Shell.error-generation;
        mark: Shell.error-kind == 3 ? IconName.info : IconName.warning;
        text: Shell.error-kind == 1 ? @tr("The layout is locked. Unlock it from the workspace menu.")
            : Shell.error-kind == 3 ? Shell.error-detail
            : @tr("That did not work: {}", Shell.error-detail);
        action: "";
        dismiss => { Shell.dismiss-error(); }
    }
    // The RBS menu: a layer under the hint and tooltip layer; a click outside closes it.
    if AppMenus.open: Rectangle {
        width: parent.width;
        height: parent.height;
        TouchArea { clicked => { AppMenus.open = false; } }
        AppMenu {
            x: Tokens.space-2;
            y: frame.height;
        }
    }
    // The info hint and tooltip layer, drawn last (ADR-0094).
    OverlayHost { width: parent.width; height: parent.height; }
}

