// The RBS desktop shell. Layout geometry comes from the toolkit-neutral rbs-ui
// crate: Slint has no recursive components, so Rust flattens each window's
// layout tree into tab stacks and splitter handles with absolute positions.
import { Theme, Tokens } from "tokens.slint";
import { ScrollArea, Sections, Button, SplitButton, IconButton, Icon, IconName, Icons, FocusRing, RingFocus, MenuItem as MenuRow, MenuSurface, EmptyState, Select, NumberField, Toggle, OverlayHost, Overlays, OverlayCover, PickerRow } from "components.slint";
import { SettingsNavItem, SettingsNavGroup, SettingsHeader, SettingsScroll } from "settings.slint";
import { Appearance, AppearanceSettings, ThemeOption, ThemeTokenRow } from "appearance.slint";
import { Shortcuts, ShortcutsSettings, ShortcutRow, ShortcutChip } from "shortcuts.slint";
import { VirtualCamera, VirtualCameraSettings } from "vcam.slint";
import { AudioSettings } from "audio.slint";
import { ReplayBuffer } from "replay.slint";
import { SourceSettingsWindow } from "source_settings.slint";
import { CommandMenu, ContextMenus, ContextItem, ContextChoice } from "context_menu.slint";
import { AppMenus, AppMenuRow, AppMenuChip, AppMenu, AppMenuButton } from "app_menu.slint";
import { Studio, ModeData, SourceSettingsData, EntryRow, SourceData, FilterData, FilterFieldData, MarkData, KindData, MeterRow, ScaleMark, EncoderData, ProgramPanel, ScenesPanel, SourcesPanel, PropertiesPanel, MixerPanel, LiveControlsPanel, TransitionPanel, OutputsPanel, LibraryPanel, StatsPanel, RecordingSettings, StreamSettings, VideoSettings, RemoteControlSettings, GeneralSettings, GlobalSourcesSettings } from "studio.slint";

export { SourceSettingsWindow, ModeData, SourceSettingsData }
export { OverlayProbe, FocusRevealProbe } from "overlay_probe.slint";
export { Sections, Overlays, OverlayCover, PickerRow, AppMenus, AppMenuRow, AppMenuChip, ContextMenus, ContextItem, ContextChoice, Theme, Tokens, Appearance, ThemeOption, ThemeTokenRow, Shortcuts, ShortcutRow, ShortcutChip, VirtualCamera, ReplayBuffer, Studio, EntryRow, SourceData, FilterData, FilterFieldData, MarkData, KindData, MeterRow, ScaleMark, EncoderData }

export struct TabData { id: string, title: string, known: bool, icon: string }
export struct StackData { window: int, stack: int, x: length, y: length, w: length, h: length, tabs: [TabData], active: int, collapsed: bool, can-collapse: bool, can-hide: bool }
// The Transition rail of the centre's studio split, in studio mode (ADR-0064).
export struct RailData { shown: bool, x: length, y: length, w: length, h: length, below: bool }
export struct HandleData { window: int, index: int, x: length, y: length, w: length, h: length, horizontal: bool, percent: int }
export struct PanelEntry { id: string, title: string, open: bool }
export struct WorkspaceEntry { name: string, built-in: bool, current: bool }
// A toolbar item (ADR-0050). kind: 0 command, 1 the workspace picker, 2 separator,
// 3 flexible space, 4 an item this version cannot run (shown disabled).
export struct ToolbarData { id: string, title: string, kind: int, enabled: bool, checked: bool, live: bool, icon: string, icon-only: bool }
// An auto-hidden panel's edge tab (ADR-0049 decision 2); `size` is its flyout's
// width, or height on the bottom edge.
export struct EdgeTabData { id: string, title: string, icon: string, size: length }

// State and commands shared by every window. Slint globals are per window, so
// A rectangle in window coordinates.
export struct Cover {
    x: length,
    y: length,
    width: length,
    height: length,
}

// Rust pushes the same state into each window's copy.
// The menu bar's run-time values (menu_bar.rs): titles, enabled and checked states
// indexed in the generated items' order, and each choice submenu's choices.
export struct MenuChoice { title: string, id: string, checked: bool, icon: image }
export global Menus {
    in property <[string]> titles;
    // Each item's icon; empty while a checkmark takes its place.
    in property <[image]> icons;
    in property <[bool]> enabled;
    in property <[bool]> checked;
    in property <[[MenuChoice]]> choices;
    // Runs a command registry id (ADR-0050).
    callback run(string);
}

export global Shell {
    // The chord that runs `canvas.transition`, as the platform writes it; shown on the
    // Transition rail (ADR-0064). Empty when it has none.
    in property <string> transition-keys;
    // The menu bar shows: macOS's system menu bar. Windows and Linux use the RBS menu
    // (ADR-0069). A binding, so every window (main and floating) gets it.
    out property <bool> native-menu-bar: Platform.os == OperatingSystemType.macos;
    // Counts `ui.app_menu.open` runs and F10 presses: each opens the RBS menu with its
    // search field.
    in-out property <int> app-menu-asked;
    // 0 not live, 1 live, 2 recording, 3 live and recording.
    in property <int> live-state;
    in property <string> live-duration;
    in property <string> live-outputs;
    // The recording in progress, or the next one while idle is not what this names:
    // the running file has no picture.
    in property <bool> audio-only;
    // RBS sends the program to the virtual camera (ADR-0066 decision 12).
    in property <bool> live-camera;
    in property <[PanelEntry]> panels;
    in property <[WorkspaceEntry]> workspaces;
    in property <string> workspace-name;
    in property <bool> workspace-built-in;
    in property <bool> locked;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // 0 none, 1 "<subject> closed." (undo), 2 automatic switch from workspace <subject>.
    in property <int> toast-kind;
    in property <string> toast-subject;
    // Bumps when a new toast replaces the one showing, so its countdown starts again.
    in property <int> toast-generation;
    // 0 none, 1 layout locked, 2 other error with <error-detail>, 3 a notice whose
    // <error-detail> is the whole text (ADR-0055: a caught panic, an unclean last exit).
    in property <int> error-kind;
    in property <string> error-detail;
    // Bumps when a new error replaces the one showing, so its countdown starts again.
    in property <int> error-generation;
    // Where the bottom toast and the top error bar are while they show (the main
    // window's): the preview layer hides only while one overlaps the picture.
    in-out property <Cover> bottom-toast;
    in-out property <Cover> top-toast;
    // The End stream question's card while it shows.
    in-out property <Cover> confirm-cover;
    // The main window was closed while a stream runs: the frame asks first (U4).
    in property <bool> quit-confirm;
    // The first Close to the background says once where RBS went (ADR-0056): 0 none,
    // 1 macOS (the Dock), 2 Windows (the notification area).
    in property <int> background-notice;
    callback background-notice-ok();
    // Cmd+W on macOS: Close, as the main window's close button (ADR-0056).
    callback close-main();
    callback quit-end-stream();
    callback quit-keep();
    // The toolbar row's groups (ADR-0071): the items before its flexible space and the
    // items after it, and whether the toolbar is shown.
    in property <[ToolbarData]> toolbar;
    in property <[ToolbarData]> toolbar-end;
    // Go live and Record, the frame's fixed group (ADR-0073): shown with the toolbar
    // hidden too.
    in property <[ToolbarData]> toolbar-fixed;
    in property <bool> toolbar-visible: true;
    // Windows (ADR-0071): the toolbar row is the title bar and ends with the window
    // buttons. Set once the window's caption is removed.
    in property <bool> custom-caption;
    in property <bool> window-maximized;
    // The maximize button gets its mouse through the OS (snap layouts): its hover and
    // pressed state come from there.
    in property <bool> caption-max-hover;
    in property <bool> caption-max-pressed;
    // 0 minimize, 1 maximize or restore, 2 close.
    callback caption(int);
    // Where the row's groups and the maximize button are, in the window (logical px):
    // the hit test's regions. Sent whenever one moves.
    callback caption-regions(length /* lead end */, length /* end start */, length /* max x */, length /* max width */, length /* row height */);
    // End stream from the menu bar: the frame asks first (U4).
    in property <bool> end-stream-confirm;
    // The same for the vertical canvas's stream (ADR-0093 decision 6).
    in property <bool> end-vertical-confirm;
    // A vertical canvas exists: Go live and Record get a ▾ with its outputs.
    in property <bool> vertical-outputs;
    // The vertical canvas streams, records (or starts to): Go live and Record show "9:16".
    in property <bool> vertical-live;
    in property <bool> vertical-rec;
    // The chips beside Record and Go live (ADR-0111): 0 none, 1 starting, 2 connecting,
    // 3 recording or live, 4 stopping; and the elapsed time.
    in property <int> vertical-rec-state;
    in property <string> vertical-rec-time;
    in property <int> vertical-live-state;
    in property <string> vertical-live-time;
    // A chip's stop: the vertical stream (true) or recording alone.
    callback vertical-stop(bool /* stream */);
    // End stream ends the vertical stream too: the question names both.
    in property <bool> end-stream-both;
    // The main output stopped and the vertical one runs on: 1 recording, 2 stream.
    in property <int> vertical-left;
    callback vertical-left-stop();
    callback vertical-left-dismiss();
    // A vertical server is saved; without one the ▾ menu offers to set it up.
    in property <bool> vertical-stream-set-up;
    // The gap between panel cards and around them: the layout's divider thickness.
    // literal: Rust sets it to rbs_ui::layout::HANDLE_THICKNESS, which the frame geometry also uses
    in property <length> gap: 6px;
    // Edge tabs of auto-hidden panels on the left, right and bottom edges.
    in property <[EdgeTabData]> left-tabs;
    in property <[EdgeTabData]> right-tabs;
    in property <[EdgeTabData]> bottom-tabs;
    // Every edge tab's panel id, joined: changes when one is added, pinned or closed.
    in property <string> edge-ids;
    // Ask the main window to slide an auto-hidden panel out (reveal-edge 0 left,
    // 1 right, 2 bottom) or to slide the current one back (reveal-edge -1).
    // The serial changes on each ask, so the same panel can be shown again.
    in property <int> reveal-edge: -1;
    in property <EdgeTabData> reveal-tab;
    in property <int> reveal-serial;
    // The slid-out auto-hide panel's rectangle while one is out (the preview layer
    // leaves it out, ADR-0054).
    in-out property <bool> flyout-open;
    in-out property <Cover> flyout;
    callback end-stream-answer(bool /* end */);
    callback end-vertical-answer(bool /* end */);

    // Dragging a tab (ADR-0049 decision 5): the payload names the panel; the dock area
    // under the pointer reports moves and the drop in its own coordinates, and Rust
    // answers with the guide: the part of window <drop-window> the drop would fill.
    pure callback panel-data(string /* panel */) -> data-transfer;
    // True when a drag payload is a panel id, so a source drag is not docked and a
    // panel drag is not taken for a source.
    pure callback is-panel(data-transfer) -> bool;
    callback drag-over(int /* window */, data-transfer, length, length);
    callback drag-drop(int /* window */, data-transfer, length, length);
    callback drag-leave();
    // The maximized panel's id, or empty (ADR-0049 decision 2; not saved).
    in property <string> maximized;
    in property <int> drop-window: -1;
    in property <Cover> drop-guide;
    // The guide in window surface coordinates while it shows: the preview layer cuts it out.
    in-out property <bool> drop-open;
    in-out property <Cover> drop-cover;
    // A window's dock area: its position in the window and its size.
    callback relayout(int /* window */, length, length, length, length);
    callback collapse(string, bool /* collapsed */);
    callback auto-hide(string);
    callback pin(string);
    callback activate-tab(int /* window */, int /* stack */, int /* tab */);
    callback close-panel(string);
    callback toggle-panel(string);
    callback dock(int /* window */);
    // Wanted position of the handle along its axis, in the dock area.
    callback drag(int /* window */, int /* handle */, length);
    callback drag-end();
    callback nudge(int /* window */, int /* handle */, length);
    callback switch-workspace(string);
    callback toast-undo();
    callback toast-dismiss();
    callback dismiss-error();
}

// Live indicator (rules U4, U21): the state in words, never colour alone. Compact on
// purpose: idle it takes no room (the status bar says "Not live · not recording");
// live or recording a small chip in the live colour (U12) with a dot and "REC",
// "LIVE" or "LIVE · REC", and "CAM" while RBS sends to the virtual camera (an app may
// be showing it to other people).
// The duration and the outputs are in the status bar under the window (spec Frame);
// the accessible name keeps the whole text.
component LiveIndicator inherits Rectangle {
    property <bool> active: Shell.live-state != 0 || Shell.live-camera;
    property <string> state-text: Shell.live-state == 1 ? @tr("Live")
        : Shell.live-state == 2 ? (Shell.audio-only ? @tr("Recording audio") : @tr("Recording"))
        : Shell.live-state == 3 ? (Shell.audio-only ? @tr("Live and recording audio") : @tr("Live and recording"))
        : @tr("Not live");
    property <string> output-text: Shell.live-state == 1 ? @tr("LIVE")
        : Shell.live-state == 2 ? (Shell.audio-only ? @tr("REC audio") : @tr("REC"))
        : Shell.live-state == 3 ? (Shell.audio-only ? @tr("LIVE · REC audio") : @tr("LIVE · REC"))
        : "";
    property <string> short-text: !Shell.live-camera ? output-text
        : output-text != "" ? @tr("{} · CAM", output-text)
        : @tr("CAM");
    property <string> outputs-full: Shell.live-state != 0
        ? state-text + " " + Shell.live-duration + (Shell.live-outputs != "" ? " · " + Shell.live-outputs : "")
        : state-text;
    property <string> full: !Shell.live-camera ? outputs-full
        : Shell.live-state == 0 ? @tr("Virtual camera on · not live · not recording")
        : @tr("{} · virtual camera on", outputs-full);
    height: Tokens.size-control-md;
    width: content.preferred-width;
    accessible-role: AccessibleRole.text;
    accessible-label: @tr("Live status: {}", full);
    content := HorizontalLayout {
        alignment: center;
        if active: VerticalLayout {
            alignment: center;
            Rectangle {
                height: Tokens.type-caption-line + Tokens.space-1;
                width: chip.preferred-width;
                border-radius: Tokens.radius-sm;
                background: Theme.state-live;
                chip := HorizontalLayout {
                    padding-left: Tokens.space-1;
                    padding-right: Tokens.space-2;
                    spacing: Tokens.space-1 / 2;
                    VerticalLayout {
                        alignment: center;
                        Icon { name: IconName.dot; ink: Theme.text-on-live; }
                    }
                    Text {
                        text: short-text;
                        color: Theme.text-on-live;
                        font-size: Tokens.type-caption-size;
                        font-weight: Tokens.type-label-weight;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
        }
    }
}

// A panel's content: the panels connected to the studio, a placeholder for the others.
component PanelContent inherits Rectangle {
    in property <TabData> tab;
    property <bool> connected: tab.id == "rbs.program" || tab.id == "rbs.transition" || tab.id == "rbs.scenes" || tab.id == "rbs.sources" || tab.id == "rbs.properties" || tab.id == "rbs.mixer" || tab.id == "rbs.preview" || tab.id == "rbs.live-controls" || tab.id == "rbs.outputs" || tab.id == "rbs.library" || tab.id == "rbs.stats" || tab.id == "rbs.program?canvas=vertical";
    background: Theme.surface-raised;
    if tab.id == "rbs.program" || tab.id == "rbs.preview" || tab.id == "rbs.program?canvas=vertical": ProgramPanel {
        width: parent.width;
        height: parent.height;
        panel: tab.id;
        title: tab.title;
    }
    if tab.id == "rbs.scenes": ScenesPanel {
        width: parent.width;
        height: parent.height;
        live-state: Shell.live-state;
    }
    if tab.id == "rbs.sources": SourcesPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.properties": PropertiesPanel {
        width: parent.width;
        height: parent.height;
        live-state: Shell.live-state;
    }
    if tab.id == "rbs.mixer": MixerPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.transition": TransitionPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.live-controls": LiveControlsPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.outputs": OutputsPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.library": LibraryPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.id == "rbs.stats": StatsPanel {
        width: parent.width;
        height: parent.height;
    }
    if tab.known && !connected: EmptyState {
        width: parent.width;
        height: parent.height;
        title: tab.title;
        message: @tr("Not connected to the engine yet.");
    }
    if !tab.known: EmptyState {
        width: parent.width;
        height: parent.height;
        title: tab.title;
        message: @tr("This panel comes from a plugin that is not installed. Close it from its tab menu.");
    }
}

// A tab in a panel header: its title, underlined in the accent colour while it is the
// shown one (no tab background, spec Frame).
component Tab inherits Rectangle {
    in property <TabData> tab;
    in property <bool> selected;
    // A stack with one panel is a window title, not a tab.
    in property <bool> sole;
    callback activate();
    callback open-menu();
    callback close();
    // Double-click, or Shift+Escape (Escape alone stays with dialogs and fields).
    callback maximize();
    height: Tokens.size-control-lg;
    width: title.preferred-width + 2 * Tokens.space-2;
    border-radius: Tokens.radius-sm;
    background: !selected && touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: AccessibleRole.tab;
    accessible-label: tab.title;
    accessible-item-selected: selected;
    accessible-description: @tr("Menu key or Shift+F10 opens panel actions; Delete or Backspace closes it; Shift+Escape maximizes or restores it");
    accessible-action-default => { activate(); }
    forward-focus: focus;
    focus := RingFocus {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { activate(); return accept; }
            if e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift) { open-menu(); return accept; }
            if e.text == Key.Delete || e.text == Key.Backspace { close(); return accept; }
            if e.text == Key.Escape && e.modifiers.shift { maximize(); return accept; }
            reject
        }
    }
    // The TouchArea comes after the FocusScope so it is on top: a FocusScope
    // under the pointer takes the press for itself (focus-on-click).
    // Dragging the tab moves the panel (ADR-0049 decision 5); a press without a drag
    // reaches the TouchArea inside as a click. Not while the layout is locked.
    drag := DragArea {
        allow-move: !Shell.locked;
        data: Shell.panel-data(tab.id);
        touch := TouchArea {
            clicked => { focus.focus-pointer(); activate(); }
            double-clicked => { maximize(); }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right { open-menu(); }
            }
        }
    }
    title := Text {
        x: Tokens.space-2;
        text: tab.title;
        color: selected || touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-size: Tokens.type-label-size;
        font-weight: selected && !sole ? Tokens.type-title-weight : Tokens.type-label-weight;
        vertical-alignment: center;
    }
    Rectangle {
        x: title.x;
        width: title.preferred-width;
        y: parent.height - Tokens.size-tab-indicator;
        height: selected && !sole ? Tokens.size-tab-indicator : 0px;
        background: Theme.accent;
    }
    Rectangle {
        border-width: focus.has-focus ? Tokens.size-focus-ring : 0px;
        border-color: Theme.border-focus;
        border-radius: Tokens.radius-sm;
    }
}

// A panel card (spec Frame): a rounded card with a header of the stack's tabs and its
// actions (auto-hide, collapse, more), then the shown panel. Collapsed, only the
// header is drawn; in a horizontal split it is a strip as wide as the header is high.
component StackView inherits Rectangle {
    in property <StackData> data;
    in property <bool> floating;
    // The rail between the pictures holds the Studio mode switch (ADR-0073); otherwise
    // Preview's title row does, left of its other buttons.
    in property <bool> switch-in-rail;
    property <length> bar: Tokens.size-control-lg;
    property <bool> strip: data.collapsed && data.h > data.w;
    property <bool> has-tabs: data.tabs.length > 0;
    property <string> active-id: has-tabs ? data.tabs[data.active].id : "";
    property <string> active-title: has-tabs ? data.tabs[data.active].title : "";
    property <string> menu-panel;
    background: Theme.surface-raised;
    // The outline shows only where the panel colour does not separate it from the
    // window ground (ADR-0112 decision 3).
    border-color: Theme.border-subtle;
    border-width: Theme.panel-outline ? Tokens.size-border : 0px;
    border-radius: Tokens.radius-lg;
    clip: true;
    if !strip: Rectangle {
        x: Tokens.size-border;
        y: 0;
        width: parent.width - 2 * Tokens.size-border;
        height: bar;
        HorizontalLayout {
            padding-left: Tokens.space-1;
            padding-right: Tokens.space-1;
            Flickable {
                horizontal-stretch: 1;
                content-width: tabs.preferred-width;
                interactive: false;
                tabs := HorizontalLayout {
                    accessible-role: tab-list;
                    alignment: start;
                    for t[i] in data.tabs: Tab {
                        tab: t;
                        sole: data.tabs.length < 2;
                        selected: i == data.active && !data.collapsed;
                        activate => {
                            if data.collapsed { Shell.collapse(t.id, false); }
                            Shell.activate-tab(data.window, data.stack, i);
                        }
                        close => { Shell.close-panel(t.id); }
                        maximize => { Menus.run("ui.panel.maximize?id=" + t.id); }
                        open-menu => {
                            menu-panel = t.id;
                            menu.open({ x: Tokens.space-2, y: bar });
                        }
                    }
                }
            }
            if has-tabs: HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                padding-top: (bar - Tokens.size-control-sm) / 2;
                padding-bottom: (bar - Tokens.size-control-sm) / 2;
                // A panel's own action in its title row: Add source on Sources.
                if active-id == "rbs.scenes" && !data.collapsed: IconButton {
                    icon: IconName.plus;
                    name: @tr("Add scene");
                    enabled: Studio.state == 1;
                    clicked => { Studio.add-scene-asked += 1; }
                }
                if active-id == "rbs.sources" && !data.collapsed: IconButton {
                    icon: IconName.plus;
                    name: @tr("Add source");
                    enabled: Studio.state == 1;
                    clicked => { add-menu.open({ x: self.absolute-position.x - root.absolute-position.x, y: bar }); }
                }
                if active-id == "rbs.preview" && !data.collapsed && !root.switch-in-rail: HorizontalLayout {
                    padding-right: Tokens.space-2;
                    // Its own bordered component, set apart from the panel's buttons.
                    Rectangle {
                        border-width: Tokens.size-border;
                        border-color: Theme.border-subtle;
                        border-radius: Tokens.radius-md;
                        HorizontalLayout {
                            padding-left: Tokens.space-2;
                            padding-right: Tokens.space-2;
                            Toggle {
                                label: @tr("Studio mode");
                                text: @tr("Studio mode");
                                checked: Studio.studio-mode;
                                toggled(on) => { Menus.run("canvas.studio_mode.toggle"); }
                            }
                        }
                    }
                }
                // Picture panels: Maximize or Restore in the title row, as in design E.
                if (active-id == "rbs.preview" || active-id == "rbs.program") && !data.collapsed: IconButton {
                    icon: IconName.expand;
                    name: Shell.maximized == active-id ? @tr("Restore layout") : @tr("Maximize {}", active-title);
                    checked: Shell.maximized == active-id;
                    clicked => { Menus.run("ui.panel.maximize?id=" + active-id); }
                }
                if data.can-hide && Shell.maximized == "": IconButton {
                    icon: IconName.pin;
                    name: @tr("Auto-hide {}", active-title);
                    clicked => { Shell.auto-hide(active-id); }
                }
                if data.can-collapse && Shell.maximized == "": IconButton {
                    // A tall stack is a column: it collapses toward the side. A wide one
                    // collapses upward.
                    icon: (data.h > data.w) ? (data.collapsed ? IconName.chevron-right : IconName.chevron-left) : (data.collapsed ? IconName.chevron-up : IconName.chevron-down);
                    name: data.collapsed ? @tr("Expand {}", active-title) : (data.h > data.w ? @tr("Collapse {} to the side", active-title) : @tr("Collapse {}", active-title));
                    accessible-expandable: true;
                    accessible-expanded: !data.collapsed;
                    clicked => { Shell.collapse(active-id, !data.collapsed); }
                }
                IconButton {
                    icon: IconName.more;
                    name: @tr("Actions for {}", active-title);
                    // The menu opens under this button, as Add source's does.
                    clicked => {
                        menu-panel = active-id;
                        menu.open({ x: self.absolute-position.x - root.absolute-position.x, y: bar });
                    }
                }
            }
        }
    }
    // A collapsed stack in a horizontal split: its expand button and the tabs' icons,
    // named for screen readers (no rotated text).
    if strip: VerticalLayout {
        padding-top: (bar - Tokens.size-control-sm) / 2;
        padding-left: (parent.width - Tokens.size-control-sm) / 2;
        spacing: Tokens.space-2;
        alignment: start;
        accessible-role: groupbox;
        accessible-label: active-title;
        IconButton {
            icon: IconName.chevron-right;
            name: @tr("Expand {}", active-title);
            accessible-expandable: true;
            accessible-expanded: false;
            clicked => { Shell.collapse(active-id, false); }
        }
        for t[i] in data.tabs: IconButton {
            icon: Icons.named(t.icon);
            name: t.title;
            clicked => {
                Shell.collapse(t.id, false);
                Shell.activate-tab(data.window, data.stack, i);
            }
        }
    }
    if has-tabs && !data.collapsed: PanelContent {
        x: Tokens.size-border;
        y: bar + Tokens.size-border;
        width: parent.width - 2 * Tokens.size-border;
        height: max(0px, parent.height - bar - 2 * Tokens.size-border);
        tab: data.tabs[data.active];
    }
    // The panel's menu: the same CommandMenu as every other context (ADR-0094 B1).
    menu := CommandMenu {
        context: "panel";
        target: "id=" + menu-panel;
    }
    // The Add source button's menu: the source types (ADR-0094 B1).
    add-menu := CommandMenu { context: "add-source"; }
}

// Splitter between two cards: the gap itself, shown in the accent colour while hovered,
// dragged or keyboard-focused. A pointer drag does not leave it focused. Tab to it
// and use the arrow keys to nudge.
component Splitter inherits Rectangle {
    in property <HandleData> data;
    background: focus.has-focus || touch.has-hover || touch.pressed ? Theme.accent : transparent;
    border-radius: Tokens.radius-sm;
    accessible-role: slider;
    accessible-label: data.horizontal ? @tr("Resize panes left and right") : @tr("Resize panes up and down");
    accessible-value: data.percent;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    forward-focus: focus;
    focus := RingFocus {
        key-pressed(e) => {
            if (data.horizontal && e.text == Key.LeftArrow) || (!data.horizontal && e.text == Key.UpArrow) {
                Shell.nudge(data.window, data.index, e.modifiers.shift ? -Tokens.step-nudge-large : -Tokens.step-nudge);
                return accept;
            }
            if (data.horizontal && e.text == Key.RightArrow) || (!data.horizontal && e.text == Key.DownArrow) {
                Shell.nudge(data.window, data.index, e.modifiers.shift ? Tokens.step-nudge-large : Tokens.step-nudge);
                return accept;
            }
            reject
        }
    }
    // The TouchArea comes after the FocusScope so it is on top: a FocusScope
    // under the pointer takes the press for itself (focus-on-click).
    touch := TouchArea {
        mouse-cursor: data.horizontal ? ew-resize : ns-resize;
        // A pointer drag does not focus the handle: the accent colour stays only
        // while the pointer is on it or it is dragged. Tab still focuses it, so the
        // arrow keys can nudge it.
        pointer-event(e) => {
            if e.kind == PointerEventKind.up { Shell.drag-end(); }
        }
        moved => {
            // The handle's wanted position in the dock area: idempotent however many
            // move events arrive before the layout catches up.
            Shell.drag(data.window, data.index, data.horizontal ? data.x + self.mouse-x - self.pressed-x : data.y + self.mouse-y - self.pressed-y);
        }
    }
}

// The Transition rail (ADR-0064): between Preview and Program, or below them with its
// controls centred; only in studio mode, and only beside the two pictures. Its move
// button puts it in the other place (`ui.layout.studio_rail`).
// Where the Transition rail sits (ADR-0064): two icon toggles drawn like the docking
// guide's targets, the current one checked, behind a divider and apart from the
// Transition button so they read as a setting.
component RailPlace inherits HorizontalLayout {
    in property <bool> below;
    in property <bool> caption: true;
    spacing: Tokens.space-1;
    alignment: center;
    if root.caption: Text {
        text: @tr("Position");
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        vertical-alignment: center;
        accessible-role: none;
    }
    IconButton {
        icon: IconName.rail-between;
        name: @tr("Transition rail between the pictures");
        checked: !root.below;
        clicked => { Menus.run("ui.layout.studio_rail?at=between"); }
    }
    IconButton {
        icon: IconName.rail-below;
        name: @tr("Transition rail below the pictures");
        checked: root.below;
        clicked => { Menus.run("ui.layout.studio_rail?at=below"); }
    }
}

// The transition to run (ADR-0061). Cut is the only type until fades. Collection
// glide lives in Settings › General and per-source override in Properties (ADR-0100).
component TransitionChoice inherits Select {
    label: @tr("Transition type");
    options: [@tr("Cut")];
    index: 0;
}

component TransitionGo inherits VerticalLayout {
    in property <bool> can;
    // A narrow rail shows an icon button; its name and shortcut appear under it while
    // the pointer or the focus is on it (ADR-0073).
    in property <bool> icons;
    spacing: Tokens.space-1;
    if !root.icons: Button {
        text: @tr("Transition");
        kind: "primary";
        enabled: root.can;
        accessible-name: Shell.transition-keys == ""
            ? @tr("Transition: put the preview scene on air")
            : @tr("Transition: put the preview scene on air ({})", Shell.transition-keys);
        clicked => { Studio.transition(); }
    }
    if root.icons: VerticalLayout {
        spacing: Tokens.space-1;
        HorizontalLayout {
            alignment: center;
            go := Button {
                icon: IconName.chevron-right;
                kind: "primary";
                enabled: root.can;
                width: Tokens.size-control-lg;
                height: Tokens.size-control-lg;
                accessible-name: Shell.transition-keys == ""
                    ? @tr("Transition: put the preview scene on air")
                    : @tr("Transition: put the preview scene on air ({})", Shell.transition-keys);
                clicked => { Studio.transition(); }
            }
        }
        // The name (and shortcut) of the icon button, shown while it is pointed at.
        Text {
            text: Shell.transition-keys == "" ? @tr("Transition") : @tr("Transition") + "\n" + Shell.transition-keys;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
            opacity: go.pointed ? 1 : 0;
        }
    }
    // The shortcut as small, quiet text under the button (the owner, 2026-11-07); the
    // button's accessible name carries it too.
    if !root.icons && Shell.transition-keys != "": Text {
        text: Shell.transition-keys;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        horizontal-alignment: center;
        accessible-role: none;
    }
}

// The Studio mode switch above the rail between the pictures (ADR-0073): the same
// setting as the toolbar button, the Scene menu entry and the shortcut. Its name is
// under the switch, so the card reads the same at any rail width.
component RailSwitch inherits Rectangle {
    background: Theme.surface-raised;
    border-color: Theme.border-subtle;
    border-width: Tokens.size-border;
    border-radius: Tokens.radius-md;
    VerticalLayout {
        padding: Tokens.space-2;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Toggle {
                label: @tr("Studio mode");
                checked: Studio.studio-mode;
                toggled(on) => { Menus.run("canvas.studio_mode.toggle"); }
            }
        }
        Text {
            text: @tr("Studio mode");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}

component TransitionRail inherits Rectangle {
    in property <bool> below;
    property <bool> can: Studio.studio-mode && Studio.state == 1;
    background: Theme.surface-raised;
    border-color: Theme.border-subtle;
    border-width: Tokens.size-border;
    border-radius: Tokens.radius-md;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: @tr("Transition");
    // Between the pictures: type and the button in a column, the position toggles
    // at the foot. Up to `size.transition.icons` wide only the icon button and the
    // position toggles show (ADR-0073). Glide is not on the rail (Settings /
    // Properties, ADR-0100).
    property <bool> icons: root.width <= Tokens.size-transition-icons;
    if !below: VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-2;
        Rectangle { }
        if !root.icons: TransitionChoice { }
        TransitionGo { can: root.can; icons: root.icons; }
        Rectangle { }
        Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
        RailPlace { below: false; caption: !root.icons; }
    }
    // Below the pictures: type and the button centred under the two pictures, the
    // position toggles at the right end behind a divider. A narrow split keeps the
    // type, the button and the position icons; the Position caption goes first.
    property <bool> compact: root.width < Tokens.size-transition-compact;
    if below && compact: HorizontalLayout {
        width: root.width;
        height: root.height;
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            TransitionChoice { min-width: Tokens.size-transition-type-min; }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: @tr("Transition");
                kind: "primary";
                enabled: root.can;
                accessible-name: Shell.transition-keys == ""
                    ? @tr("Transition: put the preview scene on air")
                    : @tr("Transition: put the preview scene on air ({})", Shell.transition-keys);
                clicked => { Studio.transition(); }
            }
        }
        Rectangle { width: Tokens.size-border; background: Theme.border-subtle; }
        VerticalLayout {
            alignment: center;
            RailPlace { below: true; caption: false; }
        }
    }
    if below && !compact: HorizontalLayout {
        width: root.width;
        height: root.height;
        alignment: center;
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            TransitionChoice { width: Tokens.size-transition-type; }
        }
        VerticalLayout {
            alignment: center;
            // Below the pictures the shortcut is not shown: only the accessible name
            // carries it (the owner, 2026-11-07).
            HorizontalLayout {
                spacing: Tokens.space-2;
                Button {
                    text: @tr("Transition");
                    kind: "primary";
                    enabled: root.can;
                    accessible-name: Shell.transition-keys == ""
                        ? @tr("Transition: put the preview scene on air")
                        : @tr("Transition: put the preview scene on air ({})", Shell.transition-keys);
                    clicked => { Studio.transition(); }
                }
            }
        }
    }
    if below && !compact: HorizontalLayout {
        x: root.width - self.preferred-width - Tokens.space-3;
        width: self.preferred-width;
        height: root.height;
        spacing: Tokens.space-2;
        Rectangle { width: Tokens.size-border; background: Theme.border-subtle; }
        VerticalLayout {
            alignment: center;
            RailPlace { below: true; }
        }
    }
}

// A window's panel cards and dividers. It tells Rust where it is in the window (the
// preview layer is placed from that) and how big it is (the layout is flattened to it).
component DockArea inherits Rectangle {
    in property <int> window;
    in property <[StackData]> stacks;
    in property <[HandleData]> handles;
    in property <RailData> rail;
    in property <bool> floating;
    // The height of the Studio mode switch card above the rail between the pictures.
    property <length> switch-h: 2 * Tokens.space-2 + 2 * Tokens.size-control-md;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    changed window => { report(); }
    changed width => { report(); }
    changed height => { report(); }
    changed ax => { report(); }
    changed ay => { report(); }
    init => { report(); }
    function report() {
        Shell.relayout(window, ax, ay, self.width, self.height);
    }
    // Under the stacks: the stacks' own items ignore drag events, so every drag over
    // the dock area reaches it.
    drop := DropArea {
        can-drop(e) => {
            if !Shell.is-panel(e.data) { return DragAction.none; }
            Shell.drag-over(root.window, e.data, e.position.x, e.position.y);
            return DragAction.move;
        }
        dropped(e) => {
            if !Shell.is-panel(e.data) { return DragAction.none; }
            Shell.drag-drop(root.window, e.data, e.position.x, e.position.y);
            return DragAction.move;
        }
        changed has-drag => {
            if !self.has-drag { Shell.drag-leave(); }
        }
    }
    for s in stacks: StackView {
        x: s.x;
        y: s.y;
        width: s.w;
        height: s.h;
        data: s;
        floating: root.floating;
        switch-in-rail: root.rail.shown && !root.rail.below;
    }
    for h in handles: Splitter {
        x: h.x;
        y: h.y;
        width: h.w;
        height: h.h;
        data: h;
    }
    // Between the pictures the rail is two cards: the Studio mode switch above, the
    // Transition controls below (ADR-0073). Below the pictures it is the Transition
    // row alone and the switch is in Preview's title row.
    if rail.shown && !rail.below: RailSwitch {
        x: rail.x;
        y: rail.y;
        width: rail.w;
        height: root.switch-h;
    }
    if rail.shown: TransitionRail {
        x: rail.x;
        y: rail.below ? rail.y : rail.y + root.switch-h + Shell.gap;
        width: rail.w;
        height: rail.below ? rail.h : rail.h - root.switch-h - Shell.gap;
        below: rail.below;
    }
    // The drop guide: the part of the window the drop would fill.
    if drop.has-drag && Shell.drop-window == root.window && Shell.drop-guide.width > 0: Rectangle {
        x: Shell.drop-guide.x;
        y: Shell.drop-guide.y;
        width: Shell.drop-guide.width;
        height: Shell.drop-guide.height;
        property <Cover> rect: { x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height };
        init => { Shell.drop-cover = rect; Shell.drop-open = true; }
        changed rect => { Shell.drop-cover = rect; }
        background: Theme.accent-subtle.with-alpha(0.6);
        border-radius: Tokens.radius-md;
        border-width: Tokens.size-focus-ring;
        border-color: Theme.accent;
    }
}

// One edge tab of an auto-hidden panel (ADR-0049 decision 2): its icon and title, the
// title turned to run along a left or right edge. Clicking it, or Enter or Space,
// slides the panel out or back.
component EdgeTab inherits Rectangle {
    in property <EdgeTabData> data;
    in property <bool> vertical;
    in property <bool> open;
    callback toggle();
    property <length> along: label.preferred-width + Tokens.size-icon-box + 2 * Tokens.space-2 + Tokens.space-1;
    width: vertical ? Tokens.size-control-md : along;
    height: vertical ? along : Tokens.size-control-md;
    border-radius: Tokens.radius-sm;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    background: open || touch.has-hover ? Theme.surface-overlay : Theme.surface-raised;
    accessible-role: AccessibleRole.tab;
    accessible-label: data.title;
    accessible-expandable: true;
    accessible-expanded: open;
    accessible-action-default => { toggle(); }
    forward-focus: focus;
    focus := RingFocus {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { toggle(); return accept; }
            reject
        }
    }
    touch := TouchArea { clicked => { focus.focus-pointer(); toggle(); } }
    Icon {
        x: vertical ? (parent.width - self.width) / 2 : Tokens.space-2;
        y: vertical ? Tokens.space-2 : (parent.height - self.height) / 2;
        name: Icons.named(data.icon);
        ink: open ? Theme.text-primary : Theme.text-secondary;
    }
    label := Text {
        // Laid out unturned, then turned about its centre.
        width: self.preferred-width;
        height: self.preferred-height;
        x: vertical ? (parent.width - self.width) / 2 : Tokens.size-icon-box + Tokens.space-2 + Tokens.space-1;
        y: vertical ? Tokens.size-icon-box + Tokens.space-2 + Tokens.space-1 + (self.width - self.height) / 2 : (parent.height - self.height) / 2;
        transform-rotation: vertical ? 90deg : 0deg;
        text: data.title;
        color: open || touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        font-weight: Tokens.type-label-weight;
    }
    FocusRing { show: focus.ring; border-radius: Tokens.radius-md; }
}

// The edge tabs on one edge. `open-id` is the slid-out panel, if it is on this edge.
component EdgeStrip inherits Rectangle {
    in property <[EdgeTabData]> tabs;
    in property <bool> vertical;
    in property <string> open-id;
    callback toggle(EdgeTabData);
    // Fixed across its edge, free along it.
    min-width: vertical ? Tokens.size-control-md : 0px;
    max-width: vertical ? Tokens.size-control-md : 100000px;
    min-height: vertical ? 0px : Tokens.size-control-md;
    max-height: vertical ? 100000px : Tokens.size-control-md;
    accessible-role: tab-list;
    if vertical: VerticalLayout {
        spacing: Tokens.space-1;
        alignment: start;
        for t in tabs: EdgeTab {
            data: t;
            vertical: true;
            open: t.id == open-id;
            toggle => { root.toggle(t); }
        }
    }
    if !vertical: HorizontalLayout {
        spacing: Tokens.space-1;
        alignment: start;
        for t in tabs: EdgeTab {
            data: t;
            vertical: false;
            open: t.id == open-id;
            toggle => { root.toggle(t); }
        }
    }
}

// A slid-out auto-hide panel: a card over the dock area along its edge. Its title
// drags like a tab, the menu is the panel menu, Pin docks it and Close closes it.
// Escape, or a click on the dock, slides it back without closing it. A direct child
// of the window, so it reports its own rectangle for the preview layer (ADR-0054).
component Flyout inherits Rectangle {
    in property <EdgeTabData> data;
    callback hide();
    // In window surface coordinates, as the preview layer is placed.
    property <Cover> rect: { x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height };
    init => { Shell.flyout = rect; Shell.flyout-open = true; focus.focus(); }
    changed rect => { Shell.flyout = rect; }
    background: Theme.surface-raised;
    border-color: Theme.border-subtle;
    border-width: Tokens.size-border;
    border-radius: Tokens.radius-md;
    clip: true;
    accessible-role: groupbox;
    accessible-label: data.title;
    // The same panel menu as a docked tab: move, float, close.
    menu := CommandMenu {
        context: "panel";
        target: "id=" + data.id;
    }
    focus := RingFocus {
        key-pressed(e) => {
            if e.text == Key.Escape { root.hide(); return accept; }
            reject
        }
        VerticalLayout {
            Rectangle {
                height: Tokens.size-control-lg;
                HorizontalLayout {
                    padding-left: Tokens.space-3;
                    padding-right: Tokens.space-1;
                    spacing: Tokens.space-1;
                    // The title is the drag handle, the same as a docked tab.
                    DragArea {
                        horizontal-stretch: 1;
                        allow-move: !Shell.locked;
                        data: Shell.panel-data(data.id);
                        Text {
                            text: data.title;
                            color: Theme.text-primary;
                            font-size: Tokens.type-label-size;
                            font-weight: Tokens.type-title-weight;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: IconName.more;
                            name: @tr("Actions for {}", data.title);
                            clicked => {
                                menu.open({
                                    x: self.absolute-position.x - menu.absolute-position.x,
                                    y: self.absolute-position.y - menu.absolute-position.y + self.height,
                                });
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: IconName.pin;
                            name: @tr("Pin {}", data.title);
                            clicked => { Shell.pin(data.id); root.hide(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: IconName.close;
                            name: @tr("Close {}", data.title);
                            clicked => { Shell.close-panel(data.id); root.hide(); }
                        }
                    }
                }
            }
            Rectangle { height: Tokens.size-border; background: Theme.border-subtle; }
            PanelContent { tab: { id: data.id, title: data.title, known: true, icon: data.icon }; }
        }
    }
}

// End stream picked in the menu bar asks first (U4). In a floating window it sits in
// the window's own bar; Keep streaming has the focus. `vertical`: the vertical
// canvas's stream (ADR-0093 decision 6).
component EndStreamConfirm inherits HorizontalLayout {
    in property <bool> vertical;
    horizontal-stretch: 0;
    spacing: Tokens.space-2;
    accessible-role: groupbox;
    accessible-label: vertical ? @tr("End the vertical stream?") : @tr("End the stream?");
    init => { keep-stream.focus(); }
    Text {
        text: vertical ? @tr("End the vertical stream? Viewers see it end.")
            : Shell.end-stream-both ? @tr("End both streams, main and vertical? Viewers see them end.")
            : @tr("End the stream? Viewers see it end.");
        color: Theme.text-primary;
        font-size: Tokens.type-body-size;
        vertical-alignment: center;
    }
    Button {
        text: vertical ? @tr("Yes, end the vertical stream")
            : Shell.end-stream-both ? @tr("Yes, end both streams") : @tr("Yes, end the stream");
        kind: "live";
        clicked => { if vertical { Shell.end-vertical-answer(true); } else { Shell.end-stream-answer(true); } }
    }
    keep-stream := Button {
        text: @tr("Keep streaming");
        clicked => { if vertical { Shell.end-vertical-answer(false); } else { Shell.end-stream-answer(false); } }
    }
}

// The same question in the main window: a card under Go live and Record, over the
// window instead of in the toolbar row, so the row keeps its room. It reports its
// rectangle as `Shell.confirm-cover` for the preview layer (ADR-0054).
component EndStreamCard inherits Rectangle {
    in property <bool> vertical;
    // A direct child of the window, so its own coordinates are the window's.
    property <Cover> rect: { x: self.x, y: self.y, width: self.width, height: self.height };
    init => { Shell.confirm-cover = rect; keep.focus(); }
    changed rect => { Shell.confirm-cover = rect; }
    // The main question was answered and the vertical one is next: the focus goes back
    // to Keep streaming, never stays on an end button.
    changed vertical => { keep.focus(); }
    function answer(end: bool) {
        if vertical { Shell.end-vertical-answer(end); } else { Shell.end-stream-answer(end); }
    }
    width: lay.preferred-width;
    height: lay.preferred-height;
    background: Theme.surface-overlay;
    border-color: Theme.border-strong;
    border-width: Tokens.size-border;
    border-radius: Tokens.radius-md;
    accessible-role: groupbox;
    accessible-label: vertical ? @tr("End the vertical stream?") : @tr("End the stream?");
    lay := VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-2;
        Text {
            text: vertical ? @tr("End the vertical stream? Viewers see it end.")
                : Shell.end-stream-both ? @tr("End both streams, main and vertical? Viewers see them end.")
                : @tr("End the stream? Viewers see it end.");
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
        }
        HorizontalLayout {
            alignment: end;
            spacing: Tokens.space-2;
            Button {
                text: vertical ? @tr("Yes, end the vertical stream")
                    : Shell.end-stream-both ? @tr("Yes, end both streams") : @tr("Yes, end the stream");
                kind: "live";
                clicked => { root.answer(true); }
            }
            keep := Button {
                text: @tr("Keep streaming");
                clicked => { root.answer(false); }
            }
        }
    }
}

// The workspace picker in the toolbar: "Workspace" and the current one's name.
component WorkspacePicker inherits Rectangle {
    callback clicked();
    height: Tokens.size-control-md;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Tokens.radius-sm;
    background: touch.has-hover ? Theme.surface-overlay : Theme.surface-raised;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    accessible-role: button;
    accessible-label: @tr("Workspace: {}", Shell.workspace-name);
    accessible-action-default => { clicked(); }
    forward-focus: focus;
    focus := RingFocus {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    touch := TouchArea { clicked => { focus.focus-pointer(); root.clicked(); } }
    row := HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;
        Text {
            text: @tr("Workspace");
            color: Theme.text-secondary;
            font-size: Tokens.type-label-size;
            vertical-alignment: center;
        }
        Text {
            text: Shell.workspace-name;
            color: Theme.text-primary;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon { name: IconName.chevron-down; ink: Theme.text-secondary; }
        }
    }
    FocusRing { show: focus.ring; }
}

// One toolbar item: a command button with its icon (a toggle that is on is tinted;
// one that stops a live output is a normal button whose stop square is in the live
// colour, U12: the state shows, the toolbar stays calm), the workspace picker, a
// separator or the flexible space. Go live is the one primary button.
component ToolbarCell inherits HorizontalLayout {
    in property <ToolbarData> item;
    // The workspace picker was clicked, at this window x.
    callback open-workspaces(length);
    // The Add source item was clicked, at this window x: it opens the type menu.
    callback open-add-source(length);
    // Go live and Record in the frame's fixed group: a ▾ with the vertical canvas's
    // outputs while it exists, and "9:16" while its stream or recording runs
    // (ADR-0093 decision 6).
    in property <bool> vertical-menu;
    in property <bool> vertical-on;
    // The ▾ was clicked, at this window x.
    callback open-vertical(length);
    property <bool> go-live: item.id == "stream.toggle" && !item.live;
    property <bool> record: item.id == "record.toggle" && !item.live;
    horizontal-stretch: item.kind == 3 ? 1 : 0;
    if (item.kind == 0 || item.kind == 4) && item.icon-only: Button {
        width: Tokens.size-control-lg;
        accessible-name: item.title;
        lead: Icons.named(item.icon);
        lead-ink: item.live && self.enabled ? Theme.state-live
            : item.checked ? Theme.text-primary : Theme.text-secondary;
        kind: "ghost";
        enabled: item.enabled;
        checked: item.checked && !item.live;
        clicked => { if item.id == "source.add" { root.open-add-source(self.absolute-position.x); } else { Menus.run(item.id); } }
    }
    if (item.kind == 0 || item.kind == 4) && !item.icon-only && !vertical-menu: Button {
        text: item.title;
        lead: Icons.named(item.icon);
        // Record's dot, and the stop square of a running output, in the live colour.
        lead-ink: (record || item.live) && self.enabled ? Theme.state-live : self.ink;
        enabled: item.enabled;
        checked: item.checked && !item.live;
        kind: go-live ? "primary" : record || item.live ? "secondary" : "ghost";
        clicked => { if item.id == "source.add" { root.open-add-source(self.absolute-position.x); } else { Menus.run(item.id); } }
    }
    if (item.kind == 0 || item.kind == 4) && !item.icon-only && vertical-menu: SplitButton {
        text: item.title;
        lead: Icons.named(item.icon);
        lead-ink: (record || item.live) && self.enabled ? Theme.state-live : self.ink;
        enabled: item.enabled;
        checked: item.checked && !item.live;
        kind: go-live ? "primary" : "secondary";
        menu-name: item.id == "stream.toggle" ? @tr("Vertical stream") : @tr("Vertical recording");
        // A running vertical output shows as its own chip beside the buttons (ADR-0111).
        menu-text: "";
        menu-description: vertical-on ? @tr("The vertical canvas is on air") : "";
        clicked => { Menus.run(item.id); }
        open-menu(x) => { root.open-vertical(x); }
    }
    if item.kind == 1: WorkspacePicker {
        clicked => { root.open-workspaces(self.absolute-position.x); }
    }
    if item.kind == 2: VerticalLayout {
        padding-top: Tokens.space-1;
        padding-bottom: Tokens.space-1;
        Rectangle {
            width: Tokens.size-border;
            background: Theme.border-subtle;
        }
    }
    // The flexible space: an empty layout cannot grow, a rectangle can.
    if item.kind == 3: Rectangle { }
}

// A window button on Windows (ADR-0071): minimize, maximize or restore, close. Not a
// Tab stop, as the OS's own are not; Alt+Space, Win+arrows and Alt+F4 stay.
component CaptionButton inherits Rectangle {
    in property <IconName> icon;
    in property <string> name;
    in property <bool> close;
    // For maximize, whose mouse the OS handles: its state from there.
    in property <bool> outside-hover;
    in property <bool> outside-pressed;
    in property <bool> outside: false;
    callback clicked();
    property <bool> hot: outside ? outside-hover || outside-pressed : touch.has-hover || touch.pressed;
    width: Tokens.size-caption-w;
    background: !hot ? transparent : close ? Theme.caption-close-hover : Theme.surface-overlay;
    accessible-role: button;
    accessible-label: name;
    accessible-action-default => { root.clicked(); }
    Icon {
        name: root.icon;
        ink: hot && close ? Theme.caption-close-text : Theme.text-primary;
    }
    touch := TouchArea {
        enabled: !root.outside;
        clicked => { root.clicked(); }
    }
}

// A running vertical output beside Record and Go live (ADR-0111 decision 6): the
// vertical mark, its state, the time since it started and a stop for it alone. It
// exists only while that output runs (P13); the 1 Hz tick that moves its time runs
// only then too.
component VerticalChip inherits Rectangle {
    // 1 starting, 2 connecting, 3 recording or live, 4 stopping.
    in property <int> state;
    in property <string> time;
    in property <bool> stream;
    callback stop();
    property <bool> on-air: state == 3;
    property <string> state-text: state == 1 ? @tr("Starting…")
        : state == 2 ? @tr("Connecting…")
        : state == 4 ? (stream ? @tr("Ending…") : @tr("Stopping…"))
        : stream ? @tr("Live") : @tr("Recording");
    height: Tokens.size-control-md;
    width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Tokens.radius-sm;
    border-width: Tokens.size-border;
    border-color: on-air ? Theme.state-live : Theme.border-subtle;
    background: Theme.surface-raised;
    accessible-role: groupbox;
    accessible-label: stream ? @tr("Vertical stream: {} {}", state-text, time)
        : @tr("Vertical recording: {} {}", state-text, time);
    row := HorizontalLayout {
        padding-left: Tokens.space-2;
        spacing: Tokens.space-1;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Icon { name: IconName.canvas-vertical; ink: on-air ? Theme.state-live : Theme.text-secondary; }
        }
        Text {
            text: (stream ? @tr("Vertical live") : @tr("Vertical rec")) + (on-air ? "" : " · " + state-text);
            color: Theme.text-primary;
            font-size: Tokens.type-caption-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
            accessible-role: none;
        }
        if on-air: Text {
            text: time;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            accessible-role: none;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: IconName.stop;
                name: stream ? @tr("End vertical stream") : @tr("Stop vertical recording");
                enabled: state == 1 || state == 2 || state == 3;
                clicked => { root.stop(); }
            }
        }
    }
}

// The window frame's toolbar row (ADR-0049, ADR-0050): the workspace's toolbar items
// and, at its right end, the live indicator (U4, U21). It stays in every workspace,
// even with every panel closed.
component FrameBar inherits Rectangle {
    // Where the workspace menu opens: under the toolbar's Workspace item.
    property <length> ws-menu-x;
    // The hit test's regions on Windows (ADR-0071), in the window: where the leading
    // group ends, where the end group starts, and the maximize button (the second of
    // the three window buttons at the row's right end). Sent when one moves.
    property <length> lead-end: lead.absolute-position.x + lead.width;
    property <length> end-start: end.absolute-position.x;
    property <length> max-x: root.absolute-position.x + root.width - 2 * Tokens.size-caption-w;
    function publish-regions() {
        if Shell.custom-caption {
            Shell.caption-regions(lead-end, end-start, max-x, Tokens.size-caption-w, root.height);
        }
    }
    changed lead-end => { publish-regions(); }
    changed end-start => { publish-regions(); }
    changed max-x => { publish-regions(); }
    property <bool> caption-on: Shell.custom-caption;
    changed caption-on => { publish-regions(); }
    height: Tokens.size-control-md + 2 * Tokens.space-1 + Tokens.size-border;
    background: Theme.surface-base;
    Rectangle {
        y: parent.height - Tokens.size-border;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    // The width the row wants with every item at full size (ADR-0112 decision 12).
    out property <length> wanted-width: row.preferred-width;
    row := HorizontalLayout {
        height: parent.height - Tokens.size-border;
        y: 0;
        padding-left: Tokens.space-2;
        // The window buttons end the row with no padding (ADR-0071).
        padding-right: Shell.custom-caption ? 0 : Tokens.space-2;
        spacing: 0;
        // The leading group: the RBS button, the items before the flexible space,
        // the in-row prompts and status texts.
        lead := HorizontalLayout {
            horizontal-stretch: 0;
            padding-top: Tokens.space-1;
            padding-bottom: Tokens.space-1;
            spacing: Tokens.space-2;
            // The RBS menu (spec, "RBS menu"): every command, with search. Part of the
            // frame, not a toolbar item, so it cannot be removed.
            rbs := AppMenuButton {
                clicked => { root.open-app-menu(); }
            }
            // The workspace's toolbar items (ADR-0050); hidden, the row stays with the
            // live indicator at its right end.
            for item in Shell.toolbar-visible ? Shell.toolbar : []: ToolbarCell {
                item: item;
                open-workspaces(x) => {
                    root.ws-menu-x = x - root.absolute-position.x;
                    ws-menu.open({ x: root.ws-menu-x, y: root.height });
                }
                open-add-source(x) => { add-source-menu.open({ x: x - root.absolute-position.x, y: root.height }); }
            }
            // Closing while live ends the stream: asked first, in the frame (U4).
            if Shell.quit-confirm: HorizontalLayout {
                horizontal-stretch: 0;
                spacing: Tokens.space-2;
                accessible-role: groupbox;
                accessible-label: @tr("End the stream and quit?");
                init => { keep-live.focus(); }
                Text {
                    text: @tr("End the stream and quit?");
                    color: Theme.text-primary;
                    font-size: Tokens.type-body-size;
                    vertical-alignment: center;
                }
                Button {
                    text: @tr("End stream and quit");
                    kind: "live";
                    clicked => { Shell.quit-end-stream(); }
                }
                keep-live := Button {
                    text: @tr("Keep streaming");
                    clicked => { Shell.quit-keep(); }
                }
            }
            // Network access (ADR-0046 decision 7): shown in every workspace while other
            // computers can connect, in words.
            if Studio.rc-network-on: Text {
                horizontal-stretch: 0;
                text: @tr("Reachable from other computers");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
                accessible-role: AccessibleRole.text;
                accessible-label: @tr("Remote control: reachable from other computers");
            }
            if Shell.locked: Text {
                horizontal-stretch: 0;
                text: @tr("Layout locked");
                color: Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
            }
        }
        // The flexible space: on Windows it moves the window (ADR-0071).
        Rectangle {
            horizontal-stretch: 1;
            min-width: Tokens.space-2;
        }
        // The end group: the items after the flexible space, then the live indicator
        // while live or recording (U4, U21). An item not shown takes no width and no
        // spacing.
        end := HorizontalLayout {
            horizontal-stretch: 0;
            padding-top: Tokens.space-1;
            padding-bottom: Tokens.space-1;
            spacing: Tokens.space-2;
            for item in Shell.toolbar-visible ? Shell.toolbar-end : []: ToolbarCell {
                item: item;
                open-workspaces(x) => {
                    root.ws-menu-x = x - root.absolute-position.x;
                    ws-menu.open({ x: root.ws-menu-x, y: root.height });
                }
                open-add-source(x) => { add-source-menu.open({ x: x - root.absolute-position.x, y: root.height }); }
            }
            // Go live and Record: part of the frame, not of the toolbar, so they stay
            // with the toolbar hidden or customised (U1, ADR-0073).
            for item in Shell.toolbar-fixed: ToolbarCell {
                item: item;
                vertical-menu: Shell.vertical-outputs;
                vertical-on: item.id == "stream.toggle" ? Shell.vertical-live : Shell.vertical-rec;
                open-workspaces(x) => { }
                open-vertical(x) => { vertical-menu.open({ x: x - root.absolute-position.x, y: root.height }); }
            }
            // Each running vertical output's chip (ADR-0111 decision 6).
            if Shell.vertical-live-state != 0: VerticalChip {
                state: Shell.vertical-live-state;
                time: Shell.vertical-live-time;
                stream: true;
                stop => { Shell.vertical-stop(true); }
            }
            if Shell.vertical-rec-state != 0: VerticalChip {
                state: Shell.vertical-rec-state;
                time: Shell.vertical-rec-time;
                stream: false;
                stop => { Shell.vertical-stop(false); }
            }
            // Idle it is not in the layout at all (the status bar says "Not live").
            if Shell.live-state != 0 || Shell.live-camera: LiveIndicator { horizontal-stretch: 0; }
        }
        // Windows: the window buttons end the row (ADR-0071).
        if Shell.custom-caption: HorizontalLayout {
            horizontal-stretch: 0;
            padding-left: Tokens.space-2;
            CaptionButton {
                icon: IconName.window-minimize;
                name: @tr("Minimize");
                clicked => { Shell.caption(0); }
            }
            max := CaptionButton {
                icon: Shell.window-maximized ? IconName.window-restore : IconName.window-maximize;
                name: Shell.window-maximized ? @tr("Restore") : @tr("Maximize");
                outside: true;
                outside-hover: Shell.caption-max-hover;
                outside-pressed: Shell.caption-max-pressed;
                clicked => { Shell.caption(1); }
            }
            CaptionButton {
                icon: IconName.close;
                name: @tr("Close");
                close: true;
                clicked => { Shell.caption(2); }
            }
        }
    }
    // The workspace menu: the same CommandMenu as every other context (ADR-0094 B1).
    ws-menu := CommandMenu { context: "workspace"; }
    add-source-menu := CommandMenu { context: "add-source"; }
    vertical-menu := CommandMenu { context: "vertical-outputs"; }
    function open-app-menu() { AppMenus.open = true; }
    property <int> asked: Shell.app-menu-asked;
    changed asked => { open-app-menu(); }
}

// A status bar item that opens a menu: "<label> <value>".
component StatusPicker inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Tokens.radius-sm;
    background: touch.has-hover ? Theme.surface-overlay : transparent;
    accessible-role: button;
    accessible-label: @tr("{}: {}", label, value);
    accessible-action-default => { clicked(); }
    forward-focus: focus;
    focus := RingFocus {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    touch := TouchArea { clicked => { focus.focus-pointer(); root.clicked(); } }
    row := HorizontalLayout {
        padding-left: Tokens.space-1;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-1;
        Text {
            text: label;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
        Text {
            text: value;
            color: Theme.text-primary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
    }
    FocusRing { show: focus.ring; }
}

// The status bar (spec Frame): live and recording state in words, the Output profile
// and Scene collection in use (each opens its menu), and the canvas. It shows values
// the app already has; it polls nothing (P13).
component StatusBar inherits Rectangle {
    // The duration and the outputs (file name, server) live here, not in the
    // frame's compact live indicator.
    property <string> outputs: Shell.live-outputs != "" ? " · " + Shell.live-outputs : "";
    property <string> state-text: Shell.live-state == 1 ? @tr("Live {} · not recording", Shell.live-duration) + outputs
        : Shell.live-state == 2 ? (Shell.audio-only ? @tr("Recording audio {}", Shell.live-duration) : @tr("Recording {}", Shell.live-duration)) + outputs
        : Shell.live-state == 3 ? (Shell.audio-only ? @tr("Live and recording audio {}", Shell.live-duration) : @tr("Live and recording {}", Shell.live-duration)) + outputs
        : @tr("Not live · not recording");
    property <string> text-with-camera: !Shell.live-camera ? state-text
        : Shell.live-state == 0 ? @tr("Virtual camera on · not live · not recording")
        : @tr("{} · virtual camera on", state-text);
    property <bool> on: Shell.live-state != 0 || Shell.live-camera;
    height: Tokens.size-control-sm + 2 * Tokens.size-border;
    // The window ground (ADR-0112 decision 1).
    background: Theme.surface-base;
    Rectangle {
        y: 0;
        height: Tokens.size-border;
        background: Theme.border-subtle;
    }
    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-3;
        padding-top: Tokens.size-border;
        spacing: Tokens.space-4;
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Tokens.space-1;
            if on: VerticalLayout {
                alignment: center;
                Icon { name: IconName.dot; ink: Theme.state-live; }
            }
            Text {
                text: text-with-camera;
                color: on ? Theme.text-primary : Theme.text-secondary;
                font-size: Tokens.type-caption-size;
                vertical-alignment: center;
            }
        }
        if Studio.st-text != "": Text {
            horizontal-stretch: 0;
            text: Studio.st-text;
            color: Studio.st-bad ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
        // What the Live controls panel said under its buttons (ADR-0073): the last
        // recording's outcome ("Saved ..."), or why recording is not possible, and the
        // virtual camera's state. Long paths are cut in the middle of the bar's room.
        if Studio.rec-state == 0 && (Studio.rec-unavailable != "" || Studio.rec-note != ""): Text {
            horizontal-stretch: 1;
            text: Studio.rec-unavailable != "" ? Studio.rec-unavailable : Studio.rec-note;
            color: Studio.rec-unavailable != "" || Studio.rec-note-bad ? Theme.state-error : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            overflow: elide;
        }
        if Studio.vcam-shown && Studio.vcam-text != "": Text {
            horizontal-stretch: 0;
            text: Studio.vcam-text;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        profile-button := StatusPicker {
            label: @tr("Output profile");
            value: Studio.profile-name;
            clicked => { profile-menu.open({ x: profile-button.x, y: profile-button.y }); }
        }
        collection-button := StatusPicker {
            label: @tr("Scene collection");
            value: Studio.collection-name;
            clicked => { collection-menu.open({ x: collection-button.x, y: collection-button.y }); }
        }
        if Studio.canvas-label != "": Text {
            horizontal-stretch: 0;
            text: Studio.canvas-rates.length > Studio.canvas-rate && Studio.canvas-rate >= 0
                ? @tr("{} · {} fps", Studio.canvas-label, Studio.canvas-rates[Studio.canvas-rate])
                : Studio.canvas-label;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
    }
    // The Output profile and Scene collection menus (ADR-0094 rule B1); each opens
    // at the top-left of its picker.
    profile-menu := CommandMenu { context: "profiles"; }
    collection-menu := CommandMenu { context: "collections"; }
}

// A notice card (undo toast, delete toast, error bar). One control tall and at
// most `size.toast.max` wide: stretch stays 0, because a layout that stretches
// inside a free-floating child of the window takes the window and covers the
// preview. The fill stays quiet; the outline, the side mark and the icon are
// what make it visible on every theme. While `timed`, the seconds left sit at
// the right end in an edge-coloured chip with a filled hourglass, and the card
// closes when they run out; Dismiss closes it sooner. The countdown steps
// by `delay.toast-tick` (not an animation, so it still runs under reduce motion).
// The first-close notice sets `timed` off: its buttons hide the windows (ADR-0056).
component Toast inherits Rectangle {
    in property <string> text;
    in property <string> action;
    // The action button's lead icon (`none` draws the words alone).
    in property <IconName> action-icon: IconName.none;
    // Reports its rectangle as `Shell.top-toast` (the error bar) instead of
    // `Shell.bottom-toast`.
    in property <bool> top;
    in property <bool> timed: true;
    // A new notice, even with the same words, starts the countdown again.
    in property <int> generation;
    in property <IconName> mark: IconName.info;
    callback act();
    callback dismiss();
    // A direct child of the window, so its own coordinates are the window's.
    property <Cover> rect: { x: self.x, y: self.y, width: self.width, height: self.height };
    property <int> total-ms: round(Tokens.delay-toast / 1ms);
    property <int> tick-ms: max(1, round(Tokens.delay-toast-tick / 1ms));
    property <int> left-ms: total-ms;
    // Never reads 0: the last step closes the card while it still says 1 s.
    property <int> seconds: max(1, ceil(root.left-ms * 1.0 / root.tick-ms));
    // False, then true, restarts the one-second step (a running timer keeps its phase).
    property <bool> clock: false;
    init => { report(); root.restart(); }
    changed rect => { report(); }
    changed generation => { root.restart(); }
    changed text => { root.restart(); }
    function report() {
        if top { Shell.top-toast = rect; } else { Shell.bottom-toast = rect; }
    }
    function restart() {
        root.left-ms = root.total-ms;
        if root.timed {
            root.clock = false;
            root.clock = true;
        }
    }
    Timer {
        interval: Tokens.delay-toast-tick;
        running: root.clock;
        triggered => {
            root.clock = false;
            if root.left-ms <= root.tick-ms {
                root.left-ms = 0;
                root.dismiss();
            } else {
                root.left-ms = root.left-ms - root.tick-ms;
                root.clock = true;
            }
        }
    }
    horizontal-stretch: 0;
    vertical-stretch: 0;
    // The row, its vertical padding and the outline. Fixed, so the card cannot
    // grow with the window the way an unsized layout does.
    height: Tokens.size-control-md + 2 * Tokens.space-1 + 2 * Tokens.size-toast-border;
    width: min(Tokens.size-toast-max, body.preferred-width);
    background: Theme.toast-surface;
    border-color: Theme.toast-edge;
    border-width: Tokens.size-toast-border;
    border-radius: Tokens.radius-md;
    clip: true;
    accessible-role: none;
    body := HorizontalLayout {
        alignment: center;
        Rectangle {
            width: Tokens.size-toast-rail;
            vertical-stretch: 1;
            background: Theme.toast-edge;
            accessible-role: none;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: Tokens.space-3;
            padding-right: Tokens.space-3;
            padding-top: Tokens.space-1;
            padding-bottom: Tokens.space-1;
            spacing: Tokens.space-3;
            alignment: center;
            // A fixed-height button stays at the top of a row that stretches. Centre
            // every child on the card, the words included.
            cross-axis-alignment: center;
            VerticalLayout {
                alignment: center;
                width: Tokens.size-icon-box;
                Icon { name: root.mark; ink: Theme.toast-edge; }
            }
            Text {
                text: root.text;
                color: Theme.text-primary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                max-width: Tokens.size-toast-max;
                overflow: elide;
            }
            if action != "": Button {
                text: root.action;
                kind: "primary";
                lead: root.action-icon;
                clicked => { act(); }
            }
            Button {
                text: @tr("Dismiss");
                kind: "secondary";
                lead: IconName.close;
                clicked => { dismiss(); }
            }
            // Past the buttons, so the time reads as the end of the card, not another action.
            // The chip is the edge colour with the surface colour on it, so the passing
            // time stands out from the quiet fill.
            if root.timed: VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                padding-left: Tokens.space-3;
                Rectangle {
                    horizontal-stretch: 0;
                    background: Theme.toast-edge;
                    border-radius: Tokens.radius-sm;
                    HorizontalLayout {
                        padding-left: Tokens.space-2;
                        padding-right: Tokens.space-2;
                        padding-top: Tokens.space-1;
                        padding-bottom: Tokens.space-1;
                        spacing: Tokens.space-1;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Icon { name: IconName.hourglass; ink: Theme.toast-surface; }
                        }
                        Text {
                            horizontal-stretch: 0;
                            text: @tr("{} s", root.seconds);
                            color: Theme.toast-surface;
                            font-size: Tokens.type-body-size;
                            font-weight: Tokens.type-label-weight;
                            vertical-alignment: center;
                            accessible-label: @tr("{n} second left" | "{n} seconds left" % root.seconds);
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    default-font-family: Theme.font-family;
    title: @tr("RBS");
    icon: @image-url("../assets/brand/icon-win-256.png");
    preferred-width: Tokens.size-window-w;
    preferred-height: Tokens.size-window-h;
    min-width: Tokens.size-window-min-w;
    min-height: Tokens.size-window-min-h;
    // The width the frame row wants for every item at full size; a test holds it inside the window's
    // minimum width in every density (ADR-0112 decision 12, U11).
    out property <length> frame-row-width: frame.wanted-width;
    // The window ground (ADR-0112 decision 1).
    background: Theme.surface-base;
    default-font-size: Tokens.type-body-size;
    in property <[StackData]> stacks;
    in property <[HandleData]> handles;
    in property <RailData> rail;
    forward-focus: edit-keys;
    // BEGIN generated menu bar (menu_bar.rs; do not edit)
    if Shell.native-menu-bar: MenuBar {
        Menu {
            title: @tr("File");
            Menu {
                title: Menus.titles[0];
                icon: Menus.icons[0];
                enabled: Menus.enabled[0];
                for c in Menus.choices[0]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            Menu {
                title: Menus.titles[1];
                icon: Menus.icons[1];
                enabled: Menus.enabled[1];
                for c in Menus.choices[1]: MenuItem { title: c.title; icon: c.icon; checkable: true; checked: c.checked; activated => { Menus.run(c.id); } }
            }
            MenuSeparator { }
