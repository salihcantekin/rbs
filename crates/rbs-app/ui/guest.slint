// The guest window (ADR-0139 phase 1d, docs/specs/peer-port.md): one window for both
// flows. Share sends this RBS's program (invite code out, answer code in); Add guest
// receives a guest (invite code in, answer code out). Both end on the check phrase,
// six words the two users compare by voice. Rust (`guest_page`) pushes what to show,
// computed by `rbs_app::guest_view`; the window holds no state of its own.
import { Theme, Tokens } from "tokens.slint";
import { Button, DialogActions, Icon, IconButton, OverlayHost, TextField } from "components.slint";
import { IconName } from "base/types.slint";

// A step of the header strip: a numbered circle, then its name. `mark`: 0 not reached,
// 1 current, 2 done.
component StepMark inherits HorizontalLayout {
    in property <string> text;
    in property <string> number;
    in property <int> mark;
    spacing: Tokens.space-1;
    alignment: start;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Rectangle {
        width: Tokens.size-guest-step-dot;
        height: Tokens.size-guest-step-dot;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: Tokens.size-border;
        border-color: root.mark == 2 ? Theme.state-healthy : root.mark == 1 ? Theme.accent : Theme.border-strong;
        background: root.mark == 1 ? Theme.accent : transparent;
        if root.mark == 2: Icon {
            name: IconName.check;
            ink: Theme.state-healthy;
            width: parent.width;
            height: parent.height;
        }
        if root.mark != 2: Text {
            text: root.number;
            color: root.mark == 1 ? Theme.text-inverse : Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
    Text {
        text: root.text;
        color: root.mark == 0 ? Theme.text-disabled : root.mark == 1 ? Theme.text-primary : Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        vertical-alignment: center;
    }
}

// The state of a pairing as a pill: a dot in the tone's colour and the words. `tone`:
// 0 neutral, 1 healthy, 2 error, 3 warning. Never the live red (rule U12).
component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <int> tone;
    background: Theme.surface-sunken;
    border-radius: self.height / 2;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    min-width: row.min-width;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    row := HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        padding-top: Tokens.space-1;
        padding-bottom: Tokens.space-1;
        spacing: Tokens.space-1;
        Rectangle {
            width: Tokens.size-guest-status-dot;
            height: Tokens.size-guest-status-dot;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: root.tone == 1 ? Theme.state-healthy
                : root.tone == 2 ? Theme.state-error
                : root.tone == 3 ? Theme.state-warning : Theme.text-secondary;
        }
        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: Tokens.type-caption-size;
            vertical-alignment: center;
        }
    }
}

// One word of the check phrase, numbered so two users can read them out in order.
component WordChip inherits Rectangle {
    in property <string> word;
    in property <int> number;
    horizontal-stretch: 1;
    preferred-width: 0px;
    height: Tokens.size-guest-word-h;
    background: Theme.accent-subtle;
    border-radius: Tokens.radius-md;
    accessible-role: AccessibleRole.text;
    accessible-label: root.number + ": " + root.word;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.number;
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            horizontal-alignment: center;
        }
        Text {
            text: root.word;
            color: Theme.text-primary;
            font-size: Tokens.type-title-size;
            font-weight: Tokens.type-title-weight;
            horizontal-alignment: center;
        }
    }
}

// A code the user copies: the text, wrapped and cut to `size.guest.code.h`, and a copy
// button. The whole code is copied, not the part shown.
component CodeBox inherits Rectangle {
    in property <string> code;
    in property <bool> ready;
    in-out property <bool> copied;
    height: Tokens.size-guest-code-h;
    background: Theme.surface-sunken;
    border-radius: Tokens.radius-md;
    border-width: Tokens.size-border;
    border-color: Theme.border-subtle;
    clip: true;
    // The text to copy from: a hidden input, as `CopyText` does.
    clip := TextInput {
        visible: false;
        text: root.code;
        read-only: true;
    }
    HorizontalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-2;
        Text {
            text: root.ready ? root.code : @tr("Preparing the code…");
            color: Theme.text-secondary;
            font-size: Tokens.type-caption-size;
            wrap: char-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        IconButton {
            name: root.copied ? @tr("Copied") : @tr("Copy code");
            lead: root.copied ? IconName.check : IconName.copy;
            enabled: root.ready;
            clicked => {
                clip.select-all();
                clip.copy();
                clip.clear-selection();
                root.copied = true;
            }
        }
    }
}

// A line of explanation with a leading icon.
component Note inherits HorizontalLayout {
    in property <string> text;
    in property <IconName> icon: IconName.info;
    spacing: Tokens.space-2;
    VerticalLayout {
        alignment: start;
        Icon {
            name: root.icon;
            ink: Theme.text-secondary;
            width: Tokens.size-icon-box;
            height: Tokens.size-icon-box;
        }
    }
    // The width is fixed (the window's, less its padding and the icon) so the layout
    // measures the wrapped text, and the window is as high as its lines need.
    Text {
        text: root.text;
        color: Theme.text-secondary;
        font-size: Tokens.type-caption-size;
        wrap: word-wrap;
        width: Tokens.size-guest-w - 2 * Tokens.space-4 - Tokens.size-icon-box - Tokens.space-2;
    }
}

export component GuestWindow inherits Window {
    default-font-family: Theme.font-family;
    default-font-size: Tokens.type-body-size;
    title: root.heading;
    icon: @image-url("../assets/brand/icon-win-256.png");
    preferred-width: Tokens.size-guest-w;
    min-width: Tokens.size-guest-w;
    max-width: Tokens.size-guest-w;
    preferred-height: layout.preferred-height;
    // The height the window opens at, for the shell to place it.
    out property <length> wanted-height: layout.preferred-height;
    background: Theme.surface-raised;

    // This side sends its program (Share), or receives a guest (Add guest).
    in property <bool> sharing;
    // 0 Invite, 1 Answer, 2 Compare, 3 Live, 4 Failed (`rbs_app::guest_view::Page`).
    in property <int> page;
    in property <string> heading;
    in property <string> hint;
    // The marks of the three steps: 0 not reached, 1 current, 2 done.
    in property <[int]> steps: [0, 0, 0];
    in property <string> badge;
    in property <int> tone;
    in property <string> expires;
    in property <string> failure;
    // The code to copy (the invite when sharing, the answer when adding a guest).
    in property <string> code;
    in property <bool> code-ready;
    in property <bool> paste-enabled;
    // The first three and the last three words of the check phrase.
    in property <[string]> words-top;
    in property <[string]> words-bottom;
    // A problem with what was pasted or with a call; empty when none.
    in property <string> problem;
    in property <bool> busy;
    in-out property <string> pasted;

    // The pasted text: Share takes the answer, Add guest takes the invite.
    callback submit(string);
    // The words match.
    callback confirm();
    // The words differ: end the pairing.
    callback mismatch();
    // End the running share or remove the guest.
    callback stop();
    // Start again after a failure.
    callback again();
    callback dismiss();

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            reject
        }
        layout := VerticalLayout {
            // Header band.
            Rectangle {
                vertical-stretch: 0;
                background: Theme.surface-overlay;
                HorizontalLayout {
                    padding: Tokens.space-3;
                    padding-left: Tokens.space-4;
                    spacing: Tokens.space-3;
                    Rectangle {
                        width: Tokens.size-row-picture-md;
                        height: Tokens.size-row-picture-md;
                        background: Theme.accent-subtle;
                        border-radius: Tokens.radius-md;
                        Icon {
                            name: root.sharing ? IconName.link : IconName.user;
                            ink: Theme.accent;
                            width: Tokens.size-icon-box;
                            height: Tokens.size-icon-box;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.heading;
                            color: Theme.text-primary;
                            font-size: Tokens.type-title-size;
                            font-weight: Tokens.type-title-weight;
                        }
                        if root.hint != "": Text {
                            text: root.hint;
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            wrap: word-wrap;
                        }
                    }
                    IconButton {
                        name: @tr("Close");
                        lead: IconName.close;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.dismiss(); }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 0;
                height: Tokens.size-border;
                background: Theme.border-subtle;
            }

            // Body.
            VerticalLayout {
                vertical-stretch: 1;
                padding-left: Tokens.space-4;
                padding-right: Tokens.space-4;
                padding-top: Tokens.space-3;
                padding-bottom: Tokens.space-3;
                spacing: Tokens.space-3;
                alignment: start;

                if root.page < 3: HorizontalLayout {
                    spacing: Tokens.space-3;
                    StepMark { text: @tr("Invite"); number: "1"; mark: root.steps[0]; }
                    StepMark { text: @tr("Answer"); number: "2"; mark: root.steps[1]; }
                    StepMark { text: @tr("Compare"); number: "3"; mark: root.steps[2]; }
                }

                // Invite page. Sharing: the invite code, then the answer box. Adding a
                // guest: the invite box.
                if root.page == 0 && root.sharing: VerticalLayout {
                    spacing: Tokens.space-2;
                    Text {
                        text: @tr("Your invite code");
                        color: Theme.text-primary;
                        font-weight: Tokens.type-label-weight;
                    }
                    CodeBox { code: root.code; ready: root.code-ready; }
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        alignment: start;
                        StatusBadge { text: root.badge; tone: root.tone; }
                        if root.expires != "": Text {
                            text: @tr("Invite expires in {}", root.expires);
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: @tr("Paste the answer code you get back");
                        color: Theme.text-primary;
                        font-weight: Tokens.type-label-weight;
                    }
                    TextField {
                        label: @tr("Answer code");
                        placeholder: @tr("Paste the answer code here");
                        enabled: root.paste-enabled && !root.busy;
                        text <=> root.pasted;
                        accepted(t) => { root.submit(t); }
                    }
                    Note { text: @tr("The other side will see your public IP address. Send the codes by a channel you trust, such as a chat message."); }
                }
                if root.page == 0 && !root.sharing: VerticalLayout {
                    spacing: Tokens.space-2;
                    TextField {
                        label: @tr("Invite code");
                        placeholder: @tr("Paste the invite code here");
                        enabled: !root.busy;
                        text <=> root.pasted;
                        accepted(t) => { root.submit(t); }
                    }
                    Note { text: @tr("The guest will see your public IP address."); }
                }

                // Answer page (adding a guest): the answer code to send back.
                if root.page == 1: VerticalLayout {
                    spacing: Tokens.space-2;
                    CodeBox { code: root.code; ready: root.code-ready; }
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        alignment: start;
                        StatusBadge { text: root.badge; tone: root.tone; }
                        if root.expires != "": Text {
                            text: @tr("Answer expires in {}", root.expires);
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            vertical-alignment: center;
                        }
                    }
                }

                // Compare page: the six words.
                if root.page == 2: VerticalLayout {
                    spacing: Tokens.space-2;
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        for w[i] in root.words-top: WordChip { word: w; number: i + 1; }
                    }
                    HorizontalLayout {
                        spacing: Tokens.space-2;
                        for w[i] in root.words-bottom: WordChip { word: w; number: i + 4; }
                    }
                    Note {
                        text: root.sharing
                            ? @tr("Read the six words aloud to your host, on a call or another channel than the one that carried the codes. Share only if they match.")
                            : @tr("Ask your guest to read their words aloud. Add the guest only if they match.");
                    }
                }

                // Live page.
                if root.page == 3: VerticalLayout {
                    spacing: Tokens.space-2;
                    HorizontalLayout {
                        alignment: start;
                        StatusBadge { text: root.badge; tone: root.tone; }
                    }
                }

                // Failed page.
                if root.page == 4: Note {
                    icon: IconName.warning;
                    text: root.failure;
                }

                if root.problem != "": Note {
                    icon: IconName.warning;
                    text: root.problem;
                }
            }

            // Footer band.
            Rectangle {
                vertical-stretch: 0;
                height: Tokens.size-border;
                background: Theme.border-subtle;
            }
            Rectangle {
                vertical-stretch: 0;
                background: Theme.surface-overlay;
                HorizontalLayout {
                    padding: Tokens.space-3;
                    padding-left: Tokens.space-4;
                    padding-right: Tokens.space-4;
                    spacing: Tokens.space-2;
                    if root.page == 0: DialogActions {
                        confirm-text: root.sharing ? @tr("Connect") : @tr("Make answer code");
                        confirm-enabled: !root.busy && root.pasted != "" && (root.sharing ? root.paste-enabled : true);
                        cancelled => { root.dismiss(); }
                        confirmed => { root.submit(root.pasted); }
                    }
                    if root.page == 1: DialogActions {
                        cancelled => { root.dismiss(); }
                    }
                    if root.page == 2: DialogActions {
                        cancel-text: root.sharing ? @tr("They differ: stop") : @tr("They differ: remove");
                        confirm-text: root.sharing ? @tr("They match: start sharing") : @tr("They match: add guest");
                        confirm-enabled: !root.busy;
                        cancelled => { root.mismatch(); }
                        confirmed => { root.confirm(); }
                    }
                    if root.page == 3: DialogActions {
                        cancel-text: @tr("Close");
                        confirm-text: root.sharing ? @tr("Stop sharing") : @tr("Remove guest");
                        confirm-kind: "danger";
                        cancelled => { root.dismiss(); }
                        confirmed => { root.stop(); }
                    }
                    if root.page == 4: DialogActions {
                        cancel-text: @tr("Close");
                        confirm-text: @tr("Start again");
                        cancelled => { root.dismiss(); }
                        confirmed => { root.again(); }
                    }
                }
            }
        }
    }
    // The info hint and tooltip layer, drawn last (ADR-0094).
    OverlayHost { width: parent.width; height: parent.height; }
}
