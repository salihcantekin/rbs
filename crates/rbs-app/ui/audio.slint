// Settings › Audio (ADR-0097 F1, docs/specs/ui-design-system.md): the Monitor card,
// with the monitor's device, its volume and its state, and the Loudness card (ADR-0092:
// Show loudness, the target and the true-peak limit). These settings belong to this
// computer (`monitor.toml`, `loudness.toml`), not to the scene collection. Rust pushes the state into
// the `Studio` global and lists the devices when the page is shown.
import { Theme, Tokens } from "tokens.slint";
import { NumberField, Select, Slider, Toggle, ValueReadout, SettingValue, SettingRow } from "components.slint";
import { SettingsCard, SettingsStatus } from "settings.slint";
import { Studio } from "base/types.slint";


export component AudioSettings inherits Rectangle {
    // The fader position while a drag runs; -1 otherwise. Cleared once the host
    // reports that position, so the knob does not jump back before the answer.
    property <float> drag: -1;
    property <float> shown-volume: Studio.monitor-volume;
    changed shown-volume => {
        if root.drag >= 0 && Math.abs(root.shown-volume - root.drag) < 0.02 {
            root.drag = -1;
        }
    }
    form := VerticalLayout {
        spacing: Tokens.space-4;
        alignment: start;
        SettingsCard {
            title: @tr("Monitor");
            id: "settings.audio.monitor";
            description: @tr("Hear sources in headphones without sending them to the outputs. These settings belong to this computer.");
            SettingRow {
                find: "audio.monitor-device";
                divider: false;
                label: @tr("Device");
                summary: @tr("Where you listen");
                hint: @tr("System default follows the computer's default output. A chosen device stays chosen while it is unplugged.");
                enabled: Studio.monitor-available;
                Select {
                    label: @tr("Monitor device");
                    options: Studio.monitor-devices;
                    index: Studio.monitor-device;
                    enabled: Studio.monitor-available;
                    selected(i) => { Studio.set-monitor-device(i); }
                }
            }
            SettingRow {
                find: "audio.monitor-volume";
                label: @tr("Volume");
                summary: @tr("Only what you hear");
                hint: @tr("The monitor's own level. It does not change the stream or the recording.");
                enabled: Studio.monitor-available;
                // Position 1 is 0 dB, the top of the fader and the default.
                changed: Studio.monitor-available && Studio.monitor-volume < 1;
                default-text: @tr("0 dB");
                reset => { root.drag = -1; Studio.set-monitor-volume(1); }
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    Slider {
                        horizontal-stretch: 1;
                        label: @tr("Monitor volume");
                        value: root.drag >= 0 ? root.drag : Studio.monitor-volume;
                        value-text: Studio.monitor-volume-text;
                        enabled: Studio.monitor-available;
                        moved(v) => { root.drag = v; Studio.preview-monitor-volume(v); }
                        released => { if root.drag >= 0 { Studio.set-monitor-volume(root.drag); } }
                        cancelled => { root.drag = -1; Studio.preview-monitor-volume(-1); }
                        reset => { root.drag = -1; Studio.set-monitor-volume(1); }
                    }
                    ValueReadout { text: Studio.monitor-volume-text; }
                }
            }
            SettingsStatus {
                text: Studio.monitor-status;
                tone: Studio.monitor-tone;
            }
            SettingRow {
                find: "audio.monitor-latency";
                label: @tr("Latency");
                summary: @tr("How late the monitor is");
                hint: @tr("The monitor goes through the mix, so it lags the sound by this much. For playing live, use your audio interface's direct monitoring.");
                SettingValue {
                    text: Studio.monitor-latency != "" ? Studio.monitor-latency : @tr("Shown while the monitor plays");
                    muted: Studio.monitor-latency == "";
                }
            }
        }
        SettingsCard {
            title: @tr("Silence check");
            id: "settings.audio.silence";
            description: @tr("Catches a recording or stream that would carry no voice.");
            SettingRow {
                find: "audio.warn-silent";
                divider: false;
                label: @tr("Warn without a microphone");
                summary: @tr("Before Record and Go live");
                hint: @tr("Asks first when no microphone in the scene is heard: muted, hidden or missing.");
                fill: false;
                Toggle {
                    label: @tr("Warn without a microphone");
                    checked: Studio.warn-silent;
                    toggled(on) => { Studio.set-warn-silent(on); }
                }
            }
        }
        SettingsCard {
            title: @tr("Loudness");
            id: "settings.audio.loudness";
            description: @tr("How loud the program sounds, the way streaming sites and broadcasters measure it (LUFS).");
            SettingRow {
                find: "audio.loudness-show";
                divider: false;
                label: @tr("Show loudness");
                summary: @tr("On the Master strip");
                hint: @tr("Measures the master mix while shown. It uses a little CPU and changes nothing you hear.");
                fill: false;
                Toggle {
                    label: @tr("Show loudness");
                    checked: Studio.loudness.on;
                    toggled(on) => { Studio.set-loudness-shown(on); }
                }
            }
            SettingRow {
                find: "audio.loudness-target";
                label: @tr("Target");
                summary: @tr("The mark on the loudness bar");
                hint: @tr("YouTube and most streaming sites play at about −14 LUFS, podcasts at −16.");
                changed: Studio.loudness-target != 0;
                default-text: @tr("Streaming");
                reset => { Studio.set-loudness-target(0); }
                Select {
                    label: @tr("Loudness target");
                    options: Studio.loudness-targets;
                    index: Studio.loudness-target;
                    selected(i) => { Studio.set-loudness-target(i); }
                }
            }
            if Studio.loudness-target == Studio.loudness-targets.length - 1: SettingRow {
                find: "audio.loudness-custom";
                label: @tr("Custom target");
                summary: @tr("In LUFS");
                fill: false;
                NumberField {
                    live: false;
                    label: @tr("Custom target");
                    unit: "LUFS";
                    value: Studio.loudness-target-lufs;
                    step: 0.5;
                    edited(v) => { Studio.set-loudness-target-lufs(v); }
                }
            }
            SettingRow {
                find: "audio.loudness-limit";
                label: @tr("True-peak limit");
                summary: @tr("Lights the dot when passed");
                hint: @tr("Peaks above this may distort after encoding. −1 dBTP suits most sites.");
                changed: Studio.loudness-limit != -1;
                default-text: @tr("−1 dBTP");
                reset => { Studio.set-loudness-limit(-1); }
                fill: false;
                NumberField {
                    live: false;
                    label: @tr("True-peak limit");
                    unit: "dBTP";
                    value: Studio.loudness-limit;
                    step: 0.1;
                    edited(v) => { Studio.set-loudness-limit(v); }
                }
            }
        }
    }
    preferred-height: form.preferred-height;
    min-height: form.min-height;
}
