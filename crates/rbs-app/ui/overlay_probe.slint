// A window for tests/overlays.rs: the info hint and the tooltip as the real library
// components draw them (ADR-0094). Not shown by the app.
import { Theme, Tokens } from "tokens.slint";
import { Button, SplitButton, InfoHint, IconButton, OverlayHost, FeatureSection, ColorPicker, Select, Tabs, ScrollArea, SettingRow, Toggle, NumberField, SegmentedControl, SettingValue } from "components.slint";
import { SettingsCard } from "settings.slint";
import { PropertiesPanel } from "studio.slint";
import { ReplayControls } from "replay.slint";
import { IconName, Experience } from "base/types.slint";

export component OverlayProbe inherits Window {
    // literal-begin: a test window; its size and the places of its two controls are test data
    width: 400px;
    height: 300px;
    out property <bool> hint-focused: hint.focused;
    hint := InfoHint {
        x: 10px;
        y: 10px;
        label: "Threshold";
        text: "Sound below this level is muted.";
        detail: "Default -40 dB";
    }
    button := IconButton {
        x: 100px;
        y: 10px;
        icon: IconName.flip-h;
        name: "Flip horizontally";
    }
    out property <string> last-pick;
    out property <bool> colour-focused: colour.focused;
    colour := ColorPicker {
        x: 200px;
        y: 10px;
        label: "Border colour";
        value: #112233;
        picked(hex) => { root.last-pick = hex; }
    }
    out property <bool> feature-on: feature.on;
    out property <length> feature-height: feature.height;
    feature := FeatureSection {
        x: 10px;
        y: 100px;
        width: 300px;
        height: self.preferred-height;
        id: "probe.feature";
        title: "Noise gate";
        hint: "Mutes sound below the threshold.";
        Rectangle { height: 40px; }
    }
    out property <int> tab-index;
    tabs := Tabs {
        x: 10px;
        y: 240px;
        width: 300px;
        label: "Properties";
        options: ["Transform", "Filters", "Audio"];
        index: root.tab-index;
        selected(i) => { root.tab-index = i; }
    }
    in property <[string]> select-options;
    in-out property <int> select-index: -1;
    long-select := Select {
        x: 10px;
        y: 60px;
        width: 150px;
        label: "Mode";
        options: root.select-options;
        index: root.select-index;
        selected(i) => { root.select-index = i; }
    }
    // literal-end
    public function focus-select() { long-select.focus(); }
    public function flip-feature() { feature.on = !feature.on; }
    public function focus-hint() { hint.take-focus(); }
    public function focus-button() { button.take-focus(); }
    OverlayHost { width: parent.width; height: parent.height; }
}

// A window for tests/overlays.rs: Tab into a row whose help lies below a scrolled
// area shows the whole row (FocusReveal), not only its control.
export component FocusRevealProbe inherits Window {
    // literal-begin: a test window; its size and the gap that pushes the row down are test data
    width: 300px;
    height: 200px;
    out property <length> offset: area.offset;
    out property <length> view-height: area.view-height;
    out property <length> row-bottom: second.y + second.height;
    area := ScrollArea {
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            width: parent.width;
            height: self.preferred-height;
            first := SettingRow {
                label: "First";
                fill: false;
                t1 := Toggle { label: "First"; }
            }
            Rectangle { height: 150px; }
            second := SettingRow {
                label: "Second";
                help: "Help under the name that wraps onto a second line in this narrow window.";
                fill: false;
                Toggle { label: "Second"; }
            }
            Rectangle { height: 300px; }
        }
    }
    // literal-end
    public function focus-first() { t1.focus(); }
}

// A window for tests/overlays.rs: a setting row shows its (i) only while the pointer
// is over the row or the (i) has the focus.
export component SettingRowProbe inherits Window {
    // literal-begin: a test window; its size and the row's place are test data
    width: 400px;
    height: 200px;
    out property <bool> hint-shown: row.hint-shown;
    in-out property <bool> changed;
    in-out property <length> row-width: 400px;
    out property <bool> reset-shown: row.reset-shown;
    out property <int> resets;
    row := SettingRow {
        changed: root.changed;
        default-text: "Off";
        reset => { root.resets += 1; root.changed = false; }
        x: 0px;
        y: 0px;
        width: root.row-width;
        height: self.preferred-height;
        divider: false;
        label: "Glide";
        summary: "Shared sources slide between scenes";
        hint: "Shared sources slide to their new place; new sources fade in.";
        fill: false;
        Toggle { label: "Glide"; }
    }
    // literal-end
}

// A window for tests/overlays.rs: rows that leave `fill` at its default. A switch and a
// shown value cannot grow, so the row puts them at its right edge; a drop-down fills
// the column up to the same edge (owner decision 2026-11-17).
export component SettingRowAlignProbe inherits Window {
    // literal-begin: a test window; its size and the rows' place are test data
    width: 600px;
    height: 300px;
    in-out property <length> row-width: 600px;
    VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.row-width;
        alignment: start;
        // literal-end
        switch-row := SettingRow {
            divider: false;
            label: "Record separate files";
            switch := Toggle { label: "Record separate files"; }
        }
        value-row := SettingRow {
            label: "Sound files";
            value := SettingValue { text: "WAV, 24-bit"; muted: true; }
        }
        pick-row := SettingRow {
            label: "Container";
            pick := Select { label: "Container"; options: ["MKV", "MP4"]; }
        }
    }
    out property <length> row-right: switch-row.absolute-position.x + switch-row.width;
    out property <length> switch-left: switch.absolute-position.x;
    out property <length> switch-right: switch.absolute-position.x + switch.width;
    out property <length> switch-own: switch.preferred-width;
    out property <length> value-left: value.absolute-position.x;
    out property <length> value-right: value.absolute-position.x + value.width;
    out property <length> value-own: value.preferred-width;
    out property <length> pick-left: pick.absolute-position.x;
    out property <length> pick-right: pick.absolute-position.x + pick.width;
    out property <bool> stacked: switch-row.stacked;
}

// A window for tests/overlays.rs: drag to change on a NumberField.
export component NumberFieldProbe inherits Window {
    // literal-begin: a test window; its size and the field's place are test data
    width: 300px;
    height: 100px;
    in-out property <float> value: 10;
    out property <int> edits;
    field := NumberField {
        x: 0px;
        y: 0px;
        width: 200px;
        label: "Width";
        value: root.value;
        edited(v) => { root.edits += 1; root.value = v; }
    }
    // literal-end
}

// A window for tests/overlays.rs: a section level written as the app writes it
// (ADR-0113 decisions 1 and 4).
export component ExperienceProbe inherits Window {
    // literal-begin: a test window; its size is test data
    width: 400px;
    height: 300px;
    // literal-end
    out property <int> made;
    out property <bool> show-all: card.show-all;
    card := SettingsCard {
        title: "Encoding";
        more-hidden: !Experience.expert;
        if Experience.expert || card.show-all: Rectangle {
            init => { root.made += 1; }
        }
    }
}

// A window for tests/effects_render.rs (ADR-0120 decision 11, ADR-0122 decision 10): the
// rows the rendered tests name, laid out with the library spacing. Each `focus-*` gives
// one control the keyboard focus, so its ring shows. The last row is a position that
// opts in to the primary's halo and keeps its clear zone. Not shown by the app.
export component EffectsProbe inherits Window {
    // literal-begin: a test window; its size and padding are test data
    width: 480px;
    height: 400px;
    background: Theme.surface-base;
    VerticalLayout {
        padding: 16px;
        // literal-end
        spacing: Tokens.space-2;
        alignment: start;
        // A keyboard-focused Button between two neighbours at space.1.
        HorizontalLayout {
            spacing: Tokens.space-1;
            alignment: start;
            first := Button { text: "Left"; kind: "primary"; }
            mid := Button { text: "Focused"; }
            right := Button { text: "Right"; kind: "primary"; }
        }
        // The Go live / Record SplitButton row at space.2.
        HorizontalLayout {
            spacing: Tokens.space-2;
            alignment: start;
            go := SplitButton { text: "Go live"; kind: "primary"; menu-name: "Vertical stream"; }
            rec := SplitButton { text: "Record"; menu-name: "Vertical recording"; }
            studio := Button { text: "Studio mode"; checked: true; }
        }
        // An IconButton row at space.1.
        HorizontalLayout {
            spacing: Tokens.space-1;
            alignment: start;
            one := IconButton { name: "One"; icon: IconName.gear; framed: true; }
            icon := IconButton { name: "Two"; icon: IconName.gear; framed: true; }
            three := IconButton { name: "Three"; icon: IconName.gear; checked: true; }
        }
        // A vertical pair: a Button above an IconButton at space.1.
        VerticalLayout {
            spacing: Tokens.space-1;
            alignment: start;
            HorizontalLayout { alignment: start; above := Button { text: "Above"; kind: "primary"; } }
            HorizontalLayout { alignment: start; below := IconButton { name: "Below"; icon: IconName.gear; framed: true; } }
        }
        // A checked and a danger button beside a secondary at space.1, and a dense one.
        HorizontalLayout {
            spacing: Tokens.space-1;
            alignment: start;
            plain := Button { text: "Plain"; }
            on := Button { text: "Checked"; checked: true; }
            del := Button { text: "Delete"; kind: "danger"; }
            small := Button { text: "Dense"; dense: true; }
        }
        // A position that opts in to the halo: every spacing and padding round the
        // primary is at least `Theme.halo-clear` while the theme draws a halo, and
        // today's value otherwise (ADR-0122 decision 8).
        HorizontalLayout {
            padding: Theme.halo-clear > 0 ? max(0px, Theme.halo-clear) : 0px;
            spacing: Theme.halo-clear > 0 ? max(Tokens.space-2, Theme.halo-clear) : Tokens.space-2;
            alignment: start;
            halo := Button { text: "Main action"; kind: "primary"; halo-room: true; }
            beside := Button { text: "Beside"; }
        }
    }
    // Every control's place and size, for the test that effects never change them.
    out property <string> geometry: "\{mid.absolute-position.x / 1px} \{mid.width / 1px} \{mid.height / 1px} "
        + "\{go.absolute-position.x / 1px} \{go.absolute-position.y / 1px} \{go.width / 1px} \{rec.width / 1px} "
        + "\{icon.absolute-position.x / 1px} \{icon.width / 1px} \{icon.height / 1px} "
        + "\{above.absolute-position.y / 1px} \{above.width / 1px} \{below.absolute-position.y / 1px} \{below.width / 1px} "
        + "\{on.absolute-position.x / 1px} \{on.absolute-position.y / 1px} \{on.width / 1px} \{del.absolute-position.x / 1px} \{del.width / 1px} "
        + "\{small.absolute-position.x / 1px} \{small.width / 1px} \{small.height / 1px} "
        + "\{halo.width / 1px} \{halo.height / 1px} \{beside.width / 1px} \{beside.height / 1px}";
    // Every button's box in the window, as `label|x|y|width|height;`: where a neighbour's
    // own effects may lie, and where the face tests sample.
    out property <string> boxes: "Left|\{first.absolute-position.x / 1px}|\{first.absolute-position.y / 1px}|\{first.width / 1px}|\{first.height / 1px};"
        + "Focused|\{mid.absolute-position.x / 1px}|\{mid.absolute-position.y / 1px}|\{mid.width / 1px}|\{mid.height / 1px};"
        + "Right|\{right.absolute-position.x / 1px}|\{right.absolute-position.y / 1px}|\{right.width / 1px}|\{right.height / 1px};"
        + "Go live|\{go.absolute-position.x / 1px}|\{go.absolute-position.y / 1px}|\{go.width / 1px}|\{go.height / 1px};"
        + "Record|\{rec.absolute-position.x / 1px}|\{rec.absolute-position.y / 1px}|\{rec.width / 1px}|\{rec.height / 1px};"
        + "Studio mode|\{studio.absolute-position.x / 1px}|\{studio.absolute-position.y / 1px}|\{studio.width / 1px}|\{studio.height / 1px};"
        + "One|\{one.absolute-position.x / 1px}|\{one.absolute-position.y / 1px}|\{one.width / 1px}|\{one.height / 1px};"
        + "Two|\{icon.absolute-position.x / 1px}|\{icon.absolute-position.y / 1px}|\{icon.width / 1px}|\{icon.height / 1px};"
        + "Three|\{three.absolute-position.x / 1px}|\{three.absolute-position.y / 1px}|\{three.width / 1px}|\{three.height / 1px};"
        + "Above|\{above.absolute-position.x / 1px}|\{above.absolute-position.y / 1px}|\{above.width / 1px}|\{above.height / 1px};"
        + "Below|\{below.absolute-position.x / 1px}|\{below.absolute-position.y / 1px}|\{below.width / 1px}|\{below.height / 1px};"
        + "Plain|\{plain.absolute-position.x / 1px}|\{plain.absolute-position.y / 1px}|\{plain.width / 1px}|\{plain.height / 1px};"
        + "Checked|\{on.absolute-position.x / 1px}|\{on.absolute-position.y / 1px}|\{on.width / 1px}|\{on.height / 1px};"
        + "Delete|\{del.absolute-position.x / 1px}|\{del.absolute-position.y / 1px}|\{del.width / 1px}|\{del.height / 1px};"
        + "Dense|\{small.absolute-position.x / 1px}|\{small.absolute-position.y / 1px}|\{small.width / 1px}|\{small.height / 1px};"
        + "Main action|\{halo.absolute-position.x / 1px}|\{halo.absolute-position.y / 1px}|\{halo.width / 1px}|\{halo.height / 1px};"
        + "Beside|\{beside.absolute-position.x / 1px}|\{beside.absolute-position.y / 1px}|\{beside.width / 1px}|\{beside.height / 1px};";
    // The opted-in row: the room left of and above the primary, and the gap to its
    // neighbour. These grow by the clear zone while the theme draws a halo.
    out property <length> halo-left: halo.absolute-position.x - first.absolute-position.x;
    out property <length> halo-gap: beside.absolute-position.x - halo.absolute-position.x - halo.width;
    // The primary's box in the window, for the clear zone test.
    out property <length> halo-x: halo.absolute-position.x;
    out property <length> halo-y: halo.absolute-position.y;
    out property <length> halo-w: halo.width;
    out property <length> halo-h: halo.height;
    public function focus-mid() { mid.take-focus(); }
    public function focus-go() { go.focus-command(); }
    public function focus-go-menu() { go.focus-menu(); }
    public function focus-record() { rec.focus-command(); }
    public function focus-record-menu() { rec.focus-menu(); }
    public function focus-icon() { icon.take-focus(); }
    public function focus-above() { above.take-focus(); }
    public function focus-below() { below.take-focus(); }
    public function focus-checked() { on.take-focus(); }
    public function focus-danger() { del.take-focus(); }
    public function focus-dense() { small.take-focus(); }
    public function focus-beside() { beside.take-focus(); }
    public function focus-halo() { halo.take-focus(); }
}

// SegmentedControl's chosen plate in a theme setting (ADR-0120 decision 14): a three
// and a four option control, a disabled one, and a Button row beside them for
// comparison. The rendered tests and the screenshots read it.
export component SegmentProbe inherits Window {
    // literal-begin: a test window; its size and padding are test data
    width: 420px;
    height: 200px;
    background: Theme.surface-raised;
    VerticalLayout {
        padding: 16px;
        // literal-end
        spacing: Tokens.space-2;
        alignment: start;
        three := SegmentedControl { label: "Spacing"; options: ["Roomy", "Regular", "Compact"]; index: 1; }
        four := SegmentedControl { label: "Effects"; options: ["Calm", "Glow", "Glass", "Tactile"]; index: 2; }
        off := SegmentedControl { label: "Off"; options: ["One", "Two", "Three"]; index: 0; enabled: false; }
        HorizontalLayout {
            spacing: Tokens.space-1;
            alignment: start;
            Button { text: "Secondary"; }
            Button { text: "Checked"; checked: true; }
            Button { text: "Primary"; kind: "primary"; }
        }
    }
    out property <string> boxes: "Spacing|\{three.absolute-position.x / 1px}|\{three.absolute-position.y / 1px}|\{three.width / 1px}|\{three.height / 1px};"
        + "Effects|\{four.absolute-position.x / 1px}|\{four.absolute-position.y / 1px}|\{four.width / 1px}|\{four.height / 1px};"
        + "Off|\{off.absolute-position.x / 1px}|\{off.absolute-position.y / 1px}|\{off.width / 1px}|\{off.height / 1px};";
}

// A window for screenshots of the Properties panel (tests/text_props_shots.rs): the
// panel as the app draws it, with the data a test sets. Not shown by the app.
export component PropertiesProbe inherits Window {
    background: Theme.surface-raised;
    PropertiesPanel {
        width: parent.width;
        height: parent.height;
        live-state: 0;
    }
}

// The Live controls' replay buffer part, for tests/replay_shots.rs (ADR-0088).
export component ReplayProbe inherits Window {
    // literal-begin: a test window; its size and padding are test data
    width: 360px;
    height: 160px;
    background: Theme.surface-raised;
    VerticalLayout {
        padding: 16px;
        // literal-end
        alignment: start;
        ReplayControls { }
    }
}
