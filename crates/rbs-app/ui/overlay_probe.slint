// A window for tests/overlays.rs: the info hint and the tooltip as the real library
// components draw them (ADR-0094). Not shown by the app.
import { InfoHint, IconButton, IconName, OverlayHost, FeatureSection, ColorPicker, Tabs, ScrollArea, SettingRow, Toggle } from "components.slint";

export component OverlayProbe inherits Window {
    // literal-begin: a test window; its size and the places of its two controls are test data
    width: 400px;
    height: 300px;
    out property <bool> hint-focused: hint.focused;
    hint := InfoHint {
        x: 10px;
        y: 10px;
        label: "Threshold";
        text: "Sound below this level is muted.";
        detail: "Default -40 dB";
    }
    button := IconButton {
        x: 100px;
        y: 10px;
        icon: IconName.flip-h;
        name: "Flip horizontally";
    }
    out property <string> last-pick;
    out property <bool> colour-focused: colour.focused;
    colour := ColorPicker {
        x: 200px;
        y: 10px;
        label: "Border colour";
        value: #112233;
        picked(hex) => { root.last-pick = hex; }
    }
    out property <bool> feature-on: feature.on;
    out property <length> feature-height: feature.height;
    feature := FeatureSection {
        x: 10px;
        y: 100px;
        width: 300px;
        height: self.preferred-height;
        id: "probe.feature";
        title: "Noise gate";
        hint: "Mutes sound below the threshold.";
        Rectangle { height: 40px; }
    }
    out property <int> tab-index;
    tabs := Tabs {
        x: 10px;
        y: 240px;
        width: 300px;
        label: "Properties";
        options: ["Transform", "Filters", "Audio"];
        index: root.tab-index;
        selected(i) => { root.tab-index = i; }
    }
    // literal-end
    public function flip-feature() { feature.on = !feature.on; }
    public function focus-hint() { hint.take-focus(); }
    public function focus-button() { button.take-focus(); }
    OverlayHost { width: parent.width; height: parent.height; }
}

// A window for tests/overlays.rs: Tab into a row whose help lies below a scrolled
// area shows the whole row (FocusReveal), not only its control.
export component FocusRevealProbe inherits Window {
    // literal-begin: a test window; its size and the gap that pushes the row down are test data
    width: 300px;
    height: 200px;
    out property <length> offset: area.offset;
    out property <length> view-height: area.view-height;
    out property <length> row-bottom: second.y + second.height;
    area := ScrollArea {
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            width: parent.width;
            height: self.preferred-height;
            first := SettingRow {
                label: "First";
                fill: false;
                t1 := Toggle { label: "First"; }
            }
            Rectangle { height: 150px; }
            second := SettingRow {
                label: "Second";
                help: "Help under the name that wraps onto a second line in this narrow window.";
                fill: false;
                Toggle { label: "Second"; }
            }
            Rectangle { height: 300px; }
        }
    }
    // literal-end
    public function focus-first() { t1.focus(); }
}
