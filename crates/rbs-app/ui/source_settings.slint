// The Source settings window (ADR-0077 decision 5): a floating, non-modal window for the
// settings of one source that the Properties panel does not carry: a camera's mode and
// frame rate, a screen's or window's frame rate and cursor. Apply sends the choice and
// keeps the window; OK sends it and closes; Cancel closes. The choice is a draft until
// then. The preview and the main window stay usable while it is open.
import { Theme, Tokens } from "tokens.slint";
import { Button, Select, Toggle, OverlayHost, NumberField, SettingRow } from "components.slint";
import { SettingsCard } from "settings.slint";
import { Studio, SourceSettingsData } from "studio.slint";

// One resize/move handle on the capture-region preview (matches preview canvas marks).
component CaptureRegionHandle inherits Rectangle {
    in property <float> center-x;
    in property <float> center-y;
    property <float> half: 4.0; // literal: mirrors rbs_ui::transform::HANDLE_SIZE / 2
    x: (center-x - half) * 1px;
    y: (center-y - half) * 1px;
    width: 8px; // literal: mirrors rbs_ui::transform::HANDLE_SIZE
    height: 8px; // literal: mirrors rbs_ui::transform::HANDLE_SIZE
    background: Theme.surface-raised;
    border-width: Tokens.size-border;
    border-color: Theme.accent;
}

export component SourceSettingsWindow inherits Window {
    default-font-family: Theme.font-family;
    default-font-size: Tokens.type-body-size;
    title: @tr("{}: Source settings", d.name);
    icon: @image-url("../assets/brand/icon-win-256.png");
    preferred-width: Tokens.size-floating-w;
    // Tall enough for Video + region/chrome cards with Cancel/Apply/OK still on screen.
    preferred-height: Tokens.size-settings-h;
    min-width: Tokens.size-menu-md;
    min-height: Tokens.size-floating-h;
    background: Theme.surface-base;
    // Escape or Cancel: the window closes without sending anything.
    callback dismiss();
    forward-focus: keys;
    // What the host answered (empty while it has not).
    property <SourceSettingsData> d: Studio.source-settings.length > 0 ? Studio.source-settings[0] : {
        id: -1, name: "", kind-code: -1, modes: [], mode-labels: [], mode-index: -1, rates: [], rate-index: -1,
        has-cursor: false, cursor: true, cap-has: false, cap-l: 0, cap-t: 0, cap-r: 0, cap-b: 0,
        chrome-on: false, chrome-t: 0, chrome-r: 0, chrome-b: 0, chrome-l: 0, chrome-fill: 0, has-work-rect: false,
        pic-w: 0, pic-h: 0, has-region-preview: false, region-preview: @image-url("../assets/brand/icon-win-256.png")
    };
    // The draft.
    in-out property <int> mode-index: -1;
    in-out property <int> rate-index: -1;
    in-out property <bool> cursor: true;
    in-out property <bool> cap-has: false;
    in-out property <int> cap-l: 0;
    in-out property <int> cap-t: 0;
    in-out property <int> cap-r: 0;
    in-out property <int> cap-b: 0;
    in-out property <bool> chrome-on: false;
    in-out property <int> chrome-t: 0;
    in-out property <int> chrome-r: 0;
    in-out property <int> chrome-b: 0;
    in-out property <int> chrome-l: 0;
    in-out property <int> chrome-fill: 0;
    // Simple chrome UI: one edge + thickness (ADR-0104 still stores four insets).
    // 0 top, 1 right, 2 bottom, 3 left. Windows taskbar defaults to bottom.
    in-out property <int> chrome-edge: 2;
    in-out property <int> chrome-thickness: 48;
    // Region drag on the preview (widget px → full-capture insets). Grip 0–7 handles, 8 move.
    property <bool> region-dragging: false;
    property <int> region-grip: -1;
    property <float> region-drag-mx0: 0;
    property <float> region-drag-my0: 0;
    property <int> region-start-l: 0;
    property <int> region-start-t: 0;
    property <int> region-start-r: 0;
    property <int> region-start-b: 0;
    // Live size of `preview-host` (bound below). Stale values misalign the crop frame.
    property <float> preview-w-px: 1;
    property <float> preview-h-px: 1;
    // True while the pointer is down on the region preview (blocks Flickable scroll).
    property <bool> region-pointer-down: false;
    property <float> region-sel-x0: root.cap-preview-x(root.cap-l);
    property <float> region-sel-y0: root.cap-preview-y(root.cap-t);
    property <float> region-sel-x1: root.cap-preview-x-right(root.cap-r);
    property <float> region-sel-y1: root.cap-preview-y-bottom(root.cap-b);
    function region-handle-reach() -> float {
        8.0 // literal: mirrors rbs_ui::transform::HANDLE_REACH
    }
    function region-handle-half() -> float {
        4.0 // literal: mirrors rbs_ui::transform::HANDLE_SIZE / 2
    }
    function region-hx(g: int) -> float {
        if g == 0 || g == 6 || g == 7 { return root.region-sel-x0; }
        if g == 2 || g == 3 || g == 4 { return root.region-sel-x1; }
        return (root.region-sel-x0 + root.region-sel-x1) * 0.5;
    }
    function region-hy(g: int) -> float {
        if g == 0 || g == 1 || g == 2 { return root.region-sel-y0; }
        if g == 4 || g == 5 || g == 6 { return root.region-sel-y1; }
        return (root.region-sel-y0 + root.region-sel-y1) * 0.5;
    }
    property <int> region-pick-grip: -1;
    property <float> region-pick-best: 9.0;
    function region-pointer-in-sel(mx: float, my: float) -> bool {
        mx >= root.region-sel-x0 && mx <= root.region-sel-x1 && my >= root.region-sel-y0 && my <= root.region-sel-y1
    }
    function region-grip-consider(g: int, mx: float, my: float) {
        let d = max(Math.abs(mx - root.region-hx(g)), Math.abs(my - root.region-hy(g)));
        if d <= root.region-handle-reach() && d < root.region-pick-best {
            root.region-pick-best = d;
            root.region-pick-grip = g;
        }
    }
    function region-grip-at(mx: float, my: float) -> int {
        if !root.cap-has && !root.region-dragging { return -1; }
        root.region-pick-best = root.region-handle-reach() + 1.0;
        root.region-pick-grip = -1;
        root.region-grip-consider(0, mx, my);
        root.region-grip-consider(1, mx, my);
        root.region-grip-consider(2, mx, my);
        root.region-grip-consider(3, mx, my);
        root.region-grip-consider(4, mx, my);
        root.region-grip-consider(5, mx, my);
        root.region-grip-consider(6, mx, my);
        root.region-grip-consider(7, mx, my);
        if root.region-pick-grip >= 0 { return root.region-pick-grip; }
        return root.region-pointer-in-sel(mx, my) ? 8 : -1;
    }
    function region-clamp-insets() {
        if d.pic-w <= 0 || d.pic-h <= 0 { return; }
        root.cap-l = max(0, min(root.cap-l, d.pic-w - 1));
        root.cap-t = max(0, min(root.cap-t, d.pic-h - 1));
        root.cap-r = max(0, min(root.cap-r, d.pic-w - 1));
        root.cap-b = max(0, min(root.cap-b, d.pic-h - 1));
        if root.cap-l + root.cap-r >= d.pic-w {
            let over = root.cap-l + root.cap-r - (d.pic-w - 1);
            if root.cap-l >= over {
                root.cap-l = root.cap-l - over;
            } else {
                root.cap-r = d.pic-w - 1 - root.cap-l;
            }
        }
        if root.cap-t + root.cap-b >= d.pic-h {
            let over = root.cap-t + root.cap-b - (d.pic-h - 1);
            if root.cap-t >= over {
                root.cap-t = root.cap-t - over;
            } else {
                root.cap-b = d.pic-h - 1 - root.cap-t;
            }
        }
    }
    function region-cancel-drag() {
        if root.region-dragging {
            root.cap-l = root.region-start-l;
            root.cap-t = root.region-start-t;
            root.cap-r = root.region-start-r;
            root.cap-b = root.region-start-b;
        }
        root.region-pointer-down = false;
        root.region-dragging = false;
        root.region-grip = -1;
    }
    function region-apply-grip(mx: float, my: float) {
        if d.pic-w <= 0 || d.pic-h <= 0 || root.preview-scale() <= 0 { return; }
        let sc = root.preview-scale();
        let ox = root.preview-ox();
        let oy = root.preview-oy();
        if root.region-grip == 8 {
            let dx = round((mx - root.region-drag-mx0) / sc);
            let dy = round((my - root.region-drag-my0) / sc);
            let w = d.pic-w - root.region-start-l - root.region-start-r;
            let h = d.pic-h - root.region-start-t - root.region-start-b;
            let nl = max(0, min(root.region-start-l + dx, d.pic-w - w));
            let nt = max(0, min(root.region-start-t + dy, d.pic-h - h));
            root.cap-l = nl;
            root.cap-r = d.pic-w - w - nl;
            root.cap-t = nt;
            root.cap-b = d.pic-h - h - nt;
            return;
        }
        if root.region-grip == 0 || root.region-grip == 6 || root.region-grip == 7 {
            root.cap-l = min(max(0, round((mx - ox) / sc)), d.pic-w - root.cap-r - 1);
        }
        if root.region-grip == 2 || root.region-grip == 3 || root.region-grip == 4 {
            root.cap-r = min(max(0, d.pic-w - round((mx - ox) / sc)), d.pic-w - root.cap-l - 1);
        }
        if root.region-grip == 0 || root.region-grip == 1 || root.region-grip == 2 {
            root.cap-t = min(max(0, round((my - oy) / sc)), d.pic-h - root.cap-b - 1);
        }
        if root.region-grip == 4 || root.region-grip == 5 || root.region-grip == 6 {
            root.cap-b = min(max(0, d.pic-h - round((my - oy) / sc)), d.pic-h - root.cap-t - 1);
        }
    }
    function cap-preview-x(left: int) -> float {
        root.preview-ox() + left * root.preview-scale();
    }
    function cap-preview-y(top: int) -> float {
        root.preview-oy() + top * root.preview-scale();
    }
    function cap-preview-x-right(right: int) -> float {
        root.preview-ox() + (max(1, d.pic-w) - right) * root.preview-scale();
    }
    function cap-preview-y-bottom(bottom: int) -> float {
        root.preview-oy() + (max(1, d.pic-h) - bottom) * root.preview-scale();
    }
    function preview-scale() -> float {
        max(0.001, min(root.preview-w-px / max(1., d.pic-w), root.preview-h-px / max(1., d.pic-h)));
    }
    function preview-ox() -> float {
        (root.preview-w-px - max(1., d.pic-w) * root.preview-scale()) * 0.5;
    }
    function preview-oy() -> float {
        (root.preview-h-px - max(1., d.pic-h) * root.preview-scale()) * 0.5;
    }
    property <bool> camera: d.kind-code == 2;
    property <bool> capture-kind: d.kind-code >= 0 && d.kind-code <= 2;
    property <bool> display: d.kind-code == 0;
    // The rates of the chosen mode for a camera; a screen's and window's own list.
    property <[string]> rates: camera ? (mode-index >= 0 && mode-index < d.modes.length ? d.modes[mode-index].rates : []) : d.rates;
    property <[string]> chrome-edge-labels: [@tr("Top"), @tr("Right"), @tr("Bottom"), @tr("Left")];
    property <[string]> chrome-fill-labels: [@tr("Cover"), @tr("Fit")];
    function pick-chrome-edge(t: int, r: int, b: int, l: int) -> int {
        // No insets yet: Windows taskbar defaults to the bottom edge.
        if t == 0 && r == 0 && b == 0 && l == 0 { return 2; }
        // Strict greater-than so a tie does not prefer Top; bottom wins ties.
        if t > r && t > b && t > l { return 0; }
        if r > b && r > l && r > t { return 1; }
        if b >= t && b >= r && b >= l { return 2; }
        return 3;
    }
    // Preview box height grows with the window (layout stretch alone was ignored).
    property <length> region-preview-h: max(
        Tokens.size-transition-min-picture,
        root.height * 0.45
    );
    function chrome-edge-thickness(edge: int, t: int, r: int, b: int, l: int) -> int {
        if edge == 0 { return t; }
        if edge == 1 { return r; }
        if edge == 2 { return b; }
        return l;
    }
    function write-chrome-from-edge() {
        root.chrome-t = 0;
        root.chrome-r = 0;
        root.chrome-b = 0;
        root.chrome-l = 0;
        if root.chrome-edge == 0 { root.chrome-t = root.chrome-thickness; }
        if root.chrome-edge == 1 { root.chrome-r = root.chrome-thickness; }
        if root.chrome-edge == 2 { root.chrome-b = root.chrome-thickness; }
        if root.chrome-edge == 3 { root.chrome-l = root.chrome-thickness; }
    }
    changed d => {
        root.mode-index = d.mode-index;
        root.rate-index = d.rate-index;
        root.cursor = d.cursor;
        root.cap-has = d.cap-has;
        root.cap-l = d.cap-l;
        root.cap-t = d.cap-t;
        root.cap-r = d.cap-r;
        root.cap-b = d.cap-b;
        root.chrome-on = d.chrome-on;
        root.chrome-t = d.chrome-t;
        root.chrome-r = d.chrome-r;
        root.chrome-b = d.chrome-b;
        root.chrome-l = d.chrome-l;
        root.chrome-fill = d.chrome-fill;
        root.chrome-edge = root.pick-chrome-edge(d.chrome-t, d.chrome-r, d.chrome-b, d.chrome-l);
        // Zero insets: keep a usable default thickness (48), not 1 px from max(1, 0).
        root.chrome-thickness = d.chrome-t == 0 && d.chrome-r == 0 && d.chrome-b == 0 && d.chrome-l == 0
            ? 48
            : max(1, root.chrome-edge-thickness(root.chrome-edge, d.chrome-t, d.chrome-r, d.chrome-b, d.chrome-l));
    }
    function apply-region-chrome() {
        // Manual region and display chrome both write Source.region; only one applies.
        // Clearing chrome also clears the region, so when saving a crop: clear chrome
        // first (if any), then write the region.
        if root.capture-kind && root.cap-has {
            root.chrome-on = false;
            if root.display {
                Studio.set-display-chrome(d.id, false, 0, 0, 0, 0, root.chrome-fill);
            }
            Studio.set-source-capture-region(d.id, false, root.cap-l, root.cap-t, root.cap-r, root.cap-b);
            return;
        }
        if root.display && root.chrome-on {
            root.write-chrome-from-edge();
            Studio.set-display-chrome(d.id, true, root.chrome-t, root.chrome-r, root.chrome-b, root.chrome-l, root.chrome-fill);
            return;
        }
        // Both off: clear chrome (and its region) then clear any manual region.
        if root.display {
            Studio.set-display-chrome(d.id, false, 0, 0, 0, 0, root.chrome-fill);
        }
        if root.capture-kind {
            Studio.set-source-capture-region(d.id, true, 0, 0, 0, 0);
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.dismiss(); return accept; }
            reject
        }
        VerticalLayout {
            padding: Tokens.size-panel-pad;
            spacing: Tokens.size-section-gap;
            vertical-stretch: 1;
            if d.id < 0: Text {
                text: @tr("Loading the settings…");
                color: Theme.text-secondary;
                font-size: Tokens.type-body-size;
            }
            // Body scrolls; Cancel / Apply / OK stay visible below.
            // A Flickable pans on a mouse drag and, within 500 ms of the press, steals
            // the pointer from a child once the drag moves 8 px. The crop handles are
            // that size, so a crop drag was taken as a page scroll as soon as it left
            // the preview. While a region is being edited, mouse drags do not pan;
            // wheel and trackpad scrolling stay. Touch panning stays except during the drag.
            if d.id >= 0: Flickable {
                vertical-stretch: 1;
                interactive: !root.region-pointer-down;
                mouse-drag-pan-enabled: !root.cap-has;
                viewport-width: self.width;
                viewport-height: body.preferred-height;
                body := VerticalLayout {
                    width: parent.width;
                    spacing: Tokens.size-section-gap;

                SettingsCard {
                    title: @tr("Video");
                    id: "source-settings.video";
                    description: @tr("Mode, frame rate and cursor for this capture.");
                    if camera: SettingRow {
                        label: @tr("Mode");
                        help: @tr("Resolution and colour mode listed by the camera.");
                        divider: false;
                        Select {
                            label: @tr("Mode");
                            options: d.mode-labels;
                            index: root.mode-index;
                            placeholder: @tr("Not listed by this camera");
                            enabled: d.modes.length > 0;
                            selected(i) => {
                                root.mode-index = i;
                                root.rate-index = root.rate-index < d.modes[i].rates.length ? root.rate-index : 0;
                            }
                        }
                    }
                    SettingRow {
                        label: @tr("Frame rate");
                        help: @tr("How often a new picture is taken.");
                        divider: camera;
                        Select {
                            label: @tr("Frame rate");
                            options: root.rates;
                            index: root.rate-index;
                            placeholder: @tr("Default");
                            selected(i) => { root.rate-index = i; }
                        }
                    }
                    if d.has-cursor: SettingRow {
                        label: @tr("Show the cursor");
                        help: @tr("Draw the pointer in the captured picture.");
                        fill: false;
                        Toggle {
                            label: @tr("Show the cursor");
                            checked: root.cursor;
                            toggled(v) => { root.cursor = v; }
                        }
                    }
                }

                if capture-kind: Rectangle {
                    background: Theme.surface-raised;
                    border-radius: Tokens.radius-lg;
                    border-width: Tokens.size-border;
                    border-color: Theme.border-subtle;
                    accessible-role: groupbox;
                    accessible-label: @tr("Capture region");
                    VerticalLayout {
                        padding: Tokens.size-panel-pad;
                        spacing: Tokens.size-field-gap;
                        Text {
                            text: @tr("Capture region").to-uppercase();
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            font-weight: Tokens.type-title-weight;
                            letter-spacing: Tokens.size-tracking-caps;
                            accessible-role: none;
                        }
                        SettingRow {
                            label: @tr("Use a region");
                            help: @tr("Crop the capture to a rectangle. Turns off Hide taskbar. Apply fits it on the canvas and does not restart capture.");
                            divider: false;
                            fill: false;
                            Toggle {
                                label: @tr("Use a region");
                                checked: root.cap-has;
                                toggled(v) => {
                                    root.cap-has = v;
                                    // Chrome and a manual region both own Source.region.
                                    if v { root.chrome-on = false; }
                                }
                            }
                        }
                        if root.cap-has && d.pic-w > 0 && d.pic-h > 0: Text {
                            text: @tr("Full capture: {} × {} px", d.pic-w, d.pic-h);
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                        }
                        if root.cap-has: Text {
                            horizontal-stretch: 1;
                            text: d.has-region-preview
                                ? @tr("Drag the handles or edges. Enlarge this window for a larger preview.")
                                : @tr("Waiting for a preview… You can still type edges in capture pixels.");
                            color: Theme.text-secondary;
                            font-size: Tokens.type-caption-size;
                            wrap: word-wrap;
                        }
                        if root.cap-has: preview-host := Rectangle {
                            height: root.region-preview-h;
                            width: 100%;
                            horizontal-stretch: 1;
                            clip: true;
                            background: Theme.surface-sunken;
                            border-radius: Tokens.radius-sm;
                            // Keep crop math on the same box the Image letterboxes into.
                            changed width => { root.preview-w-px = max(1., self.width / 1px); }
                            changed height => { root.preview-h-px = max(1., self.height / 1px); }
                            init => {
                                root.preview-w-px = max(1., self.width / 1px);
                                root.preview-h-px = max(1., self.height / 1px);
                            }
                            if d.has-region-preview: Image {
                                width: parent.width;
                                height: parent.height;
                                source: d.region-preview;
                                image-fit: contain;
                            }
                            if root.cap-has || root.region-dragging: Rectangle {
                                x: root.region-sel-x0 * 1px;
                                y: root.region-sel-y0 * 1px;
                                width: (root.region-sel-x1 - root.region-sel-x0) * 1px;
                                height: (root.region-sel-y1 - root.region-sel-y0) * 1px;
                                border-width: Tokens.size-focus-ring;
                                border-color: Theme.accent;
                                background: #00000000; // literal: selection hole, not chrome
                            }
                            if root.cap-has || root.region-dragging: CaptureRegionHandle {
                                center-x: root.region-hx(0);
                                center-y: root.region-hy(0);
                            }
                            if root.cap-has || root.region-dragging: CaptureRegionHandle {
                                center-x: root.region-hx(1);
                                center-y: root.region-hy(1);
                            }
                            if root.cap-has || root.region-dragging: CaptureRegionHandle {
                                center-x: root.region-hx(2);
                                center-y: root.region-hy(2);
                            }
                            if root.cap-has || root.region-dragging: CaptureRegionHandle {
                                center-x: root.region-hx(3);
                                center-y: root.region-hy(3);
                            }
                            if root.cap-has || root.region-dragging: CaptureRegionHandle {
                                center-x: root.region-hx(4);
                                center-y: root.region-hy(4);
                            }
                            if root.cap-has || root.region-dragging: CaptureRegionHandle {
                                center-x: root.region-hx(5);
                                center-y: root.region-hy(5);
                            }
                            if root.cap-has || root.region-dragging: CaptureRegionHandle {
                                center-x: root.region-hx(6);
                                center-y: root.region-hy(6);
                            }
                            if root.cap-has || root.region-dragging: CaptureRegionHandle {
                                center-x: root.region-hx(7);
                                center-y: root.region-hy(7);
                            }
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                pointer-event(e) => {
                                    let mx = self.mouse-x / 1px;
                                    let my = self.mouse-y / 1px;
                                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                        root.region-pointer-down = true;
                                        root.preview-w-px = max(1., preview-host.width / 1px);
                                        root.preview-h-px = max(1., preview-host.height / 1px);
                                        let grip = root.region-grip-at(mx, my);
                                        if grip >= 0 {
                                            root.region-dragging = true;
                                            root.region-grip = grip;
                                            root.region-drag-mx0 = mx;
                                            root.region-drag-my0 = my;
                                            root.region-start-l = root.cap-l;
                                            root.region-start-t = root.cap-t;
                                            root.region-start-r = root.cap-r;
                                            root.region-start-b = root.cap-b;
                                            root.cap-has = true;
                                        }
                                    }
                                    if e.kind == PointerEventKind.move && root.region-dragging {
                                        root.region-apply-grip(mx, my);
                                    }
                                    if e.kind == PointerEventKind.up {
                                        root.region-pointer-down = false;
                                        if root.region-dragging {
                                            root.region-dragging = false;
                                            root.region-grip = -1;
                                            root.region-clamp-insets();
                                        }
                                    }
                                    if e.kind == PointerEventKind.cancel {
                                        root.region-cancel-drag();
                                    }
                                }
                                // The grab continues after the pointer leaves this box.
                                moved => {
                                    if root.region-dragging {
                                        root.region-apply-grip(self.mouse-x / 1px, self.mouse-y / 1px);
                                    }
                                }
                            }
                        }
                        if root.cap-has: HorizontalLayout {
                            spacing: Tokens.size-field-gap;
                            alignment: start;
                            NumberField {
                                preferred-width: Tokens.size-field-compact;
                                prefix: @tr("L");
                                label: @tr("Region left of {}", d.name);
                                value: root.cap-l;
                                edited(v) => { root.cap-l = max(0, round(v)); }
                            }
                            NumberField {
                                preferred-width: Tokens.size-field-compact;
                                prefix: @tr("R");
                                label: @tr("Region right of {}", d.name);
                                value: root.cap-r;
                                edited(v) => { root.cap-r = max(0, round(v)); }
                            }
                            NumberField {
                                preferred-width: Tokens.size-field-compact;
                                prefix: @tr("T");
                                label: @tr("Region top of {}", d.name);
                                value: root.cap-t;
                                edited(v) => { root.cap-t = max(0, round(v)); }
                            }
                            NumberField {
                                preferred-width: Tokens.size-field-compact;
                                prefix: @tr("B");
                                label: @tr("Region bottom of {}", d.name);
                                value: root.cap-b;
                                edited(v) => { root.cap-b = max(0, round(v)); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Clear");
                                    dense: true;
                                    kind: "ghost";
                                    enabled: root.cap-has;
                                    clicked => {
                                        root.cap-has = false;
                                        root.cap-l = 0;
                                        root.cap-t = 0;
                                        root.cap-r = 0;
                                        root.cap-b = 0;
                                    }
                                }
                            }
                        }
                    }
                }

                if display: SettingsCard {
                    title: @tr("Display chrome");
                    id: "source-settings.chrome";
                    description: @tr("Cut taskbar or Dock insets from the capture without restarting it.");
                    SettingRow {
                        label: @tr("Hide taskbar and Dock");
                        help: @tr("Choose the edge and thickness in capture pixels. Turns off Use a region.");
                        divider: false;
                        fill: false;
                        Toggle {
                            label: @tr("Hide taskbar and Dock");
                            checked: root.chrome-on;
                            toggled(v) => {
                                root.chrome-on = v;
                                // Chrome and a manual region both own Source.region.
                                if v {
                                    root.cap-has = false;
                                    if root.chrome-t == 0 && root.chrome-r == 0 && root.chrome-b == 0 && root.chrome-l == 0 {
                                        root.chrome-edge = 2;
                                        root.chrome-thickness = max(48, root.chrome-thickness);
                                    }
                                }
                            }
                        }
                    }
                    if root.chrome-on: SettingRow {
                        label: @tr("Bar edge");
                        help: @tr("Which edge holds the bar. Bottom is usual on Windows.");
                        Select {
                            preferred-width: Tokens.size-transition-short;
                            label: @tr("Bar edge");
                            options: root.chrome-edge-labels;
                            index: root.chrome-edge;
                            selected(i) => { root.chrome-edge = i; }
                        }
                    }
                    if root.chrome-on: SettingRow {
                        label: @tr("Thickness");
                        help: @tr("Height or width of the bar in capture pixels.");
                        fill: false;
                        NumberField {
                            preferred-width: Tokens.size-field-compact;
                            label: @tr("Bar thickness of {} in pixels", d.name);
                            value: root.chrome-thickness;
                            edited(v) => { root.chrome-thickness = max(1, round(v)); }
                        }
                        Text {
                            text: @tr("px");
                            color: Theme.text-secondary;
                            font-size: Tokens.type-body-size;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    if root.chrome-on: SettingRow {
                        label: @tr("Place the work area");
                        help: @tr("Cover fills the item box; Fit keeps the cut area's shape.");
                        Select {
                            preferred-width: Tokens.size-transition-short;
                            label: @tr("Place the work area");
                            options: root.chrome-fill-labels;
                            index: root.chrome-fill;
                            selected(i) => { root.chrome-fill = i; }
                        }
                    }
                    if root.chrome-on: SettingRow {
                        label: @tr("Chrome actions");
                        help: @tr("Apply writes the cut. Fit places the item. Reset uses the system work area.");
                        fill: false;
                        Button {
                            text: @tr("Apply");
                            dense: true;
                            kind: "primary";
                            clicked => { root.apply-region-chrome(); }
                        }
                        Button {
                            text: @tr("Fit item");
                            dense: true;
                            clicked => { Studio.fit-display-chrome(d.id); }
                        }
                        Button {
                            text: @tr("Reset");
                            dense: true;
                            kind: "ghost";
                            enabled: d.has-work-rect;
                            clicked => { Studio.reset-display-chrome(d.id); }
                        }
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: @tr("A change opens the source again with the new settings. Its name, layout and filters stay. One Undo step.");
                    color: Theme.text-secondary;
                    font-size: Tokens.type-caption-size;
                    wrap: word-wrap;
                }
                } // body
            } // Flickable
            HorizontalLayout {
                spacing: Tokens.size-field-gap;
                alignment: end;
                Button {
                    text: @tr("Cancel");
                    clicked => { root.dismiss(); }
                }
                Button {
                    text: @tr("Apply");
                    enabled: d.id >= 0;
                    clicked => {
                        Studio.apply-source-settings(d.id, root.mode-index, root.rate-index, root.cursor);
                        root.apply-region-chrome();
                    }
                }
                Button {
                    text: @tr("OK");
                    kind: "primary";
                    enabled: d.id >= 0;
                    clicked => {
                        Studio.apply-source-settings(d.id, root.mode-index, root.rate-index, root.cursor);
                        root.apply-region-chrome();
                        root.dismiss();
                    }
                }
            }
        }
    }
    // The info hint and tooltip layer, drawn last (ADR-0094).
    OverlayHost { width: parent.width; height: parent.height; }
}
