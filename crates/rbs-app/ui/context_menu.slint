        for _ in ContextMenus.items[11].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[11].title; enabled: ContextMenus.items[11].enabled; checkable: ContextMenus.items[11].checkable; checked: ContextMenus.items[11].checked; activated => { ContextMenus.run(ContextMenus.items[11].id); } }
        for _ in ContextMenus.items[11].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[11].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[11].title; enabled: ContextMenus.items[11].enabled; for c in ContextMenus.items[11].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[12].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[12].title; enabled: ContextMenus.items[12].enabled; checkable: ContextMenus.items[12].checkable; checked: ContextMenus.items[12].checked; activated => { ContextMenus.run(ContextMenus.items[12].id); } }
        for _ in ContextMenus.items[12].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[12].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[12].title; enabled: ContextMenus.items[12].enabled; for c in ContextMenus.items[12].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[13].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[13].title; enabled: ContextMenus.items[13].enabled; checkable: ContextMenus.items[13].checkable; checked: ContextMenus.items[13].checked; activated => { ContextMenus.run(ContextMenus.items[13].id); } }
        for _ in ContextMenus.items[13].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[13].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[13].title; enabled: ContextMenus.items[13].enabled; for c in ContextMenus.items[13].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[14].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[14].title; enabled: ContextMenus.items[14].enabled; checkable: ContextMenus.items[14].checkable; checked: ContextMenus.items[14].checked; activated => { ContextMenus.run(ContextMenus.items[14].id); } }
        for _ in ContextMenus.items[14].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[14].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[14].title; enabled: ContextMenus.items[14].enabled; for c in ContextMenus.items[14].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[15].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[15].title; enabled: ContextMenus.items[15].enabled; checkable: ContextMenus.items[15].checkable; checked: ContextMenus.items[15].checked; activated => { ContextMenus.run(ContextMenus.items[15].id); } }
