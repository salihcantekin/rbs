// Context menus built from the command registry (ADR-0050 decision 4; spec
// "Context menus"). One `CommandMenu` sits in each element that has a menu: the
// element opens it on a right-click, the Menu key or Shift+F10 with `open(point)`,
// which first asks Rust for the items of its context and target, so a menu always
// shows the state of the moment. Only one menu is open at a time, so one list of
// items serves every menu of a window.

// One choice of a submenu: its title, the registry id it runs, and whether it is the
// current one.
export struct ContextChoice { title: string, id: string, checked: bool }

// One item: `kind` 1 a command, 2 a separator, 3 a submenu of `choices`.
export struct ContextItem {
    kind: int,
    title: string,
    id: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
    choices: [ContextChoice],
}

export global ContextMenus {
    // The items of the menu being opened, at most as many as the slots below.
    in-out property <[ContextItem]> items;
    // The items of `context`'s menu for `target` (`key=value&...`, the parameters
    // that name what was right-clicked, percent-encoded as in command ids).
    callback prepare(string /* context */, string /* target */) -> [ContextItem];
    // Runs a command registry id.
    callback run(string);
}

// The menu of one context. Its own right-click handling is off: the element under the
// pointer calls `open`, so the items are made before the menu shows.
export component CommandMenu inherits ContextMenuArea {
    in property <string> context;
    in property <string> target;
    enabled: false;
    // Opens the menu at `at`, relative to this element; nothing opens when the
    // context has no items.
    public function open(at: Point) {
        ContextMenus.items = ContextMenus.prepare(root.context, root.target);
        if ContextMenus.items.length > 0 {
            root.show(at);
        }
    }
    Menu {
        // BEGIN generated context menu slots (context_menu.rs; do not edit)
        for _ in ContextMenus.items[0].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[0].title; enabled: ContextMenus.items[0].enabled; checkable: ContextMenus.items[0].checkable; checked: ContextMenus.items[0].checked; activated => { ContextMenus.run(ContextMenus.items[0].id); } }
        for _ in ContextMenus.items[0].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[0].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[0].title; enabled: ContextMenus.items[0].enabled; for c in ContextMenus.items[0].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[1].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[1].title; enabled: ContextMenus.items[1].enabled; checkable: ContextMenus.items[1].checkable; checked: ContextMenus.items[1].checked; activated => { ContextMenus.run(ContextMenus.items[1].id); } }
        for _ in ContextMenus.items[1].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[1].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[1].title; enabled: ContextMenus.items[1].enabled; for c in ContextMenus.items[1].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[2].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[2].title; enabled: ContextMenus.items[2].enabled; checkable: ContextMenus.items[2].checkable; checked: ContextMenus.items[2].checked; activated => { ContextMenus.run(ContextMenus.items[2].id); } }
        for _ in ContextMenus.items[2].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[2].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[2].title; enabled: ContextMenus.items[2].enabled; for c in ContextMenus.items[2].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[3].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[3].title; enabled: ContextMenus.items[3].enabled; checkable: ContextMenus.items[3].checkable; checked: ContextMenus.items[3].checked; activated => { ContextMenus.run(ContextMenus.items[3].id); } }
        for _ in ContextMenus.items[3].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[3].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[3].title; enabled: ContextMenus.items[3].enabled; for c in ContextMenus.items[3].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[4].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[4].title; enabled: ContextMenus.items[4].enabled; checkable: ContextMenus.items[4].checkable; checked: ContextMenus.items[4].checked; activated => { ContextMenus.run(ContextMenus.items[4].id); } }
        for _ in ContextMenus.items[4].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[4].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[4].title; enabled: ContextMenus.items[4].enabled; for c in ContextMenus.items[4].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[5].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[5].title; enabled: ContextMenus.items[5].enabled; checkable: ContextMenus.items[5].checkable; checked: ContextMenus.items[5].checked; activated => { ContextMenus.run(ContextMenus.items[5].id); } }
        for _ in ContextMenus.items[5].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[5].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[5].title; enabled: ContextMenus.items[5].enabled; for c in ContextMenus.items[5].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[6].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[6].title; enabled: ContextMenus.items[6].enabled; checkable: ContextMenus.items[6].checkable; checked: ContextMenus.items[6].checked; activated => { ContextMenus.run(ContextMenus.items[6].id); } }
        for _ in ContextMenus.items[6].kind == 2 ? 1 : 0: MenuSeparator { }
        for _ in ContextMenus.items[6].kind == 3 ? 1 : 0: Menu { title: ContextMenus.items[6].title; enabled: ContextMenus.items[6].enabled; for c in ContextMenus.items[6].choices: MenuItem { title: c.title; checkable: true; checked: c.checked; activated => { ContextMenus.run(c.id); } } }
        for _ in ContextMenus.items[7].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[7].title; enabled: ContextMenus.items[7].enabled; checkable: ContextMenus.items[7].checkable; checked: ContextMenus.items[7].checked; activated => { ContextMenus.run(ContextMenus.items[7].id); } }
        for _ in ContextMenus.items[7].kind == 2 ? 1 : 0: MenuSeparator { }
