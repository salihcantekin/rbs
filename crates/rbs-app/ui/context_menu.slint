        for _ in ContextMenus.items[9].kind == 1 ? 1 : 0: MenuItem { title: ContextMenus.items[9].title; enabled: ContextMenus.items[9].enabled; checkable: ContextMenus.items[9].checkable; checked: ContextMenus.items[9].checked; activated => { ContextMenus.run(ContextMenus.items[9].id); } }
        for _ in ContextMenus.items[9].kind == 2 ? 1 : 0: MenuSeparator { }
