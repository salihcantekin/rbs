// The Page fields of a browser source (ADR-0109, ADR-0132, ADR-0149), shared by the
// Properties panel's Page tab and the Source settings window, and the collapsible
// Section both use.
import { Theme, Tokens } from "tokens.slint";
import { Button, IconButton, InfoHint, NumberField, SectionHeader, SegmentedControl, TextArea, TextField, Toggle, CaptionField as Field } from "components.slint";
import { SettingsCallout } from "settings.slint";
import { BrowserData, Studio, Sections, IconName } from "base/types.slint";

// A collapsible group of fields under a SectionHeader. A closed section draws nothing and
// takes no room. Its state is saved in the workspace file under `id` (ADR-0078).
export component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> id;
    // The explanation behind an info button at the end of the header (ADR-0094 rule A1);
    // empty draws no button.
    in property <string> hint;
    // A section with one value and a known default (owner decision 2026-11-14, ADR-0114
    // decision 4): while the value differs, a reset button sits at the trailing end of
    // the header, before the info button. `default-text` names the default.
    in property <bool> changed;
    in property <string> default-text;
    callback reset();
    property <bool> closed: Sections.closed(root.id, Sections.rev);
    spacing: Tokens.size-field-gap;
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        SectionHeader {
            horizontal-stretch: 1;
            title: root.title;
            collapsible: true;
            open: !root.closed;
            toggled(o) => { Sections.set-closed(root.id, !o); }
        }
        if root.changed && !root.closed: IconButton {
            icon: IconName.reset;
            name: @tr("Reset {} to {}", root.title, root.default-text);
            clicked => { root.reset(); }
        }
        if root.hint != "" && !root.closed: InfoHint {
            label: root.title;
            text: root.hint;
        }
    }
    // Slint cannot put @children in an `if`, so a closed section is hidden and takes
    // no room (like Shown): it draws and handles no input. Width follows the section
    // so a stretched slider (volume) fills the panel instead of staying at preferred width.
    Rectangle {
        visible: !root.closed;
        width: 100%;
        height: root.closed ? 0px : inner.preferred-height;
        inner := VerticalLayout {
            width: 100%;
            spacing: Tokens.size-field-gap;
            @children
        }
    }
}

// The Page tab of a browser source (ADR-0109, ADR-0132, ADR-0149): the page, its size
// and rate, then Custom CSS, Automation and Behaviour. Every change is one undo step and
// reaches a running page without a restart, except Keep running when hidden.
export component BrowserFields inherits VerticalLayout {
    // The source name, for accessible names.
    in property <string> name;
    property <BrowserData> b: Studio.browser-props;
    // A section's gap between rows, so a tall tab reads top to bottom (owner 2026-11-17).
    spacing: Tokens.size-section-gap;
    // Why the page is not on air, with the action that fixes it (U9).
    if b.state == 1: SettingsCallout {
        label: @tr("Browser engine not installed");
        Text {
            text: @tr("Pages need the browser engine. Install it once in Settings › Add-ons.");
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            Button {
                lead: IconName.gear;
                text: @tr("Open Add-ons");
                kind: "primary";
                dense: true;
                clicked => { Studio.open-browser-engine(); }
            }
        }
    }
    if b.state == 2 || b.state == 3: SettingsCallout {
        label: b.state == 2 ? @tr("No page slot free") : @tr("The page did not load");
        Text {
            text: b.state == 2
                ? @tr("Two pages already run. This page starts when one of them is hidden.")
                : b.status;
            color: Theme.text-primary;
            font-size: Tokens.type-body-size;
            wrap: word-wrap;
        }
    }
    SegmentedControl {
        label: @tr("Page of {}", root.name);
        options: [@tr("Web address"), @tr("Local file")];
        index: b.file ? 1 : 0;
        selected(i) => { if (i == 1) != b.file { Studio.set-browser-local(b.id, i == 1); } }
    }
    if !b.file: Field {
        label: @tr("Address");
        TextField {
            label: @tr("Web address of {}", root.name);
            text: b.url;
            placeholder: "https://";
            accepted(v) => { if v != b.url { Studio.set-browser-value(b.id, "url", v); } }
        }
    }
    if b.file: Field {
        label: @tr("File");
        HorizontalLayout {
            spacing: Tokens.space-1;
            Text {
                horizontal-stretch: 1;
                text: b.file-name == "" ? @tr("No file") : b.file-name;
                color: b.file-name == "" ? Theme.text-secondary : Theme.text-primary;
                font-size: Tokens.type-body-size;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                lead: IconName.folder;
                text: @tr("Choose…");
                accessible-name: @tr("Choose a page file for {}", root.name);
                dense: true;
                clicked => { Studio.choose-browser-file(b.id); }
            }
        }
    }
    if b.file: Toggle {
        text: @tr("Reload when the file changes");
        label: @tr("Reload {} when its file changes", root.name);
        checked: b.reload-on-file-change;
        toggled(on) => { Studio.set-browser-flag(b.id, "reload_on_file_change", on); }
    }
    // Live actions on the running page: not undo steps (ADR-0132 decisions 5 and 6).
    HorizontalLayout {
        spacing: Tokens.space-1;
        alignment: start;
        Button {
            lead: IconName.refresh;
            text: @tr("Reload");
            accessible-name: @tr("Reload {}", root.name);
            dense: true;
            enabled: b.running;
            clicked => { Studio.browser-reload(b.id, false); }
        }
        Button {
            lead: IconName.refresh;
            text: @tr("Reload without cache");
            accessible-name: @tr("Reload {} without the cache", root.name);
            dense: true;
            enabled: b.running;
            clicked => { Studio.browser-reload(b.id, true); }
        }
    }
    HorizontalLayout {
        alignment: start;
        Button {
            lead: IconName.window;
            text: @tr("Interact…");
            accessible-name: @tr("Interact with {}", root.name);
            dense: true;
            enabled: b.state == 0 || b.state == 4;
            clicked => { Studio.browser-interact(b.id); }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Field {
            horizontal-stretch: 1;
            label: @tr("Width");
            NumberField {
                live: false;
                label: @tr("Page width of {}", root.name);
                unit: @tr("px");
                value: b.width;
                edited(v) => { Studio.set-browser-number(b.id, "width", max(2, min(8192, 2 * round(v / 2)))); }
            }
        }
        Field {
            horizontal-stretch: 1;
            label: @tr("Height");
            NumberField {
                live: false;
                label: @tr("Page height of {}", root.name);
                unit: @tr("px");
                value: b.height;
                edited(v) => { Studio.set-browser-number(b.id, "height", max(2, min(8192, 2 * round(v / 2)))); }
            }
        }
    }
    if b.width != b.canvas-w || b.height != b.canvas-h: HorizontalLayout {
        alignment: start;
        Button {
            lead: IconName.fill-canvas;
            text: @tr("Use canvas size");
            accessible-name: @tr("Use the canvas size for {}", root.name);
            dense: true;
            clicked => {
                Studio.set-browser-number(b.id, "width", b.canvas-w);
                Studio.set-browser-number(b.id, "height", b.canvas-h);
            }
        }
    }
    HorizontalLayout {
        spacing: Tokens.size-field-gap;
        Field {
            horizontal-stretch: 1;
            label: @tr("Frame rate");
            NumberField {
                live: false;
                label: @tr("Frame rate of {}", root.name);
                unit: @tr("fps");
                value: b.fps;
                edited(v) => { Studio.set-browser-number(b.id, "fps", max(1, min(60, round(v)))); }
            }
        }
        Field {
            horizontal-stretch: 1;
            label: @tr("Zoom");
            NumberField {
                live: false;
                label: @tr("Page zoom of {}", root.name);
                unit: "%";
                value: b.zoom;
                edited(v) => { Studio.set-browser-number(b.id, "zoom_percent", max(25, min(500, round(v)))); }
            }
        }
    }
    Toggle {
        text: @tr("Transparent background");
        label: @tr("Transparent background for {}", root.name);
        checked: b.transparent;
        toggled(on) => { Studio.set-browser-flag(b.id, "transparent", on); }
    }
    Section {
        title: @tr("Custom CSS");
        id: "properties.browser-css";
        hint: @tr("Added to the page as a style sheet when it loads, and at once while it runs. For example: body {{ background-color: rgba(0, 0, 0, 0); overflow: hidden; }}");
        TextArea {
            label: @tr("Custom CSS of {}", root.name);
            text: b.css;
            lines: 4;
            placeholder: @tr("No custom CSS");
            accepted(v) => { if v != b.css { Studio.set-browser-value(b.id, "css", v); } }
        }
    }
    Section {
        title: @tr("Automation");
        id: "properties.browser-automation";
        hint: @tr("Reloads the page or runs your script on a timer. The script runs inside the page with the page's own rights; it cannot reach RBS.");
        Field {
            label: @tr("Reload every");
            NumberField {
                live: false;
                label: @tr("Reload {} every so many seconds, 0 for never", root.name);
                unit: @tr("s");
                value: b.reload-every;
                edited(v) => { Studio.set-browser-number(b.id, "reload_every_s", v < 10 ? 0 : min(86400, round(v))); }
            }
        }
        Field {
            label: @tr("Script");
            TextArea {
                label: @tr("JavaScript for {}", root.name);
                text: b.script;
                lines: 4;
                placeholder: @tr("No script");
                accepted(v) => { if v != b.script { Studio.set-browser-value(b.id, "script", v); } }
            }
        }
        Toggle {
            text: @tr("Run when the page loads");
            label: @tr("Run the script of {} when the page loads", root.name);
            checked: b.script-on-load;
            enabled: b.script != "";
            toggled(on) => { Studio.set-browser-flag(b.id, "script_on_load", on); }
        }
        Field {
            label: @tr("Run every");
            NumberField {
                live: false;
                label: @tr("Run the script of {} every so many seconds, 0 for never", root.name);
                unit: @tr("s");
                value: b.script-every;
                enabled: b.script != "";
                edited(v) => { Studio.set-browser-number(b.id, "script_every_s", max(0, min(86400, round(v)))); }
            }
        }
        HorizontalLayout {
            alignment: start;
            Button {
                lead: IconName.play;
                text: @tr("Run now");
                accessible-name: @tr("Run the script of {} now", root.name);
                dense: true;
                enabled: b.running && b.script != "";
                clicked => { Studio.browser-run-script(b.id); }
            }
        }
    }
    Section {
        title: @tr("Behaviour");
        id: "properties.browser-behaviour";
        HorizontalLayout {
            spacing: Tokens.space-1;
            Toggle {
                horizontal-stretch: 1;
                text: @tr("Keep running when hidden");
                label: @tr("Keep {} running when hidden", root.name);
                checked: b.keep-running;
                toggled(on) => { Studio.set-browser-flag(b.id, "keep_running", on); }
            }
            VerticalLayout {
                alignment: center;
                InfoHint {
                    label: @tr("Keep running when hidden");
                    text: @tr("Chat and timers keep their state across scene changes. Costs one browser process and one of the two page slots while the source is in any scene; a shown page takes that slot first.");
                }
            }
        }
        HorizontalLayout {
            spacing: Tokens.space-1;
            Toggle {
                horizontal-stretch: 1;
                text: @tr("Retry when the page fails");
                label: @tr("Retry {} when the page fails to load", root.name);
                checked: b.retry-on-error;
                toggled(on) => { Studio.set-browser-flag(b.id, "retry_on_error", on); }
            }
            VerticalLayout {
                alignment: center;
                InfoHint {
                    label: @tr("Retry when the page fails");
                    text: @tr("The last good picture stays on air while RBS loads the page again, never an error page.");
                }
            }
        }
        Toggle {
            text: @tr("Keep signed in");
            label: @tr("Keep {} signed in", root.name);
            checked: b.keep-signed-in;
            toggled(on) => { Studio.set-browser-flag(b.id, "keep_signed_in", on); }
        }
        if b.keep-signed-in: HorizontalLayout {
            alignment: start;
            Button {
                lead: IconName.eraser;
                text: @tr("Forget sign-in");
                accessible-name: @tr("Forget the sign-in of {}", root.name);
                dense: true;
                clicked => { Studio.browser-forget-sign-in(b.id); }
            }
        }
    }
}

