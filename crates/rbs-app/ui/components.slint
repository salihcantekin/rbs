        : name == IconName.broadcast ? "M 6.75 8 a 1.25 1.25 0 1 0 2.5 0 a 1.25 1.25 0 1 0 -2.5 0 Z M 5.25 5.25 C 3.75 6.75 3.75 9.25 5.25 10.75 M 10.75 5.25 C 12.25 6.75 12.25 9.25 10.75 10.75 M 3.25 3.25 C 0.75 5.75 0.75 10.25 3.25 12.75 M 12.75 3.25 C 15.25 5.75 15.25 10.25 12.75 12.75"
        : name == IconName.link ? "M 6.5 9.5 L 9.5 6.5 M 7 4.5 L 8.5 3 C 9.75 1.75 11.75 1.75 13 3 C 14.25 4.25 14.25 6.25 13 7.5 L 11.5 9 M 9 11.5 L 7.5 13 C 6.25 14.25 4.25 14.25 3 13 C 1.75 11.75 1.75 9.75 3 8.5 L 4.5 7"
