// An icon by its name in the icon set, as Rust passes it (registry and panel icons).
export global Icons {
    // Slint has no string to enum conversion; unknown names draw nothing.
    public pure function named(name: string) -> IconName {
        return name == "more" ? IconName.more
        : name == "chevron-down" ? IconName.chevron-down
        : name == "chevron-up" ? IconName.chevron-up
        : name == "chevron-left" ? IconName.chevron-left
        : name == "chevron-right" ? IconName.chevron-right
