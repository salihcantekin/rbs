// RBS component library, first part (docs/specs/ui-design-system.md, "Components").
// Every value comes from the generated tokens (rule U6). Every control is reachable
// by keyboard, shows a focus ring and has an accessible role and name (rule U7).
import { Theme, Tokens } from "tokens.slint";

// Focus ring drawn around a focused control.
// A FocusScope that tells keyboard focus from pointer focus (like CSS :focus-visible).
// A click or press calls `focus-pointer()`; `ring` is then false until focus leaves,
// so the focus ring appears only after Tab or arrow-key navigation, never after a mouse
// click. Focus and the accessibility tree are unchanged.
export component RingFocus inherits FocusScope {
    out property <bool> ring: self.has-focus && !by-pointer;
    property <bool> by-pointer;
    public function focus-pointer() {
        by-pointer = true;
        self.focus();
    }
    changed has-focus => { if !self.has-focus { by-pointer = false; } }
}

export component FocusRing inherits Rectangle {
    in property <bool> show;
    border-width: show ? Tokens.size-focus-ring : 0px;
    border-color: Theme.border-focus;
    border-radius: Tokens.radius-sm;
}

// The RBS mark (docs/specs/ui-design-system.md, "Brand mark"): a scene frame with a round
// camera bubble cut out of its corner, and the bubble's dot in the brand colour. Drawn in a
// 64 x 64 view box; `ink` is the frame, `Theme.brand` the dot. Decorative: the control
// that shows it carries the accessible name.
// The RBS mark: a window (title bar and sidebar cut out) with a camera bubble in its
// lower right corner. The window is `Theme.brand`, the cut-outs and the bubble's ring are
// `ground` (the colour the mark sits on, so pass the button's own background), the camera
// is `ink`. Same geometry as the application icon (assets/brand/generate_icons.py).
export component BrandMark inherits Rectangle {
    in property <color> ink: Theme.text-primary;
    in property <color> ground: Theme.surface-raised;
    width: Tokens.size-icon-box;
    height: Tokens.size-icon-box;
    accessible-role: none;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 64;
        viewbox-height: 64;
        fill: Theme.brand;
        commands: "M 11 9 H 53 A 8 8 0 0 1 61 17 V 43 A 8 8 0 0 1 53 51 H 11 A 8 8 0 0 1 3 43 V 17 A 8 8 0 0 1 11 9 Z";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 64;
        viewbox-height: 64;
        fill: root.ground;
        commands: "M 3 20 H 61 V 23 H 3 Z M 22 23 H 25 V 51 H 22 Z M 28 44 a 18 18 0 1 0 36 0 a 18 18 0 1 0 -36 0 Z";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 64;
        viewbox-height: 64;
        fill: root.ink;
        commands: "M 31 44 a 15 15 0 1 0 30 0 a 15 15 0 1 0 -30 0 Z";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 64;
        viewbox-height: 64;
        fill: root.ground;
        commands: "M 41 40 a 5 5 0 1 0 10 0 a 5 5 0 1 0 -10 0 Z M 38 52 a 8 6.5 0 0 1 16 0 Z";
    }
}

// BEGIN generated icon set (icons.rs; do not edit)
// The icon set (docs/specs/ui-design-system.md, "Icons"; rbs_ui::icon::ICONS).
export enum IconName {
    none,
    more,
    chevron-down,
    chevron-up,
    chevron-left,
    chevron-right,
    check,
    close,
    dot,
    ring,
    stop,
    plus,
    pin,
    panel-left,
    panel-right,
    panel-bottom,
    bolt,
    grid,
    copy,
    window,
    search,
    monitor,
    camera,
    mic,
    speaker,
    eye,
    eye-off,
    expand,
    lock,
    unlock,
    speaker-off,
    sliders,
    palette,
    keyboard,
    broadcast,
    link,
    globe,
    gear,
    user,
    folder,
    undo,
    redo,
    layout,
    panel-all,
    panel-none,
    reset,
    refresh,
    image,
    pencil,
    trash,
    transition,
    export,
    import,
    arrow-left,
    arrow-right,
    menu,
    rail-between,
    rail-below,
    window-minimize,
    window-maximize,
    window-restore,
}

// Vector icon. Icons are paths, not font glyphs, so they look the same on every OS
// (a glyph missing from the system font shows as an empty box). Drawn in a 16 x 16
// view box. Decorative: the control that shows it carries the accessible name.
export component Icon inherits Rectangle {
    in property <IconName> name;
    in property <color> ink: Theme.text-primary;
    // Filled shapes; the others are drawn as lines.
    property <bool> filled: name == IconName.more || name == IconName.dot || name == IconName.stop;
    property <string> commands:
        name == IconName.more ? "M 2.5 8 a 1.25 1.25 0 1 0 2.5 0 a 1.25 1.25 0 1 0 -2.5 0 Z M 6.75 8 a 1.25 1.25 0 1 0 2.5 0 a 1.25 1.25 0 1 0 -2.5 0 Z M 11 8 a 1.25 1.25 0 1 0 2.5 0 a 1.25 1.25 0 1 0 -2.5 0 Z"
        : name == IconName.chevron-down ? "M 4 6 L 8 10 L 12 6"
        : name == IconName.chevron-up ? "M 4 10 L 8 6 L 12 10"
        : name == IconName.chevron-left ? "M 10 4 L 6 8 L 10 12"
        : name == IconName.chevron-right ? "M 6 4 L 10 8 L 6 12"
        : name == IconName.check ? "M 3.5 8.5 L 6.5 11.5 L 12.5 4.5"
        : name == IconName.close ? "M 4.5 4.5 L 11.5 11.5 M 11.5 4.5 L 4.5 11.5"
        : name == IconName.dot ? "M 4 8 a 4 4 0 1 0 8 0 a 4 4 0 1 0 -8 0 Z"
        : name == IconName.ring ? "M 4 8 a 4 4 0 1 0 8 0 a 4 4 0 1 0 -8 0 Z"
        : name == IconName.stop ? "M 4.5 4.5 L 11.5 4.5 L 11.5 11.5 L 4.5 11.5 Z"
        : name == IconName.plus ? "M 8 3 L 8 13 M 3 8 L 13 8"
        : name == IconName.pin ? "M 5.5 2.5 L 10.5 2.5 M 6.5 2.5 L 6.5 6.5 L 4.5 9.5 L 11.5 9.5 L 9.5 6.5 L 9.5 2.5 M 8 9.5 L 8 14"
        : name == IconName.panel-left ? "M 2.5 3 L 13.5 3 L 13.5 13 L 2.5 13 Z M 6.5 3 L 6.5 13"
        : name == IconName.panel-right ? "M 2.5 3 L 13.5 3 L 13.5 13 L 2.5 13 Z M 9.5 3 L 9.5 13"
