// RBS component library, first part (docs/specs/ui-design-system.md, "Components").
// Every value comes from the generated tokens (rule U6). Every control is reachable
// by keyboard, shows a focus ring and has an accessible role and name (rule U7).
import { Theme, Tokens } from "tokens.slint";

// Focus ring drawn around a focused control.
component FocusRing inherits Rectangle {
    in property <bool> show;
    border-width: show ? Tokens.size-focus-ring : 0px;
    border-color: Theme.border-focus;
    border-radius: Tokens.radius-sm;
}

// The icon set (docs/specs/ui-design-system.md, "Icons").
export enum IconName { none, more, chevron-down, check, close, dot, ring }

// Vector icon. Icons are paths, not font glyphs, so they look the same on every OS
// (a glyph missing from the system font shows as an empty box). Drawn in a 16 x 16
// view box. Decorative: the control that shows it carries the accessible name.
export component Icon inherits Rectangle {
    in property <IconName> name;
    in property <color> ink: Theme.text-primary;
    width: Tokens.size-icon-box;
    height: Tokens.size-icon-box;
    accessible-role: none;
    if name == IconName.more: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.ink;
        commands: "M 2.5 8 a 1.25 1.25 0 1 0 2.5 0 a 1.25 1.25 0 1 0 -2.5 0 Z M 6.75 8 a 1.25 1.25 0 1 0 2.5 0 a 1.25 1.25 0 1 0 -2.5 0 Z M 11 8 a 1.25 1.25 0 1 0 2.5 0 a 1.25 1.25 0 1 0 -2.5 0 Z";
    }
    if name == IconName.chevron-down: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.ink;
        stroke-width: Tokens.size-icon-stroke;
        commands: "M 4 6 L 8 10 L 12 6";
    }
    if name == IconName.check: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.ink;
        stroke-width: Tokens.size-icon-stroke;
        commands: "M 3.5 8.5 L 6.5 11.5 L 12.5 4.5";
    }
    if name == IconName.close: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.ink;
        stroke-width: Tokens.size-icon-stroke;
        commands: "M 4.5 4.5 L 11.5 11.5 M 11.5 4.5 L 4.5 11.5";
    }
    if name == IconName.dot: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.ink;
        commands: "M 4 8 a 4 4 0 1 0 8 0 a 4 4 0 1 0 -8 0 Z";
    }
    if name == IconName.ring: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.ink;
        stroke-width: Tokens.size-icon-stroke;
        commands: "M 4 8 a 4 4 0 1 0 8 0 a 4 4 0 1 0 -8 0 Z";
    }
}

// Button: kinds "primary", "secondary", "ghost", and "live" (only for stopping a live
// or recording output: the fixed live colour, rule U12). Activated by click, Enter or
// Space.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: text;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <bool> dense: false;
    // Optional icon after the text. For an icon-only button use IconButton.
    in property <IconName> icon;
    callback clicked();
    height: dense ? Tokens.size-control-sm : Tokens.size-control-md;
    min-width: max(root.height, content.preferred-width + (text == "" ? 0px : 2 * Tokens.space-3));
    border-radius: Tokens.radius-sm;
    background: !enabled ? transparent
        : kind == "primary" ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : kind == "live" ? Theme.state-live
        : checked ? Theme.accent-subtle
        : touch.has-hover ? Theme.surface-overlay
        : kind == "ghost" ? transparent : Theme.surface-raised;
    border-width: kind == "secondary" ? Tokens.size-border : 0px;
    border-color: Theme.border-subtle;
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    forward-focus: focus;
    property <color> ink: !enabled ? Theme.text-disabled : kind == "primary" ? Theme.text-inverse : kind == "live" ? Theme.text-on-live : Theme.text-primary;
    content := HorizontalLayout {
        alignment: center;
        spacing: Tokens.space-1;
        if root.text != "": Text {
            text: root.text;
            color: root.ink;
            font-size: Tokens.type-label-size;
            font-weight: Tokens.type-label-weight;
            vertical-alignment: center;
        }
        if root.icon != IconName.none: VerticalLayout {
            alignment: center;
            Icon { name: root.icon; ink: root.ink; }
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    // The TouchArea comes after the FocusScope so it is on top: a FocusScope
    // under the pointer takes the press for itself (focus-on-click).
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.clicked(); }
    }
    FocusRing { show: focus.has-focus; }
}

// Icon-only button (ghost, dense). Always set `name`: it is the accessible name and
// the tooltip-to-be, because the icon itself has no text.
export component IconButton inherits Button {
    in property <string> name;
    text: "";
    accessible-name: name;
    kind: "ghost";
    dense: true;
    width: Tokens.size-control-sm;
}

// Menu item inside a Menu popup.
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    // Focus this item when it is created (the first item of a menu that just opened).
    in property <bool> autofocus;
    callback activated();
    // Focusing in `init` is too early: the popup window is not active yet and
    // the request is lost. A one-shot timer focuses once, after the first frame,
    // and then stops, so it costs nothing while the menu stays open.
    property <bool> focused-once;
    Timer {
        interval: 1ms;
        running: root.autofocus && !root.focused-once;
        triggered => { root.focused-once = true; focus.focus(); }
    }
    height: Tokens.size-control-md;
    background: focus.has-focus || touch.has-hover ? Theme.accent-subtle : transparent;
    border-radius: Tokens.radius-sm;
    accessible-role: button;
    accessible-label: text;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-3;
        spacing: Tokens.space-2;
        VerticalLayout {
            width: Tokens.size-icon-box;
            alignment: center;
            Icon {
                name: root.checked ? IconName.check : IconName.none;
                ink: root.enabled ? Theme.text-primary : Theme.text-disabled;
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            // A long device name is cut with an ellipsis; the accessible label keeps it.
            overflow: elide;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.activated(); return accept; }
            reject
        }
    }
    // The TouchArea comes after the FocusScope so it is on top: a FocusScope
    // under the pointer takes the press for itself (focus-on-click).
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

// Popover surface for menus.
export component MenuSurface inherits Rectangle {
    background: Theme.surface-overlay;
    border-color: Theme.border-strong;
    border-width: Tokens.size-border;
    border-radius: Tokens.radius-md;
}

// Empty state: what the panel is for and the next action (rule U10).
export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> message;
    // The next action as a button (rule U10); none when empty.
    in property <string> action;
    callback act();
    VerticalLayout {
        alignment: center;
        spacing: Tokens.space-2;
        padding: Tokens.space-4;
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Tokens.type-title-size;
            font-weight: Tokens.type-title-weight;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.message;
            color: Theme.text-secondary;
            font-size: Tokens.type-body-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.action != "": HorizontalLayout {
            alignment: center;
            Button { text: root.action; kind: "primary"; clicked => { root.act(); } }
        }
    }
}

// Select: a button showing the chosen option; it opens a list of the options. The
// owner counts `open` as an overlay (the preview layer hides under popups).
export component Select inherits Rectangle {
    // The field's name: the accessible name is "<label>: <option>".
    in property <string> label;
    in property <[string]> options;
    in property <int> index;
    in property <bool> enabled: true;
    out property <bool> open: menu.is-open;
    callback selected(int);
    height: Tokens.size-control-md;
    Button {
        width: root.width;
        height: root.height;
        text: root.options[root.index];
        accessible-name: @tr("{}: {}", root.label, root.options[root.index]);
        icon: IconName.chevron-down;
        enabled: root.enabled;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        close-policy: close-on-click-outside;
        y: root.height;
        width: root.width;
        MenuSurface {
            width: root.width;
            accessible-role: list;
            accessible-label: root.label;
            VerticalLayout {
                padding: Tokens.space-2;
                spacing: Tokens.space-1;
                for o[i] in root.options: MenuItem {
                    text: o;
                    checked: i == root.index;
                    autofocus: i == root.index;
                    activated => { root.selected(i); menu.close(); }
                }
            }
        }
    }
}

// Checkbox: an on/off setting with its label beside the box. Toggled by click, Space
// or Enter; the label is the accessible name and the state is shown by the check mark
// as well as the fill (never by colour alone, U7). States: unchecked, checked, hover
// (accent border), pressed (overlay or hover fill), focused (focus ring) and disabled
// (subtle border, disabled ink, no input). A long label wraps and the row grows.
export component Checkbox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: Tokens.size-control-md;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { toggled(!checked); } }
    forward-focus: focus;
    property <color> ink: enabled ? Theme.text-primary : Theme.text-disabled;
    HorizontalLayout {
        spacing: Tokens.space-2;
        alignment: start;
        VerticalLayout {
            alignment: center;
            box := Rectangle {
                width: Tokens.size-icon-box;
                height: Tokens.size-icon-box;
                border-radius: Tokens.radius-sm;
                border-width: Tokens.size-border;
                border-color: !root.enabled ? Theme.border-subtle
                    : touch.has-hover ? Theme.accent : Theme.border-strong;
                background: !root.enabled ? Theme.surface-sunken
                    : root.checked ? (touch.pressed ? Theme.accent-hover : Theme.accent)
                    : touch.pressed ? Theme.surface-overlay : Theme.surface-sunken;
                Icon {
                    name: root.checked ? IconName.check : IconName.none;
                    ink: root.enabled ? Theme.text-inverse : Theme.text-disabled;
                }
            }
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: Tokens.type-body-size;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.toggled(!root.checked); return accept; }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.toggled(!root.checked); }
    }
    FocusRing { show: focus.has-focus; }
}

// SegmentedControl: a few mutually exclusive options side by side.
export component SegmentedControl inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in property <int> index;
    in property <bool> enabled: true;
    callback selected(int);
    height: Tokens.size-control-md;
    accessible-role: groupbox;
    accessible-label: label;
    HorizontalLayout {
        spacing: Tokens.space-1;
        alignment: start;
        for o[i] in root.options: Button {
            text: o;
            accessible-name: @tr("{}: {}", root.label, o);
            checked: i == root.index;
            enabled: root.enabled;
            clicked => { root.selected(i); }
        }
    }
}

// TextField: one line of text. `accepted` runs on Return and when focus leaves.
export component TextField inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <bool> enabled: true;
    callback accepted(string);
    height: Tokens.size-control-md;
    border-radius: Tokens.radius-sm;
    border-width: Tokens.size-border;
    border-color: input.has-focus ? Theme.border-focus : Theme.border-subtle;
    background: Theme.surface-sunken;
    forward-focus: input;
    input := TextInput {
        x: Tokens.space-2;
        width: parent.width - 2 * Tokens.space-2;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        vertical-alignment: center;
        color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        font-size: Tokens.type-body-size;
        selection-background-color: Theme.accent-subtle;
        selection-foreground-color: Theme.text-primary;
        accessible-label: root.label;
        accepted => { root.accepted(self.text); }
    }
    property <bool> focused: input.has-focus;
    changed focused => { if !focused { root.accepted(root.text); } }
}
