{
  "name": "rbs-stream-deck",
  "private": true,
  "type": "module",
  "dependencies": {
    "@elgato/streamdeck": "^3.0.6",
    "@elgato/utils": "^0.7.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "json-schema-to-typescript": "^16.0.0",
    "rollup": "^4.68.8",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "version": "0.1.0",
  "description": "Stream Deck plugin for RBS (a Control API client)",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen-types": "node scripts/gen-types.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.rbs.streamdeck\"",
    "test": "node scripts/gen-types.mjs --check && vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && node scripts/pack.mjs",
    "check-types": "node scripts/gen-types.mjs --check"
  }
}
